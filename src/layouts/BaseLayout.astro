---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import PreviewBanner from '../components/PreviewBanner.astro';
import AnnouncementBanner from '../components/AnnouncementBanner.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Bachata lessons, private coaching, and social events.',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, 'https://dancewithb.fun').toString();

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'DanceSchool',
  name: 'Dance with B',
  description: 'Bachata sensual classes, private coaching, and social dance events in Madison, WI.',
  url: 'https://dancewithb.fun',
  image: 'https://dancewithb.fun/favicon.svg',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '6725 Seybold Rd',
    addressLocality: 'Madison',
    addressRegion: 'WI',
    postalCode: '53719',
    addressCountry: 'US',
  },
  founder: {
    '@type': 'Person',
    name: 'B Li',
  },
  // Reflects the published group-class hours (also set on the Google
  // Business Profile). Private lessons/workshops run outside these hours
  // by appointment, so they're described in copy rather than modeled here.
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: 'Sunday',
    opens: '13:00',
    closes: '15:00',
  },
  sameAs: ['https://www.instagram.com/ohmytofuu/', 'https://open.spotify.com/playlist/15WaYTwjYFwQ2yq33c9Gh8'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title} | Dance with B</title>
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Dance with B`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} | Dance with B`} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <PreviewBanner />
    <AnnouncementBanner />
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
  </body>
</html>
