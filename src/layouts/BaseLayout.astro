---
import '../styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import poppins800Latin from '@fontsource/poppins/files/poppins-latin-800-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PreviewBanner from '../components/PreviewBanner.astro';
import AnnouncementBanner from '../components/AnnouncementBanner.astro';
import { siteTimeZone } from '../lib/siteTime';
import { DEFAULT_SHARE_IMAGE, jsonLd, siteSchema } from '../lib/seoSchema';
import { DEFAULT_LOCATION } from '../lib/siteLocation';

interface Props {
  title: string;
  description?: string;
  // Link-preview image (absolute URL); the site icon when not given.
  image?: string;
  // A class's own link preview (lib/sharePreview.ts): its title replaces "<title> | Dance with B", the flyer's pixel size and alt text, and the class's own link (path and ?series=) as the canonical.
  ogTitle?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  canonical?: string;
  // Extra schema.org JSON-LD for search engines (e.g. the homepage's classes); never shown.
  structuredData?: unknown[];
  // Kept out of search results (e.g. a dancer's own feedback link).
  noindex?: boolean;
}

const {
  title,
  description = 'Bachata lessons, private coaching, and social events.',
  image = DEFAULT_SHARE_IMAGE,
  ogTitle,
  imageWidth,
  imageHeight,
  imageAlt,
  canonical,
  structuredData = [],
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(canonical ?? Astro.url.pathname, 'https://dancewithb.fun').toString();
const shareTitle = ogTitle ?? `${title} | Dance with B`;

// Search engines see Dance with B and B as the instructor and organizer
// (lib/seoSchema.ts), with no studio address, since the venue changes.
const siteStructuredData = siteSchema(['https://www.instagram.com/ohmytofuu/', 'https://open.spotify.com/playlist/15WaYTwjYFwQ2yq33c9Gh8'], Astro.locals.siteLocation ?? DEFAULT_LOCATION);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Read by siteTime.ts in the browser, so pages show times in the site's zone. */}
    <meta name="site-time-zone" content={siteTimeZone()} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* Installed on a phone (see /app), it opens full screen under this name and color. */}
    <meta name="theme-color" content="#170f0d" />
    <meta name="apple-mobile-web-app-title" content="Dance with B" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{shareTitle}</title>
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Dance with B" />
    <meta property="og:image" content={image} />
    {imageWidth && imageHeight && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageWidth && imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={image === DEFAULT_SHARE_IMAGE ? 'summary' : 'summary_large_image'} />
    <meta name="twitter:image" content={image} />
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={jsonLd(siteStructuredData)} />
    {structuredData.map((data) => <script type="application/ld+json" set:html={jsonLd(data)} />)}
    {/* Only the two files the first screen needs: the body font (Inter, every weight in one file) and the logo (Poppins 800). Others load when a page shows them. */}
    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={poppins800Latin} crossorigin />
  </head>
  <body class="flex min-h-screen flex-col">
    <script>
      const siteTop = document.getElementById('site-top');
      if (siteTop) new ResizeObserver(() => document.documentElement.style.setProperty('--site-top-h', `${siteTop.offsetHeight}px`)).observe(siteTop);
      // Makes the site installable (public/sw.js caches nothing).
      if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {});
      // iOS Safari only paints :active (the pressed look, global.css) once the page has a touch listener.
      document.addEventListener('touchstart', () => {}, { passive: true });
    </script>
    <PreviewBanner />
    {/* The announcement banner sticks to the top with the nav header. Its height goes in --site-top-h for anything that sticks just below them. */}
    <div id="site-top" class="sticky top-0 z-50 print:hidden">
      <AnnouncementBanner />
      <Header />
    </div>
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
