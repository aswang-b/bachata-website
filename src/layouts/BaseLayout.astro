---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import PreviewBanner from '../components/PreviewBanner.astro';
import AnnouncementBanner from '../components/AnnouncementBanner.astro';
import { siteTimeZone } from '../lib/siteTime';
import { DEFAULT_SHARE_IMAGE, jsonLd, siteSchema } from '../lib/seoSchema';

interface Props {
  title: string;
  description?: string;
  // Link-preview image (absolute URL); the site icon when not given.
  image?: string;
  // Extra schema.org JSON-LD for search engines (e.g. the homepage's classes); never shown.
  structuredData?: unknown[];
}

const {
  title,
  description = 'Bachata lessons, private coaching, and social events.',
  image = DEFAULT_SHARE_IMAGE,
  structuredData = [],
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, 'https://dancewithb.fun').toString();

// Search engines see Dance with B and B as the instructor and organizer
// (lib/seoSchema.ts), with no studio address, since the venue changes.
const siteStructuredData = siteSchema(['https://www.instagram.com/ohmytofuu/', 'https://open.spotify.com/playlist/15WaYTwjYFwQ2yq33c9Gh8']);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Read by siteTime.ts in the browser, so pages show times in the site's zone. */}
    <meta name="site-time-zone" content={siteTimeZone()} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="description" content={description} />
    <title>{title} | Dance with B</title>
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Dance with B`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Dance with B" />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content={image === DEFAULT_SHARE_IMAGE ? 'summary' : 'summary_large_image'} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:title" content={`${title} | Dance with B`} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={jsonLd(siteStructuredData)} />
    {structuredData.map((data) => <script type="application/ld+json" set:html={jsonLd(data)} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <script>
      const siteTop = document.getElementById('site-top');
      if (siteTop) new ResizeObserver(() => document.documentElement.style.setProperty('--site-top-h', `${siteTop.offsetHeight}px`)).observe(siteTop);
    </script>
    <PreviewBanner />
    {/* The announcement banner sticks to the top with the nav header. Its height goes in --site-top-h for anything that sticks just below them. */}
    <div id="site-top" class="sticky top-0 z-50 print:hidden">
      <AnnouncementBanner />
      <Header />
    </div>
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
  </body>
</html>
