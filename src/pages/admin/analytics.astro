  // --- Editing locks ---
  // A conservative pessimistic lock: only the tab that holds it may add,
  // edit, or delete rows, so two concurrent edits can never clobber each
  // other. Sign-ups and check-ins each get their own lock resource, so
  // editing one never blocks the other. holderId is per-browser-tab
  // (sessionStorage), so reloading the same tab keeps ownership; a new tab
  // gets a new identity and must lock separately.
  let holderId = '';
  try {
    holderId = sessionStorage.getItem('bwb-analytics-holder') ?? '';
  } catch {
    // ignore
  }
  if (!holderId) {
    holderId = crypto.randomUUID();
    try {
      sessionStorage.setItem('bwb-analytics-holder', holderId);
    } catch {
      // ignore — lock still works for this page load, just won't survive a reload.
    }
  }

  const timeFormatter = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone: siteTimeZone() });

  function makeLockController(
    resource: 'signups' | 'eventRegistrations' | 'checkins' | 'attendance' | 'recycling',
    lockBtn: HTMLButtonElement,
    lockStatus: HTMLElement,
    onChange: (locked: boolean) => void
  ) {
    let isLockedByMe = false;
    let heartbeatTimer: ReturnType<typeof setInterval> | null = null;

    function startHeartbeat() {
      if (!heartbeatTimer) heartbeatTimer = setInterval(tryLock, 2 * 60 * 1000);
    }

    function stopHeartbeat() {
      if (heartbeatTimer) {
        clearInterval(heartbeatTimer);
        heartbeatTimer = null;
      }
    }

    async function refresh() {
      const {
        data: { session },
      } = await supabaseBrowser.auth.getSession();
      if (!session) return;

      const res = await fetch(`/api/admin/lock-status?resource=${resource}`, { headers: { Authorization: `Bearer ${session.access_token}` } });
      if (!res.ok) return;
      const { locked, lockedBy, expiresAt } = await res.json();

      const myFullId = `${session.user.email}::${holderId}`;
      isLockedByMe = locked && lockedBy === myFullId;

      if (isLockedByMe) {
        lockBtn.textContent = 'Release Lock';
        lockStatus.textContent = `Editing enabled — expires ${timeFormatter.format(new Date(expiresAt))} (auto-extends while this tab is open).`;
      } else if (locked) {
        const email = String(lockedBy).split('::')[0];
        lockBtn.textContent = 'Try Lock to Edit';
        lockStatus.textContent = `🔒 Locked for editing by ${email} until ${timeFormatter.format(new Date(expiresAt))}.`;
      } else {
        lockBtn.textContent = 'Try Lock to Edit';
        lockStatus.textContent = 'Not locked — click to enable adding, editing, and deleting rows.';
      }

      onChange(isLockedByMe);
    }

    async function tryLock() {
      const {
        data: { session },
      } = await supabaseBrowser.auth.getSession();
      if (!session) return;

      if (isLockedByMe) {
        const res = await fetch('/api/admin/release-lock', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${session.access_token}` },
          body: JSON.stringify({ holderId, resource }),
        });
        if (res.ok) stopHeartbeat();
        await refresh();
        return;
      }

      const res = await fetch('/api/admin/acquire-lock', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${session.access_token}` },
        body: JSON.stringify({ holderId, resource }),
      });
      const data = await res.json();

      if (res.ok && data.acquired) {
        // Re-acquiring on the same holderId extends the lock, so this both
        // detects an expired lock and refreshes an active one.
        startHeartbeat();
      } else if (res.ok) {
        lockStatus.textContent = `🔒 Locked for editing by ${data.lockedByEmail} until ${timeFormatter.format(new Date(data.expiresAt))}.`;
      }
      await refresh();
    }

    lockBtn.addEventListener('click', () => tryLock());

    // Only the active tab's lock needs a live heartbeat — the other two
    // resources' locks (if held) simply expire via their own TTL while their
    // tab isn't active, same as if the page had been closed, rather than
    // running 3 concurrent polling loops the whole time the page is open.
    async function pauseHeartbeat() {
      stopHeartbeat();
    }

    async function resumeHeartbeat() {
      await refresh();
      if (isLockedByMe) startHeartbeat();
    }

    return { refresh, isLocked: () => isLockedByMe, pauseHeartbeat, resumeHeartbeat };
  }

