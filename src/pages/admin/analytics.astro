---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Data & Analytics">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="flex items-center justify-between gap-4">
      <h1 class="font-display text-3xl font-extrabold text-ink">Dancer Dashboard</h1>
      <a href="/admin" class="text-sm font-semibold text-accent hover:underline">&larr; Admin Tools</a>
    </div>

    <p id="loading" class="mt-8 text-sm text-muted">Loading&hellip;</p>

    <div id="signed-out" class="mt-8 hidden flex-col items-start gap-3">
      <p class="text-sm text-muted">Sign in as an admin to view this page.</p>
      <a href="/admin" class="text-sm font-semibold text-accent hover:underline">Go to Admin Tools</a>
    </div>

    <div id="not-admin" class="mt-8 hidden flex-col items-start gap-3">
      <p class="text-sm text-muted">This account isn't authorized as an admin.</p>
    </div>

    <div id="dashboard" class="mt-8 hidden flex-col gap-6">
      <div class="flex gap-1 border-b border-border" role="tablist">
        <button type="button" data-tab="signups" class="tab-btn border-b-2 border-transparent px-4 py-2.5 text-sm font-bold text-ink/60 transition-colors hover:text-ink">
          Sign-Ups
        </button>
        <button type="button" data-tab="checkins" class="tab-btn border-b-2 border-transparent px-4 py-2.5 text-sm font-bold text-ink/60 transition-colors hover:text-ink">
          Check-Ins
        </button>
        <button type="button" data-tab="attendance" class="tab-btn border-b-2 border-transparent px-4 py-2.5 text-sm font-bold text-ink/60 transition-colors hover:text-ink">
          Attendance
        </button>
      </div>

      <!-- ==================== SIGN-UPS TAB ==================== -->
      <section id="tab-panel-signups" class="tab-panel flex flex-col gap-6">
        <div class="flex flex-col gap-4 rounded-2xl border border-border bg-surface p-4 sm:flex-row sm:items-end">
          <label class="flex flex-1 flex-col gap-1.5">
            <span class="text-xs font-semibold uppercase tracking-wider text-muted">Search by dancer name</span>
            <input
              id="signups-name-search"
              type="text"
              placeholder="e.g. Jane Doe"
              class="rounded-xl border border-border bg-bg px-3 py-2 text-ink focus:border-accent focus:outline-none"
            />
          </label>
          <label class="flex flex-1 flex-col gap-1.5">
            <span class="text-xs font-semibold uppercase tracking-wider text-muted">Filter by class</span>
            <select id="signups-class-filter" class="rounded-xl border border-border bg-bg px-3 py-2 text-ink focus:border-accent focus:outline-none">
              <option value="">All classes</option>
            </select>
          </label>
          <button
            id="signups-clear-filters"
            class="rounded-full border border-border px-4 py-2 text-xs font-bold uppercase tracking-wider text-ink/70 transition-colors hover:bg-bg"
          >
            Clear
          </button>
        </div>

        <div class="flex flex-wrap items-center gap-3 rounded-2xl border border-border bg-surface p-4">
          <button
            id="signups-lock-btn"
            class="rounded-full border border-accent px-4 py-2 text-xs font-bold uppercase tracking-wider text-accent transition-colors hover:bg-accent hover:text-white"
          >
            Try Lock to Edit
          </button>
          <p id="signups-lock-status" class="text-xs text-muted"></p>
        </div>

        <div>
          <div class="flex items-baseline justify-between">
            <h2 class="font-display text-xl font-bold text-ink">Sign-Ups</h2>
            <p id="signups-count" class="text-xs text-muted"></p>
          </div>
          <div class="mt-2 flex flex-wrap items-center gap-2">
            <button
              id="add-signup-btn"
              class="add-signup-row-btn hidden rounded-full border border-accent px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-accent transition-colors hover:bg-accent hover:text-white"
            >
              + Add Sign-Up
            </button>
            <button
              id="show-deleted-signups-btn"
              class="rounded-full border border-border px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-ink/70 transition-colors hover:bg-surface"
            >
              Recently Deleted
            </button>
          </div>

          <div id="deleted-signups-panel" class="mt-3 hidden flex-col gap-3 rounded-2xl border border-border bg-surface p-4">
            <div class="flex items-baseline justify-between">
              <p class="text-xs font-semibold uppercase tracking-wider text-muted">Deleted in the last 7 days</p>
              <p id="deleted-signups-count" class="text-xs text-muted"></p>
            </div>
            <div class="overflow-x-auto rounded-xl border border-border">
              <table class="w-full min-w-[640px] text-left text-sm">
                <thead class="bg-bg text-xs font-semibold uppercase tracking-wider text-muted">
                  <tr>
                    <th class="px-4 py-2.5">Name</th>
                    <th class="px-4 py-2.5">Class</th>
                    <th class="px-4 py-2.5">Deleted</th>
                    <th class="px-4 py-2.5">By</th>
                    <th class="px-4 py-2.5">Restore</th>
                  </tr>
                </thead>
                <tbody id="deleted-signups-body"></tbody>
              </table>
              <p id="deleted-signups-empty" class="hidden px-4 py-6 text-center text-sm text-muted">Nothing deleted in the last 7 days.</p>
            </div>
          </div>

          <div class="mt-3 overflow-x-auto rounded-2xl border border-border">
            <table class="w-full min-w-[860px] text-left text-sm">
              <thead class="bg-surface text-xs font-semibold uppercase tracking-wider text-muted">
                <tr>
                  <th class="sort-header cursor-pointer select-none px-4 py-3" data-table="signups" data-column="firstName">First Name</th>
                  <th class="sort-header cursor-pointer select-none px-4 py-3" data-table="signups" data-column="lastName">Last Name</th>
                  <th class="sort-header cursor-pointer select-none px-4 py-3" data-table="signups" data-column="email">Contact Info</th>
                  <th class="sort-header cursor-pointer select-none px-4 py-3 min-w-[220px]" data-table="signups" data-column="class">Class</th>
                  <th class="px-4 py-3">Series</th>
                  <th class="px-4 py-3">Payment</th>
                  <th class="sort-header cursor-pointer select-none px-4 py-3" data-table="signups" data-column="paid">Paid</th>
                  <th class="sort-header cursor-pointer select-none px-4 py-3" data-table="signups" data-column="createdAt">Registered</th>
                  <th class="signups-actions-header hidden px-4 py-3 min-w-[96px]">Actions</th>
                </tr>
              </thead>
              <tbody id="signups-body"></tbody>
            </table>
            <p id="signups-empty" class="hidden px-4 py-6 text-center text-sm text-muted">No sign-ups match these filters.</p>
          </div>
        </div>
      </section>

      <!-- ==================== CHECK-INS TAB ==================== -->
      <section id="tab-panel-checkins" class="tab-panel hidden flex-col gap-6">
        <div class="flex flex-col gap-4 rounded-2xl border border-border bg-surface p-4 sm:flex-row sm:items-end">
          <label class="flex flex-1 flex-col gap-1.5">
            <span class="text-xs font-semibold uppercase tracking-wider text-muted">Search by dancer name</span>
            <input
              id="checkins-name-search"
              type="text"
              placeholder="e.g. Jane Doe"
              class="rounded-xl border border-border bg-bg px-3 py-2 text-ink focus:border-accent focus:outline-none"
            />
          </label>
          <label class="flex flex-1 flex-col gap-1.5">
            <span class="text-xs font-semibold uppercase tracking-wider text-muted">Filter by class</span>
            <select id="checkins-class-filter" class="rounded-xl border border-border bg-bg px-3 py-2 text-ink focus:border-accent focus:outline-none">
              <option value="">All classes</option>
            </select>
          </label>
          <label id="checkins-occurrence-filter-wrap" class="hidden flex-1 flex-col gap-1.5">
            <span class="text-xs font-semibold uppercase tracking-wider text-muted">Occurrence</span>
            <select id="checkins-occurrence-filter" class="rounded-xl border border-border bg-bg px-3 py-2 text-ink focus:border-accent focus:outline-none">
              <option value="">All dates</option>
            </select>
          </label>
          <button
            id="checkins-clear-filters"
            class="rounded-full border border-border px-4 py-2 text-xs font-bold uppercase tracking-wider text-ink/70 transition-colors hover:bg-bg"
          >
            Clear
          </button>
        </div>

        <div class="flex flex-wrap items-center gap-3 rounded-2xl border border-border bg-surface p-4">
          <button
            id="checkins-lock-btn"
            class="rounded-full border border-accent px-4 py-2 text-xs font-bold uppercase tracking-wider text-accent transition-colors hover:bg-accent hover:text-white"
          >
            Try Lock to Edit
          </button>
          <p id="checkins-lock-status" class="text-xs text-muted"></p>
        </div>

        <div>
          <div class="flex items-baseline justify-between">
            <h2 class="font-display text-xl font-bold text-ink">Check-Ins</h2>
            <p id="checkins-count" class="text-xs text-muted"></p>
          </div>
          <div class="mt-2 flex flex-wrap items-center gap-2">
            <button
              id="add-checkin-btn"
              class="add-checkin-row-btn hidden rounded-full border border-accent px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-accent transition-colors hover:bg-accent hover:text-white"
            >
              + Add Check-In
            </button>
            <button
              id="show-deleted-checkins-btn"
              class="rounded-full border border-border px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-ink/70 transition-colors hover:bg-surface"
            >
              Recently Deleted
            </button>
          </div>

          <div id="deleted-checkins-panel" class="mt-3 hidden flex-col gap-3 rounded-2xl border border-border bg-surface p-4">
            <div class="flex items-baseline justify-between">
              <p class="text-xs font-semibold uppercase tracking-wider text-muted">Deleted in the last 7 days</p>
              <p id="deleted-checkins-count" class="text-xs text-muted"></p>
            </div>
            <div class="overflow-x-auto rounded-xl border border-border">
              <table class="w-full min-w-[560px] text-left text-sm">
                <thead class="bg-bg text-xs font-semibold uppercase tracking-wider text-muted">
                  <tr>
                    <th class="px-4 py-2.5">Name</th>
                    <th class="px-4 py-2.5">Class</th>
                    <th class="px-4 py-2.5">Deleted</th>
                    <th class="px-4 py-2.5">By</th>
                    <th class="px-4 py-2.5">Restore</th>
                  </tr>
                </thead>
                <tbody id="deleted-checkins-body"></tbody>
              </table>
              <p id="deleted-checkins-empty" class="hidden px-4 py-6 text-center text-sm text-muted">Nothing deleted in the last 7 days.</p>
            </div>
          </div>

          <div class="mt-3 overflow-x-auto rounded-2xl border border-border">
            <table class="w-full min-w-[560px] text-left text-sm">
              <thead class="bg-surface text-xs font-semibold uppercase tracking-wider text-muted">
                <tr>
                  <th class="sort-header cursor-pointer select-none px-4 py-3" data-table="checkins" data-column="firstName">First Name</th>
                  <th class="sort-header cursor-pointer select-none px-4 py-3" data-table="checkins" data-column="lastName">Last Name</th>
                  <th class="sort-header cursor-pointer select-none px-4 py-3" data-table="checkins" data-column="phone">Phone</th>
                  <th class="sort-header cursor-pointer select-none px-4 py-3" data-table="checkins" data-column="classTitle">Class</th>
                  <th class="sort-header cursor-pointer select-none px-4 py-3" data-table="checkins" data-column="classDate">Class Date</th>
                  <th class="sort-header cursor-pointer select-none px-4 py-3" data-table="checkins" data-column="createdAt">Checked In At</th>
                  <th class="checkins-actions-header hidden px-4 py-3">Actions</th>
                </tr>
              </thead>
              <tbody id="checkins-body"></tbody>
            </table>
            <p id="checkins-empty" class="hidden px-4 py-6 text-center text-sm text-muted">No check-ins match these filters.</p>
          </div>
        </div>
      </section>

      <!-- ==================== ATTENDANCE TAB ==================== -->
      <section id="tab-panel-attendance" class="tab-panel hidden flex-col gap-6">
        <div class="flex flex-col gap-4 rounded-2xl border border-border bg-surface p-4 sm:flex-row sm:items-end">
          <label class="flex flex-1 flex-col gap-1.5">
            <span class="text-xs font-semibold uppercase tracking-wider text-muted">Search by dancer name</span>
            <input
              id="attendance-name-search"
              type="text"
              placeholder="e.g. Jane Doe"
              class="rounded-xl border border-border bg-bg px-3 py-2 text-ink focus:border-accent focus:outline-none"
            />
          </label>
          <label class="flex flex-1 flex-col gap-1.5">
            <span class="text-xs font-semibold uppercase tracking-wider text-muted">Filter by class</span>
            <select id="attendance-class-filter" class="rounded-xl border border-border bg-bg px-3 py-2 text-ink focus:border-accent focus:outline-none">
              <option value="">All classes</option>
            </select>
          </label>
          <label id="attendance-occurrence-filter-wrap" class="hidden flex-1 flex-col gap-1.5">
            <span class="text-xs font-semibold uppercase tracking-wider text-muted">Occurrence</span>
            <select id="attendance-occurrence-filter" class="rounded-xl border border-border bg-bg px-3 py-2 text-ink focus:border-accent focus:outline-none">
              <option value="">All dates</option>
            </select>
          </label>
          <button
            id="attendance-clear-filters"
            class="rounded-full border border-border px-4 py-2 text-xs font-bold uppercase tracking-wider text-ink/70 transition-colors hover:bg-bg"
          >
            Clear
          </button>
        </div>

        <div class="flex flex-wrap items-center gap-3 rounded-2xl border border-border bg-surface p-4">
          <button
            id="attendance-lock-btn"
            class="rounded-full border border-accent px-4 py-2 text-xs font-bold uppercase tracking-wider text-accent transition-colors hover:bg-accent hover:text-white"
          >
            Try Lock to Edit
          </button>
          <p id="attendance-lock-status" class="text-xs text-muted"></p>
        </div>

        <div>
          <h2 class="font-display text-xl font-bold text-ink">Workqueue</h2>
          <p class="mt-1 text-xs text-muted">Sign-ups for classes that already happened with no matching check-in, and check-ins that don't match a sign-up.</p>

          <div class="mt-3 grid gap-6 lg:grid-cols-2">
            <div>
              <div class="flex items-baseline justify-between">
                <h3 class="text-sm font-bold text-ink">Orphaned Sign-Ups</h3>
                <p id="orphaned-signups-count" class="text-xs text-muted"></p>
              </div>
              <div class="mt-2 overflow-x-auto rounded-2xl border border-border">
                <table class="w-full min-w-[680px] text-left text-sm">
                  <thead class="bg-surface text-xs font-semibold uppercase tracking-wider text-muted">
                    <tr>
                      <th class="sort-header cursor-pointer select-none px-3 py-2.5" data-table="attendance-orphaned-signups" data-column="lastName">Dancer</th>
                      <th class="sort-header cursor-pointer select-none px-3 py-2.5" data-table="attendance-orphaned-signups" data-column="phone">Phone</th>
                      <th class="sort-header cursor-pointer select-none px-3 py-2.5" data-table="attendance-orphaned-signups" data-column="email">Email</th>
                      <th class="sort-header cursor-pointer select-none px-3 py-2.5" data-table="attendance-orphaned-signups" data-column="classTitle">Class</th>
                      <th class="sort-header cursor-pointer select-none px-3 py-2.5" data-table="attendance-orphaned-signups" data-column="occurrenceDate">Date</th>
                      <th class="orphaned-signups-actions-header hidden px-3 py-2.5">Resolve</th>
                    </tr>
                  </thead>
                  <tbody id="orphaned-signups-body"></tbody>
                </table>
                <p id="orphaned-signups-empty" class="hidden px-4 py-6 text-center text-sm text-muted">None — nice!</p>
              </div>
            </div>

            <div>
              <div class="flex items-baseline justify-between">
                <h3 class="text-sm font-bold text-ink">Orphaned Check-Ins</h3>
                <p id="orphaned-checkins-count" class="text-xs text-muted"></p>
              </div>
              <div class="mt-2 overflow-x-auto rounded-2xl border border-border">
                <table class="w-full min-w-[560px] text-left text-sm">
                  <thead class="bg-surface text-xs font-semibold uppercase tracking-wider text-muted">
                    <tr>
                      <th class="sort-header cursor-pointer select-none px-3 py-2.5" data-table="attendance-orphaned-checkins" data-column="last_name">Dancer</th>
                      <th class="sort-header cursor-pointer select-none px-3 py-2.5" data-table="attendance-orphaned-checkins" data-column="phone">Phone</th>
                      <th class="sort-header cursor-pointer select-none px-3 py-2.5" data-table="attendance-orphaned-checkins" data-column="email">Email</th>
                      <th class="sort-header cursor-pointer select-none px-3 py-2.5" data-table="attendance-orphaned-checkins" data-column="class_title">Class</th>
                      <th class="sort-header cursor-pointer select-none px-3 py-2.5" data-table="attendance-orphaned-checkins" data-column="created_at">Checked In</th>
                      <th class="orphaned-signups-actions-header hidden px-3 py-2.5">Link to Class</th>
                    </tr>
                  </thead>
                  <tbody id="orphaned-checkins-body"></tbody>
                </table>
                <p id="orphaned-checkins-empty" class="hidden px-4 py-6 text-center text-sm text-muted">None — nice!</p>
              </div>
            </div>
          </div>
        </div>

        <div>
          <div class="flex items-baseline justify-between">
            <h2 class="font-display text-xl font-bold text-ink">Matches</h2>
            <p id="attendance-matches-count" class="text-xs text-muted"></p>
          </div>
          <div class="mt-2 overflow-x-auto rounded-2xl border border-border">
            <table class="w-full min-w-[880px] text-left text-sm">
              <thead class="bg-surface text-xs font-semibold uppercase tracking-wider text-muted">
                <tr>
                  <th class="sort-header cursor-pointer select-none px-4 py-3" data-table="attendance-matches" data-column="lastName">Dancer</th>
                  <th class="sort-header cursor-pointer select-none px-4 py-3" data-table="attendance-matches" data-column="phone">Phone</th>
                  <th class="sort-header cursor-pointer select-none px-4 py-3" data-table="attendance-matches" data-column="email">Email</th>
                  <th class="sort-header cursor-pointer select-none px-4 py-3" data-table="attendance-matches" data-column="classTitle">Class</th>
                  <th class="sort-header cursor-pointer select-none px-4 py-3" data-table="attendance-matches" data-column="occurrenceDate">Date</th>
                  <th class="sort-header cursor-pointer select-none px-4 py-3" data-table="attendance-matches" data-column="status">Status</th>
                </tr>
              </thead>
              <tbody id="attendance-matches-body"></tbody>
            </table>
            <p id="attendance-matches-empty" class="hidden px-4 py-6 text-center text-sm text-muted">No attendance data yet.</p>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { supabaseBrowser } from '../../lib/supabaseBrowser';

  // The index signatures below exist only so sortRows()'s generic
  // `T extends Record<string, unknown>` constraint is satisfied — they don't
  // change runtime behavior, just let TS verify the sort logic is type-safe.
  interface ClassRegistrationEntry {
    id: string | null;
    classTitle: string;
    classLabel: string;
    seriesMode: 'whole' | 'dropin' | null;
    price: number | null;
    occurrenceEventId: string | null;
    occurrenceLabel: string | null;
  }

  interface Signup {
    submissionId: string;
    createdAt: string;
    firstName: string;
    lastName: string;
    email: string;
    phone: string;
    registrationType: string;
    // Derived in reloadData() from classRegistrations, for the existing
    // name-search/class-filter/sort logic that expects a flat string.
    class: string;
    classRegistrations: ClassRegistrationEntry[];
    paymentMethod: string | null;
    paid: boolean;
    dancerIndex: number | null;
    dancerCount: number;
    [key: string]: unknown;
  }

  interface Checkin {
    id: string;
    createdAt: string;
    firstName: string;
    lastName: string;
    phone: string;
    classTitle: string;
    eventId: string | null;
    classDate: string | null;
    [key: string]: unknown;
  }

  interface AttendanceEntry {
    classRegistrationId: string;
    occurrenceEventId: string | null;
    occurrenceDate: string | null;
    firstName: string;
    lastName: string;
    phone: string | null;
    email: string | null;
    classTitle: string;
    seriesMode: 'whole' | 'dropin' | null;
    price: number | null;
    expansionFailed: boolean;
    status: 'matched' | 'no_show' | 'orphaned' | 'upcoming';
    matchedCheckin: { id: string; first_name: string; last_name: string; phone: string; class_title: string; created_at: string } | null;
    [key: string]: unknown;
  }

  interface OrphanedCheckin {
    id: string;
    first_name: string;
    last_name: string;
    phone: string;
    email: string | null;
    class_title: string;
    event_id: string | null;
    created_at: string;
    [key: string]: unknown;
  }

  interface ClassSeriesOccurrence {
    id: string;
    label: string;
    startTime: string;
  }

  interface ClassSeriesEntry {
    key: string;
    title: string;
    isSeries: boolean;
    subLabel: string;
    singleEventId: string | null;
    occurrences: ClassSeriesOccurrence[];
    priceWholeSeries: number | null;
    priceDropIn: number | null;
  }

  const panels = {
    loading: document.getElementById('loading')!,
    signedOut: document.getElementById('signed-out')!,
    notAdmin: document.getElementById('not-admin')!,
    dashboard: document.getElementById('dashboard')!,
  };

  function showPanel(name: keyof typeof panels) {
    for (const [key, el] of Object.entries(panels)) {
      const isTarget = key === name;
      el.classList.toggle('hidden', !isTarget);
      el.classList.toggle('flex', isTarget && key !== 'loading' && key !== 'dashboard');
    }
    panels.dashboard.classList.toggle('hidden', name !== 'dashboard');
    panels.dashboard.classList.toggle('flex', name === 'dashboard');
  }

  // --- Tabs ---
  const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab-btn'));
  const tabPanels: Record<string, HTMLElement> = {
    signups: document.getElementById('tab-panel-signups')!,
    checkins: document.getElementById('tab-panel-checkins')!,
    attendance: document.getElementById('tab-panel-attendance')!,
  };

  // Populated once the lock controllers exist (below); referenced here only
  // at call time, after that assignment has already run.
  let lockControllersByTab: Record<string, { pauseHeartbeat: () => Promise<void>; resumeHeartbeat: () => Promise<void> }> = {};
  let activeTab = 'signups';

  function setActiveTab(tab: string) {
    if (!tabPanels[tab]) tab = 'signups';
    if (tab !== activeTab) {
      lockControllersByTab[activeTab]?.pauseHeartbeat();
      lockControllersByTab[tab]?.resumeHeartbeat();
      activeTab = tab;
    }
    for (const [key, panel] of Object.entries(tabPanels)) {
      const active = key === tab;
      panel.classList.toggle('hidden', !active);
      panel.classList.toggle('flex', active);
    }
    tabButtons.forEach((btn) => {
      const active = btn.dataset.tab === tab;
      btn.classList.toggle('border-accent', active);
      btn.classList.toggle('text-ink', active);
      btn.classList.toggle('text-ink/60', !active);
    });
    const url = new URL(location.href);
