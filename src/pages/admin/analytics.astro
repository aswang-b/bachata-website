          : '';
        return `
          <div class="flex flex-col gap-0.5">
            <label class="flex items-start gap-1.5 text-xs text-ink">
              <input type="checkbox" class="signup-class-checkbox mt-0.5 h-3.5 w-3.5" data-key="${escapeAttr(series.key)}" data-title="${escapeAttr(series.title)}" data-base="${escapeAttr(optionBase)}" data-is-series="${String(series.isSeries)}" />
              <span>${escapeHtml(series.title)} <span class="text-muted">(${escapeHtml(series.subLabel)})</span></span>
            </label>
            ${modeControlsHtml}
            ${occurrenceSelectHtml}
          </div>`;
      })
      .join('');

    return `
      <div class="flex max-h-32 w-44 flex-col gap-1.5 overflow-y-auto rounded-lg border border-border bg-bg p-2">
        ${classSeries.length ? optionsHtml : '<span class="text-xs text-muted">No classes found.</span>'}
      </div>
      <p class="mt-1 w-44 truncate text-[10px] text-muted" title="${escapeAttr(currentClassRaw)}">Current: ${escapeHtml(currentClassRaw || '—')}</p>`;
  }

  // Lets an admin set or fix the date of a dancer's existing Drop-In
  // registrations without re-picking classes. Ignored (and disabled) if new
  // classes are picked above, since picking classes replaces the old ones.
  function existingDropInDatesHtml(entries: ClassRegistrationEntry[] | undefined): string {
    const dropIns = (entries ?? []).filter((e) => e.id && e.seriesMode === 'dropin');
    if (dropIns.length === 0) return '';

    const blocks = dropIns
      .map((e) => {
        const series = findSeriesForEventId(e.occurrenceEventId)?.series ?? classSeries.find((c) => c.title === e.classTitle);
        if (!series) return `<div class="text-[10px] text-muted">${escapeHtml(e.classTitle)}: no matching class found</div>`;
        const options = series.occurrences
          .map((o) => `<option value="${escapeAttr(o.id)}" ${o.id === e.occurrenceEventId ? 'selected' : ''}>${escapeHtml(o.label)}</option>`)
          .join('');
        return `
          <label class="flex flex-col gap-0.5 text-[10px] text-muted">
            ${escapeHtml(e.classTitle)} drop-in date
            <select class="existing-dropin-occurrence w-44 rounded-lg border border-border bg-bg px-1.5 py-1 text-xs text-ink" data-registration-id="${escapeAttr(e.id ?? '')}" data-original="${escapeAttr(e.occurrenceEventId ?? '')}">
              <option value="" ${e.occurrenceEventId ? '' : 'selected'}>Date not recorded</option>
              ${options}
            </select>
          </label>`;
      })
      .join('');

    return `<div class="existing-dropin-dates mt-2 flex w-44 flex-col gap-1.5 border-t border-border pt-2">${blocks}</div>`;
  }

  // Shows a class's date select only while Drop-in is the chosen mode, and
  // dims the existing-registration date controls once new classes are picked.
  function syncSignupPicker(row: Element) {
    row.querySelectorAll('.signup-class-checkbox').forEach((checkbox) => {
      const container = checkbox.closest('.flex.flex-col');
      const checked = (checkbox as HTMLInputElement).checked;
      const dropIn = container?.querySelector<HTMLInputElement>('.signup-class-mode[value="dropin"]')?.checked ?? false;
      container?.querySelector('.signup-class-occurrence')?.classList.toggle('hidden', !(checked && dropIn));
    });
    const anyPicked = row.querySelector('.signup-class-checkbox:checked') !== null;
    row.querySelector('.existing-dropin-dates')?.classList.toggle('opacity-40', anyPicked);
    row.querySelectorAll<HTMLSelectElement>('.existing-dropin-occurrence').forEach((select) => (select.disabled = anyPicked));
  }

  // The dancer's Leader/Follower role (counted toward a class's role caps).
  function roleSelectHtml(role: string): string {
    const opts = [
      ['leader', 'Leader'],
      ['follower', 'Follower'],
    ];
    // Shown in the Series column, which an edit row doesn't otherwise use.
    return `<label class="flex flex-col gap-0.5 text-[10px] font-bold uppercase tracking-wide text-muted">Role<select class="edit-input role w-24 rounded-lg border border-border bg-bg px-2 py-1 text-xs font-normal normal-case tracking-normal text-ink">${role ? '' : '<option value="" selected>No role</option>'}${opts
      .map(([value, label]) => `<option value="${value}" ${role === value ? 'selected' : ''}>${label}</option>`)
      .join('')}</select></label>`;
  }

  function signupEditRowHtml(s: Partial<Signup>, mode: 'edit' | 'add'): string {
    const submissionId = s.submissionId ?? '';
    const dancerIndex = s.dancerIndex ?? '';
    const originalClass = s.class ?? '';
    return `
      <tr class="border-t border-accent bg-accent/5" data-signup-edit-row="1" data-original-class="${escapeAttr(originalClass)}">
        <td class="px-2 py-2"><input class="edit-input first-name w-24 rounded-lg border border-border bg-bg px-2 py-1 text-xs" value="${escapeAttr(s.firstName ?? '')}" placeholder="First name" /></td>
        <td class="px-2 py-2"><input class="edit-input last-name w-24 rounded-lg border border-border bg-bg px-2 py-1 text-xs" value="${escapeAttr(s.lastName ?? '')}" placeholder="Last name" /></td>
        <td class="px-2 py-2"><div class="flex flex-col gap-1"><input class="edit-input email w-32 rounded-lg border border-border bg-bg px-2 py-1 text-xs" value="${escapeAttr(s.email ?? '')}" placeholder="Email" /><input class="edit-input phone w-32 rounded-lg border border-border bg-bg px-2 py-1 text-xs" value="${escapeAttr(s.phone ?? '')}" placeholder="Phone" /></div></td>
        <td class="px-2 py-2 signup-class-cell">${signupClassPickerHtml(originalClass)}${existingDropInDatesHtml(s.classRegistrations)}</td>
        <td class="px-2 py-2">${s.dancerIndex != null ? roleSelectHtml(s.role ?? '') : '<span class="text-xs text-muted">—</span>'}</td>
        <td class="px-2 py-2 payment-select-cell">${paymentSelectHtml(s.paymentMethod ?? null)}</td>
        <td class="px-2 py-2"><input type="checkbox" class="edit-input paid h-4 w-4" ${s.paid ? 'checked' : ''} /></td>
        <td class="px-2 py-2 text-xs text-muted">—</td>
        <td class="px-2 py-2">
          <div class="flex gap-2">
            <button class="save-signup-btn text-xs font-bold text-green-600 hover:underline" data-mode="${mode}" data-submission-id="${submissionId}" data-dancer-index="${dancerIndex}">Save</button>
            <button class="cancel-signup-edit-btn text-xs font-semibold text-ink/60 hover:underline">Cancel</button>
          </div>
        </td>
      </tr>`;
  }

  function checkinEditRowHtml(c: Partial<Checkin>, mode: 'edit' | 'add'): string {
    // A check-in with no linked occurrence still remembers its class title —
    // preselect that class so the admin only has to pick the date.
    const match = findSeriesForEventId(c.eventId ?? null);
    const titleSeries = match ? null : classSeries.find((s) => s.title === c.classTitle) ?? null;
    const selectedKey = match?.series.key ?? titleSeries?.key ?? '';
    const selectedOccurrenceId = match?.occurrenceId ?? '';
    const selectedSeries = match?.series ?? titleSeries;
    const selectedIsSeries = selectedSeries?.isSeries ?? false;

    const seriesOptionsHtml = classSeries
      .map((series) => `<option value="${escapeAttr(series.key)}" ${series.key === selectedKey ? 'selected' : ''}>${escapeHtml(series.title)} — ${escapeHtml(series.subLabel)}</option>`)
      .join('');

    const occurrenceOptionsHtml = selectedIsSeries
      ? selectedSeries!.occurrences
          .map((occ) => `<option value="${escapeAttr(occ.id)}" ${occ.id === selectedOccurrenceId ? 'selected' : ''}>${escapeHtml(occ.label)}</option>`)
          .join('')
      : '';

    return `
      <tr class="border-t border-accent bg-accent/5" data-checkin-edit-row="1">
        <td class="px-2 py-2"><input class="edit-input first-name w-24 rounded-lg border border-border bg-bg px-2 py-1 text-xs" value="${escapeAttr(c.firstName ?? '')}" placeholder="First name" /></td>
        <td class="px-2 py-2"><input class="edit-input last-name w-24 rounded-lg border border-border bg-bg px-2 py-1 text-xs" value="${escapeAttr(c.lastName ?? '')}" placeholder="Last name" /></td>
        <td class="px-2 py-2"><input class="edit-input phone w-32 rounded-lg border border-border bg-bg px-2 py-1 text-xs" value="${escapeAttr(c.phone ?? '')}" placeholder="Phone" /></td>
        <td class="px-2 py-2">
          <select class="edit-input checkin-class-select w-36 rounded-lg border border-border bg-bg px-2 py-1 text-xs">
            <option value="">Select class…</option>
            ${seriesOptionsHtml}
          </select>
        </td>
        <td class="px-2 py-2">
          <select class="edit-input checkin-date-select w-36 rounded-lg border border-border bg-bg px-2 py-1 text-xs" ${selectedIsSeries ? '' : 'disabled'}>
            <option value="">${selectedIsSeries ? 'Select date…' : '—'}</option>
            ${occurrenceOptionsHtml}
          </select>
        </td>
        <td class="px-2 py-2 text-xs text-muted">—</td>
        <td class="px-2 py-2">
          <div class="flex gap-2">
            <button class="save-checkin-btn text-xs font-bold text-green-600 hover:underline" data-mode="${mode}" data-id="${c.id ?? ''}">Save</button>
            <button class="cancel-checkin-edit-btn text-xs font-semibold text-ink/60 hover:underline">Cancel</button>
          </div>
        </td>
      </tr>`;
  }

  async function withAuthHeader(): Promise<Record<string, string> | null> {
    const {
      data: { session },
    } = await supabaseBrowser.auth.getSession();
    if (!session) return null;
    return { 'Content-Type': 'application/json', Authorization: `Bearer ${session.access_token}` };
  }

  // --- Sign-Ups tab ---
  function renderSignups() {
    const nameQuery = signupsNameSearch.value.trim();
    const isLockedByMe = signupsLock.isLocked();

    // A Whole-Series sign-up covers every date of its class; a Drop-In only
    // the date it was for (one with no recorded date can't be placed).
    const attendsOccurrence = (s: Signup, classTitle: string, occurrenceId: string) =>
      s.classRegistrations.some(
        (e) => e.classTitle === classTitle && (e.seriesMode === 'whole' || e.occurrenceEventId === occurrenceId)
      );

    const filteredSignups = allSignups.filter(
      (s) =>
        matchesName(s.firstName, s.lastName, nameQuery) &&
        signupsClassFilters.matches(
          (f) => matchesClass(s.class, f.classTitle) && (!f.occurrenceId || attendsOccurrence(s, f.classTitle, f.occurrenceId))
        )
    );
    const sortedSignups = sortRows(filteredSignups, signupSort);

    const addSignupRowHtml = addingSignup ? signupEditRowHtml({}, 'add') : '';

    signupsBody.innerHTML =
      addSignupRowHtml +
      sortedSignups
        .flatMap((s) => {
          const key = signupRowKey(s);
          if (editingSignupKey === key) return [signupEditRowHtml(s, 'edit')];

          const paymentLabel = s.paymentMethod === 'venmo' ? 'Venmo' : s.paymentMethod === 'cash' ? 'Cash' : '—';
          const roleLabel = s.role === 'leader' ? 'Leader' : s.role === 'follower' ? 'Follower' : '';
          const classEntries = s.classRegistrations;

          // One row per class the dancer is registered for, so multiple
          // classes (or dancers) never get crammed into a single cell.
          // Continuation rows for the same dancer repeat only the Class /
          // Series columns and butt up against the row above them. Each
          // row carries its own real price (snapshotted at registration
          // time in class_registrations), so unlike the old text-parsing
          // approach the price is never blank past the first class.
          return classEntries.map((entry, entryIndex) => {
            const isFirst = entryIndex === 0;
            const modeLabel = entry.seriesMode === 'whole' ? 'Whole Series' : entry.seriesMode === 'dropin' ? 'Drop In' : '—';
            const paymentSubtotalLabel =
              paymentLabel === '—' && entry.price == null ? '—' : `${paymentLabel}${entry.price != null ? ` — ${formatPrice(entry.price)}` : ''}`;
            return `
          <tr class="${isFirst ? 'border-t border-border' : 'border-t-0'}">
            <td class="px-4 py-2.5 text-ink">${isFirst ? escapeHtml(s.firstName) : ''}</td>
            <td class="px-4 py-2.5 text-ink">${isFirst ? escapeHtml(s.lastName) : ''}</td>
            <td class="px-4 py-2.5 text-ink/70">${isFirst ? contactCell(s.email, s.phone) : ''}</td>
            <td class="px-4 py-2.5 text-ink/70">${escapeHtml(entry.classLabel ? `${entry.classLabel}${roleLabel ? ` - ${roleLabel}` : ''}` : '—')}</td>
            <td class="px-4 py-2.5 text-ink/70">${modeLabel}${
              entry.seriesMode === 'dropin'
                ? `<div class="mt-0.5 text-xs ${entry.occurrenceLabel ? 'text-ink' : 'text-muted'}">${escapeHtml(entry.occurrenceLabel ?? 'Date not recorded')}</div>`
                : ''
            }</td>
            <td class="px-4 py-2.5 text-ink/70">${paymentSubtotalLabel}</td>
            <td class="px-4 py-2.5">${isFirst ? `<input type="checkbox" class="paid-checkbox h-4 w-4" data-submission-id="${s.submissionId}" ${s.paid ? 'checked' : ''} ${isLockedByMe ? '' : 'disabled title="Click Try Lock to Edit to change payment status"'} />` : ''}</td>
            <td class="px-4 py-2.5 text-ink/70">${isFirst ? dateFormatter.format(new Date(s.createdAt)) : ''}</td>
            ${
              isLockedByMe
                ? isFirst
                  ? `<td class="px-4 py-2.5"><div class="flex gap-3">
                      <button class="edit-signup-btn text-ink/60 transition-colors hover:text-accent" aria-label="Edit" data-key="${key}">${EDIT_ICON_SVG}</button>
                      <button class="resend-confirmation-btn text-ink/60 transition-colors hover:text-accent" aria-label="Resend confirmation email" title="Resend the confirmation email to everyone on this sign-up" data-submission-id="${s.submissionId}">${MAIL_ICON_SVG}</button>
                      <button class="delete-signup-btn text-ink/60 transition-colors hover:text-red-600" aria-label="Delete" data-submission-id="${s.submissionId}" data-dancer-index="${s.dancerIndex ?? ''}" data-dancer-count="${s.dancerCount}">${TRASH_ICON_SVG}</button>
                    </div></td>`
                  : '<td class="px-4 py-2.5"></td>'
                : ''
            }
          </tr>`;
          });
        })
        .join('');

    document.querySelectorAll<HTMLInputElement>('.paid-checkbox').forEach((checkbox) => {
      checkbox.addEventListener('change', async () => {
        const submissionId = checkbox.dataset.submissionId!;
        const paid = checkbox.checked;
        checkbox.disabled = true;

        const headers = await withAuthHeader();
        if (!headers) {
          checkbox.disabled = false;
          return;
        }

        const res = await fetch('/api/admin/update-signup', {
          method: 'POST',
          headers,
          body: JSON.stringify({ submissionId, paid, holderId }),
        });

        if (res.ok) {
          allSignups.forEach((s) => {
            if (s.submissionId === submissionId) s.paid = paid;
          });
        } else {
          checkbox.checked = !paid;
        }
        checkbox.disabled = false;
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.edit-signup-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        editingSignupKey = btn.dataset.key!;
        addingSignup = false;
        renderSignups();
      });
    });

    document.querySelectorAll<HTMLInputElement>('.signup-class-checkbox').forEach((checkbox) => {
      checkbox.addEventListener('change', () => {
        const modeControls = checkbox.closest('.flex.flex-col')?.querySelector('.class-mode-controls');
        if (modeControls) {
          modeControls.classList.toggle('hidden', !checkbox.checked);
          modeControls.classList.toggle('flex', checkbox.checked);
        }
        const row = checkbox.closest('tr');
        if (row) syncSignupPicker(row);
      });
    });

    document.querySelectorAll<HTMLInputElement>('.signup-class-mode').forEach((radio) => {
      radio.addEventListener('change', () => {
        const row = radio.closest('tr');
        if (row) syncSignupPicker(row);
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.cancel-signup-edit-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        editingSignupKey = null;
        addingSignup = false;
        renderSignups();
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.delete-signup-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const dancerCount = Number(btn.dataset.dancerCount ?? '0');
        const confirmMsg =
          dancerCount > 1 ? 'Move this dancer to the Recycling Bin?' : 'Move this entire sign-up to the Recycling Bin?';
        if (!confirm(confirmMsg)) return;

        const headers = await withAuthHeader();
        if (!headers) return;

        const dancerIndexRaw = btn.dataset.dancerIndex;
        const res = await fetch('/api/admin/edit-signup', {
          method: 'POST',
          headers,
          body: JSON.stringify({
            action: 'delete',
            holderId,
            submissionId: btn.dataset.submissionId,
            dancerIndex: dancerIndexRaw ? Number(dancerIndexRaw) : null,
          }),
        });

        if (res.ok) {
          await reloadAfterDeletionChange();
        } else {
          const data = await res.json().catch(() => ({}));
          alert(data.error ?? 'Failed to delete.');
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.save-signup-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const row = btn.closest('tr')!;
        const get = (cls: string) => (row.querySelector(`.${cls}`) as HTMLInputElement)?.value.trim() ?? '';
        const paymentMethod = (row.querySelector('.payment-select-cell select') as HTMLSelectElement)?.value ?? '';
        const paid = (row.querySelector('.paid') as HTMLInputElement)?.checked ?? false;

        const firstName = get('first-name');
        const lastName = get('last-name');
        if (!firstName || !lastName) {
          alert('First and last name are required.');
          return;
        }

        const headers = await withAuthHeader();
        if (!headers) return;

        // Class is a checkbox picker, not free text. If nothing is checked the
        // admin didn't intend to change the classes, so the existing
        // registrations are kept as they are (only Drop-In date changes, if
        // any, are applied). Picked classes replace them, and a Drop-In must
        // say which class date it is for.
        const selections: { key: string; title: string; label: string; mode: 'whole' | 'dropin' | null; occurrenceEventId: string | null }[] = [];
        for (const checkbox of Array.from(row.querySelectorAll<HTMLInputElement>('.signup-class-checkbox:checked'))) {
          const container = checkbox.closest('.flex.flex-col');
          const title = checkbox.dataset.title ?? '';
          const classMode: 'whole' | 'dropin' | null =
            checkbox.dataset.isSeries !== 'true'
              ? null
              : container?.querySelector<HTMLInputElement>('.signup-class-mode:checked')?.value === 'dropin'
                ? 'dropin'
                : 'whole';
          const occurrenceEventId = classMode === 'dropin' ? container?.querySelector<HTMLSelectElement>('.signup-class-occurrence')?.value || null : null;
          if (classMode === 'dropin' && !occurrenceEventId) {
            alert(`Pick which class date the drop-in for "${title}" is for.`);
            return;
          }
          selections.push({ key: checkbox.dataset.key ?? '', title, label: checkbox.dataset.base ?? '', mode: classMode, occurrenceEventId });
        }
        // The legacy "<label> — <Whole Series|Drop In>; …" text stored on the sign-up.
        const className = selections
          .map((s) => (s.mode ? `${s.label} — ${s.mode === 'dropin' ? 'Drop In' : 'Whole Series'}` : s.label))
          .join('; ');

        const mode = btn.dataset.mode;
        const payload: Record<string, unknown> = {
          action: mode === 'add' ? 'create' : 'update',
          holderId,
          firstName,
          lastName,
          email: get('email'),
          phone: get('phone'),
          role: get('role'),
          className,
          paymentMethod,
          paid,
        };
        if (selections.length > 0) {
          payload.classSelections = selections;
        } else if (mode === 'edit') {
          payload.keepClasses = true;
          payload.occurrenceUpdates = Array.from(row.querySelectorAll<HTMLSelectElement>('.existing-dropin-occurrence'))
            .filter((select) => select.value !== (select.dataset.original ?? ''))
            .map((select) => ({ registrationId: select.dataset.registrationId, occurrenceEventId: select.value || null }));
        }
        if (mode === 'edit') {
          payload.submissionId = btn.dataset.submissionId;
          const dancerIndexRaw = btn.dataset.dancerIndex;
          payload.dancerIndex = dancerIndexRaw ? Number(dancerIndexRaw) : null;
        }

        const res = await fetch('/api/admin/edit-signup', { method: 'POST', headers, body: JSON.stringify(payload) });
        if (res.ok) {
          editingSignupKey = null;
          addingSignup = false;
          await reloadSignups();
        } else {
          const data = await res.json().catch(() => ({}));
          alert(data.error ?? 'Failed to save.');
        }
      });
    });

    signupsEmpty.classList.toggle('hidden', sortedSignups.length > 0);
    signupsCount.textContent = `${sortedSignups.length} ${sortedSignups.length === 1 ? 'result' : 'results'}`;
    updateSortHeaders('signups', signupSort);
  }

  signupsNameSearch.addEventListener('input', renderSignups);
  document.getElementById('signups-clear-filters')?.addEventListener('click', () => {
    signupsNameSearch.value = '';
    signupsClassFilters.reset();
    renderSignups();
  });

  // --- Event Registration tab ---
  // For seeing who registered for which event and reconciling payment. This
  // tab's own lock enables the Paid checkboxes and editing/deleting rows.
  const eventRegistrationsBody = document.getElementById('event-registrations-body')!;
  const eventRegistrationsEmpty = document.getElementById('event-registrations-empty')!;
  const eventRegistrationsCount = document.getElementById('event-registrations-count')!;
  const eventRegistrationsNameSearch = document.getElementById('event-registrations-name-search') as HTMLInputElement;
  const eventRegistrationsEventFilter = document.getElementById('event-registrations-event-filter') as HTMLSelectElement;

  // The filter lists the events that have registrations, keeping the current pick.
  function refreshEventFilterOptions() {
    const current = eventRegistrationsEventFilter.value;
    const titles = [...new Set(allEventRegistrations.flatMap((s) => s.classRegistrations.map((e) => e.classTitle)).filter(Boolean))].sort((a, b) =>
      a.localeCompare(b)
    );
    eventRegistrationsEventFilter.innerHTML =
      '<option value="">All events</option>' + titles.map((t) => `<option value="${escapeAttr(t)}">${escapeHtml(t)}</option>`).join('');
    eventRegistrationsEventFilter.value = titles.includes(current) ? current : '';
  }

  // Edit row for one dancer's event registration. The event checkboxes start
  // unchecked: checking any replaces the dancer's current events.
  function eventRegistrationEditRowHtml(s: Signup): string {
    const current = s.classRegistrations.map((e) => e.classTitle).filter(Boolean).join('; ');
    const optionsHtml = eventSeries
      .map(
        (series) => `
          <label class="flex items-start gap-1.5 text-xs text-ink">
            <input type="checkbox" class="event-registration-checkbox mt-0.5 h-3.5 w-3.5" data-key="${escapeAttr(series.key)}" data-title="${escapeAttr(series.title)}" data-base="${escapeAttr(`${series.title} — ${series.subLabel}`)}" />
            <span>${escapeHtml(series.title)} <span class="text-muted">(${escapeHtml(series.subLabel)})</span></span>
          </label>`
      )
      .join('');
    return `
      <tr class="border-t border-accent bg-accent/5">
        <td class="px-2 py-2"><input class="edit-input first-name w-24 rounded-lg border border-border bg-bg px-2 py-1 text-xs" value="${escapeAttr(s.firstName)}" placeholder="First name" /></td>
        <td class="px-2 py-2"><input class="edit-input last-name w-24 rounded-lg border border-border bg-bg px-2 py-1 text-xs" value="${escapeAttr(s.lastName)}" placeholder="Last name" /></td>
        <td class="px-2 py-2"><div class="flex flex-col gap-1"><input class="edit-input email w-32 rounded-lg border border-border bg-bg px-2 py-1 text-xs" value="${escapeAttr(s.email)}" placeholder="Email" /><input class="edit-input phone w-32 rounded-lg border border-border bg-bg px-2 py-1 text-xs" value="${escapeAttr(s.phone)}" placeholder="Phone" /></div></td>
        <td class="px-2 py-2">
          <div class="flex max-h-32 w-48 flex-col gap-1.5 overflow-y-auto rounded-lg border border-border bg-bg p-2">
            ${eventSeries.length ? optionsHtml : '<span class="text-xs text-muted">No events found.</span>'}
          </div>
          <p class="mt-1 w-48 truncate text-[10px] text-muted" title="${escapeAttr(current)}">Current: ${escapeHtml(current || '—')}</p>
        </td>
        <td class="px-2 py-2 payment-select-cell">${paymentSelectHtml(s.paymentMethod)}</td>
        <td class="px-2 py-2"><input type="checkbox" class="edit-input paid h-4 w-4" ${s.paid ? 'checked' : ''} /></td>
        <td class="px-2 py-2 text-xs text-muted">—</td>
        <td class="px-2 py-2">
          <div class="flex gap-2">
            <button class="save-event-registration-btn text-xs font-bold text-green-600 hover:underline" data-submission-id="${s.submissionId}" data-dancer-index="${s.dancerIndex ?? ''}">Save</button>
            <button class="cancel-event-registration-edit-btn text-xs font-semibold text-ink/60 hover:underline">Cancel</button>
          </div>
        </td>
      </tr>`;
  }

  function renderEventRegistrations() {
    const nameQuery = eventRegistrationsNameSearch.value.trim();
    const eventFilter = eventRegistrationsEventFilter.value;
    const isLockedByMe = eventRegistrationsLock.isLocked();

    const filtered = allEventRegistrations.filter(
      (s) => matchesName(s.firstName, s.lastName, nameQuery) && (!eventFilter || s.classRegistrations.some((e) => e.classTitle === eventFilter))
    );
    const sorted = sortRows(filtered, eventRegistrationSort);

    // One row per event the dancer registered for, like Sign-Ups; continuation
    // rows repeat only the Event and Payment columns.
    eventRegistrationsBody.innerHTML = sorted
      .flatMap((s) => {
        const key = signupRowKey(s);
        if (isLockedByMe && editingEventRegistrationKey === key) return [eventRegistrationEditRowHtml(s)];
        const paymentLabel = s.paymentMethod === 'venmo' ? 'Venmo' : s.paymentMethod === 'cash' ? 'Cash' : '—';
        // A registration with no saved event rows still gets one ("—") row.
        const entries: ClassRegistrationEntry[] =
          s.classRegistrations.length > 0
            ? s.classRegistrations
            : [{ id: null, classTitle: '', classLabel: '', seriesMode: null, price: null, occurrenceEventId: null, occurrenceLabel: null }];
        return entries.map((entry, entryIndex) => {
          const isFirst = entryIndex === 0;
          const paymentSubtotalLabel =
            paymentLabel === '—' && entry.price == null ? '—' : `${paymentLabel}${entry.price != null ? ` — ${formatPrice(entry.price)}` : ''}`;
          return `
          <tr class="${isFirst ? 'border-t border-border' : 'border-t-0'}">
            <td class="px-4 py-2.5 text-ink">${isFirst ? escapeHtml(s.firstName) : ''}</td>
            <td class="px-4 py-2.5 text-ink">${isFirst ? escapeHtml(s.lastName) : ''}</td>
            <td class="px-4 py-2.5 text-ink/70">${isFirst ? contactCell(s.email, s.phone) : ''}</td>
            <td class="px-4 py-2.5 text-ink/70">${escapeHtml(entry.classTitle || '—')}</td>
            <td class="px-4 py-2.5 text-ink/70">${paymentSubtotalLabel}</td>
            <td class="px-4 py-2.5">${isFirst ? `<input type="checkbox" class="event-paid-checkbox h-4 w-4" data-submission-id="${s.submissionId}" ${s.paid ? 'checked' : ''} ${isLockedByMe ? '' : 'disabled title="Click Try Lock to Edit to change payment status"'} />` : ''}</td>
            <td class="px-4 py-2.5 text-ink/70">${isFirst ? dateFormatter.format(new Date(s.createdAt)) : ''}</td>
            ${
              isLockedByMe
                ? isFirst
                  ? `<td class="px-4 py-2.5"><div class="flex gap-3">
                      <button class="edit-event-registration-btn text-ink/60 transition-colors hover:text-accent" aria-label="Edit" data-key="${key}">${EDIT_ICON_SVG}</button>
                      <button class="resend-confirmation-btn text-ink/60 transition-colors hover:text-accent" aria-label="Resend confirmation email" title="Resend the confirmation email to everyone on this sign-up" data-submission-id="${s.submissionId}">${MAIL_ICON_SVG}</button>
                      <button class="delete-event-registration-btn text-ink/60 transition-colors hover:text-red-600" aria-label="Delete" data-submission-id="${s.submissionId}" data-dancer-index="${s.dancerIndex ?? ''}" data-dancer-count="${s.dancerCount}">${TRASH_ICON_SVG}</button>
                    </div></td>`
                  : '<td class="px-4 py-2.5"></td>'
                : ''
            }
          </tr>`;
        });
      })
      .join('');

    eventRegistrationsBody.querySelectorAll<HTMLButtonElement>('.edit-event-registration-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        editingEventRegistrationKey = btn.dataset.key!;
        renderEventRegistrations();
      });
    });

    eventRegistrationsBody.querySelectorAll<HTMLButtonElement>('.cancel-event-registration-edit-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        editingEventRegistrationKey = null;
        renderEventRegistrations();
      });
    });

    eventRegistrationsBody.querySelectorAll<HTMLButtonElement>('.delete-event-registration-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const dancerCount = Number(btn.dataset.dancerCount ?? '0');
        if (!confirm(dancerCount > 1 ? 'Move this dancer to the Recycling Bin?' : 'Move this entire event registration to the Recycling Bin?')) return;

        const headers = await withAuthHeader();
        if (!headers) return;

        const dancerIndexRaw = btn.dataset.dancerIndex;
        const res = await fetch('/api/admin/edit-signup', {
          method: 'POST',
          headers,
          body: JSON.stringify({
            action: 'delete',
            holderId,
            submissionId: btn.dataset.submissionId,
            dancerIndex: dancerIndexRaw ? Number(dancerIndexRaw) : null,
          }),
        });

        if (res.ok) {
          await reloadAfterDeletionChange();
        } else {
          const data = await res.json().catch(() => ({}));
          alert(data.error ?? 'Failed to delete.');
        }
      });
    });

    eventRegistrationsBody.querySelectorAll<HTMLButtonElement>('.save-event-registration-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const row = btn.closest('tr')!;
        const get = (cls: string) => (row.querySelector(`.${cls}`) as HTMLInputElement)?.value.trim() ?? '';
        const firstName = get('first-name');
        const lastName = get('last-name');
        if (!firstName || !lastName) {
          alert('First and last name are required.');
          return;
        }

        const headers = await withAuthHeader();
        if (!headers) return;

        // Picking events replaces the dancer's current ones (re-priced at
        // today's ticket price); picking none keeps them as they are.
        const selections = Array.from(row.querySelectorAll<HTMLInputElement>('.event-registration-checkbox:checked')).map((checkbox) => ({
          key: checkbox.dataset.key ?? '',
          title: checkbox.dataset.title ?? '',
          label: checkbox.dataset.base ?? '',
          mode: null,
          occurrenceEventId: null,
        }));
        const dancerIndexRaw = btn.dataset.dancerIndex;
        const payload: Record<string, unknown> = {
          action: 'update',
          holderId,
          submissionId: btn.dataset.submissionId,
          dancerIndex: dancerIndexRaw ? Number(dancerIndexRaw) : null,
          firstName,
          lastName,
          email: get('email'),
          phone: get('phone'),
          className: selections.map((s) => s.label).join('; '),
          paymentMethod: (row.querySelector('.payment-select-cell select') as HTMLSelectElement)?.value ?? '',
          paid: (row.querySelector('.paid') as HTMLInputElement)?.checked ?? false,
        };
        if (selections.length > 0) payload.classSelections = selections;
        else payload.keepClasses = true;

        const res = await fetch('/api/admin/edit-signup', { method: 'POST', headers, body: JSON.stringify(payload) });
        if (res.ok) {
          editingEventRegistrationKey = null;
          if (await reloadData()) renderEventRegistrations();
        } else {
          const data = await res.json().catch(() => ({}));
          alert(data.error ?? 'Failed to save.');
        }
      });
    });

    eventRegistrationsBody.querySelectorAll<HTMLInputElement>('.event-paid-checkbox').forEach((checkbox) => {
      checkbox.addEventListener('change', async () => {
        const submissionId = checkbox.dataset.submissionId!;
        const paid = checkbox.checked;
        checkbox.disabled = true;

        const headers = await withAuthHeader();
        const res = headers
          ? await fetch('/api/admin/update-signup', { method: 'POST', headers, body: JSON.stringify({ submissionId, paid, holderId }) })
          : null;

        if (res?.ok) {
          // Every dancer on a group registration shares the submission's paid flag.
          allEventRegistrations.forEach((s) => {
            if (s.submissionId === submissionId) s.paid = paid;
          });
          renderEventRegistrations();
        } else {
          checkbox.checked = !paid;
          checkbox.disabled = false;
        }
      });
    });

    eventRegistrationsEmpty.classList.toggle('hidden', sorted.length > 0);
    eventRegistrationsCount.textContent = `${sorted.length} ${sorted.length === 1 ? 'result' : 'results'}`;
    updateSortHeaders('event-registrations', eventRegistrationSort);
  }

  eventRegistrationsNameSearch.addEventListener('input', renderEventRegistrations);
  eventRegistrationsEventFilter.addEventListener('change', renderEventRegistrations);
  document.getElementById('event-registrations-clear-filters')?.addEventListener('click', () => {
    eventRegistrationsNameSearch.value = '';
    eventRegistrationsEventFilter.value = '';
    renderEventRegistrations();
  });

  addSignupBtn.addEventListener('click', () => {
    editingSignupKey = null;
    addingSignup = true;
    renderSignups();
  });

  // --- Check-Ins tab ---
  function renderCheckins() {
    const nameQuery = checkinsNameSearch.value.trim();
    const isLockedByMe = checkinsLock.isLocked();

    const filteredCheckins = allCheckins.filter(
      (c) =>
        matchesName(c.firstName, c.lastName, nameQuery) &&
        checkinsClassFilters.matches((f) => matchesClass(c.classTitle, f.classTitle) && (!f.occurrenceId || c.eventId === f.occurrenceId))
    );
    const sortedCheckins = sortRows(filteredCheckins, checkinSort);

    const addCheckinRowHtml = addingCheckin ? checkinEditRowHtml({}, 'add') : '';

    checkinsBody.innerHTML =
      addCheckinRowHtml +
      sortedCheckins
        .map((c) => {
          if (editingCheckinKey === c.id) return checkinEditRowHtml(c, 'edit');
          return `
          <tr class="border-t border-border">
            <td class="px-4 py-2.5 text-ink">${escapeHtml(c.firstName)}</td>
            <td class="px-4 py-2.5 text-ink">${escapeHtml(c.lastName)}</td>
            <td class="px-4 py-2.5 text-ink/70">${escapeHtml(c.phone)}</td>
            <td class="px-4 py-2.5 text-ink/70">${escapeHtml(c.classTitle)}</td>
            <td class="px-4 py-2.5 text-ink/70">${c.classDate ? dateFormatter.format(new Date(c.classDate)) : '—'}</td>
            <td class="px-4 py-2.5 text-ink/70">${dateFormatter.format(new Date(c.createdAt))}</td>
            ${
              isLockedByMe
                ? `<td class="px-4 py-2.5"><div class="flex gap-3">
                    <button class="edit-checkin-btn text-ink/60 transition-colors hover:text-accent" aria-label="Edit" data-id="${c.id}">${EDIT_ICON_SVG}</button>
                    <button class="delete-checkin-btn text-ink/60 transition-colors hover:text-red-600" aria-label="Delete" data-id="${c.id}">${TRASH_ICON_SVG}</button>
                  </div></td>`
                : ''
            }
          </tr>`;
        })
        .join('');

    document.querySelectorAll<HTMLButtonElement>('.edit-checkin-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        editingCheckinKey = btn.dataset.id!;
        addingCheckin = false;
        renderCheckins();
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.cancel-checkin-edit-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        editingCheckinKey = null;
        addingCheckin = false;
        renderCheckins();
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.delete-checkin-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('Move this check-in to the Recycling Bin?')) return;
        const headers = await withAuthHeader();
        if (!headers) return;

        const res = await fetch('/api/admin/edit-checkin', {
          method: 'POST',
          headers,
          body: JSON.stringify({ action: 'delete', holderId, id: btn.dataset.id }),
        });

        if (res.ok) {
          await reloadAfterDeletionChange();
        } else {
          const data = await res.json().catch(() => ({}));
          alert(data.error ?? 'Failed to delete.');
        }
      });
    });

    document.querySelectorAll<HTMLSelectElement>('.checkin-class-select').forEach((select) => {
      select.addEventListener('change', () => {
        const row = select.closest('tr')!;
        const dateSelect = row.querySelector('.checkin-date-select') as HTMLSelectElement;
        const series = classSeries.find((s) => s.key === select.value);

        if (series && series.isSeries) {
          dateSelect.disabled = false;
          dateSelect.innerHTML =
            '<option value="">Select date…</option>' +
            series.occurrences.map((o) => `<option value="${escapeAttr(o.id)}">${escapeHtml(o.label)}</option>`).join('');
        } else {
          dateSelect.disabled = true;
          dateSelect.innerHTML = '<option value="">—</option>';
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.save-checkin-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const row = btn.closest('tr')!;
        const get = (cls: string) => (row.querySelector(`.${cls}`) as HTMLInputElement)?.value.trim() ?? '';

        const firstName = get('first-name');
        const lastName = get('last-name');
        const phone = get('phone');

        const seriesKey = (row.querySelector('.checkin-class-select') as HTMLSelectElement)?.value ?? '';
        const series = classSeries.find((s) => s.key === seriesKey);
        const eventId = series ? (series.isSeries ? (row.querySelector('.checkin-date-select') as HTMLSelectElement)?.value ?? '' : series.singleEventId ?? '') : '';

        if (!firstName || !lastName || !phone || !eventId) {
          alert("First name, last name, phone, and a class (with date, if it's a series) are required.");
          return;
        }

        const headers = await withAuthHeader();
        if (!headers) return;

        const mode = btn.dataset.mode;
        const payload: Record<string, unknown> = {
          action: mode === 'add' ? 'create' : 'update',
          holderId,
          firstName,
          lastName,
          phone: get('phone'),
          eventId,
        };
        if (mode === 'edit') payload.id = btn.dataset.id;

        const res = await fetch('/api/admin/edit-checkin', { method: 'POST', headers, body: JSON.stringify(payload) });
        if (res.ok) {
          editingCheckinKey = null;
          addingCheckin = false;
          await reloadCheckins();
        } else {
          const data = await res.json().catch(() => ({}));
          alert(data.error ?? 'Failed to save.');
        }
      });
    });

    checkinsEmpty.classList.toggle('hidden', sortedCheckins.length > 0);
    checkinsCount.textContent = `${sortedCheckins.length} ${sortedCheckins.length === 1 ? 'result' : 'results'}`;
    updateSortHeaders('checkins', checkinSort);
  }

  checkinsNameSearch.addEventListener('input', renderCheckins);
  document.getElementById('checkins-clear-filters')?.addEventListener('click', () => {
    checkinsNameSearch.value = '';
    checkinsClassFilters.reset();
    renderCheckins();
  });

  addCheckinBtn.addEventListener('click', () => {
    editingCheckinKey = null;
    addingCheckin = true;
    renderCheckins();
  });

  // --- Attendance tab ---
  const attendanceNameSearch = document.getElementById('attendance-name-search') as HTMLInputElement;
  const orphanedSignupsBody = document.getElementById('orphaned-signups-body')!;
  const orphanedSignupsEmpty = document.getElementById('orphaned-signups-empty')!;
  const orphanedSignupsCount = document.getElementById('orphaned-signups-count')!;
  const orphanedCheckinsBody = document.getElementById('orphaned-checkins-body')!;
  const orphanedCheckinsEmpty = document.getElementById('orphaned-checkins-empty')!;
  const orphanedCheckinsCount = document.getElementById('orphaned-checkins-count')!;
  const attendanceMatchesBody = document.getElementById('attendance-matches-body')!;
  const attendanceMatchesEmpty = document.getElementById('attendance-matches-empty')!;
  const attendanceMatchesCount = document.getElementById('attendance-matches-count')!;

  function formatEntryDate(iso: string | null): string {
    return iso ? dateFormatter.format(new Date(iso)) : '—';
  }

  function renderAttendance() {
    const nameQuery = attendanceNameSearch.value.trim();
    const isLockedByMe = attendanceLock.isLocked();

    const matchesName_ = (first: string, last: string) => matchesName(first, last, nameQuery);
    // Passes when the row matches any of the class filter rows.
    const matchesClassFilters = (classTitle: string | null, eventId: string | null) =>
      attendanceClassFilters.matches((f) => matchesClass(classTitle, f.classTitle) && (!f.occurrenceId || eventId === f.occurrenceId));

    const orphanedSignups = sortRows(
      attendanceEntries.filter(
        (e) => e.status === 'orphaned' && matchesName_(e.firstName, e.lastName) && matchesClassFilters(e.classTitle, e.occurrenceEventId)
      ),
      attendanceOrphanedSignupsSort
    );
    const orphanedCheckinsFiltered = sortRows(
      attendanceOrphanedCheckins.filter((c) => matchesName_(c.first_name, c.last_name) && matchesClassFilters(c.class_title, c.event_id)),
      attendanceOrphanedCheckinsSort
    );
    const otherEntries = sortRows(
      attendanceEntries.filter(
        (e) => e.status !== 'orphaned' && matchesName_(e.firstName, e.lastName) && matchesClassFilters(e.classTitle, e.occurrenceEventId)
      ),
      attendanceMatchesSort
    );

    // "They did come, the check-in just never got recorded": creates a
    // check-in for this entry. An entry pinned to a date uses that date; one
    // without (a legacy Drop-In) asks which date of its class it was.
    const createCheckinControlsHtml = (e: AttendanceEntry) => {
      const button = (disabled: boolean) =>
        `<button class="create-checkin-btn self-start text-left text-xs font-bold text-accent hover:underline" data-registration-id="${e.classRegistrationId}" data-occurrence-id="${e.occurrenceEventId ?? ''}" ${disabled ? 'disabled' : ''}>Create Check-In</button>`;
      if (e.occurrenceEventId) return button(false);
      const series = classSeries.find((s) => s.title === e.classTitle);
      const occurrences = series ? (series.isSeries ? series.occurrences : series.singleEventId ? [{ id: series.singleEventId, label: series.subLabel }] : []) : [];
      return `<div class="flex gap-1.5">
          <select class="create-checkin-date-select rounded-lg border border-border bg-bg px-1.5 py-1 text-xs" ${occurrences.length === 0 ? 'disabled' : ''}>
            <option value="">${occurrences.length === 0 ? 'No class dates' : 'Select date…'}</option>
            ${occurrences.map((o) => `<option value="${escapeAttr(o.id)}">${escapeHtml(o.label)}</option>`).join('')}
          </select>
          ${button(occurrences.length === 0)}
        </div>`;
    };

    orphanedSignupsBody.innerHTML = orphanedSignups
      .map((e) => {
        // A Whole-Series entry is pinned to one occurrence date, so only
        // offer check-ins for that same date — otherwise the reconcile
        // dropdown would let an admin link a dancer's, say, Sep 6 entry to
        // a check-in that actually happened on Aug 16. A Drop-In (or
        // unexpandable) entry has no fixed date, so any check-in for the
        // same class is a fair candidate.
        const candidateCheckins = attendanceOrphanedCheckins.filter(
          (c) => c.class_title === e.classTitle && (!e.occurrenceEventId || c.event_id === e.occurrenceEventId)
        );
        const optionsHtml = candidateCheckins
          .map(
            (c) =>
              `<option value="${escapeAttr(c.id)}">${escapeHtml(`${c.first_name} ${c.last_name}`)} — ${escapeHtml(c.phone || '—')} — ${formatEntryDate(c.created_at)}</option>`
          )
          .join('');
        return `
        <tr class="border-t border-border">
          <td class="px-3 py-2.5 text-ink">${escapeHtml(`${e.firstName} ${e.lastName}`)}</td>
          <td class="px-3 py-2.5 text-ink/70">${escapeHtml(e.phone || '—')}</td>
          <td class="px-3 py-2.5 text-ink/70">${escapeHtml(e.email || '—')}</td>
          <td class="px-3 py-2.5 text-ink/70">${escapeHtml(e.classTitle)}${
            e.expansionFailed
              ? ' <span class="font-bold text-orange-600" title="Could not find this Whole-Series sign-up\'s class series (it may have been deleted) — matching by class title alone instead of a specific date.">⚠</span>'
              : ''
          }</td>
          <td class="px-3 py-2.5 text-ink/70">${formatEntryDate(e.occurrenceDate)}</td>
          ${
            isLockedByMe
              ? `<td class="px-3 py-2.5">
                  <div class="flex flex-col gap-1.5">
                    <div class="flex gap-1.5">
                      <select class="reconcile-select rounded-lg border border-border bg-bg px-1.5 py-1 text-xs" ${candidateCheckins.length === 0 ? 'disabled' : ''}>
                        ${candidateCheckins.length === 0 ? '<option value="">No candidates</option>' : optionsHtml}
                      </select>
                      <button class="reconcile-btn text-xs font-bold text-accent hover:underline" data-registration-id="${e.classRegistrationId}" data-occurrence-id="${e.occurrenceEventId ?? ''}" ${candidateCheckins.length === 0 ? 'disabled' : ''}>Link</button>
                    </div>
                    ${createCheckinControlsHtml(e)}
                    <button class="no-show-btn self-start text-left text-xs font-semibold text-red-600 hover:underline" data-registration-id="${e.classRegistrationId}" data-occurrence-id="${e.occurrenceEventId ?? ''}">Mark No-Show</button>
                    <button class="delete-orphan-signup-btn self-start text-left text-xs font-semibold text-ink/60 hover:text-red-600 hover:underline" data-registration-id="${e.classRegistrationId}" data-series-mode="${e.seriesMode ?? ''}">Delete</button>
                  </div>
                </td>`
              : ''
          }
        </tr>`;
      })
      .join('');

    // Lets an admin tie a check-in to a specific class occurrence when it
    // couldn't be linked automatically (e.g. checked in on a day the class
    // wasn't scheduled). Preselects the class it already points at, or the
    // series matching its stored title.
    const linkCheckinCellHtml = (c: OrphanedCheckin) => {
      const current = findSeriesForEventId(c.event_id);
      const series = current?.series ?? classSeries.find((s) => s.title === c.class_title) ?? null;
      const classOptions = classSeries
        .map((s) => `<option value="${escapeAttr(s.key)}" ${s.key === series?.key ? 'selected' : ''}>${escapeHtml(s.title)} — ${escapeHtml(s.subLabel)}</option>`)
        .join('');
      const dateOptions = series?.isSeries
        ? series.occurrences
            .map((o) => `<option value="${escapeAttr(o.id)}" ${o.id === current?.occurrenceId ? 'selected' : ''}>${escapeHtml(o.label)}</option>`)
            .join('')
        : '';
      return `<td class="px-3 py-2.5">
          <div class="flex flex-col gap-1.5">
            <select class="link-class-select rounded-lg border border-border bg-bg px-1.5 py-1 text-xs">
              <option value="">Select class…</option>
              ${classOptions}
            </select>
            <div class="flex gap-1.5">
              <select class="link-date-select rounded-lg border border-border bg-bg px-1.5 py-1 text-xs" ${series?.isSeries ? '' : 'disabled'}>
                <option value="">${series?.isSeries ? 'Select date…' : '—'}</option>
                ${dateOptions}
              </select>
              <button class="link-checkin-btn text-xs font-bold text-accent hover:underline" data-checkin-id="${escapeAttr(c.id)}">Link</button>
            </div>
            <button class="create-signup-btn self-start text-left text-xs font-bold text-accent hover:underline" data-checkin-id="${escapeAttr(c.id)}" title="Creates an unpaid Drop-In sign-up for the class date picked above">Create Sign-Up</button>
            <button class="delete-orphan-checkin-btn self-start text-left text-xs font-semibold text-ink/60 hover:text-red-600 hover:underline" data-checkin-id="${escapeAttr(c.id)}">Delete</button>
          </div>
        </td>`;
    };

    orphanedCheckinsBody.innerHTML = orphanedCheckinsFiltered
      .map(
        (c) => `
      <tr class="border-t border-border">
        <td class="px-3 py-2.5 text-ink">${escapeHtml(`${c.first_name} ${c.last_name}`)}</td>
        <td class="px-3 py-2.5 text-ink/70">${escapeHtml(c.phone || '—')}</td>
        <td class="px-3 py-2.5 text-ink/70">${escapeHtml(c.email || '—')}</td>
        <td class="px-3 py-2.5 text-ink/70">${escapeHtml(c.class_title)}${c.event_id ? '' : ' <span class="text-xs text-orange-600" title="Not linked to a specific class date.">(no date)</span>'}</td>
        <td class="px-3 py-2.5 text-ink/70">${formatEntryDate(c.created_at)}</td>
        ${isLockedByMe ? linkCheckinCellHtml(c) : ''}
      </tr>`
      )
      .join('');

    document.querySelectorAll<HTMLSelectElement>('.link-class-select').forEach((select) => {
      select.addEventListener('change', () => {
        const dateSelect = select.closest('td')!.querySelector('.link-date-select') as HTMLSelectElement;
        const series = classSeries.find((s) => s.key === select.value);
        if (series?.isSeries) {
          dateSelect.disabled = false;
          dateSelect.innerHTML =
            '<option value="">Select date…</option>' +
            series.occurrences.map((o) => `<option value="${escapeAttr(o.id)}">${escapeHtml(o.label)}</option>`).join('');
        } else {
          dateSelect.disabled = true;
          dateSelect.innerHTML = '<option value="">—</option>';
        }
      });
    });

    // The class occurrence picked in an orphaned check-in's Resolve cell.
    const pickedLinkEventId = (cell: Element): string => {
      const series = classSeries.find((s) => s.key === (cell.querySelector('.link-class-select') as HTMLSelectElement).value);
      if (!series) return '';
      return series.isSeries ? (cell.querySelector('.link-date-select') as HTMLSelectElement).value : series.singleEventId ?? '';
    };

    const postResolve = async (btn: HTMLButtonElement, payload: Record<string, unknown>, failureMessage: string) => {
      const headers = await withAuthHeader();
      if (!headers) return;
      btn.disabled = true;
      const res = await fetch('/api/admin/resolve-attendance', {
        method: 'POST',
        headers,
        body: JSON.stringify({ ...payload, holderId }),
      });
      if (res.ok) {
        // A created or deleted row also shows up in the other tabs.
        await reloadAfterDeletionChange();
      } else {
        const data = await res.json().catch(() => ({}));
        alert(data.error ?? failureMessage);
        btn.disabled = false;
      }
    };

    document.querySelectorAll<HTMLButtonElement>('.delete-orphan-signup-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const message =
          btn.dataset.seriesMode === 'whole'
            ? 'Move this whole-series sign-up (every date of the class, not just this one) to the Recycling Bin?'
            : 'Move this sign-up to the Recycling Bin?';
        if (!confirm(message)) return;
        await postResolve(btn, { action: 'delete_registration', classRegistrationId: btn.dataset.registrationId }, 'Failed to delete the sign-up.');
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.delete-orphan-checkin-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('Move this check-in to the Recycling Bin?')) return;
        await postResolve(btn, { action: 'delete_checkin', checkinId: btn.dataset.checkinId }, 'Failed to delete the check-in.');
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.create-signup-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const eventId = pickedLinkEventId(btn.closest('td')!);
        if (!eventId) {
          alert('Pick the class (and a date, if it is a series) to create the sign-up for.');
          return;
        }
        if (!confirm('Create an unpaid Drop-In sign-up for this dancer and link it to this check-in?')) return;
        await postResolve(btn, { action: 'create_signup_for_checkin', checkinId: btn.dataset.checkinId, eventId }, 'Failed to create the sign-up.');
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.create-checkin-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const occurrenceId = btn.dataset.occurrenceId || null;
        const eventId = occurrenceId ?? btn.closest('td')!.querySelector<HTMLSelectElement>('.create-checkin-date-select')?.value ?? '';
        if (!eventId) {
          alert('Pick which class date this dancer attended.');
          return;
        }
        if (!confirm('Record a check-in for this dancer and link it to this sign-up?')) return;
        await postResolve(
          btn,
          { action: 'create_checkin_for_signup', classRegistrationId: btn.dataset.registrationId, occurrenceEventId: occurrenceId, eventId },
          'Failed to create the check-in.'
        );
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.link-checkin-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const cell = btn.closest('td')!;
        const eventId = pickedLinkEventId(cell);
        if (!eventId) {
          alert('Pick a class (and a date, if it is a series) to link this check-in to.');
          return;
        }

        const headers = await withAuthHeader();
        if (!headers) return;
        btn.disabled = true;

        const res = await fetch('/api/admin/resolve-attendance', {
          method: 'POST',
          headers,
          body: JSON.stringify({ action: 'link_checkin_event', holderId, checkinId: btn.dataset.checkinId, eventId }),
        });

        if (res.ok) {
          // Re-fetch so the server re-runs matching: the check-in now has a
          // date, so it may pair with a sign-up automatically.
          await reloadAttendance();
        } else {
          const data = await res.json().catch(() => ({}));
          alert(data.error ?? 'Failed to link the check-in.');
          btn.disabled = false;
        }
      });
    });

    const statusLabel = (status: AttendanceEntry['status']) =>
      status === 'matched'
        ? '<span class="font-bold text-green-600">Matched ✓</span>'
        : status === 'no_show'
          ? '<span class="font-bold text-red-600">No-Show ✗</span>'
          : '<span class="text-ink/40">Upcoming —</span>';

    attendanceMatchesBody.innerHTML = otherEntries
      .map(
        (e) => `
      <tr class="border-t border-border">
        <td class="px-4 py-2.5 text-ink">${escapeHtml(`${e.firstName} ${e.lastName}`)}</td>
        <td class="px-4 py-2.5 text-ink/70">${escapeHtml(e.phone || '—')}</td>
        <td class="px-4 py-2.5 text-ink/70">${escapeHtml(e.email || '—')}</td>
        <td class="px-4 py-2.5 text-ink/70">${escapeHtml(e.classTitle)}${
          e.expansionFailed
            ? ' <span class="font-bold text-orange-600" title="Could not find this Whole-Series sign-up\'s class series (it may have been deleted) — this status is a degraded guess, matched by class title alone rather than a specific date.">⚠</span>'
            : ''
        }</td>
        <td class="px-4 py-2.5 text-ink/70">${formatEntryDate(e.occurrenceDate)}</td>
        <td class="px-4 py-2.5">${statusLabel(e.status)}</td>
      </tr>`
      )
      .join('');

    document.querySelectorAll<HTMLButtonElement>('.reconcile-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const row = btn.closest('tr')!;
        const checkinId = (row.querySelector('.reconcile-select') as HTMLSelectElement)?.value;
        if (!checkinId) return;

        const headers = await withAuthHeader();
        if (!headers) return;
        btn.disabled = true;

        const res = await fetch('/api/admin/resolve-attendance', {
          method: 'POST',
          headers,
          body: JSON.stringify({
            action: 'reconcile',
            holderId,
            classRegistrationId: btn.dataset.registrationId,
            occurrenceEventId: btn.dataset.occurrenceId || null,
            checkinId,
          }),
        });

        if (res.ok) {
          // Patch local state instead of a full reloadAttendance() round trip —
          // the mutation just succeeded server-side, the lock guarantees no one
          // else is concurrently changing this data, and a full re-fetch +
          // re-match of up to 10k+10k rows is unnecessary cost for one row.
          const registrationId = btn.dataset.registrationId;
          const occurrenceId = btn.dataset.occurrenceId || null;
          const checkin = attendanceOrphanedCheckins.find((c) => c.id === checkinId);
          const entry = attendanceEntries.find(
            (e) => e.classRegistrationId === registrationId && (e.occurrenceEventId ?? null) === occurrenceId
          );
          if (entry) {
            entry.status = 'matched';
            entry.matchedCheckin = checkin
              ? {
                  id: checkin.id,
                  first_name: checkin.first_name,
                  last_name: checkin.last_name,
                  phone: checkin.phone,
                  class_title: checkin.class_title,
                  created_at: checkin.created_at,
                }
              : null;
          }
          attendanceOrphanedCheckins = attendanceOrphanedCheckins.filter((c) => c.id !== checkinId);
          renderAttendance();
        } else {
          const data = await res.json().catch(() => ({}));
          alert(data.error ?? 'Failed to reconcile.');
          btn.disabled = false;
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.no-show-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('Mark this sign-up as a no-show?')) return;
        const headers = await withAuthHeader();
        if (!headers) return;
        btn.disabled = true;

        const res = await fetch('/api/admin/resolve-attendance', {
          method: 'POST',
          headers,
          body: JSON.stringify({
            action: 'no_show',
            holderId,
            classRegistrationId: btn.dataset.registrationId,
            occurrenceEventId: btn.dataset.occurrenceId || null,
          }),
        });

        if (res.ok) {
          const registrationId = btn.dataset.registrationId;
          const occurrenceId = btn.dataset.occurrenceId || null;
          const entry = attendanceEntries.find(
            (e) => e.classRegistrationId === registrationId && (e.occurrenceEventId ?? null) === occurrenceId
          );
          if (entry) entry.status = 'no_show';
          renderAttendance();
        } else {
          const data = await res.json().catch(() => ({}));
          alert(data.error ?? 'Failed to mark as a no-show.');
          btn.disabled = false;
        }
      });
    });

    orphanedSignupsEmpty.classList.toggle('hidden', orphanedSignups.length > 0);
    orphanedCheckinsEmpty.classList.toggle('hidden', orphanedCheckinsFiltered.length > 0);
    attendanceMatchesEmpty.classList.toggle('hidden', otherEntries.length > 0);
    orphanedSignupsCount.textContent = `${orphanedSignups.length} ${orphanedSignups.length === 1 ? 'entry' : 'entries'}`;
    orphanedCheckinsCount.textContent = `${orphanedCheckinsFiltered.length} ${orphanedCheckinsFiltered.length === 1 ? 'entry' : 'entries'}`;
    attendanceMatchesCount.textContent = `${otherEntries.length} ${otherEntries.length === 1 ? 'result' : 'results'}`;
    updateSortHeaders('attendance-orphaned-signups', attendanceOrphanedSignupsSort);
    updateSortHeaders('attendance-orphaned-checkins', attendanceOrphanedCheckinsSort);
    updateSortHeaders('attendance-matches', attendanceMatchesSort);
  }

  attendanceNameSearch.addEventListener('input', renderAttendance);
  document.getElementById('attendance-clear-filters')?.addEventListener('click', () => {
    attendanceNameSearch.value = '';
    attendanceClassFilters.reset();
    renderAttendance();
  });

  // --- Recycling Bin tab ---
  // Every delete on this page lands here (rows are only flagged); Restore
  // clears one item's flags and Empty permanently deletes everything.
  interface RecyclingBinItem {
    deletionId: string;
    kind: 'signup' | 'dancer' | 'class' | 'checkin';
    deletedAt: string;
    deletedBy: string | null;
    name: string;
    classes: { title: string; mode: 'whole' | 'dropin' | null; date: string | null }[];
    [key: string]: unknown;
  }
  let recyclingBinItems: RecyclingBinItem[] = [];
  let recyclingBinTruncated = false;

  const recyclingBody = document.getElementById('recycling-body')!;
  const recyclingEmptyNote = document.getElementById('recycling-empty')!;
  const recyclingCount = document.getElementById('recycling-count')!;
  const recyclingTabCount = document.getElementById('recycling-tab-count')!;
  const emptyBinBtn = document.getElementById('empty-recycling-btn') as HTMLButtonElement;
  const binDateFormatter = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', timeZone: siteTimeZone() });
  const binClassDateFormatter = new Intl.DateTimeFormat('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: siteTimeZone() });

  const BIN_KIND_LABELS: Record<RecyclingBinItem['kind'], string> = {
    signup: 'Sign-up',
    dancer: 'Dancer (group sign-up)',
    class: 'Class registration',
    checkin: 'Check-in',
  };

  async function loadRecyclingBin() {
    const headers = await withAuthHeader();
    if (!headers) return;
    const res = await fetch('/api/admin/recycling-bin', { headers });
    if (!res.ok) return;
    const { items, truncated } = (await res.json()) as { items: RecyclingBinItem[]; truncated: boolean };
    recyclingBinTruncated = truncated;
    recyclingBinItems = items.map((item) => ({ ...item, kindLabel: BIN_KIND_LABELS[item.kind] }));
    renderRecyclingBin();
  }

  function binClassesHtml(item: RecyclingBinItem): string {
    if (item.classes.length === 0) return '—';
    return item.classes
      .map((c) => {
        const mode = c.mode === 'whole' ? 'Whole Series' : c.mode === 'dropin' ? 'Drop In' : '';
        const date = c.date ? binClassDateFormatter.format(new Date(c.date)) : '';
        const detail = [mode, date].filter(Boolean).join(', ');
        return `<div>${escapeHtml(c.title)}${detail ? ` <span class="text-xs text-muted">(${escapeHtml(detail)})</span>` : ''}</div>`;
      })
      .join('');
  }

  function renderRecyclingBin() {
    const items = sortRows(recyclingBinItems, recyclingSort);
    const isLockedByMe = recyclingLock.isLocked();

    recyclingBody.innerHTML = items
      .map(
        (item) => `
      <tr class="border-t border-border align-top">
        <td class="px-4 py-2.5 text-ink">${escapeHtml(item.name)}</td>
        <td class="px-4 py-2.5 text-ink/70">${escapeHtml(BIN_KIND_LABELS[item.kind])}</td>
        <td class="px-4 py-2.5 text-ink/70">${binClassesHtml(item)}</td>
        <td class="px-4 py-2.5 text-ink/70">${item.deletedAt ? binDateFormatter.format(new Date(item.deletedAt)) : '—'}</td>
        <td class="px-4 py-2.5 text-ink/70">${
          item.deletedBy === DUPLICATE_DELETED_BY
            ? '<span class="rounded-full bg-accent/15 px-2 py-0.5 text-xs font-bold uppercase tracking-wider text-accent">Duplicate</span><div class="mt-1 text-xs text-muted">Auto-removed: submitted twice</div>'
            : escapeHtml(item.deletedBy ?? '—')
        }</td>
        <td class="px-4 py-2.5">${
          isLockedByMe
            ? `<button class="restore-bin-btn text-xs font-semibold text-accent hover:underline" data-deletion-id="${escapeAttr(item.deletionId)}">Restore</button>`
            : '<span class="text-xs text-muted">Lock to restore</span>'
        }</td>
      </tr>`
      )
      .join('');

    document.querySelectorAll<HTMLButtonElement>('.restore-bin-btn').forEach((btn) => {
      btn.addEventListener('click', () => postRecyclingAction(btn, { action: 'restore', deletionId: btn.dataset.deletionId }, 'Failed to restore.'));
    });

    const countLabel = recyclingBinTruncated
      ? `Showing the newest ${items.length} items (the bin holds more)`
      : `${items.length} ${items.length === 1 ? 'item' : 'items'}`;
    recyclingCount.textContent = countLabel;
    recyclingTabCount.textContent = items.length > 0 ? String(items.length) : '';
    recyclingTabCount.classList.toggle('hidden', items.length === 0);
    recyclingEmptyNote.classList.toggle('hidden', items.length > 0);
    emptyBinBtn.disabled = !isLockedByMe || items.length === 0;
    updateSortHeaders('recycling', recyclingSort);
  }

  // A delete, restore, or empty can change every tab, so all of them reload.
  async function reloadAfterDeletionChange() {
    await Promise.all([
      reloadData().then((ok) => {
        if (ok) {
          renderSignups();
          renderEventRegistrations();
          renderCheckins();
        }
      }),
      reloadAttendance(),
      loadRecyclingBin(),
    ]);
  }

  async function postRecyclingAction(btn: HTMLButtonElement, payload: Record<string, unknown>, failureMessage: string) {
    const headers = await withAuthHeader();
    if (!headers) return;
    btn.disabled = true;
    const res = await fetch('/api/admin/recycling-bin', { method: 'POST', headers, body: JSON.stringify({ ...payload, holderId }) });
    if (res.ok) {
      await reloadAfterDeletionChange();
    } else {
      const data = await res.json().catch(() => ({}));
      alert(data.error ?? failureMessage);
      btn.disabled = false;
    }
  }

  emptyBinBtn.addEventListener('click', () => {
    const n = recyclingBinItems.length;
    if (!confirm(`Permanently delete ${n} ${n === 1 ? 'item' : 'items'}? This can't be undone.`)) return;
    postRecyclingAction(emptyBinBtn, { action: 'empty' }, 'Failed to empty the recycling bin.');
  });

  // --- Data loading ---
  // Sign-ups and check-ins are fetched together (one endpoint, one round
  // trip) since class-picker/series data is shared by both tabs, but each
  // tab only re-renders its own table afterward.
  async function reloadData(): Promise<boolean> {
    const {
      data: { session },
    } = await supabaseBrowser.auth.getSession();
    if (!session) return false;

    const dataRes = await fetch('/api/admin/analytics-data', {
      headers: { Authorization: `Bearer ${session.access_token}` },
    });
    if (!dataRes.ok) return false;

    const { signups, eventRegistrations, checkins, classTitles, classSeries: series, eventSeries: events, bouncedEmails: bounces } = await dataRes.json();
    bouncedEmails = new Map(((bounces ?? []) as { email: string; bouncedAt: string; reason: string | null }[]).map((b) => [b.email, b]));
    eventSeries = events ?? [];
    allSignups = (signups as Signup[]).map((s) => ({
      ...s,
      class: serializeClassRegistrations(s.classRegistrations),
      seriesSort: s.classRegistrations.map((e) => (e.seriesMode === 'whole' ? 'Whole Series' : e.seriesMode === 'dropin' ? 'Drop In' : '—')).join(' / '),
      paymentSort: signupPaymentSortKey(s),
    }));
    allEventRegistrations = ((eventRegistrations ?? []) as Signup[]).map((s) => ({
      ...s,
      class: serializeClassRegistrations(s.classRegistrations),
      seriesSort: '',
      paymentSort: signupPaymentSortKey(s),
    }));
    refreshEventFilterOptions();
    allCheckins = checkins;
    classSeries = series ?? [];

    classTitleOptions = classTitles as string[];
    for (const group of [signupsClassFilters, checkinsClassFilters, attendanceClassFilters]) group.refresh();

    return true;
  }

  async function reloadSignups() {
    if (await reloadData()) renderSignups();
  }

  async function reloadCheckins() {
    if (await reloadData()) renderCheckins();
  }

  // Fetches and stores attendance data without drawing it, so page load can
  // run it alongside the other loads and render everything once at the end.
  async function loadAttendanceData(): Promise<boolean> {
    const headers = await withAuthHeader();
    if (!headers) return false;

    const res = await fetch('/api/admin/attendance-data', { headers });
    if (!res.ok) return false;

    const { entries, orphanedCheckins } = await res.json();
    attendanceEntries = entries ?? [];
    attendanceOrphanedCheckins = orphanedCheckins ?? [];
    return true;
  }

  async function reloadAttendance() {
    if (await loadAttendanceData()) renderAttendance();
  }

  async function init() {
    const gate = await checkAdminSession();
    if (gate.status !== 'admin') {
      showPanel(gate.status);
      return;
    }

    setActiveTab(new URLSearchParams(location.search).get('tab') ?? 'signups');

    // These are independent, so run them together instead of one after
    // another — the dashboard appears after the slowest, not the sum.
    await Promise.all([
      reloadData(),
      loadAttendanceData(),
      signupsLock.refresh(),
      eventRegistrationsLock.refresh(),
      checkinsLock.refresh(),
      attendanceLock.refresh(),
      recyclingLock.refresh(),
      loadRecyclingBin(),
    ]);
    showPanel('dashboard');
    renderSignups();
    renderEventRegistrations();
    renderCheckins();
    renderAttendance();
    renderRecyclingBin();
    // Only the tab actually shown on load needs its heartbeat running (see
    // setActiveTab) — this also covers reloading the page while already
    // holding that tab's lock, which refresh() alone wouldn't re-arm.
    await lockControllersByTab[activeTab]?.resumeHeartbeat();
  }

  init();
</script>
