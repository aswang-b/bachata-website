  // checked" fallback still works against real class_registrations data.
  function serializeClassRegistrations(entries: ClassRegistrationEntry[]): string {
    return entries
      .filter((e) => e.classLabel)
      .map((e) => (e.seriesMode ? `${e.classLabel} — ${e.seriesMode === 'dropin' ? 'Drop In' : 'Whole Series'}` : e.classLabel))
      .join('; ');
  }

  const EDIT_ICON_SVG = `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-5m-1.5-9.5a2.121 2.121 0 0 1 3 3L12 16l-4 1 1-4 9.5-9.5Z" /></svg>`;
  const MAIL_ICON_SVG = `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 0 0 2.22 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2Z" /></svg>`;

  // Resends a sign-up's confirmation email to each dancer's current address,
  // e.g. after fixing one that bounced (Sign-Ups and Event Registration tabs).
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.resend-confirmation-btn');
    if (!btn || btn.disabled) return;
    const submissionId = btn.dataset.submissionId ?? '';
    const people = [...allSignups, ...allEventRegistrations].filter((s) => s.submissionId === submissionId);
    const addresses = [...new Set(people.map((p) => p.email).filter(Boolean))];
    if (addresses.length === 0) {
      alert('No one on this sign-up has an email address. Add one with Edit first.');
      return;
    }
    if (!confirm(`Resend the confirmation email to ${addresses.join(', ')}?`)) return;
    const headers = await withAuthHeader();
    if (!headers) return;
    btn.disabled = true;
    try {
      const res = await fetch('/api/admin/resend-confirmation', { method: 'POST', headers, body: JSON.stringify({ submissionId }) });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) {
        alert(body.error ?? 'Failed to resend the email.');
        return;
      }
      alert(`Sent to ${body.sent.join(', ')}.${body.failed?.length ? ` Couldn't send to ${body.failed.join(', ')}.` : ''}`);
    } finally {
      btn.disabled = false;
    }
  });
  const TRASH_ICON_SVG = `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 7h12M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2m-8 0 .867 12.142A2 2 0 0 0 9.862 21h4.276a2 2 0 0 0 1.995-1.858L17 7M10 11v6m4-6v6" /></svg>`;

