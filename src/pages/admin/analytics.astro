  const addCheckinBtn = document.getElementById('add-checkin-btn') as HTMLButtonElement;

  const dateFormatter = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str ?? '';
    return div.innerHTML;
  }

  function escapeAttr(str: string): string {
    return escapeHtml(str).replace(/"/g, '&quot;');
  }

  function matchesName(firstName: string, lastName: string, query: string): boolean {
    if (!query) return true;
    const full = `${firstName} ${lastName}`.toLowerCase();
    return full.includes(query.toLowerCase());
  }

  function matchesClass(classText: string | null, filter: string): boolean {
    if (!filter) return true;
    return Boolean(classText && classText.includes(filter));
  }

  function sortRows<T extends Record<string, unknown>>(rows: T[], sort: { column: string; direction: 'asc' | 'desc' }): T[] {
    const sorted = [...rows].sort((a, b) => {
      const av = a[sort.column];
      const bv = b[sort.column];
      let cmp: number;

      if (DATE_COLUMNS.has(sort.column)) {
        cmp = (av ? new Date(av as string).getTime() : 0) - (bv ? new Date(bv as string).getTime() : 0);
      } else if (typeof av === 'boolean' || typeof bv === 'boolean') {
        cmp = Number(Boolean(av)) - Number(Boolean(bv));
      } else {
        cmp = String(av ?? '').localeCompare(String(bv ?? ''), undefined, { sensitivity: 'base' });
      }

      return sort.direction === 'asc' ? cmp : -cmp;
    });
    return sorted;
  }

  function updateSortHeaders(table: string, sort: { column: string; direction: 'asc' | 'desc' }) {
    document.querySelectorAll<HTMLElement>(`.sort-header[data-table="${table}"]`).forEach((th) => {
      const column = th.dataset.column ?? '';
      const isActive = sort.column === column;
      th.textContent = th.textContent!.replace(/ [↑↓]$/, '') + (isActive ? (sort.direction === 'asc' ? ' ↑' : ' ↓') : '');
    });
  }

  const SORT_STATE_BY_TABLE: Record<string, { column: string; direction: 'asc' | 'desc' }> = {
    signups: signupSort,
    checkins: checkinSort,
    'attendance-orphaned-signups': attendanceOrphanedSignupsSort,
    'attendance-orphaned-checkins': attendanceOrphanedCheckinsSort,
    'attendance-matches': attendanceMatchesSort,
  };
  const RENDER_BY_TABLE: Record<string, () => void> = {
    signups: () => renderSignups(),
    checkins: () => renderCheckins(),
    'attendance-orphaned-signups': () => renderAttendance(),
    'attendance-orphaned-checkins': () => renderAttendance(),
    'attendance-matches': () => renderAttendance(),
  };

  document.querySelectorAll<HTMLElement>('.sort-header').forEach((th) => {
    th.addEventListener('click', () => {
      const table = th.dataset.table ?? '';
      const column = th.dataset.column ?? '';
      const sort = SORT_STATE_BY_TABLE[table];
      if (!sort) return;
      if (sort.column === column) {
        sort.direction = sort.direction === 'asc' ? 'desc' : 'asc';
      } else {
        sort.column = column;
        sort.direction = 'asc';
      }
      RENDER_BY_TABLE[table]?.();
    });
  });

  function formatPrice(value: number): string {
    return Number.isInteger(value) ? `$${value}` : `$${value.toFixed(2)}`;
  }

  // Reconstructs the "<label> — <Whole Series|Drop In>" wire format the
  // public registration form builds (see register.astro's updateClassValue),
  // so the class-picker's "keep what was already there if nothing is
  // checked" fallback still works against real class_registrations data.
  function serializeClassRegistrations(entries: ClassRegistrationEntry[]): string {
    return entries
      .filter((e) => e.classLabel)
      .map((e) => (e.seriesMode ? `${e.classLabel} — ${e.seriesMode === 'dropin' ? 'Drop In' : 'Whole Series'}` : e.classLabel))
      .join('; ');
  }

  const EDIT_ICON_SVG = `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-5m-1.5-9.5a2.121 2.121 0 0 1 3 3L12 16l-4 1 1-4 9.5-9.5Z" /></svg>`;
  const TRASH_ICON_SVG = `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 7h12M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2m-8 0 .867 12.142A2 2 0 0 0 9.862 21h4.276a2 2 0 0 0 1.995-1.858L17 7M10 11v6m4-6v6" /></svg>`;

  function paymentSelectHtml(current: string | null): string {
    const opts: [string, string][] = [
      ['', '—'],
      ['cash', 'Cash'],
      ['venmo', 'Venmo'],
    ];
    return `<select class="edit-input rounded-lg border border-border bg-bg px-2 py-1 text-xs">${opts
      .map(([value, label]) => `<option value="${value}" ${current === value || (!current && !value) ? 'selected' : ''}>${label}</option>`)
      .join('')}</select>`;
  }

  function signupClassPickerHtml(currentClassRaw: string): string {
    const optionsHtml = classSeries
      .map((series) => {
        const optionBase = `${series.title} — ${series.subLabel}`;
        const modeControlsHtml = series.isSeries
          ? `
            <span class="class-mode-controls ml-5 hidden gap-2">
              <label class="flex items-center gap-1 text-[10px] text-ink/70">
                <input type="radio" name="signup-class-mode-${escapeAttr(series.key)}" class="signup-class-mode h-3 w-3" value="whole" checked />
                Whole
              </label>
              <label class="flex items-center gap-1 text-[10px] text-ink/70">
                <input type="radio" name="signup-class-mode-${escapeAttr(series.key)}" class="signup-class-mode h-3 w-3" value="dropin" />
                Drop-in
              </label>
            </span>`
          : '';
        // Drop-ins are for one specific date, so picking Drop-in reveals a date select.
        const occurrenceSelectHtml = series.isSeries
          ? `
            <select class="signup-class-occurrence ml-5 hidden w-36 rounded-lg border border-border bg-bg px-1 py-0.5 text-[10px] text-ink">
              <option value="">Pick class date…</option>
              ${series.occurrences.map((o) => `<option value="${escapeAttr(o.id)}">${escapeHtml(o.label)}</option>`).join('')}
            </select>`
          : '';
        return `
          <div class="flex flex-col gap-0.5">
            <label class="flex items-start gap-1.5 text-xs text-ink">
              <input type="checkbox" class="signup-class-checkbox mt-0.5 h-3.5 w-3.5" data-key="${escapeAttr(series.key)}" data-title="${escapeAttr(series.title)}" data-base="${escapeAttr(optionBase)}" data-is-series="${String(series.isSeries)}" />
              <span>${escapeHtml(series.title)} <span class="text-muted">(${escapeHtml(series.subLabel)})</span></span>
            </label>
            ${modeControlsHtml}
            ${occurrenceSelectHtml}
          </div>`;
      })
      .join('');

    return `
      <div class="flex max-h-32 w-44 flex-col gap-1.5 overflow-y-auto rounded-lg border border-border bg-bg p-2">
        ${classSeries.length ? optionsHtml : '<span class="text-xs text-muted">No classes found.</span>'}
      </div>
      <p class="mt-1 w-44 truncate text-[10px] text-muted" title="${escapeAttr(currentClassRaw)}">Current: ${escapeHtml(currentClassRaw || '—')}</p>`;
  }

  // Lets an admin set or fix the date of a dancer's existing Drop-In
  // registrations without re-picking classes. Ignored (and disabled) if new
  // classes are picked above, since picking classes replaces the old ones.
  function existingDropInDatesHtml(entries: ClassRegistrationEntry[] | undefined): string {
    const dropIns = (entries ?? []).filter((e) => e.id && e.seriesMode === 'dropin');
    if (dropIns.length === 0) return '';

    const blocks = dropIns
      .map((e) => {
        const series = findSeriesForEventId(e.occurrenceEventId)?.series ?? classSeries.find((c) => c.title === e.classTitle);
        if (!series) return `<div class="text-[10px] text-muted">${escapeHtml(e.classTitle)}: no matching class found</div>`;
        const options = series.occurrences
          .map((o) => `<option value="${escapeAttr(o.id)}" ${o.id === e.occurrenceEventId ? 'selected' : ''}>${escapeHtml(o.label)}</option>`)
          .join('');
        return `
          <label class="flex flex-col gap-0.5 text-[10px] text-muted">
            ${escapeHtml(e.classTitle)} drop-in date
            <select class="existing-dropin-occurrence w-44 rounded-lg border border-border bg-bg px-1.5 py-1 text-xs text-ink" data-registration-id="${escapeAttr(e.id ?? '')}" data-original="${escapeAttr(e.occurrenceEventId ?? '')}">
              <option value="" ${e.occurrenceEventId ? '' : 'selected'}>Date not recorded</option>
              ${options}
            </select>
          </label>`;
      })
      .join('');

    return `<div class="existing-dropin-dates mt-2 flex w-44 flex-col gap-1.5 border-t border-border pt-2">${blocks}</div>`;
  }

  // Shows a class's date select only while Drop-in is the chosen mode, and
  // dims the existing-registration date controls once new classes are picked.
  function syncSignupPicker(row: Element) {
    row.querySelectorAll('.signup-class-checkbox').forEach((checkbox) => {
      const container = checkbox.closest('.flex.flex-col');
      const checked = (checkbox as HTMLInputElement).checked;
      const dropIn = container?.querySelector<HTMLInputElement>('.signup-class-mode[value="dropin"]')?.checked ?? false;
      container?.querySelector('.signup-class-occurrence')?.classList.toggle('hidden', !(checked && dropIn));
    });
    const anyPicked = row.querySelector('.signup-class-checkbox:checked') !== null;
    row.querySelector('.existing-dropin-dates')?.classList.toggle('opacity-40', anyPicked);
    row.querySelectorAll<HTMLSelectElement>('.existing-dropin-occurrence').forEach((select) => (select.disabled = anyPicked));
  }

