  });

  // Payment column sort key: method first (what the column leads with), then
  // the dancer's total across their classes so same-method rows order by amount.
  function signupPaymentSortKey(s: Pick<Signup, 'paymentMethod' | 'classRegistrations'>): string {
    const method = s.paymentMethod === 'venmo' ? 'Venmo' : s.paymentMethod === 'cash' ? 'Cash' : '—';
    const total = s.classRegistrations.reduce((sum, e) => sum + (e.price ?? 0), 0);
    return `${method} ${total.toFixed(2).padStart(9, '0')}`;
