  // Populates `select` with the occurrence dates of whichever series
  // matches `classTitle`, hiding `wrap` entirely when that class isn't an
  // actual multi-date series (nothing to narrow down to).
  function populateOccurrenceFilter(select: HTMLSelectElement, wrap: HTMLElement, classTitle: string) {
    select.innerHTML = '<option value="">All dates</option>';
    const series = classSeries.find((s) => s.title === classTitle && s.isSeries);
    if (!classTitle || !series) {
      wrap.classList.add('hidden');
      select.value = '';
      return;
    }
    for (const occ of series.occurrences) {
      const option = document.createElement('option');
      option.value = occ.id;
      option.textContent = occ.label;
      select.appendChild(option);
    }
    wrap.classList.remove('hidden');
  }

  const signupsBody = document.getElementById('signups-body')!;
  const checkinsBody = document.getElementById('checkins-body')!;
  const signupsEmpty = document.getElementById('signups-empty')!;
  const checkinsEmpty = document.getElementById('checkins-empty')!;
  const signupsCount = document.getElementById('signups-count')!;
  const checkinsCount = document.getElementById('checkins-count')!;

