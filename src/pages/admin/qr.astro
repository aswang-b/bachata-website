---
import BaseLayout from '../../layouts/BaseLayout.astro';

const tab = 'qr-tab border-b-2 border-transparent px-4 py-2.5 text-sm font-bold text-ink/60 transition-colors hover:text-ink aria-selected:border-accent aria-selected:text-accent';
const field = 'rounded-xl border border-border bg-bg px-3 py-2 text-sm text-ink';
const cta = 'gradient-accent self-start rounded-full px-6 py-2.5 text-sm font-bold uppercase tracking-wider text-white transition-opacity hover:opacity-90 disabled:opacity-50';
const pill = 'rounded-full border border-accent px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-accent transition-colors hover:bg-accent hover:text-white disabled:opacity-50';
const card = 'flex flex-col gap-4 rounded-2xl border border-border bg-surface p-5';
---

<BaseLayout title="QR Codes">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="flex items-center justify-between gap-4">
      <h1 class="font-display text-3xl font-extrabold text-ink">QR Codes</h1>
      <a href="/admin" class="text-sm font-semibold text-accent hover:underline">&larr; Admin Tools</a>
    </div>
    <p class="mt-2 text-sm text-muted">The door sign: check in for class, then pay on Venmo. Each code has a simple version for phones that struggle with the branded one.</p>

    <p id="loading" class="mt-8 text-sm text-muted">Loading&hellip;</p>
    <div id="signed-out" class="mt-8 hidden flex-col items-start gap-3">
      <p class="text-sm text-muted">Sign in as an admin to view this page.</p>
      <a href="/admin" class="text-sm font-semibold text-accent hover:underline">Go to Admin Tools</a>
    </div>
    <div id="admin-unavailable" class="mt-8 hidden flex-col items-start gap-3">
      <p class="text-sm text-muted">We couldn't check your sign-in just now. Check your connection, then reload the page.</p>
    </div>
    <div id="not-admin" class="mt-8 hidden flex-col items-start gap-3">
      <p class="text-sm text-muted">This account isn't authorized as an admin.</p>
    </div>

    <div id="qr-admin" class="mt-8 hidden flex-col gap-6">
      <div class="flex gap-1 overflow-x-auto border-b border-border" role="tablist">
        <button type="button" role="tab" id="tab-sign" aria-selected="true" class={tab}>Door sign</button>
        <button type="button" role="tab" id="tab-venmo" aria-selected="false" class={tab}>Venmo accounts</button>
        <button type="button" role="tab" id="tab-setup" aria-selected="false" class={tab}>Setup</button>
      </div>

      <div id="panel-sign" class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:items-start">
        <div class="flex min-w-0 flex-col gap-6">
          <section class={card}>
            <h2 class="font-display text-lg font-bold text-ink">1. Check in to</h2>
            <p id="selection-summary" class="min-h-4 text-xs font-semibold text-accent"></p>
            <p id="no-classes" class="hidden rounded-xl border border-border bg-bg px-3 py-2.5 text-sm text-muted">No classes are scheduled for today or later.</p>
            <div id="class-list" class="flex max-h-[28rem] flex-col gap-2 overflow-y-auto"></div>
            <label class="flex items-start gap-3 rounded-xl border border-border bg-bg px-4 py-3 has-[:disabled]:opacity-50">
              <input id="register-too" type="checkbox" disabled class="mt-0.5 h-4 w-4 shrink-0 accent-accent" />
              <span class="flex flex-col gap-0.5">
                <span class="text-sm font-semibold text-ink">Also register attendees as drop-ins</span>
                <span id="register-too-hint" class="text-xs text-muted"></span>
              </span>
            </label>
          </section>

          <section class={card}>
            <h2 class="font-display text-lg font-bold text-ink">2. Pay on Venmo</h2>
            <div id="venmo-choices" class="flex flex-col gap-2" role="radiogroup" aria-label="Venmo account on the sign"></div>
            <div id="venmo-other" class="hidden flex-col gap-3">
              <label class="flex flex-col gap-1">
                <span class="text-sm font-medium text-ink/80">Their Venmo username</span>
                <span class="flex gap-2">
                  <input id="venmo-username" type="text" maxlength="31" placeholder="@username" autocomplete="off" class:list={[field, 'min-w-0 flex-1']} />
                  <button id="venmo-find" type="button" class={pill}>Find</button>
                </span>
              </label>
              <div id="venmo-found" class="hidden"></div>
              <p id="venmo-status" class="min-h-4 text-xs text-muted" role="status"></p>
            </div>
          </section>

          <section class={card}>
            <h2 class="font-display text-lg font-bold text-ink">3. The sign</h2>
            <label class="flex flex-col gap-1">
              <span class="text-sm font-medium text-ink/80">Heading</span>
              <input id="sign-heading" type="text" maxlength="60" value="Welcome to class!" class={field} />
            </label>
            <label class="flex items-center gap-2 text-sm text-ink/80">
              <input id="sign-classes" type="checkbox" checked class="accent-accent" />
              Show the class names under the check-in code
            </label>
            <button id="sign-point" type="button" disabled class={cta}>Point check-in here</button>
            <p id="sign-status" class="min-h-4 text-xs text-muted" role="status"></p>
          </section>
        </div>

        <section class:list={[card, 'min-w-0 lg:sticky lg:top-24']}>
          <h2 class="font-display text-lg font-bold text-ink">Preview</h2>
          <div id="sign-preview" class="sign-frame"></div>
          <div class="flex flex-wrap gap-2">
            <button id="show-full" type="button" class={pill}>Show full screen</button>
            <button id="download-sign" type="button" class={pill}>Download sign (PNG)</button>
            <button id="copy-link" type="button" class={pill}>Copy check-in link</button>
          </div>
          <p id="opens" class="text-xs text-muted"></p>
        </section>
      </div>

      <div id="panel-venmo" class="hidden flex-col gap-6">
        <section class={card}>
          <h2 class="font-display text-lg font-bold text-ink">Venmo accounts</h2>
          <p class="text-sm text-muted">The sign can show any of these. The default is picked when the page opens.</p>
          <ul id="venmo-list" class="flex flex-col divide-y divide-border"></ul>
          <p id="venmo-list-status" class="min-h-4 text-xs text-muted" role="status"></p>
        </section>
      </div>

      <div id="panel-setup" class="hidden flex-col gap-6">
        <section class={card}>
          <h2 class="font-display text-lg font-bold text-ink">Branded check-in code</h2>
          <p id="setup-connection" class="text-sm text-muted"></p>
          <ol class="flex flex-col gap-3">
            <li class="flex flex-col gap-2 rounded-xl border border-border bg-bg p-4">
              <span class="text-sm font-bold text-ink">Step 1 · Create the check-in short link</span>
              <span id="setup-link" class="text-sm text-muted"></span>
              <button id="setup-create" type="button" class={pill + ' self-start'}>Create the link</button>
            </li>
            <li class="flex flex-col gap-2 rounded-xl border border-border bg-bg p-4">
              <span class="text-sm font-bold text-ink">Step 2 · Make its branded code</span>
              <span class="text-sm text-muted">Opens the generator with the link filled in. Pick a design and Save it with author "Dance With B", then come back and press Check again.</span>
              <span class="flex flex-wrap gap-2">
                <a id="setup-generator" target="_blank" rel="noopener" class={pill}>Open the generator</a>
                <button id="setup-refresh" type="button" class={pill}>Check again</button>
              </span>
            </li>
          </ol>
          <label class="flex flex-col gap-1">
            <span class="text-sm font-medium text-ink/80">Branded code on the sign</span>
            <select id="setup-code" class={field}></select>
          </label>
          <p id="setup-status" class="min-h-4 text-xs text-muted" role="status"></p>
        </section>
      </div>
    </div>
  </div>

  <div id="full" class="fixed inset-0 z-[100] hidden flex-col bg-[#fffdfb] text-[#1c1114]">
    <div class="flex items-center justify-between gap-3 px-4 pt-[max(12px,env(safe-area-inset-top))] pb-2">
      <div id="full-switch" class="flex gap-1 rounded-full border border-[#e3d3d7] p-1 text-sm font-bold"></div>
      <button id="full-close" type="button" class="rounded-full border border-[#e3d3d7] px-4 py-1.5 text-sm font-bold">Close</button>
    </div>
    <div id="full-sign" class="sign-frame full flex-1"></div>
  </div>
</BaseLayout>

<style is:global>
  .sign-frame { background: #fffdfb; color: #1c1114; border-radius: 12px; container-type: inline-size; }
  .sign-frame:not(.full) { aspect-ratio: 16 / 9; box-shadow: 0 6px 24px rgb(0 0 0 / 0.25); }
  .sign { display: grid; height: 100%; grid-template-rows: auto 1fr; align-content: start; padding: 3cqw 2cqw; gap: 2.5cqw; }
  .sign h3 { margin: 0; text-align: center; font: 800 4.2cqw/1.1 var(--font-display); }
  .sign-halves { display: grid; grid-auto-columns: minmax(0, 1fr); grid-auto-flow: column; min-height: 0; }
  .sign-half { display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 1cqw; text-align: center; min-width: 0; min-height: 0; padding: 0 2cqw; }
  .sign-half + .sign-half { border-left: 2px dashed #ecdfe2; }
  .sign-step { font: 700 1.3cqw/1 Inter, system-ui, sans-serif; letter-spacing: 0.16em; text-transform: uppercase; color: #b3264c; }
  .sign-title { font: 800 2.9cqw/1.1 var(--font-display); }
  .sign-title .venmo { color: #008cff; }
  .sign-code { width: min(30cqw, 100%); aspect-ratio: 1; background: #fff; border: 0; padding: 0; cursor: default; }
  .sign-code img, .sign-code canvas { width: 100%; height: 100%; display: block; image-rendering: pixelated; }
  .sign-code img { image-rendering: auto; }
  .sign-note { font: 500 1.4cqw/1.3 Inter, system-ui, sans-serif; color: #6b5a5e; overflow-wrap: anywhere; }
  .sign-swap { font: 600 1.15cqw/1 Inter, system-ui, sans-serif; color: #6b5a5e; border: 1px solid #dccbd0; border-radius: 999px; padding: 0.5cqw 1cqw; background: none; cursor: pointer; }
  .sign-empty { font: 500 1.5cqw/1.4 Inter, system-ui, sans-serif; color: #6b5a5e; width: min(30cqw, 100%); aspect-ratio: 1; display: grid; place-items: center; border: 2px dashed #e3d3d7; border-radius: 1cqw; padding: 2cqw; }
  .sign-frame.full .sign { padding: 2vh 3vw; }
  .sign-frame.full .sign-code, .sign-frame.full .sign-empty { width: min(36cqw, 62vh); }
  /* A phone held up: one code at a time, big. */
  @container (max-width: 640px) {
    .sign-frame.full .sign h3 { font-size: 7cqw; }
    .sign-frame.full .sign-halves { grid-auto-flow: row; }
    .sign-frame.full .sign-half { gap: 3cqw; }
    .sign-frame.full .sign-half[data-hidden='true'] { display: none; }
    .sign-frame.full .sign-half + .sign-half { border-left: 0; }
    .sign-frame.full .sign-step { font-size: 3.4cqw; }
    .sign-frame.full .sign-title { font-size: 7.5cqw; }
    .sign-frame.full .sign-code, .sign-frame.full .sign-empty { width: min(86cqw, 60vh); }
    .sign-frame.full .sign-note { font-size: 3.8cqw; }
    .sign-frame.full .sign-swap { font-size: 3.4cqw; padding: 2cqw 3cqw; }
  }
</style>

<script>
  import { checkAdminSession } from '../../lib/adminSession';
  import { createClassPicker, type ClassPicker } from '../../lib/classPicker';
  import { codeCanvas, downloadBlob, loadImage, signPng } from '../../lib/qrSign';
  import type { ClassSeriesEntry } from '../../lib/classSeries';
  import { siteFormatter } from '../../lib/siteTime';
  import { supabaseBrowser } from '../../lib/supabaseBrowser';

  const whenFormatter = siteFormatter({ month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
  const dayFormatter = siteFormatter({ month: 'short', day: 'numeric', year: 'numeric' });

  interface Account { username: string; name: string; userId: string; picture: string | null; label: string; codeUrl: string; profileUrl: string }
  interface Checkin {
    code: string; short: string; designId: number | null; pointedLabel: string | null; pointedAt: string | null; opens?: string | null;
    pointedEventIds?: string[]; pointedTitles?: string[];
    hits?: number; missing?: boolean; error?: string; codes: { id: number; name: string; created_at: number }[]; generatorUrl: string;
  }
  interface Studio { saved: boolean; connected: boolean; venmo: Account[]; defaultVenmo: string | null; checkin: Checkin | null }

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const panels = { loading: $('loading'), signedOut: $('signed-out'), notAdmin: $('not-admin'), unavailable: $('admin-unavailable'), admin: $('qr-admin') };
  function showPanel(name: keyof typeof panels) {
    for (const [key, el] of Object.entries(panels)) {
      el.classList.toggle('hidden', key !== name);
      el.classList.toggle('flex', key === name);
    }
  }
  const toggleShown = (el: HTMLElement, show: boolean, display = 'flex') => {
    el.classList.toggle('hidden', !show);
    el.classList.toggle(display, show);
  };
  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text?: string) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  let studio: Studio;
  let picker: ClassPicker;
  let venmoLogo: HTMLImageElement | null = null;
  let branded: { id: number; img: HTMLImageElement } | null = null;
  // The Venmo account on the sign: a saved one, someone just found, or none.
  let venmoChoice: Account | null = null;
  let found: Account | null = null;
  // Plain check-in address made without a short link (before setup).
  let directUrl: string | null = null;
  // Which code the full-screen view shows at phone width, and whether the check-in code is the simple one.
  let fullShows: 'checkin' | 'venmo' = 'checkin';
  let simple = false;

  // Asked for each call, so a sign left open for hours keeps a fresh token (getSession refreshes it).
  async function auth(): Promise<Record<string, string>> {
    const {
      data: { session },
    } = await supabaseBrowser.auth.getSession();
    return { Authorization: `Bearer ${session?.access_token ?? ''}` };
  }

  async function api(method: 'GET' | 'POST', body?: unknown, query = ''): Promise<any> {
    const res = await fetch(`/api/admin/qr-studio${query}`, {
      method,
      headers: { ...(await auth()), ...(body ? { 'Content-Type': 'application/json' } : {}) },
      body: body ? JSON.stringify(body) : undefined,
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw Object.assign(new Error(data.error ?? 'Something went wrong.'), { status: res.status, data });
    return data;
  }

  // ---- Tabs ----
  const tabs = { sign: $('tab-sign'), venmo: $('tab-venmo'), setup: $('tab-setup') };
  function showTab(name: keyof typeof tabs) {
    for (const [key, t] of Object.entries(tabs)) t.setAttribute('aria-selected', String(key === name));
    $('panel-sign').classList.toggle('hidden', name !== 'sign');
    $('panel-sign').classList.toggle('grid', name === 'sign');
    toggleShown($('panel-venmo'), name === 'venmo');
    toggleShown($('panel-setup'), name === 'setup');
  }
  for (const [key, t] of Object.entries(tabs)) t.addEventListener('click', () => showTab(key as keyof typeof tabs));

  // ---- What the sign shows ----
  const linkReady = () => Boolean(studio.checkin && !studio.checkin.missing && !studio.checkin.error);
  const checkinText = () => (linkReady() ? studio.checkin!.short : directUrl);
  const sameIds = (a: string[], b: string[]) => a.length === b.length && [...a].sort().join() === [...b].sort().join();
  // The classes the check-in code opens: the short link's last pointing, not
  // whatever is picked now (the plain code is remade on every pick).
  const signNames = () => (linkReady() ? (studio.checkin!.pointedTitles ?? []) : picker.titles());
  const pickNotPointed = () => linkReady() && picker.eventIds().length > 0 && !sameIds(picker.eventIds(), studio.checkin!.pointedEventIds ?? []);

  // Drawing a code is the slow part; each one is drawn once and copied.
  const drawn = new Map<string, HTMLCanvasElement>();
  function code(text: string, logo: HTMLImageElement | null = null) {
    const key = `${logo ? 'logo:' : ''}${text}`;
    let source = drawn.get(key);
    if (!source) {
      if (drawn.size > 20) drawn.clear();
      source = codeCanvas(text, 600, logo);
      drawn.set(key, source);
    }
    const copy = document.createElement('canvas');
    copy.width = copy.height = source.width;
    copy.getContext('2d')!.drawImage(source, 0, 0);
    return copy;
  }

  function renderSign(frame: HTMLElement, full: boolean) {
    const sign = el('div', 'sign');
    const heading = ($('sign-heading') as HTMLInputElement).value.trim();
    sign.append(el('h3', '', heading));
    const halves = el('div', 'sign-halves');
    const two = Boolean(venmoChoice);

    const checkin = el('div', 'sign-half');
    checkin.dataset.hidden = String(full && fullShows !== 'checkin');
    checkin.append(el('span', 'sign-step', two ? 'Step 1' : 'Check in'), el('span', 'sign-title', 'Check in for class'));
    const text = checkinText();
    if (!text) {
      checkin.append(el('div', 'sign-empty', linkReady() ? '' : 'Pick classes, then press Make the check-in code.'));
    } else {
      const holder = el('button', 'sign-code') as HTMLButtonElement;
      holder.type = 'button';
      const useBranded = branded && linkReady() && !simple;
      if (useBranded) {
        const img = branded!.img.cloneNode() as HTMLImageElement;
        img.alt = 'Branded check-in QR code';
        holder.append(img);
      } else holder.append(Object.assign(code(text), { ariaLabel: 'Check-in QR code' }));
      holder.setAttribute('aria-label', useBranded ? 'Branded check-in QR code' : 'Simple check-in QR code');
      checkin.append(holder);
      const names = ($('sign-classes') as HTMLInputElement).checked ? signNames().join(' · ') : '';
      if (names) checkin.append(el('span', 'sign-note', names));
      if (branded && linkReady()) {
        const swap = el('button', 'sign-swap', simple ? 'Back to the branded code' : 'Hard to scan? Tap for a simpler code') as HTMLButtonElement;
        swap.type = 'button';
        swap.addEventListener('click', () => {
          simple = !simple;
          redraw();
        });
        checkin.append(swap);
      }
    }
    halves.append(checkin);

    if (venmoChoice) {
      const pay = el('div', 'sign-half');
      pay.dataset.hidden = String(full && fullShows !== 'venmo');
      const title = el('span', 'sign-title', 'Pay on ');
      title.append(el('span', 'venmo', 'Venmo'));
      pay.append(el('span', 'sign-step', 'Step 2'), title);
      const holder = el('div', 'sign-code');
      holder.append(code(venmoChoice.codeUrl, venmoLogo));
      holder.setAttribute('aria-label', `Venmo QR code for @${venmoChoice.username}`);
      pay.append(holder, el('span', 'sign-note', `@${venmoChoice.username}${venmoChoice.label ? ` · ${venmoChoice.label}` : ''}`));
      halves.append(pay);
    }
    sign.append(halves);
    frame.replaceChildren(sign);
  }

  function redraw() {
    renderSign($('sign-preview'), false);
    if (!$('full').classList.contains('hidden')) {
      renderSign($('full-sign'), true);
      renderFullSwitch();
    }
    const c = studio.checkin;
    $('opens').textContent = linkReady()
      ? `The check-in code is ${c!.short}. It opens: ${c!.pointedLabel ?? 'the check-in page'}${c!.pointedAt ? ` (pointed ${whenFormatter.format(new Date(c!.pointedAt))})` : ''}.` +
        (pickNotPointed() ? ' The classes picked aren’t the ones it opens yet: press Point check-in here.' : '')
      : directUrl
        ? `Plain check-in code for this pick. Set up the branded code on the Setup tab to keep one code for every class.`
        : '';
    const point = $<HTMLButtonElement>('sign-point');
    point.textContent = linkReady() ? 'Point check-in here' : 'Make the check-in code';
    point.disabled = picker.eventIds().length === 0;
    $<HTMLButtonElement>('copy-link').disabled = !checkinText();
  }

  // ---- Venmo on the sign ----
  function renderVenmoChoices() {
    const box = $('venmo-choices');
    const current = venmoChoice?.username ?? (found ? '' : 'none');
    const option = (value: string, label: string, sub: string) => {
      const row = el('label', 'flex cursor-pointer items-center gap-3 rounded-xl border border-border bg-bg px-3 py-2.5 text-sm has-[:checked]:border-accent');
      const input = el('input', 'accent-accent') as HTMLInputElement;
      input.type = 'radio';
      input.name = 'venmo-choice';
      input.value = value;
      input.checked = value === 'other' ? Boolean(found) && venmoChoice === found : value === current;
      const text = el('span', 'flex min-w-0 flex-col');
      text.append(el('span', 'font-semibold text-ink', label));
      if (sub) text.append(el('span', 'text-xs text-muted', sub));
      row.append(input, text);
      input.addEventListener('change', () => {
        toggleShown($('venmo-other'), value === 'other');
        if (value === 'other') {
          venmoChoice = found;
          $('venmo-username').focus();
        } else venmoChoice = studio.venmo.find((a) => a.username === value) ?? null;
        redraw();
      });
      return row;
    };
    box.replaceChildren(
      ...studio.venmo.map((a) => option(a.username, a.label || a.name, `@${a.username}`)),
      option('other', 'Someone else', 'An artist you’re working with'),
      option('none', 'No Venmo code on this sign', '')
    );
  }

  function foundCard(account: Account) {
    const box = el('div', 'flex flex-col gap-3 rounded-xl border border-green-700/60 bg-green-900/20 p-3');
    const who = el('div', 'flex items-center gap-3');
    if (account.picture) {
      const img = el('img', 'h-11 w-11 shrink-0 rounded-full object-cover') as HTMLImageElement;
      img.src = account.picture;
      img.alt = '';
      img.referrerPolicy = 'no-referrer';
      who.append(img);
    }
    const text = el('div', 'min-w-0');
    text.append(el('p', 'font-semibold text-ink', account.name), el('p', 'text-xs text-muted', `@${account.username} on Venmo. Is this them?`));
    who.append(text);
    const label = el('input', 'rounded-xl border border-border bg-bg px-3 py-2 text-sm text-ink') as HTMLInputElement;
    label.id = 'venmo-label';
    label.placeholder = 'Name on the sign (optional), e.g. their stage name';
    label.maxLength = 60;
    label.addEventListener('input', () => {
      account.label = label.value.trim();
      redraw();
    });
    const save = el('button', 'self-start rounded-full border border-accent px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-accent hover:bg-accent hover:text-white', 'Remember them') as HTMLButtonElement;
    save.type = 'button';
    save.id = 'venmo-remember';
    save.addEventListener('click', async () => {
      save.disabled = true;
      try {
        studio = { ...studio, ...(await api('POST', { action: 'venmo-save', username: account.username, label: account.label })) };
        found = null;
        venmoChoice = studio.venmo.find((a) => a.username === account.username) ?? null;
        renderVenmoChoices();
        renderVenmoList();
        toggleShown($('venmo-other'), false);
        $('venmo-found').classList.add('hidden');
        $('venmo-status').textContent = '';
        redraw();
      } catch (err) {
        $('venmo-status').textContent = (err as Error).message;
        save.disabled = false;
      }
    });
    box.append(who, label, save);
    return box;
  }

  async function findVenmo() {
    const status = $('venmo-status');
    const username = $<HTMLInputElement>('venmo-username').value;
    status.textContent = 'Looking them up on Venmo…';
    $('venmo-found').classList.add('hidden');
    try {
      const { account } = await api('POST', { action: 'venmo-find', username });
      found = account as Account;
      venmoChoice = found;
      $('venmo-found').replaceChildren(foundCard(found));
      $('venmo-found').classList.remove('hidden');
      status.textContent = '';
    } catch (err) {
      found = null;
      venmoChoice = null;
      status.textContent = (err as Error).message;
    }
    redraw();
  }
  $('venmo-find').addEventListener('click', findVenmo);
  $('venmo-username').addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      findVenmo();
    }
  });

  // ---- Venmo accounts tab ----
  function renderVenmoList() {
    const list = $('venmo-list');
    list.replaceChildren(
      ...studio.venmo.map((a) => {
        const li = el('li', 'venmo-account flex flex-wrap items-center justify-between gap-3 py-3');
        const text = el('div', 'min-w-0');
        text.append(el('p', 'font-semibold text-ink', `${a.label || a.name}${a.username === studio.defaultVenmo ? ' · default' : ''}`), el('p', 'text-xs text-muted', `@${a.username} · ${a.name} on Venmo`));
        const buttons = el('div', 'flex flex-wrap gap-2');
        const act = (label: string, action: string) => {
          const b = el('button', 'rounded-full border border-accent px-3 py-1 text-xs font-bold uppercase tracking-wider text-accent hover:bg-accent hover:text-white', label) as HTMLButtonElement;
          b.type = 'button';
          b.addEventListener('click', async () => {
            try {
              studio = { ...studio, ...(await api('POST', { action, username: a.username })) };
              if (action === 'venmo-remove' && venmoChoice?.username === a.username) venmoChoice = null;
              renderVenmoList();
              renderVenmoChoices();
              redraw();
              $('venmo-list-status').textContent = '';
            } catch (err) {
              $('venmo-list-status').textContent = (err as Error).message;
            }
          });
          buttons.append(b);
        };
        if (a.username !== studio.defaultVenmo) act('Make default', 'venmo-default');
        act('Remove', 'venmo-remove');
        li.append(text, buttons);
        return li;
      })
    );
    if (!studio.saved) $('venmo-list-status').textContent = 'Run migration 0068 in Supabase so the site can remember accounts.';
  }

  // ---- Setup tab ----
  // `fresh` loads it again even when it's the same code (it may have been re-saved).
  async function loadBranded(fresh = false) {
    const c = studio.checkin;
    const id = c && linkReady() ? c.designId : null;
    if (!id) {
      branded = null;
      return;
    }
    if (branded?.id === id && !fresh) return;
    try {
      const res = await fetch(`/api/admin/qr-studio?svg=${id}${fresh ? '&fresh=1' : ''}`, { headers: await auth(), cache: fresh ? 'no-store' : 'default' });
      if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error ?? "Couldn't load the branded code.");
      // A data: address, not a blob: one, so nothing is left to free and it never runs as this site's page.
      const url = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(await res.text())}`;
      branded = { id, img: await loadImage(url) };
    } catch (err) {
      branded = null;
      $('setup-status').textContent = (err as Error).message;
    }
  }

  function renderSetup() {
    const c = studio.checkin;
    $('setup-connection').textContent = !studio.connected
      ? 'Not connected: add QR_API_TOKEN (the "Dance With B" author token) to the site’s environment in Netlify.'
      : !studio.saved
        ? 'Connected. Run migration 0068 in Supabase so the site can remember its link.'
        : 'Connected to qr.dancewithb.fun as Dance With B.';
    const link = $('setup-link');
    if (!c) link.textContent = 'Not created yet.';
    else if (c.error) link.textContent = `${c.short} · ${c.error}`;
    else if (c.missing) link.textContent = `${c.short} was deleted on the QR site. Create a new one.`;
    else link.textContent = `${c.short} · ${c.hits ?? 0} scan${c.hits === 1 ? '' : 's'} so far`;
    $<HTMLButtonElement>('setup-create').disabled = !studio.connected || !studio.saved || linkReady();
    const generator = $<HTMLAnchorElement>('setup-generator');
    generator.classList.toggle('pointer-events-none', !c);
    generator.classList.toggle('opacity-50', !c);
    if (c) generator.href = c.generatorUrl;
    const select = $<HTMLSelectElement>('setup-code');
    const codes = c?.codes ?? [];
    select.replaceChildren(
      ...(codes.length ? codes.map((x) => new Option(`${x.name} (saved ${dayFormatter.format(new Date(x.created_at * 1000))})`, String(x.id))) : [new Option('None saved for this link yet', '')])
    );
    select.disabled = codes.length === 0;
    if (c?.designId) select.value = String(c.designId);
  }

  async function refreshStudio(next?: Studio, fresh = false) {
    studio = next ?? (await api('GET', undefined, fresh ? '?fresh=1' : ''));
    await loadBranded(fresh);
    renderSetup();
    renderVenmoList();
    redraw();
  }

  $('setup-create').addEventListener('click', async () => {
    $('setup-status').textContent = 'Creating…';
    try {
      await refreshStudio(await api('POST', { action: 'create-link' }));
      $('setup-status').textContent = 'Created. Now make its branded code.';
    } catch (err) {
      $('setup-status').textContent = (err as Error).message;
    }
  });
  $('setup-refresh').addEventListener('click', async () => {
    $('setup-status').textContent = 'Checking…';
    try {
      await refreshStudio(undefined, true);
      $('setup-status').textContent = studio.checkin?.codes.length ? 'Found it. The sign uses it now.' : 'No branded code saved for this link yet.';
    } catch (err) {
      $('setup-status').textContent = (err as Error).message;
    }
  });
  $('setup-code').addEventListener('change', async (e) => {
    try {
      await refreshStudio(await api('POST', { action: 'choose-code', id: Number((e.target as HTMLSelectElement).value) }));
      $('setup-status').textContent = 'The sign uses this code now.';
    } catch (err) {
      $('setup-status').textContent = (err as Error).message;
    }
  });

  // ---- Pointing ----
  async function point(confirm = false) {
    const status = $('sign-status');
    const button = $<HTMLButtonElement>('sign-point');
    button.disabled = true;
    status.textContent = linkReady() ? 'Pointing…' : 'Making…';
    try {
      // Without a working short link (none yet, deleted, or the QR site down), a plain code.
      const result = await api('POST', { action: 'point', eventIds: picker.eventIds(), createRegistration: $<HTMLInputElement>('register-too').checked, confirm, direct: !linkReady() });
      if (result.pointed) {
        await refreshStudio();
        status.textContent = `✓ ${result.short} now opens check-in for ${result.title}.`;
      } else {
        directUrl = result.url;
        status.textContent = `✓ Check-in code for ${result.title}.`;
      }
    } catch (err) {
      const e = err as Error & { status?: number; data?: { pointedLabel?: string; pointedAt?: string } };
      if (e.status === 409 && e.data?.pointedLabel !== undefined) {
        status.replaceChildren(document.createTextNode(`It was pointed at ${e.data.pointedLabel} at ${whenFormatter.format(new Date(e.data.pointedAt!))}. Anyone scanning a printed copy will get the new classes. `));
        const yes = el('button', 'font-semibold text-accent hover:underline', 'Point it here anyway') as HTMLButtonElement;
        yes.type = 'button';
        yes.id = 'point-anyway';
        yes.addEventListener('click', () => point(true));
        status.append(yes);
      } else status.textContent = e.message;
    } finally {
      redraw();
    }
  }
  $('sign-point').addEventListener('click', () => point());
  // Typing and resizing redraw at most once a frame.
  let redrawQueued = false;
  function redrawSoon() {
    if (redrawQueued) return;
    redrawQueued = true;
    requestAnimationFrame(() => {
      redrawQueued = false;
      redraw();
    });
  }
  $('sign-heading').addEventListener('input', redrawSoon);
  $('sign-classes').addEventListener('change', redraw);

  // ---- Showing and saving ----
  function renderFullSwitch() {
    const box = $('full-switch');
    const narrow = $('full-sign').clientWidth <= 640;
    box.classList.toggle('invisible', !narrow || !venmoChoice);
    box.replaceChildren(
      ...(['checkin', 'venmo'] as const).map((which) => {
        const b = el('button', `rounded-full px-4 py-1.5 ${fullShows === which ? 'bg-[#1c1114] text-white' : ''}`, which === 'checkin' ? 'Check in' : 'Pay') as HTMLButtonElement;
        b.type = 'button';
        b.addEventListener('click', () => {
          fullShows = which;
          redraw();
        });
        return b;
      })
    );
  }
  type WakeLock = EventTarget & { release(): Promise<void> };
  let wakeLock: WakeLock | null = null;
  const fullOpen = () => !$('full').classList.contains('hidden');
  // Keeps the screen on. The browser drops the lock whenever the tab is hidden,
  // so it's asked for again when the sign comes back.
  async function keepAwake() {
    if (wakeLock || !fullOpen()) return;
    try {
      const lock = (await (navigator as Navigator & { wakeLock?: { request(t: 'screen'): Promise<WakeLock> } }).wakeLock?.request('screen')) ?? null;
      if (!lock) return;
      if (!fullOpen()) {
        lock.release().catch(() => {});
        return;
      }
      wakeLock = lock;
      lock.addEventListener('release', () => {
        if (wakeLock === lock) wakeLock = null;
      });
    } catch {
      /* the screen may dim */
    }
  }
  $('show-full').addEventListener('click', async () => {
    toggleShown($('full'), true);
    fullShows = 'checkin';
    redraw();
    try {
      await document.documentElement.requestFullscreen?.();
    } catch {
      /* the overlay alone is fine */
    }
    await keepAwake();
  });
  function closeFull() {
    toggleShown($('full'), false);
    if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
    wakeLock?.release().catch(() => {});
    wakeLock = null;
  }
  $('full-close').addEventListener('click', closeFull);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && fullOpen()) closeFull();
  });
  // In real full screen the browser takes Escape itself; leaving full screen closes the sign too.
  document.addEventListener('fullscreenchange', () => {
    if (!document.fullscreenElement && fullOpen()) closeFull();
  });
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') keepAwake();
  });
  addEventListener('resize', () => {
    if (fullOpen()) redrawSoon();
  });

  $('download-sign').addEventListener('click', async () => {
    const text = checkinText();
    try {
      const blob = await signPng({
        heading: $<HTMLInputElement>('sign-heading').value.trim(),
        checkin: text ? { branded: linkReady() ? (branded?.img ?? null) : null, text, classes: $<HTMLInputElement>('sign-classes').checked ? signNames().join(' · ') : '' } : null,
        venmo: venmoChoice ? { text: venmoChoice.codeUrl, label: venmoChoice.label, username: venmoChoice.username, logo: venmoLogo } : null,
      });
      downloadBlob(blob, 'door-sign.png');
    } catch (err) {
      $('sign-status').textContent = (err as Error).message;
    }
  });
  $('copy-link').addEventListener('click', async () => {
    const text = checkinText();
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      $('sign-status').textContent = `Copied ${text}`;
    } catch {
      $('sign-status').textContent = text;
    }
  });

  async function init() {
    const gate = await checkAdminSession();
    if (gate.status !== 'admin') {
      showPanel(gate.status);
      return;
    }
    try {
      const [classesRes, state, logo] = await Promise.all([
        auth().then((headers) => fetch('/api/admin/checkin-classes', { headers })).then((r) => r.json()),
        api('GET'),
        loadImage('/venmo-logo.svg').catch(() => null),
      ]);
      studio = state;
      venmoLogo = logo;
      const classes = (classesRes.classSeries ?? []) as ClassSeriesEntry[];
      $('no-classes').classList.toggle('hidden', classes.length > 0);
      picker = createClassPicker($('class-list'), $('selection-summary'), $('register-too'), $('register-too-hint'), classes, () => {
        directUrl = null;
        redraw();
      });
      venmoChoice = studio.venmo.find((a) => a.username === studio.defaultVenmo) ?? studio.venmo[0] ?? null;
      renderVenmoChoices();
      await refreshStudio(studio);
      showPanel('admin');
    } catch (err) {
      showPanel('unavailable');
      console.error(err);
    }
  }
  init();
</script>
