---
import BaseLayout from '../layouts/BaseLayout.astro';
import IntakeForm from '../components/IntakeForm.astro';
---

<BaseLayout
  title="Contact — Private Lessons in Madison, WI"
  description="Book private bachata coaching or ask about class schedules in Madison, WI. Fill out the form and I'll be in touch soon."
>
  <IntakeForm
    registrationType="private"
    heading="Contact Me"
    subtext="Fill out the form below and I'll be in touch soon!"
    commentsLabel="Message"
    contactMethodPicker={true}
    requireAll={true}
    requireComments={true}
  />
</BaseLayout>
