---
// Rendered per request, so the header and footer follow the live settings
// (Site Visibility, the WhatsApp community link) instead of the last deploy's.
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { DEFAULT_LOCATION, placeLabel } from '../lib/siteLocation';
import IntakeForm from '../components/IntakeForm.astro';
import { cacheSharedPage } from '../lib/pageCache';

cacheSharedPage(Astro.response.headers);
const loc = Astro.locals.siteLocation ?? DEFAULT_LOCATION;
const place = placeLabel(loc);
---

<BaseLayout
  title={`Contact — Private Lessons in ${place}`}
  description={`Book private bachata coaching or ask about class schedules in ${place}. Fill out the form and I'll be in touch soon.`}
>
  <IntakeForm
    registrationType="private"
    heading="Contact Me"
    subtext="Fill out the form below and I'll be in touch soon!"
    commentsLabel="Message"
    contactMethodPicker={true}
    requireAll={true}
    requireComments={true}
  />
</BaseLayout>
