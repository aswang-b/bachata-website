---
// Rendered per request, so the header and footer follow the live settings
// (Site Visibility, the WhatsApp community link) instead of the last deploy's.
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { DEFAULT_LOCATION, placeLabel } from '../lib/siteLocation';
import IntakeForm from '../components/IntakeForm.astro';
import { cacheContactPage } from '../lib/pageCache';
import { findSpotClass, spotLine, spotPrefill } from '../lib/spotRequest';

// Opened from an "Ask about a spot" link (askAboutSpot.ts): the class is looked
// up from the id alone, and a page opened that way is never cached at the edge.
// An id that isn't a public, upcoming class gives the ordinary page.
const spotParam = Astro.url.searchParams.get('spot');
cacheContactPage(Astro.response.headers, spotParam !== null);
const spot = spotParam === null ? null : await findSpotClass(spotParam);
const loc = Astro.locals.siteLocation ?? DEFAULT_LOCATION;
const place = placeLabel(loc);
---

<BaseLayout
  title={`Contact — Private Lessons in ${place}`}
  description={`Book private bachata coaching or ask about class schedules in ${place}. Fill out the form and I'll be in touch soon.`}
>
  <IntakeForm
    registrationType="private"
    heading="Contact Me"
    subtext="Fill out the form below and I'll be in touch soon!"
    commentsLabel="Message"
    contactMethodPicker={true}
    requireAll={true}
    requireComments={true}
    spotId={spot ? (spotParam ?? undefined) : undefined}
    spotLine={spot ? spotLine(spot) : undefined}
    commentsPrefill={spot ? spotPrefill(spot) : undefined}
  />
</BaseLayout>
