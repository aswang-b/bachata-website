---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { supabase } from '../lib/supabase';
import { buildClassSeriesList, chicagoDayBoundsUtcIso } from '../lib/classSeries';
import { getSiteSettings } from '../lib/siteSettings';

const { disable_checkin_page: checkinDisabled } = await getSiteSettings();

const seriesList = checkinDisabled
  ? []
  : await (async () => {
      const { startIso } = chicagoDayBoundsUtcIso();
      const { data: classEvents, error } = await supabase
        .from('events')
        .select('id, title, start_time, end_time, google_recurring_event_id')
        .eq('visibility', 'public')
        .eq('event_type', 'class')
        .gte('start_time', startIso)
        .order('start_time', { ascending: true });

      if (error) console.error('Failed to load classes for check-in:', error);
      return buildClassSeriesList(classEvents ?? []);
    })();

const inputClass =
  'rounded-xl border border-border bg-surface px-3 py-2.5 text-ink placeholder:text-muted/60 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20';
---

<BaseLayout
  title="Class Check-In"
  description="Check in for your bachata class at Dance Life Studio, Madison, WI."
>
  <div class="mx-auto max-w-xl px-6 py-16">
    <h1 class="font-display text-3xl font-bold text-ink">Check In for Class</h1>

    {checkinDisabled ? (
      <p class="mt-4 rounded-xl border border-border bg-surface px-4 py-3 text-sm text-muted">
        Check-in isn't available online right now — please check in with an instructor at class.
      </p>
    ) : (
      <>
        <p class="mt-2 text-sm text-muted">
          Already registered? Check in here when you arrive for class. Select any classes you're checking in for
          &mdash; you can pick more than one.
        </p>

        <form method="POST" action="/api/submit-checkin" class="mt-8 flex flex-col gap-5">
          <div id="series-keys-container"></div>

          <div class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-ink/80">Classes<span class="text-accent"> *</span></span>

            {seriesList.length === 0 ? (
              <p class="rounded-xl border border-border bg-surface px-3 py-2.5 text-sm text-muted">
                No classes are scheduled for today or later.
              </p>
            ) : (
              <div id="class-list" class="flex flex-col gap-2">
                {seriesList.map((s) => (
                  <button
                    type="button"
                    class="class-item flex w-full flex-col items-start gap-0.5 rounded-xl border border-border bg-surface px-4 py-3 text-left transition-colors hover:bg-bg aria-pressed:border-accent aria-pressed:bg-bg"
                    aria-pressed="false"
                    data-key={s.key}
                  >
                    <span class="font-semibold text-ink">{s.title}</span>
                    <span class="text-xs text-muted">{s.subLabel}</span>
                  </button>
                ))}
              </div>
            )}

            <p id="class-error" class="hidden text-xs font-semibold text-red-600">
              Please select at least one class.
            </p>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <label class="flex flex-col gap-1.5">
              <span class="text-sm font-medium text-ink/80">First Name<span class="text-accent"> *</span></span>
              <input type="text" name="first_name" required class={inputClass} />
            </label>

            <label class="flex flex-col gap-1.5">
              <span class="text-sm font-medium text-ink/80">Last Name<span class="text-accent"> *</span></span>
              <input type="text" name="last_name" required class={inputClass} />
            </label>
          </div>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-ink/80">Phone<span class="text-accent"> *</span></span>
            <input type="tel" name="phone" required class={inputClass} />
          </label>

          <button
            type="submit"
            class="gradient-accent mt-2 rounded-full px-6 py-3 text-sm font-bold uppercase tracking-wider text-white transition-opacity hover:opacity-90"
          >
            Check In
          </button>
        </form>
      </>
    )}
  </div>
</BaseLayout>

<script>
  const seriesKeysContainer = document.getElementById('series-keys-container');
  const classError = document.getElementById('class-error');
  const selectedKeys = new Set<string>();

  function syncHiddenInputs() {
    if (!seriesKeysContainer) return;
    seriesKeysContainer.innerHTML = '';
    for (const key of selectedKeys) {
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'series_keys';
      input.value = key;
      seriesKeysContainer.appendChild(input);
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.class-item').forEach((item) => {
    const key = item.dataset.key ?? '';

    item.addEventListener('click', () => {
      const nowSelected = item.getAttribute('aria-pressed') !== 'true';
      item.setAttribute('aria-pressed', String(nowSelected));
      if (nowSelected) {
        selectedKeys.add(key);
        classError?.classList.add('hidden');
      } else {
        selectedKeys.delete(key);
      }
      syncHiddenInputs();
    });
  });

  document.querySelector('form')?.addEventListener('submit', (e) => {
    if (selectedKeys.size === 0) {
      e.preventDefault();
      classError?.classList.remove('hidden');
      classError?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  });
</script>
