---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { supabase } from '../lib/supabase';
import { buildClassSeriesList, chicagoDayBoundsUtcIso } from '../lib/classSeries';
import { getSiteSettings } from '../lib/siteSettings';
import { TIME_ZONE } from '../lib/classSeries';
import { verifyCheckinRegisterToken } from '../lib/checkinToken';

const { disable_checkin_page: checkinDisabled } = await getSiteSettings();

// An admin-generated QR for several classes links here as
// `?events=<id>,<id>` (with `&register=<id>.<token>,…` when attendees should
// also be registered). Those exact events — public or private — are offered
// instead of today's public classes, so dancers pick which they're here for.
const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const eventsParam = Astro.url.searchParams.get('events');
const linkedIds = eventsParam
  ? [...new Set(eventsParam.split(',').map((s) => s.trim()).filter((id) => UUID_RE.test(id)))].slice(0, 12)
  : null;
const isLinked = linkedIds !== null;

const registerTokens = new Map<string, string>();
for (const pair of (Astro.url.searchParams.get('register') ?? '').split(',')) {
  const [id, token] = pair.split('.');
  if (id && token) registerTokens.set(id, token);
}

interface PickerItem {
  key: string;
  title: string;
  subLabel: string;
  // Set when checking in to this class also registers the dancer as a drop-in.
  registerPrice: number | null;
}

const dateFormatter = new Intl.DateTimeFormat('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: TIME_ZONE });
const timeFormatter = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone: TIME_ZONE });

async function loadLinkedItems(ids: string[]): Promise<PickerItem[]> {
  if (ids.length === 0) return [];
  const { data, error } = await supabase
    .from('events')
    .select('id, title, start_time, end_time, price_drop_in, registration_closed')
    .eq('event_type', 'class')
    .in('id', ids)
    .order('start_time', { ascending: true });
  if (error) console.error('Failed to load linked classes for check-in:', error);
  return (data ?? []).map((e) => ({
    key: e.id,
    title: e.title,
    subLabel: `${dateFormatter.format(new Date(e.start_time))}, ${timeFormatter.format(new Date(e.start_time))}–${timeFormatter.format(new Date(e.end_time))}`,
    registerPrice:
      e.price_drop_in != null && !e.registration_closed && verifyCheckinRegisterToken(e.id, registerTokens.get(e.id)) ? e.price_drop_in : null,
  }));
}

async function loadTodayItems(): Promise<PickerItem[]> {
  const { startIso } = chicagoDayBoundsUtcIso();
  const { data: classEvents, error } = await supabase
    .from('events')
    .select('id, title, start_time, end_time, google_recurring_event_id')
    .eq('visibility', 'public')
    .eq('event_type', 'class')
    .gte('start_time', startIso)
    .order('start_time', { ascending: true });

  if (error) console.error('Failed to load classes for check-in:', error);
  return buildClassSeriesList(classEvents ?? []).map((s) => ({ key: s.key, title: s.title, subLabel: s.subLabel, registerPrice: null }));
}

const pickerItems: PickerItem[] = checkinDisabled ? [] : isLinked ? await loadLinkedItems(linkedIds) : await loadTodayItems();
// Tokens for the classes that register on check-in (the API re-verifies per class).
const registerTokenInputs = pickerItems.filter((p) => p.registerPrice != null).map((p) => registerTokens.get(p.key)!);

const inputClass =
  'rounded-xl border border-border bg-surface px-3 py-2.5 text-ink placeholder:text-muted/60 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20';
---

<BaseLayout
  title="Class Check-In"
  description="Check in for your bachata class at Dance Life Studio, Madison, WI."
>
  <div class="mx-auto max-w-xl px-6 py-16">
    <h1 class="font-display text-3xl font-bold text-ink">Check In for Class</h1>

    {checkinDisabled ? (
      <p class="mt-4 rounded-xl border border-border bg-surface px-4 py-3 text-sm text-muted">
        Check-in isn't available online right now — please check in with an instructor at class.
      </p>
    ) : (
      <>
        <p class="mt-2 text-sm text-muted">
          Already registered? Check in here when you arrive for class. Select any classes you're checking in for
          &mdash; you can pick more than one.
        </p>

        <form method="POST" action="/api/submit-checkin" class="mt-8 flex flex-col gap-5">
          {/* Picked classes become hidden inputs here: `event_ids` for a QR's exact events, `series_keys` for today's classes. */}
          <div id="series-keys-container" data-field={isLinked ? 'event_ids' : 'series_keys'}></div>
          {registerTokenInputs.map((token) => <input type="hidden" name="register_token" value={token} />)}

          <div class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-ink/80">Classes<span class="text-accent"> *</span></span>

            {pickerItems.length === 0 ? (
              <p class="rounded-xl border border-border bg-surface px-3 py-2.5 text-sm text-muted">
                {isLinked
                  ? "This check-in link isn't valid anymore. Ask the front desk for a current QR code."
                  : 'No classes are scheduled for today or later.'}
              </p>
            ) : (
              <div id="class-list" class="flex flex-col gap-2">
                {pickerItems.map((s) => (
                  <button
                    type="button"
                    class="class-item flex w-full flex-col items-start gap-0.5 rounded-xl border border-border bg-surface px-4 py-3 text-left transition-colors hover:bg-bg aria-pressed:border-accent aria-pressed:bg-bg"
                    aria-pressed="false"
                    data-key={s.key}
                  >
                    <span class="font-semibold text-ink">{s.title}</span>
                    <span class="text-xs text-muted">{s.subLabel}</span>
                    {s.registerPrice != null && <span class="text-xs text-accent">Also registers you as a drop-in (${s.registerPrice})</span>}
                  </button>
                ))}
              </div>
            )}

            <p id="class-error" class="hidden text-xs font-semibold text-red-600">
              Please select at least one class.
            </p>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <label class="flex flex-col gap-1.5">
              <span class="text-sm font-medium text-ink/80">First Name<span class="text-accent"> *</span></span>
              <input type="text" name="first_name" required class={inputClass} />
            </label>

            <label class="flex flex-col gap-1.5">
              <span class="text-sm font-medium text-ink/80">Last Name<span class="text-accent"> *</span></span>
              <input type="text" name="last_name" required class={inputClass} />
            </label>
          </div>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-ink/80">Phone<span class="text-accent"> *</span></span>
            <input type="tel" name="phone" required class={inputClass} />
          </label>

          <button
            type="submit"
            class="gradient-accent mt-2 rounded-full px-6 py-3 text-sm font-bold uppercase tracking-wider text-white transition-opacity hover:opacity-90"
          >
            Check In
          </button>
        </form>
      </>
    )}
  </div>
</BaseLayout>

<script>
  const seriesKeysContainer = document.getElementById('series-keys-container');
  // `series_keys` on today's page; `event_ids` when the page was opened from a multi-class QR.
  const fieldName = seriesKeysContainer?.dataset.field ?? 'series_keys';
  const classError = document.getElementById('class-error');
  const selectedKeys = new Set<string>();

  function syncHiddenInputs() {
    if (!seriesKeysContainer) return;
    seriesKeysContainer.innerHTML = '';
    for (const key of selectedKeys) {
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = fieldName;
      input.value = key;
      seriesKeysContainer.appendChild(input);
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.class-item').forEach((item) => {
    const key = item.dataset.key ?? '';

    item.addEventListener('click', () => {
      const nowSelected = item.getAttribute('aria-pressed') !== 'true';
      item.setAttribute('aria-pressed', String(nowSelected));
      if (nowSelected) {
        selectedKeys.add(key);
        classError?.classList.add('hidden');
      } else {
        selectedKeys.delete(key);
      }
      syncHiddenInputs();
    });
  });

  document.querySelector('form')?.addEventListener('submit', (e) => {
    if (selectedKeys.size === 0) {
      e.preventDefault();
      classError?.classList.remove('hidden');
      classError?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  });
</script>
