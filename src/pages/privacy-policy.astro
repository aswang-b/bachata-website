---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Privacy Policy">
  <div class="mx-auto max-w-2xl px-6 py-16">
    <h1 class="font-display text-3xl font-extrabold text-ink">Privacy Policy</h1>
    <p class="mt-6 text-sm leading-relaxed text-muted">
      This page is a placeholder. This site collects the information you submit
      through our registration forms (name, email, phone, class, and comments)
      in order to contact you about classes and events. We use cookies to
      support basic site functionality. This policy will be replaced with a
      complete, studio-specific privacy policy before launch.
    </p>
  </div>
</BaseLayout>
