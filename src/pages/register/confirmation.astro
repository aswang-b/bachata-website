---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { supabase } from '../../lib/supabase';
import { siteFormatter } from '../../lib/siteTime';
import { listFaqs } from '../../lib/faqs';
import { getCommunityGuidelines, guidelineSections } from '../../lib/communityGuidelines';
import { getClassRegistrationsForSubmission } from '../../lib/classRegistrations';
import { buildReceiptLines, formatPrice, paymentAgreementText, quantityNote, receiptHeading, receiptSubtotal } from '../../lib/registrationReceipt';

interface Dancer {
  firstName?: string;
  lastName?: string;
  role?: string;
  phone?: string;
  email?: string;
}

const REGISTRATION_TYPE_LABELS: Record<string, string> = {
  group: 'Group Lesson',
  private: 'Private Instruction',
  events: 'Event / Workshop',
};

const id = Astro.url.searchParams.get('id');
let submission: {
  created_at: string;
  registration_type: string;
  first_name: string;
  last_name: string;
  email: string | null;
  phone: string | null;
  instagram: string | null;
  preferred_contact_method: string | null;
  class: string | null;
  comments: string | null;
  dancers: Dancer[] | null;
  payment_method: string | null;
} | null = null;

if (id) {
  const { data } = await supabase
    .from('intake_submissions')
    .select(
      'created_at, registration_type, first_name, last_name, email, phone, instagram, preferred_contact_method, class, comments, dancers, payment_method'
    )
    .eq('id', id)
    .maybeSingle();
  submission = data;
}

const classRegistrations = id && submission ? await getClassRegistrationsForSubmission(id) : [];
// Itemized like /register's live subtotal; legacy sign-ups with no saved
// registration rows fall back to the plain class text below.
const receiptLines = await buildReceiptLines(classRegistrations);
const subtotal = receiptSubtotal(receiptLines);

// Event tickets are worded as such rather than as classes.
const isEvent = submission?.registration_type === 'events';

// FAQ-style items under the confirmation: an event's community guidelines
// (all of them, on screen and in print), or for classes the FAQ reminders
// (every FAQ on screen; only the ones marked for confirmations in print).
// An item without a title (guideline text before its first heading) is
// shown as a plain block.
interface ReminderItem {
  title: string | null;
  body: string;
}
let reminders: ReminderItem[] = [];
let printReminders: ReminderItem[] = [];
if (submission && isEvent) {
  reminders = guidelineSections(await getCommunityGuidelines());
  printReminders = reminders;
} else if (submission) {
  const faqs = await listFaqs();
  reminders = faqs.map((f) => ({ title: f.question, body: f.answer }));
  printReminders = faqs.filter((f) => f.includeInConfirmation).map((f) => ({ title: f.question, body: f.answer }));
}
const remindersHeading = isEvent ? 'Our Community Guidelines' : 'A Few Reminders';
const reminderBodyClass =
  'px-4 py-3 text-sm leading-relaxed text-ink/70 [&_a]:font-semibold [&_a]:text-accent [&_a]:underline [&_ol]:list-decimal [&_ol]:pl-5 [&_p:not(:first-child)]:mt-3 [&_ul]:list-disc [&_ul]:pl-5';

const dateFormatter = siteFormatter({ month: 'long', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });
---

<BaseLayout title="Registration Confirmed">
  <div class="mx-auto flex max-w-xl flex-col items-center px-6 py-24 text-center print:py-0" style="-webkit-print-color-adjust: exact; print-color-adjust: exact;">
    <div class="flex w-full flex-col items-center print:break-inside-avoid">
      <div class="gradient-accent mb-4 flex h-16 w-16 items-center justify-center rounded-full">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h1 class="font-display text-3xl font-extrabold text-ink">Your Registration is Confirmed!</h1>
      <p class="mt-3 text-muted">{isEvent ? 'See you there!' : 'See you in class!'}</p>

      {submission && (
        <div class="mt-8 w-full rounded-2xl border border-border bg-surface p-6 text-left">
          <p class="text-xs font-bold uppercase tracking-wider text-accent">
            {REGISTRATION_TYPE_LABELS[submission.registration_type] ?? submission.registration_type}
          </p>
          <p class="mt-1 text-xs text-muted">Submitted {dateFormatter.format(new Date(submission.created_at))}</p>

          <div class="mt-4 flex flex-col gap-2 text-sm text-ink">
            {submission.dancers && submission.dancers.length > 0 ? (
              submission.dancers.map((d, i) => (
                <div class="flex flex-col">
                  <span class="font-semibold">{isEvent ? 'Attendee' : 'Dancer'} {i + 1}: {d.firstName} {d.lastName}</span>
                  <span class="text-ink/70">{[d.role, d.phone, d.email].filter(Boolean).join(' · ')}</span>
                </div>
              ))
            ) : (
              <div class="flex flex-col">
                <span class="font-semibold">{submission.first_name} {submission.last_name}</span>
                <span class="text-ink/70">
                  {submission.email ?? ''}
                  {submission.phone ? ` · ${submission.phone}` : ''}
                  {submission.instagram ? ` · ${submission.instagram}` : ''}
                </span>
                {submission.preferred_contact_method && (
                  <span class="text-xs text-muted">Preferred contact: {submission.preferred_contact_method}</span>
                )}
              </div>
            )}

            {receiptLines.length > 0 ? (
              <div class="mt-2 flex flex-col gap-2 border-t border-border pt-2">
                <span class="text-xs font-semibold uppercase tracking-wider text-muted">{receiptHeading(isEvent)}</span>
                <ul class="flex flex-col gap-2">
                  {receiptLines.map((line) => (
                    <li class="flex items-start justify-between gap-3">
                      <div class="flex min-w-0 flex-col">
                        <span class="font-medium">{line.title}</span>
                        {line.detail && <span class="text-xs text-muted">{line.detail}</span>}
                      </div>
                      <div class="shrink-0 text-right">
                        <div>{line.lineTotal != null ? formatPrice(line.lineTotal) : '—'}</div>
                        {quantityNote(line, isEvent) && <div class="text-xs text-muted">{quantityNote(line, isEvent)}</div>}
                      </div>
                    </li>
                  ))}
                </ul>
                {subtotal != null && (
                  <div class="flex items-center justify-between border-t border-border pt-2 font-semibold">
                    <span>Subtotal</span>
                    <span>{formatPrice(subtotal)}</span>
                  </div>
                )}
              </div>
            ) : (
              submission.class && (
                <div class="mt-2 flex flex-col border-t border-border pt-2">
                  <span class="text-xs font-semibold uppercase tracking-wider text-muted">Class</span>
                  <span>{submission.class}</span>
                </div>
              )
            )}

            {paymentAgreementText(submission.payment_method) && <p>{paymentAgreementText(submission.payment_method)}</p>}

            {submission.comments && (
              <div class="flex flex-col">
                <span class="text-xs font-semibold uppercase tracking-wider text-muted">Notes</span>
                <span>{submission.comments}</span>
              </div>
            )}
          </div>
        </div>
      )}
    </div>

    {submission && (
      <p class="mt-4 text-xs text-muted print:hidden">
        This page is your confirmation — print it or save it for your records.
      </p>
    )}

    {reminders.length > 0 && (
      <div class="mt-8 w-full text-left">
        <h2 class={`text-xs font-bold uppercase tracking-wider text-muted print:break-after-avoid ${printReminders.length === 0 ? 'print:hidden' : ''}`}>
          {remindersHeading}
        </h2>

        {/* Interactive, collapsed-by-default accordion for on-screen viewing. */}
        <div class="mt-3 flex flex-col gap-2 print:hidden">
          {reminders.map((item) =>
            item.title ? (
              <details class="group rounded-xl border border-border bg-surface open:bg-bg">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-sm font-semibold text-ink [&::-webkit-details-marker]:hidden">
                  {item.title}
                  <span class="shrink-0 text-muted transition-transform group-open:rotate-180">⌄</span>
                </summary>
                <div class={`border-t border-border ${reminderBodyClass}`} set:html={item.body} />
              </details>
            ) : (
              <div class={`rounded-xl border border-border bg-surface ${reminderBodyClass}`} set:html={item.body} />
            )
          )}
        </div>

        {/* Static, always-expanded version for print — a printed page can't
            click a <details> open, so every item just shows outright. */}
        {printReminders.length > 0 && (
          <div class="mt-3 hidden flex-col gap-2 print:flex">
            {printReminders.map((item) => (
              <div class="rounded-xl border border-border bg-surface print:break-inside-avoid">
                {item.title && <p class="border-b border-border px-4 py-3 text-sm font-semibold text-ink">{item.title}</p>}
                <div class={reminderBodyClass} set:html={item.body} />
              </div>
            ))}
          </div>
        )}
      </div>
    )}

    <div class="mt-8 flex gap-3 print:hidden">
      {submission && (
        <button
          id="print-btn"
          class="rounded-full border border-border px-6 py-2 text-sm font-semibold text-ink/70 transition-colors hover:bg-surface"
        >
          Print
        </button>
      )}
      <a
        href="/"
        class="rounded-full border-2 border-accent px-6 py-2 text-sm font-bold uppercase tracking-wider text-accent transition-colors hover:bg-accent hover:text-white"
      >
        Back to Home
      </a>
    </div>
  </div>
</BaseLayout>

<script>
  document.getElementById('print-btn')?.addEventListener('click', () => window.print());
</script>
