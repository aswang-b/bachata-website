---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { supabase } from '../lib/supabase';
import { buildClassSeriesList } from '../lib/classSeries';
import { getActivePrice, priceTierLabel } from '../lib/pricing';
import { applyCardOrder, getHomepageCardOrder, getHomepageContent, getHomepageSectionOrder, type HomepageSection } from '../lib/homepageContent';
import { listFaqs } from '../lib/faqs';
import { getSpotsByOccurrence, publicSpotsLabel, seriesSpots } from '../lib/capacity';
import { eventPillStyle } from '../lib/eventColors';
import classPlaceholder from '../assets/stock/class-placeholder.jpg';
import classPlaceholder2 from '../assets/stock/class-placeholder-2.jpg';
import eventPlaceholder from '../assets/stock/event-placeholder.jpg';

const classPlaceholders = [classPlaceholder, classPlaceholder2];

const { lessonOverview } = await getHomepageContent();
const faqs = await listFaqs();

const { data: events, error } = await supabase
  .from('events')
  .select(
    'id, title, description, location, start_time, end_time, google_recurring_event_id, event_type, price_whole_series, price_drop_in, price_student, image_url, color, registration_closed, price_whole_series_early_bird, price_drop_in_early_bird, price_student_early_bird, early_bird_until, price_whole_series_flash_sale, price_drop_in_flash_sale, price_student_flash_sale, flash_sale_until, lesson_overview_title, lesson_overview_body, hide_lesson_overview, capacity, show_capacity, capacity_by_role, leader_capacity, follower_capacity'
  )
  .eq('visibility', 'public')
  .in('event_type', ['class', 'event'])
  .gte('start_time', new Date().toISOString())
  .order('start_time', { ascending: true });

if (error) console.error('Failed to load current offerings:', error);

// Unfiltered by date, so a series' whole-series occurrence count doesn't
// shrink as classes pass (see buildClassSeriesList's `allEventsForTotals`).
const { data: allEventsForTotals, error: totalsError } = await supabase
  .from('events')
  .select('id, google_recurring_event_id')
  .eq('visibility', 'public')
  .in('event_type', ['class', 'event']);

if (totalsError) console.error('Failed to load series totals:', totalsError);

// Soonest first by default; an admin-saved order (set with the arrows shown to
// admins on this page, reset from Admin Tools → Homepage) overrides it. Only
// upcoming classes are loaded above, so a past class drops off regardless.
const [cardOrder, sectionOrder] = await Promise.all([getHomepageCardOrder(), getHomepageSectionOrder()]);
const offerings = applyCardOrder(
  buildClassSeriesList(events ?? [], allEventsForTotals ?? []).sort((a, b) => a.nextStartTime.localeCompare(b.nextStartTime)),
  cardOrder
);

// Events and classes get their own sections (events first by default; admins
// can swap them). The one saved card order still applies within each section.
const SECTION_TITLES: Record<HomepageSection, string> = {
  events: 'Upcoming Events',
  classes: 'Current Lesson Offerings',
};
const sections = sectionOrder
  .map((id) => ({
    id,
    title: SECTION_TITLES[id],
    offerings: offerings.filter((o) => (o.eventType === 'event') === (id === 'events')),
  }))
  .filter((section) => section.offerings.length > 0);

// Spots per series (its tightest upcoming class). Shown on the card only when
// the class/event shows its capacity publicly; admins get the rest from
// /api/admin/series-spots. A full one can't be registered for either way.
let spotsByOccurrence = new Map<string, import('../lib/capacity').SpotsInfo>();
try {
  spotsByOccurrence = await getSpotsByOccurrence(events ?? []);
} catch {
  // Show the cards without spots rather than failing the homepage.
}
const showCapacityByKey = new Map((events ?? []).map((e) => [e.google_recurring_event_id ?? e.id, e.show_capacity]));
function offeringSpots(offering: (typeof offerings)[number]) {
  const spots = seriesSpots(
    spotsByOccurrence,
    offering.occurrences.map((o) => o.id)
  );
  const shown = showCapacityByKey.get(offering.key) ?? false;
  return { full: spots?.full ?? false, shown, hasSpots: spots != null, publicLabel: publicSpotsLabel(spots, shown) };
}

function formatPrice(value: number): string {
  return Number.isInteger(value) ? `$${value}` : `$${value.toFixed(2)}`;
}

function priceTypeHtml(label: string, offering: (typeof offerings)[number], field: 'whole' | 'dropIn' | 'student', suffix = ''): string {
  const base = field === 'whole' ? offering.priceWholeSeries : field === 'dropIn' ? offering.priceDropIn : offering.priceStudent;
  if (base == null) return '';
  const earlyBird = field === 'whole' ? offering.priceWholeSeriesEarlyBird : field === 'dropIn' ? offering.priceDropInEarlyBird : offering.priceStudentEarlyBird;
  const flashSale = field === 'whole' ? offering.priceWholeSeriesFlashSale : field === 'dropIn' ? offering.priceDropInFlashSale : offering.priceStudentFlashSale;
  const result = getActivePrice(new Date(), {
    base,
    earlyBird,
    earlyBirdUntil: offering.earlyBirdUntil,
    flashSale,
    flashSaleUntil: offering.flashSaleUntil,
  });
  if (result.display === 'original') return `${label}: ${formatPrice(result.originalPrice!)}${suffix}`;
  return `${label}: <s class="text-muted">${formatPrice(result.originalPrice!)}</s> ${formatPrice(result.activePrice!)}${suffix} <span class="rounded-full bg-accent/15 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-accent">${priceTierLabel(result.tag)}</span>`;
}

function priceLine(offering: (typeof offerings)[number]): string | null {
  if (offering.priceWholeSeries == null && offering.priceDropIn == null && offering.priceStudent == null) return null;
  // Events have a single ticket price (with its own early bird / flash sale).
  if (offering.eventType === 'event') return priceTypeHtml('Ticket', offering, 'whole') || null;
  // Events (not classes) just list the price, with no per-class unit.
  const perClass = offering.eventType === 'event' ? '' : '/class';
  const whole = priceTypeHtml(offering.isSeries ? 'Whole Series' : 'Price', offering, 'whole');
  // A one-off class with only a drop-in price (e.g. a practica) still shows that price.
  const dropIn =
    offering.isSeries || offering.priceWholeSeries == null
      ? priceTypeHtml('Drop In', offering, 'dropIn', offering.isSeries ? perClass : '')
      : '';
  const student = priceTypeHtml('Student', offering, 'student', perClass);
  return [whole, dropIn, student].filter(Boolean).join(' &middot; ');
}

function seriesTypeLabel(offering: (typeof offerings)[number]): string {
  return offering.isSeries ? `${offering.totalOccurrences}-Week Series` : 'Workshop';
}

// Pills use a solid, slightly darkened fill of the class's color (see
// eventPillStyle) rather than colored text on a translucent chip, so their
// text stays readable over the card photo.

function locationHref(location: string): string {
  if (/^https?:\/\//i.test(location)) return location;
  return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location)}`;
}

const registerBase = (offering: (typeof offerings)[number]) => (offering.eventType === 'event' ? '/register/events' : '/register');
---

<BaseLayout
  title="Bachata Classes in Madison, WI"
  description="Weekly bachata sensual classes, private coaching, and social dance events in Madison, WI at Dance Life Studio. Beginner-friendly — no partner or experience required."
>
  <section class="mx-auto max-w-6xl px-6 py-20">
    {sections.length === 0 ? (
      <>
        <div class="mb-12 mx-auto max-w-4xl text-center">
          <h2 class="font-display text-3xl font-extrabold text-ink">Current Lesson Offerings</h2>
        </div>
        <p class="mx-auto max-w-md text-center text-sm text-muted">
          No upcoming classes or events right now — check back soon!
        </p>
      </>
    ) : (
      <p id="card-order-hint" class="mx-auto mb-8 hidden max-w-3xl rounded-xl border border-border bg-surface px-4 py-2.5 text-xs text-muted">
        Admin: use the arrows on each card to reorder it within its section, and the arrows by each section title to swap the sections. The order is saved for
        everyone, and you can reset it to the default under Admin Tools → Homepage.
        <span id="card-order-status" class="ml-1 font-semibold text-accent"></span>
      </p>
      <div id="offering-sections" class="flex flex-col gap-16">
        {sections.map((section) => (
        <div data-section={section.id} class="homepage-section flex flex-col">
          <div class="mb-12 mx-auto flex max-w-4xl items-center justify-center gap-3 text-center">
            <h2 class="font-display text-3xl font-extrabold text-ink">{section.title}</h2>
            {/* Admin-only section arrows; revealed by the script below once an admin session is confirmed. */}
            <div class="section-order-controls hidden gap-1.5">
              <button type="button" data-section-move="-1" aria-label={`Move ${section.title} up`} title="Move section up" class="flex h-8 w-8 items-center justify-center rounded-full border border-border text-ink/70 transition-colors hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:border-border disabled:hover:text-ink/70">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 15 6-6 6 6" /></svg>
              </button>
              <button type="button" data-section-move="1" aria-label={`Move ${section.title} down`} title="Move section down" class="flex h-8 w-8 items-center justify-center rounded-full border border-border text-ink/70 transition-colors hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:border-border disabled:hover:text-ink/70">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
              </button>
            </div>
          </div>
      <div class="offering-list mx-auto flex w-full max-w-3xl flex-col gap-6">
        {section.offerings.map((offering, index) => {
          const image =
            offering.imageUrl ??
            (offering.eventType === 'event' ? eventPlaceholder.src : classPlaceholders[index % classPlaceholders.length].src);
          const price = priceLine(offering);
          // A class can override the "About This Class Format" header and/or body
          // (each falls back to the default when not filled in) or hide the section.
          const overviewTitle = offering.lessonOverviewTitle ?? 'About This Class Format';
          const overviewBody = offering.lessonOverviewBody ?? lessonOverview;
          const href = `${registerBase(offering)}?series=${encodeURIComponent(offering.key)}`;
          const { full, shown, hasSpots, publicLabel } = offeringSpots(offering);

          return (
            <article
              data-offering-key={offering.key}
              class="group flex flex-col overflow-hidden rounded-3xl border border-border bg-bg shadow-[0_2px_16px_rgba(0,0,0,0.06)] transition-all hover:-translate-y-1 hover:shadow-[0_12px_32px_rgba(0,0,0,0.12)]"
            >
              <div class="relative h-28 w-full overflow-hidden sm:h-36">
                <img
                  src={image}
                  alt={offering.title}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute left-3 top-3 flex gap-2">
                  {/* Events sit in their own "Upcoming Events" section, so only classes get a type pill. */}
                  {offering.eventType !== 'event' && (
                    <span class="rounded-full px-3 py-1 text-xs font-extrabold uppercase tracking-wide shadow-md" style={eventPillStyle(offering.color)}>
                      {seriesTypeLabel(offering)}
                    </span>
                  )}
                  {!offering.registrationClosed && publicLabel && (
                    <span data-public-spots class="rounded-full bg-black/60 px-3 py-1 text-xs font-extrabold uppercase tracking-wide text-white shadow-md backdrop-blur">
                      {publicLabel}
                    </span>
                  )}
                  {/* Filled in for admins by the script below when the count is hidden from the public. */}
                  {hasSpots && !shown && !full && (
                    <span data-admin-spots-key={offering.key} class="hidden rounded-full bg-black/60 px-3 py-1 text-xs font-extrabold uppercase tracking-wide text-white shadow-md backdrop-blur"></span>
                  )}
                </div>
                {/* Admin-only reorder arrows; revealed by the script below once an admin session is confirmed. */}
                <div class="card-order-controls absolute right-3 top-3 hidden gap-1.5">
                  <button type="button" data-move="-1" aria-label={`Move ${offering.title} up`} title="Move up" class="flex h-8 w-8 items-center justify-center rounded-full bg-black/60 text-white shadow-md backdrop-blur transition-colors hover:bg-accent disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:bg-black/60">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 15 6-6 6 6" /></svg>
                  </button>
                  <button type="button" data-move="1" aria-label={`Move ${offering.title} down`} title="Move down" class="flex h-8 w-8 items-center justify-center rounded-full bg-black/60 text-white shadow-md backdrop-blur transition-colors hover:bg-accent disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:bg-black/60">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                  </button>
                </div>
              </div>
              <div class="flex flex-col gap-3 p-6 sm:p-8">
                <h3 class="font-display text-xl font-bold text-ink sm:text-2xl">{offering.title}</h3>
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
                  <span>{offering.subLabel}</span>
                  {offering.location && (
                    <>
                      <span class="text-muted/50">·</span>
                      <a
                        href={locationHref(offering.location)}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-semibold text-accent hover:opacity-80"
                      >
                        <span aria-hidden="true">📍</span> <span class="underline underline-offset-2">{offering.location}</span>
                      </a>
                    </>
                  )}
                </div>
                {price && <p class="text-sm font-semibold text-ink" set:html={price} />}

                {offering.registrationClosed || full ? (
                  <span class="mt-1 inline-block self-start rounded-full bg-border px-6 py-2.5 text-center text-sm font-bold uppercase tracking-wider text-ink/50">
                    {offering.registrationClosed ? 'Registration Closed' : 'Full'}
                  </span>
                ) : (
                  <a
                    href={href}
                    class="gradient-accent mt-1 inline-block self-start rounded-full px-6 py-2.5 text-center text-sm font-bold uppercase tracking-wider text-white transition-opacity hover:opacity-90"
                  >
                    Register Now
                  </a>
                )}

                <div class="mt-2 flex flex-col gap-2">
                  {offering.description && (
                    <details open class="group/acc rounded-xl border border-border bg-surface open:bg-bg">
                      <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-sm font-semibold text-ink [&::-webkit-details-marker]:hidden">
                        About {offering.title}
                        <span class="shrink-0 text-muted transition-transform group-open/acc:rotate-180">⌄</span>
                      </summary>
                      <div
                        class="border-t border-border px-4 py-3 text-sm leading-relaxed text-ink/70 [&_a]:text-accent [&_a]:underline [&_ol]:list-decimal [&_ol]:pl-5 [&_ul]:list-disc [&_ul]:pl-5"
                        set:html={offering.description}
                      />
                    </details>
                  )}

                  {overviewBody && !offering.hideLessonOverview && (
                    <details class="group/acc rounded-xl border border-border bg-surface open:bg-bg">
                      <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-sm font-semibold text-ink [&::-webkit-details-marker]:hidden">
                        {overviewTitle}
                        <span class="shrink-0 text-muted transition-transform group-open/acc:rotate-180">⌄</span>
                      </summary>
                      <div
                        class="border-t border-border px-4 py-3 text-sm leading-relaxed text-ink/70 [&_a]:font-semibold [&_a]:text-accent [&_a]:underline [&_ol]:list-decimal [&_ol]:pl-5 [&_p:not(:first-child)]:mt-3 [&_ul]:list-disc [&_ul]:pl-5"
                        set:html={overviewBody}
                      />
                    </details>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
        </div>
        ))}
      </div>
    )}

    {faqs.length > 0 && (
      <div class="mx-auto mt-12 max-w-3xl">
        <h3 class="font-display text-xl font-bold text-ink">FAQs & Other Info</h3>
        <div class="mt-4 flex flex-col gap-2">
          {faqs.map((faq) => (
            <details class="group rounded-xl border border-border bg-surface open:bg-bg">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 font-semibold text-ink [&::-webkit-details-marker]:hidden">
                {faq.question}
                <span class="shrink-0 text-muted transition-transform group-open:rotate-180">⌄</span>
              </summary>
              <div
                class="border-t border-border px-4 py-3 text-sm leading-relaxed text-ink/70 [&_a]:font-semibold [&_a]:text-accent [&_a]:underline [&_ol]:list-decimal [&_ol]:pl-5 [&_p:not(:first-child)]:mt-3 [&_ul]:list-disc [&_ul]:pl-5"
                set:html={faq.answer}
              />
            </details>
          ))}
        </div>
      </div>
    )}
  </section>
</BaseLayout>

<script>
  import { supabaseBrowser } from '../lib/supabaseBrowser';
  import { checkAdminSession } from '../lib/adminSession';
  import { isPreviewingAsPublic } from '../lib/previewMode';

  const sectionsEl = document.getElementById('offering-sections');
  const hint = document.getElementById('card-order-hint');
  const status = document.getElementById('card-order-status');

  let saving = false;

  const sections = () => Array.from(sectionsEl?.querySelectorAll<HTMLElement>(':scope > [data-section]') ?? []);
  // Every card on the page, in page order — the saved card order covers both
  // sections, and a card only ever moves within its own.
  const cards = () => Array.from(sectionsEl?.querySelectorAll<HTMLElement>('[data-offering-key]') ?? []);
  const sectionCards = (list: Element) => Array.from(list.querySelectorAll<HTMLElement>(':scope > [data-offering-key]'));

  function refreshArrows() {
    sectionsEl?.querySelectorAll('.offering-list').forEach((list) => {
      const all = sectionCards(list);
      all.forEach((card, index) => {
        card.querySelector<HTMLButtonElement>('[data-move="-1"]')!.disabled = index === 0;
        card.querySelector<HTMLButtonElement>('[data-move="1"]')!.disabled = index === all.length - 1;
      });
    });
    const allSections = sections();
    allSections.forEach((section, index) => {
      section.querySelector<HTMLButtonElement>('[data-section-move="-1"]')!.disabled = index === 0;
      section.querySelector<HTMLButtonElement>('[data-section-move="1"]')!.disabled = index === allSections.length - 1;
    });
  }

  function showStatus(message: string) {
    if (!status) return;
    status.textContent = message;
    setTimeout(() => {
      if (status.textContent === message) status.textContent = '';
    }, 2000);
  }

  // Spots remaining on cards whose count is hidden from the public.
  async function revealAdminSpots(accessToken: string) {
    const tags = Array.from(document.querySelectorAll<HTMLElement>('[data-admin-spots-key]'));
    if (tags.length === 0) return;
    try {
      const res = await fetch('/api/admin/series-spots', { headers: { Authorization: `Bearer ${accessToken}` } });
      if (!res.ok) return;
      const { series } = (await res.json()) as { series: Record<string, { label: string }> };
      for (const tag of tags) {
        const info = series[tag.dataset.adminSpotsKey ?? ''];
        if (!info) continue;
        tag.textContent = `${info.label} (admin only)`;
        tag.classList.remove('hidden');
        // The public's partial badge (e.g. "Leaders full") is covered by this one.
        tag.parentElement?.querySelector('[data-public-spots]')?.classList.add('hidden');
      }
    } catch {
      // Leave the tags hidden if the count can't be loaded.
    }
  }

  async function saveOrder(accessToken: string, body: { order?: string[]; sectionOrder?: string[] }): Promise<boolean> {
    const res = await fetch('/api/admin/update-homepage-card-order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${accessToken}` },
      body: JSON.stringify(body),
    });
    return res.ok;
  }

  // Moves one element past its neighbor in `parent` (a card within its
  // section, or a whole section), saves, and undoes the move if the save fails.
  async function moveAndSave(
    parent: HTMLElement,
    siblings: HTMLElement[],
    el: HTMLElement,
    direction: number,
    buildBody: () => { order?: string[]; sectionOrder?: string[] }
  ) {
    const target = siblings[siblings.indexOf(el) + direction];
    if (!target) return;

    // Ignore clicks while a save is in flight so responses can't land out of
    // order, and so the rollback below always restores a known state.
    if (saving) return;
    saving = true;

    // Move optimistically, then undo if the save fails.
    if (direction < 0) parent.insertBefore(el, target);
    else parent.insertBefore(target, el);
    refreshArrows();
    showStatus('Saving…');

    try {
      const {
        data: { session: current },
      } = await supabaseBrowser.auth.getSession();
      if (current && (await saveOrder(current.access_token, buildBody()))) {
        showStatus('Saved.');
      } else {
        throw new Error('save failed');
      }
    } catch {
      siblings.forEach((sibling) => parent.appendChild(sibling));
      refreshArrows();
      showStatus('Could not save the new order — try again.');
    } finally {
      saving = false;
    }
  }

  async function revealReorderControlsIfAdmin() {
    if (!sectionsEl || cards().length === 0 || isPreviewingAsPublic()) return;

    const gate = await checkAdminSession();
    if (gate.status !== 'admin') return;

    revealAdminSpots(gate.session.access_token);

    hint?.classList.remove('hidden');
    document.querySelectorAll('.card-order-controls, .section-order-controls').forEach((el) => {
      el.classList.remove('hidden');
      el.classList.add('flex');
    });
    refreshArrows();

    sectionsEl.addEventListener('click', async (event) => {
      const target = event.target as HTMLElement;

      const sectionButton = target.closest<HTMLButtonElement>('[data-section-move]');
      if (sectionButton) {
        const section = sectionButton.closest<HTMLElement>('[data-section]');
        if (!section || sectionButton.disabled) return;
        await moveAndSave(sectionsEl, sections(), section, Number(sectionButton.dataset.sectionMove), () => ({
          sectionOrder: sections().map((s) => s.dataset.section!),
        }));
        return;
      }

      const button = target.closest<HTMLButtonElement>('[data-move]');
      const card = button?.closest<HTMLElement>('[data-offering-key]');
      const list = card?.parentElement;
      if (!button || !card || !list || button.disabled) return;
      await moveAndSave(list, sectionCards(list), card, Number(button.dataset.move), () => ({
        order: cards().map((c) => c.dataset.offeringKey!),
      }));
    });
  }

  revealReorderControlsIfAdmin();
</script>
