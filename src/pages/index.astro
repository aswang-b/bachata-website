---
export const prerender = false;

// The homepage: one block per flyer, shown whole beside the live details of
// every class or event it advertises (src/lib/flyerBlocks.ts); classes and
// events without a flyer get a block of their own. Admins can reorder blocks
// within a section and swap the sections (saved for everyone; reset from
// Admin Tools → Homepage).

import BaseLayout from '../layouts/BaseLayout.astro';
import { supabase } from '../lib/supabase';
import { buildClassSeriesList, type ClassSeriesEntry } from '../lib/classSeries';
import { applyCardOrder, getGalleryFlyers, getHomepageCardOrder, getHomepageContent, getHomepageSectionOrder, type HomepageSection } from '../lib/homepageContent';
import { listFaqs } from '../lib/faqs';
import { listActiveDeals } from '../lib/dealsStore';
import { getSpotsByOccurrence, publicSpotsLabel, seriesSpots } from '../lib/capacity';
import { blockDeals, dateRange, formatPrice, groupByFlyer, priceOptions, seriesBounds } from '../lib/flyerBlocks';
import PastFlyersGallery from '../components/PastFlyersGallery.astro';
import FlyerDialog from '../components/FlyerDialog.astro';
import { locationHref } from '../lib/locationLink';
import { flyerSize, flyerSrcset, scaledImageUrl } from '../lib/eventImages';
import classPlaceholder from '../assets/stock/class-placeholder.jpg';
import eventPlaceholder from '../assets/stock/event-placeholder.jpg';

const now = new Date();
const [{ lessonOverview }, faqs, { data: events, error }, { data: allEventsForTotals }, cardOrder, sectionOrder, deals, galleryFlyers] = await Promise.all([
  getHomepageContent(),
  listFaqs(),
  supabase
    .from('events')
    .select(
      'id, title, description, location, start_time, end_time, google_recurring_event_id, event_type, price_whole_series, price_drop_in, price_student, image_url, flyer_url, color, registration_closed, price_whole_series_early_bird, price_drop_in_early_bird, price_student_early_bird, early_bird_until, price_whole_series_flash_sale, price_drop_in_flash_sale, price_student_flash_sale, flash_sale_until, lesson_overview_title, lesson_overview_body, hide_lesson_overview, capacity, show_capacity, capacity_by_role, leader_capacity, follower_capacity'
    )
    .eq('visibility', 'public')
    .in('event_type', ['class', 'event'])
    .gte('start_time', now.toISOString())
    .order('start_time', { ascending: true }),
  supabase.from('events').select('id, google_recurring_event_id, start_time').eq('visibility', 'public').in('event_type', ['class', 'event']),
  getHomepageCardOrder(),
  getHomepageSectionOrder(),
  listActiveDeals(now),
  getGalleryFlyers(),
]);
if (error) console.error('Failed to load current offerings:', error);

const offerings = applyCardOrder(
  buildClassSeriesList(events ?? [], allEventsForTotals ?? []).sort((a, b) => a.nextStartTime.localeCompare(b.nextStartTime)),
  cardOrder
);
const blocks = groupByFlyer(offerings);
// A series shows its full dates, not just the classes still to come.
const bounds = seriesBounds(allEventsForTotals ?? []);

// A block sits in the section of the first thing on its flyer.
const SECTION_TITLES: Record<HomepageSection, string> = { events: 'Upcoming Events', classes: 'Upcoming Classes' };
const sections = sectionOrder
  .map((id) => ({ id, title: SECTION_TITLES[id], blocks: blocks.filter((b) => (b.offerings[0].eventType === 'event') === (id === 'events')) }))
  .filter((s) => s.blocks.length > 0);
// The first flyer on the page is usually its largest image: loaded right
// away, not lazily, so the page doesn't wait on it.
const firstFlyerBlock = sections.flatMap((s) => s.blocks).find((b) => b.flyerUrl)?.key;
// The flyer column is about a third of the page (the whole width on a phone).
const FLYER_SIZES = '(min-width: 1152px) 380px, (min-width: 768px) 33vw, 100vw';
const blockTitles = (offerings: ClassSeriesEntry[]) => offerings.map((o) => o.title).join(' and ');

let spotsByOccurrence = new Map<string, import('../lib/capacity').SpotsInfo>();
try {
  spotsByOccurrence = await getSpotsByOccurrence(events ?? []);
} catch {
  // Show the blocks without spots rather than failing the page.
}
const showCapacityByKey = new Map((events ?? []).map((e) => [e.google_recurring_event_id ?? e.id, e.show_capacity]));
function spotsFor(offering: ClassSeriesEntry) {
  const spots = seriesSpots(spotsByOccurrence, offering.occurrences.map((o) => o.id));
  const shown = showCapacityByKey.get(offering.key) ?? false;
  return { full: spots?.full ?? false, label: publicSpotsLabel(spots, shown), adminOnly: spots != null && !shown && !spots.full };
}

// Events sit under Upcoming Events, so only classes get a type tag.
const typeLabel = (o: ClassSeriesEntry) => (o.eventType === 'event' ? '' : o.isSeries ? `${o.totalOccurrences}-week series` : 'Workshop');
const registerHref = (o: ClassSeriesEntry) => `${o.eventType === 'event' ? '/register/events' : '/register'}?series=${encodeURIComponent(o.key)}`;
---

<BaseLayout
  title="Bachata Classes in Madison, WI"
  description="Weekly bachata sensual classes, private coaching, and social dance events in Madison, WI at Dance Life Studio. Beginner-friendly — no partner or experience required."
>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
    {sections.length === 0 && <p class="mx-auto max-w-md text-center text-sm text-muted">No upcoming classes or events right now — check back soon!</p>}

    {sections.length > 0 && (
      <p id="card-order-hint" class="mx-auto mb-8 hidden max-w-3xl rounded-xl border border-border bg-surface px-4 py-2.5 text-xs text-muted">
        Admin: use the arrows on each flyer to move it within its section, and the arrows by each section title to swap the sections. The order is saved for
        everyone, and you can reset it to the default under Admin Tools → Homepage.
        <span id="card-order-status" class="ml-1 font-semibold text-accent"></span>
      </p>
    )}

    <div id="offering-sections" class="flex flex-col gap-16">
      {sections.map((section) => (
        <div data-section={section.id} class="flex flex-col gap-8">
          <div class="flex items-center justify-center gap-3">
            <h2 class="text-center font-display text-3xl font-extrabold text-ink">{section.title}</h2>
            {/* Admin-only section arrows; revealed by the script below once an admin session is confirmed. */}
            <div class="section-order-controls hidden gap-1.5">
              <button type="button" data-section-move="-1" aria-label={`Move ${section.title} up`} title="Move section up" class="flex h-8 w-8 items-center justify-center rounded-full border border-border text-ink/70 transition-colors hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-30">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 15 6-6 6 6" /></svg>
              </button>
              <button type="button" data-section-move="1" aria-label={`Move ${section.title} down`} title="Move section down" class="flex h-8 w-8 items-center justify-center rounded-full border border-border text-ink/70 transition-colors hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-30">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
              </button>
            </div>
          </div>
          <div class="offering-list flex flex-col gap-8">
          {section.blocks.map((block) => {
            const blockDealList = blockDeals(block.offerings, deals);
            const single = block.offerings.length === 1 ? block.offerings[0] : null;
            const fallbackImage = single?.imageUrl ?? (single?.eventType === 'event' ? eventPlaceholder.src : classPlaceholder.src);
            return (
              <article data-flyer-block={block.key} class:list={['relative overflow-clip rounded-3xl border border-border bg-bg shadow-[0_2px_16px_rgba(0,0,0,0.06)]', block.flyerUrl && 'md:grid md:grid-cols-[minmax(0,4fr)_minmax(0,8fr)]']}>
                {/* Admin-only reorder arrows; revealed by the script below once an admin session is confirmed. */}
                <div class="card-order-controls absolute left-3 top-3 z-10 hidden gap-1.5">
                  <button type="button" data-move="-1" aria-label={`Move ${blockTitles(block.offerings)} up`} title="Move up" class="flex h-8 w-8 items-center justify-center rounded-full bg-black/60 text-white shadow-md backdrop-blur transition-colors hover:bg-accent disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:bg-black/60">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 15 6-6 6 6" /></svg>
                  </button>
                  <button type="button" data-move="1" aria-label={`Move ${blockTitles(block.offerings)} down`} title="Move down" class="flex h-8 w-8 items-center justify-center rounded-full bg-black/60 text-white shadow-md backdrop-blur transition-colors hover:bg-accent disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:bg-black/60">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                  </button>
                </div>
                {block.flyerUrl ? (
                  <button type="button" data-flyer-open={block.flyerUrl} class="group relative block w-full bg-surface p-3 sm:p-4 md:sticky md:top-[calc(var(--site-top-h,4rem)+1rem)] md:self-start md:bg-transparent md:p-4 md:pr-0">
                    {/* Its alt text and the visible hint below name the button. */}
                    <img
                      src={scaledImageUrl(block.flyerUrl, 800)}
                      srcset={flyerSrcset(block.flyerUrl)}
                      sizes={FLYER_SIZES}
                      width={flyerSize(block.flyerUrl)?.width}
                      height={flyerSize(block.flyerUrl)?.height}
                      alt={`Flyer for ${blockTitles(block.offerings)}`}
                      loading={block.key === firstFlyerBlock ? 'eager' : 'lazy'}
                      fetchpriority={block.key === firstFlyerBlock ? 'high' : undefined}
                      decoding="async"
                      class="mx-auto max-h-[75vh] w-full rounded-2xl object-contain md:max-h-[calc(100vh-var(--site-top-h,4rem)-5rem)]" />
                    <span class="mt-1 block text-center text-xs font-semibold text-muted group-hover:text-accent">Tap to view full size</span>
                  </button>
                ) : (
                  <img src={fallbackImage} alt="" class="h-28 w-full object-cover sm:h-36" />
                )}

                <div class="flex flex-col gap-3 p-3 sm:p-4">

                  {block.offerings.map((o) => {
                    const { full, label, adminOnly } = spotsFor(o);
                    const prices = priceOptions(o, now);
                    const overviewBody = o.lessonOverviewBody ?? lessonOverview;
                    const showOverview = Boolean(overviewBody) && !o.hideLessonOverview;
                    // A flyer with one class/event: its description, then About This Class Format, shown in the panel beside the flyer.
                    const inlineDetails = Boolean(single && block.flyerUrl && (o.description || showOverview));
                    return (
                      <div data-offering-key={o.key} class:list={['rounded-2xl border border-border bg-surface/60 px-4 py-3', inlineDetails && 'md:flex md:flex-1 md:flex-col']}>
                        <div class="flex items-start justify-between gap-3">
                          <h3 class="min-w-0 font-display text-xl font-bold text-ink">{o.title}</h3>
                          {typeLabel(o) && <span class="mt-1.5 hidden sm:inline shrink-0 whitespace-nowrap text-xs font-bold uppercase tracking-wide text-muted">{typeLabel(o)}</span>}
                        </div>
                        {/* On a phone the title gets the full width: the dates are followed by the type tag, and a series' day and time go on the next line. */}
                        <p class="mt-1 text-sm text-ink/80 sm:hidden">
                          {o.isSeries ? dateRange(o, bounds) : o.subLabel}
                          {typeLabel(o) && <><span class="text-muted" aria-hidden="true"> · </span><span class="whitespace-nowrap text-xs font-bold uppercase tracking-wide text-muted">{typeLabel(o)}</span></>}
                        </p>
                        <p class="mt-1 text-sm text-ink/80">
                          {o.isSeries && <span class="sm:hidden">{o.subLabel}</span>}
                          <span class="hidden sm:inline">{o.isSeries ? `${o.subLabel} · ${dateRange(o, bounds)}` : o.subLabel}</span>
                          {!o.registrationClosed && label && <span data-public-spots class="ml-2 rounded-full bg-accent/15 px-2 py-0.5 text-xs font-bold text-accent">{label}</span>}
                          {/* Filled in for admins by the script below when the count is hidden from the public. */}
                          {adminOnly && <span data-admin-spots-key={o.key} class="ml-2 hidden rounded-full bg-accent/15 px-2 py-0.5 text-xs font-bold text-accent"></span>}
                        </p>
                        {o.location && (
                          <a href={locationHref(o.location)} target="_blank" rel="noopener noreferrer" class="mt-1 inline-block text-sm font-semibold text-accent hover:opacity-80">
                            {/* The pin emoji has blank space on its left; pulled back so it lines up with the text above. */}
                            <span aria-hidden="true" class="-ml-[0.35em]">📍</span> <span class="underline underline-offset-2">{o.location}</span>
                          </a>
                        )}

                        {/* Register sits in one place whatever the prices: under them on a phone, at the right from tablet width up (long prices wrap in their own column). */}
                        <div class="mt-2 flex flex-col items-start gap-2 sm:flex-row sm:items-center sm:justify-between sm:gap-3">
                          {prices.length > 0 ? (
                            <p class="flex min-w-0 flex-wrap gap-x-4 gap-y-1 text-sm text-ink sm:flex-1">
                              {prices.map((p) => (
                                <span>
                                  {p.label}:{' '}
                                  {p.was != null && <s class="text-muted">{formatPrice(p.was)}</s>}{' '}
                                  <strong class="font-bold">{formatPrice(p.price)}</strong>{p.suffix}
                                  {p.tag && <span class="ml-1 rounded-full bg-accent/15 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-accent">{p.tag}</span>}
                                </span>
                              ))}
                            </p>
                          ) : <span />}
                          {o.registrationClosed || full ? (
                            <span class="shrink-0 rounded-full bg-border px-5 py-2 text-xs font-bold uppercase tracking-wider text-ink/60">{o.registrationClosed ? 'Registration closed' : 'Full'}</span>
                          ) : (
                            <a href={registerHref(o)} class="gradient-accent shrink-0 rounded-full px-5 py-2 text-xs font-bold uppercase tracking-wider text-white transition-opacity hover:opacity-90">Register</a>
                          )}
                        </div>

                        {inlineDetails && (
                          <div data-desc-preview class="group/desc mt-2 flex min-h-28 flex-col overflow-hidden rounded-xl border border-border bg-bg md:flex-1 data-[fits]:min-h-0 md:data-[fits]:flex-none">
                            {/* On desktop the text is taken out of the flow, so the flyer alone sets the card's height and the text fills what's beside it. */}
                            <div data-desc-clip id={`desc-${o.key}`} class="relative max-h-56 overflow-hidden md:max-h-none md:min-h-0 md:flex-1 group-data-[expanded]/desc:max-h-none group-data-[expanded]/desc:md:flex-none group-data-[fits]/desc:md:flex-none">
                              <div data-desc-body class="px-3 py-2.5 text-sm leading-relaxed text-ink/75 [&_a]:font-semibold [&_a]:text-accent [&_a]:underline [&_ol]:list-decimal [&_ol]:pl-5 [&_p:not(:first-child)]:mt-3 [&_ul]:list-disc [&_ul]:pl-5 md:absolute md:inset-x-0 md:top-0 group-data-[expanded]/desc:md:static group-data-[fits]/desc:md:static">
                                {o.description && <div set:html={o.description} />}
                                {showOverview && (
                                  <div class:list={[o.description && 'mt-3 border-t border-border pt-3']}>
                                    <p class="font-bold text-ink">{o.lessonOverviewTitle ?? 'About This Class Format'}</p>
                                    <div class="mt-1" set:html={overviewBody} />
                                  </div>
                                )}
                              </div>
                              <div class="pointer-events-none absolute inset-x-0 bottom-0 h-14 bg-gradient-to-t from-bg to-transparent group-data-[expanded]/desc:hidden group-data-[fits]/desc:hidden"></div>
                            </div>
                            <button type="button" data-desc-toggle aria-expanded="false" aria-controls={`desc-${o.key}`} class="hidden border-t border-border px-3 py-2 text-left text-sm font-bold text-accent hover:opacity-80">Read more</button>
                          </div>
                        )}
                        {o.description && !inlineDetails && (
                          <details class="group/acc mt-2 rounded-xl border border-border bg-surface open:bg-bg">
                            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-3 py-2 text-sm font-bold text-ink [&::-webkit-details-marker]:hidden">
                              More about {o.title}
                              <span class="shrink-0 text-muted transition-transform group-open/acc:rotate-180">⌄</span>
                            </summary>
                            <div class="border-t border-border px-3 py-2.5 text-sm leading-relaxed text-ink/75 [&_a]:font-semibold [&_a]:text-accent [&_a]:underline [&_ol]:list-decimal [&_ol]:pl-5 [&_p:not(:first-child)]:mt-3 [&_ul]:list-disc [&_ul]:pl-5" set:html={o.description} />
                          </details>
                        )}
                        {showOverview && !inlineDetails && (
                          <details class="group/acc mt-2 rounded-xl border border-border bg-surface open:bg-bg">
                            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-3 py-2 text-sm font-bold text-ink [&::-webkit-details-marker]:hidden">
                              {o.lessonOverviewTitle ?? 'About This Class Format'}
                              <span class="shrink-0 text-muted transition-transform group-open/acc:rotate-180">⌄</span>
                            </summary>
                            <div class="border-t border-border px-3 py-2.5 text-sm leading-relaxed text-ink/75 [&_a]:font-semibold [&_a]:text-accent [&_a]:underline [&_ol]:list-decimal [&_ol]:pl-5 [&_p:not(:first-child)]:mt-3 [&_ul]:list-disc [&_ul]:pl-5" set:html={overviewBody} />
                          </details>
                        )}
                      </div>
                    );
                  })}

                  {blockDealList.map((d) => (
                    <p class="rounded-2xl border border-dashed border-accent/50 px-4 py-2.5 text-sm text-ink">
                      {d.custom ? d.text : <><span class="font-bold text-accent">{d.name}:</span> {d.text}</>}
                    </p>
                  ))}
                </div>
              </article>
            );
          })}
          </div>
        </div>
      ))}
    </div>

    {faqs.length > 0 && (
      <div class="mx-auto mt-16 max-w-3xl">
        <h3 class="font-display text-xl font-bold text-ink">FAQs & Other Info</h3>
        <div class="mt-4 flex flex-col gap-2">
          {faqs.map((faq) => (
            <details class="group rounded-xl border border-border bg-surface open:bg-bg">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 font-semibold text-ink [&::-webkit-details-marker]:hidden">
                {faq.question}
                <span class="shrink-0 text-muted transition-transform group-open:rotate-180">⌄</span>
              </summary>
              <div class="border-t border-border px-4 py-3 text-sm leading-relaxed text-ink/70 [&_a]:font-semibold [&_a]:text-accent [&_a]:underline [&_ol]:list-decimal [&_ol]:pl-5 [&_p:not(:first-child)]:mt-3 [&_ul]:list-disc [&_ul]:pl-5" set:html={faq.answer} />
            </details>
          ))}
        </div>
      </div>
    )}

    <PastFlyersGallery flyers={galleryFlyers} />
  </section>

  <FlyerDialog />
</BaseLayout>

<script>
  import { supabaseBrowser } from '../lib/supabaseBrowser';
  import { checkAdminSession } from '../lib/adminSession';
  import { isPreviewingAsPublic } from '../lib/previewMode';

  // Admins also see the spots left on classes whose count is hidden from the public.
  async function revealAdminSpots() {
    const tags = Array.from(document.querySelectorAll<HTMLElement>('[data-admin-spots-key]'));
    if (tags.length === 0 || isPreviewingAsPublic()) return;
    const gate = await checkAdminSession();
    if (gate.status !== 'admin') return;
    try {
      const res = await fetch('/api/admin/series-spots', { headers: { Authorization: `Bearer ${gate.session.access_token}` } });
      if (!res.ok) return;
      const { series } = (await res.json()) as { series: Record<string, { label: string }> };
      for (const tag of tags) {
        const info = series[tag.dataset.adminSpotsKey ?? ''];
        if (!info) continue;
        tag.textContent = `${info.label} (admin only)`;
        tag.classList.remove('hidden');
        // The public's partial tag (e.g. "Leaders full") is covered by this one.
        tag.parentElement?.querySelector('[data-public-spots]')?.classList.add('hidden');
      }
    } catch {
      // Leave the tags hidden if the count can't be loaded.
    }
  }
  revealAdminSpots();

  // Admin reordering: a flyer block moves within its section, a section swaps
  // with the other. The saved card order is every class/event key in page
  // order, so a block's classes keep their place together.
  const sectionsEl = document.getElementById('offering-sections');
  const hint = document.getElementById('card-order-hint');
  const orderStatus = document.getElementById('card-order-status');
  let saving = false;

  const sections = () => Array.from(sectionsEl?.querySelectorAll<HTMLElement>(':scope > [data-section]') ?? []);
  const sectionBlocks = (list: Element) => Array.from(list.querySelectorAll<HTMLElement>(':scope > [data-flyer-block]'));
  const offeringKeys = () => Array.from(sectionsEl?.querySelectorAll<HTMLElement>('[data-offering-key]') ?? []).map((el) => el.dataset.offeringKey!);

  function refreshArrows() {
    sectionsEl?.querySelectorAll('.offering-list').forEach((list) => {
      const all = sectionBlocks(list);
      all.forEach((block, index) => {
        block.querySelector<HTMLButtonElement>('[data-move="-1"]')!.disabled = index === 0;
        block.querySelector<HTMLButtonElement>('[data-move="1"]')!.disabled = index === all.length - 1;
      });
    });
    const allSections = sections();
    allSections.forEach((section, index) => {
      section.querySelector<HTMLButtonElement>('[data-section-move="-1"]')!.disabled = index === 0;
      section.querySelector<HTMLButtonElement>('[data-section-move="1"]')!.disabled = index === allSections.length - 1;
    });
  }

  function showStatus(message: string) {
    if (!orderStatus) return;
    orderStatus.textContent = message;
    setTimeout(() => {
      if (orderStatus.textContent === message) orderStatus.textContent = '';
    }, 2000);
  }

  async function saveOrder(accessToken: string, body: { order?: string[]; sectionOrder?: string[] }): Promise<boolean> {
    const res = await fetch('/api/admin/update-homepage-card-order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${accessToken}` },
      body: JSON.stringify(body),
    });
    return res.ok;
  }

  // Moves one element past its neighbor in `parent`, saves, and undoes the move if the save fails.
  async function moveAndSave(parent: HTMLElement, siblings: HTMLElement[], el: HTMLElement, direction: number, buildBody: () => { order?: string[]; sectionOrder?: string[] }) {
    const target = siblings[siblings.indexOf(el) + direction];
    // One save at a time, so responses can't land out of order.
    if (!target || saving) return;
    saving = true;
    if (direction < 0) parent.insertBefore(el, target);
    else parent.insertBefore(target, el);
    refreshArrows();
    showStatus('Saving…');
    try {
      const {
        data: { session: current },
      } = await supabaseBrowser.auth.getSession();
      if (!current || !(await saveOrder(current.access_token, buildBody()))) throw new Error('save failed');
      showStatus('Saved.');
    } catch {
      siblings.forEach((sibling) => parent.appendChild(sibling));
      refreshArrows();
      showStatus('Could not save the new order — try again.');
    } finally {
      saving = false;
    }
  }

  async function revealReorderControlsIfAdmin() {
    if (!sectionsEl || offeringKeys().length === 0 || isPreviewingAsPublic()) return;
    const gate = await checkAdminSession();
    if (gate.status !== 'admin') return;

    hint?.classList.remove('hidden');
    document.querySelectorAll('.card-order-controls, .section-order-controls').forEach((el) => {
      el.classList.remove('hidden');
      el.classList.add('flex');
    });
    refreshArrows();

    sectionsEl.addEventListener('click', async (event) => {
      const target = event.target as HTMLElement;
      const sectionButton = target.closest<HTMLButtonElement>('[data-section-move]');
      if (sectionButton) {
        const section = sectionButton.closest<HTMLElement>('[data-section]');
        if (!section || sectionButton.disabled) return;
        await moveAndSave(sectionsEl, sections(), section, Number(sectionButton.dataset.sectionMove), () => ({ sectionOrder: sections().map((s) => s.dataset.section!) }));
        return;
      }
      const button = target.closest<HTMLButtonElement>('[data-move]');
      const block = button?.closest<HTMLElement>('[data-flyer-block]');
      const list = block?.parentElement;
      if (!button || !block || !list || button.disabled) return;
      await moveAndSave(list, sectionBlocks(list), block, Number(button.dataset.move), () => ({ order: offeringKeys() }));
    });
  }
  revealReorderControlsIfAdmin();

  // Single-class flyer blocks: "Read more" only when the details run past the space they have.
  const previews = Array.from(document.querySelectorAll<HTMLElement>('[data-desc-preview]'));
  function measurePreviews() {
    const open = previews.filter((preview) => preview.dataset.expanded === undefined);
    // Measured against the full space beside the flyer (a fitting box shrinks
    // to its text). Every change, then every measurement, then every result,
    // so the page is laid out once rather than once per block.
    open.forEach((preview) => preview.removeAttribute('data-fits'));
    const fits = open.map((preview) => {
      const clip = preview.querySelector<HTMLElement>('[data-desc-clip]')!;
      const body = preview.querySelector<HTMLElement>('[data-desc-body]')!;
      return body.scrollHeight <= clip.clientHeight + 2;
    });
    open.forEach((preview, i) => {
      preview.toggleAttribute('data-fits', fits[i]);
      preview.querySelector('[data-desc-toggle]')!.classList.toggle('hidden', fits[i]);
    });
  }
  let measureQueued = false;
  function queueMeasure() {
    if (measureQueued) return;
    measureQueued = true;
    requestAnimationFrame(() => {
      measureQueued = false;
      measurePreviews();
    });
  }
  for (const preview of previews) {
    const toggle = preview.querySelector<HTMLButtonElement>('[data-desc-toggle]')!;
    const setExpanded = (expanded: boolean) => {
      preview.toggleAttribute('data-expanded', expanded);
      toggle.textContent = expanded ? 'Show less' : 'Read more';
      toggle.setAttribute('aria-expanded', String(expanded));
    };
    toggle.addEventListener('click', () => {
      const expanded = preview.dataset.expanded === undefined;
      setExpanded(expanded);
      if (!expanded) {
        measurePreviews();
        preview.closest('article')?.scrollIntoView({ block: 'nearest' });
      }
    });
    // Tabbing to a link in the cut-off part shows the rest, so focus is never out of sight.
    preview.querySelector('[data-desc-body]')!.addEventListener('focusin', (event) => {
      if (preview.dataset.expanded !== undefined || preview.dataset.fits !== undefined) return;
      setExpanded(true);
      // The text grew under the focused link, which may have moved off screen.
      (event.target as HTMLElement).scrollIntoView({ block: 'nearest' });
    });
  }
  // The flyer's height (once loaded) and the window's width decide the space.
  document.querySelectorAll<HTMLImageElement>('[data-flyer-open] img').forEach((img) => img.addEventListener('load', queueMeasure));
  window.addEventListener('resize', queueMeasure);
  measurePreviews();
</script>
