---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { supabase } from '../../lib/supabase';

const id = Astro.url.searchParams.get('id');

let firstName = '';
let classTitle = '';

if (id) {
  const { data } = await supabase.from('class_checkins').select('first_name, class_title').eq('id', id).maybeSingle();
  if (data) {
    firstName = data.first_name;
    classTitle = data.class_title;
  }
}
---

<BaseLayout title="Checked In">
  <div class="mx-auto flex max-w-xl flex-col items-center px-6 py-24 text-center">
    <div class="gradient-accent mb-4 flex h-16 w-16 items-center justify-center rounded-full">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <h1 class="font-display text-3xl font-extrabold text-ink">
      {firstName && classTitle ? `Thank you, ${firstName}!` : "You're Checked In!"}
    </h1>
    <p class="mt-3 text-muted">
      {classTitle ? `You successfully checked in for ${classTitle}.` : 'See you on the dance floor.'}
    </p>
    <a
      href="/"
      class="mt-8 rounded-full border-2 border-accent px-6 py-2 text-sm font-bold uppercase tracking-wider text-accent transition-colors hover:bg-accent hover:text-white"
    >
      Back to Home
    </a>
  </div>
</BaseLayout>
