---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { supabase } from '../../lib/supabase';
import { TIME_ZONE } from '../../lib/classSeries';
import { getSiteSettings } from '../../lib/siteSettings';

const { eventId } = Astro.params;

const { disable_checkin_page: checkinDisabled } = await getSiteSettings();

const { data: event } = checkinDisabled
  ? { data: null }
  : await supabase.from('events').select('id, title, start_time, end_time, price_drop_in, registration_closed').eq('id', eventId).maybeSingle();

// Set by the admin QR's "also register attendees" option. Re-checked here so a
// link tweaked onto a class with no drop-in price (or closed registration)
// just does a normal check-in; the API enforces the same rules.
const registersToo =
  Astro.url.searchParams.get('register') === '1' && !!event && event.price_drop_in != null && !event.registration_closed;

const dateFormatter = new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: TIME_ZONE });
const timeFormatter = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone: TIME_ZONE });

const scheduleLabel = event
  ? `${dateFormatter.format(new Date(event.start_time))}, ${timeFormatter.format(new Date(event.start_time))}–${timeFormatter.format(new Date(event.end_time))}`
  : '';

const inputClass =
  'rounded-xl border border-border bg-surface px-3 py-2.5 text-ink placeholder:text-muted/60 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20';
---

<BaseLayout title="Class Check-In">
  <div class="mx-auto max-w-xl px-6 py-16">
    {checkinDisabled ? (
      <>
        <h1 class="font-display text-3xl font-bold text-ink">Check In for Class</h1>
        <p class="mt-4 rounded-xl border border-border bg-surface px-4 py-3 text-sm text-muted">
          Check-in isn't available online right now — please check in with an instructor at class.
        </p>
      </>
    ) : !event ? (
      <>
        <h1 class="font-display text-3xl font-bold text-ink">Check-In Link Not Found</h1>
        <p class="mt-2 text-sm text-muted">
          This check-in link isn't valid anymore. Ask the front desk for a current QR code, or
          <a href="/check-in" class="font-semibold text-accent underline">check in here</a> instead.
        </p>
      </>
    ) : (
      <>
        <h1 class="font-display text-3xl font-bold text-ink">Check In for Class</h1>
        <div class="mt-4 rounded-xl border border-border bg-surface px-4 py-3">
          <p class="font-semibold text-ink">{event.title}</p>
          <p class="text-sm text-muted">{scheduleLabel}</p>
        </div>
        {registersToo && (
          <p class="mt-3 text-xs text-muted">
            Checking in also registers you as a drop-in (${event.price_drop_in}) — payment is collected at the door.
          </p>
        )}

        <form method="POST" action="/api/submit-checkin" class="mt-8 flex flex-col gap-5">
          <input type="hidden" name="event_ids" value={event.id} />
          {registersToo && <input type="hidden" name="create_registration" value="1" />}

          <div class="grid gap-5 sm:grid-cols-2">
            <label class="flex flex-col gap-1.5">
              <span class="text-sm font-medium text-ink/80">First Name<span class="text-accent"> *</span></span>
              <input type="text" name="first_name" required class={inputClass} />
            </label>

            <label class="flex flex-col gap-1.5">
              <span class="text-sm font-medium text-ink/80">Last Name<span class="text-accent"> *</span></span>
              <input type="text" name="last_name" required class={inputClass} />
            </label>
          </div>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-ink/80">Phone<span class="text-accent"> *</span></span>
            <input type="tel" name="phone" required class={inputClass} />
          </label>

          <button
            type="submit"
            class="gradient-accent mt-2 rounded-full px-6 py-3 text-sm font-bold uppercase tracking-wider text-white transition-opacity hover:opacity-90"
          >
            Check In
          </button>
        </form>
      </>
    )}
  </div>
</BaseLayout>
