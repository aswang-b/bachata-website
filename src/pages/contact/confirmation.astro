---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { supabase } from '../../lib/supabase';

const id = Astro.url.searchParams.get('id');
let submission: {
  created_at: string;
  first_name: string;
  last_name: string;
  email: string | null;
  phone: string | null;
  instagram: string | null;
  preferred_contact_method: string | null;
  comments: string | null;
} | null = null;

if (id) {
  const { data } = await supabase
    .from('intake_submissions')
    .select('created_at, first_name, last_name, email, phone, instagram, preferred_contact_method, comments')
    .eq('id', id)
    .eq('registration_type', 'private')
    .maybeSingle();
  submission = data;
}

const dateFormatter = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });
---

<BaseLayout title="Message Received">
  <div class="mx-auto flex max-w-xl flex-col items-center px-6 py-24 text-center">
    <div class="gradient-accent mb-4 flex h-16 w-16 items-center justify-center rounded-full">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <h1 class="font-display text-3xl font-extrabold text-ink">Message Received!</h1>
    <p class="mt-3 text-muted">Thanks for reaching out — I'll get back to you as soon as possible.</p>

    {submission && (
      <div class="mt-8 w-full rounded-2xl border border-border bg-surface p-6 text-left">
        <p class="text-xs text-muted">Submitted {dateFormatter.format(new Date(submission.created_at))}</p>

        <div class="mt-4 flex flex-col gap-2 text-sm text-ink">
          <div class="flex flex-col">
            <span class="font-semibold">{submission.first_name} {submission.last_name}</span>
            <span class="text-ink/70">
              {submission.email ?? ''}
              {submission.phone ? ` · ${submission.phone}` : ''}
              {submission.instagram ? ` · ${submission.instagram}` : ''}
            </span>
            {submission.preferred_contact_method && (
              <span class="text-xs text-muted">Preferred contact: {submission.preferred_contact_method}</span>
            )}
          </div>

          {submission.comments && (
            <div class="flex flex-col">
              <span class="text-xs font-semibold uppercase tracking-wider text-muted">Message</span>
              <span>{submission.comments}</span>
            </div>
          )}
        </div>
      </div>
    )}

    <a
      href="/"
      class="mt-8 rounded-full border-2 border-accent px-6 py-2 text-sm font-bold uppercase tracking-wider text-accent transition-colors hover:bg-accent hover:text-white"
    >
      Back to Home
    </a>
  </div>
</BaseLayout>
