  // Events have one ticket price (plus its early bird / flash sale), so the
  // per-series, drop-in and student columns only show for classes.
  // Swaps the general Capacity field for the Leader/Follower ones. Events
  // never ask for a role, so they only get the general cap.
  function renderCapacityFields() {
    const isEvent = selectedType === 'event';
    const byRole = capacityByRole && !isEvent;
    capacityByRoleRow.classList.toggle('hidden', isEvent);
    capacityByRoleRow.classList.toggle('flex', !isEvent);
    capacityByRoleToggle.setAttribute('aria-checked', String(byRole));
    capacityGeneralRow.classList.toggle('hidden', byRole);
    capacityGeneralRow.classList.toggle('flex', !byRole);
    capacityRolesRow.classList.toggle('hidden', !byRole);
    capacityRolesRow.classList.toggle('flex', byRole);
  }

  capacityByRoleToggle.addEventListener('click', (e) => {
    e.preventDefault();
    capacityByRole = !capacityByRole;
    renderCapacityFields();
  });

  function renderPricingForType() {
    const isEvent = selectedType === 'event';
    priceWholeLabel.textContent = isEvent ? 'Ticket price' : 'Whole series';
    classOnlyPriceEls.forEach((el) => {
      el.classList.toggle('hidden', isEvent);
      if (el.tagName === 'LABEL') el.classList.toggle('flex', !isEvent);
    });
  }

  function renderTypeButtons() {
    renderPricingForType();
    renderCapacityFields();
    for (const btn of typeButtons) {
      const active = btn.dataset.type === selectedType;
      btn.classList.toggle('gradient-accent', active);
      btn.classList.toggle('text-white', active);
      btn.classList.toggle('border-transparent', active);
      btn.classList.toggle('text-ink/70', !active);
      btn.classList.toggle('border-border', !active);
    }
  }

  // The picker shows the event's color; the quick picks are the five colors
  // most recently used on events (newest first), with the current one ringed.
  function renderColorButtons() {
    const current = eventColorHex(selectedColor);
    colorPicker.value = current;
    const quick = cachedAllEvents.length > 0 ? recentEventColors(cachedAllEvents) : DEFAULT_QUICK_COLORS;
    recentColorsRow.replaceChildren(
      ...quick.map((hex) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.color = hex;
        btn.className = 'event-color-btn h-7 w-7 rounded-full';
        btn.style.backgroundColor = hex;
        btn.setAttribute('aria-label', `Use ${hex}`);
        btn.title = hex;
        const active = hex === current;
        btn.setAttribute('aria-pressed', String(active));
        btn.classList.toggle('ring-2', active);
        btn.classList.toggle('ring-offset-2', active);
        btn.classList.toggle('ring-offset-bg', active);
        btn.classList.toggle('ring-ink', active);
        return btn;
      })
    );
  }

  function renderRepeatDayButtons() {
    for (const btn of repeatDayButtons) {
      const active = selectedRepeatDays.has(btn.dataset.day ?? '');
      btn.classList.toggle('gradient-accent', active);
      btn.classList.toggle('text-white', active);
      btn.classList.toggle('border-transparent', active);
      btn.classList.toggle('text-ink/70', !active);
      btn.classList.toggle('border-border', !active);
    }
  }

  const WEEKDAY_CODES = ['SU', 'MO', 'TU', 'WE', 'TH', 'FR', 'SA'];

  // The editor's date and time fields are in the site's time zone (siteTime.ts),
  // whatever zone the admin's own device is in.
  function toLocalParts(iso: string) {
    return { date: zonedDateKey(iso), time: zonedTimeOfDay(iso) };
  }

  function fromLocalParts(date: string, time: string) {
    return zonedToInstant(date, time).toISOString();
  }

  // datetime-local inputs want/give "YYYY-MM-DDTHH:mm", in the site's time zone.
  function toLocalDateTimeValue(iso: string | null | undefined): string {
    if (!iso) return '';
    const { date, time } = toLocalParts(iso);
    return `${date}T${time}`;
  }

  function fromLocalDateTimeValue(value: string): string | null {
    if (!value) return null;
    const [date, time] = value.split('T');
    return zonedToInstant(date, time?.slice(0, 5) ?? '00:00').toISOString();
  }

  function showEventDetail(event: SiteEvent) {
    detailEvent = event;
    detailPlaceholder.classList.add('hidden');
    detailContent.classList.remove('hidden');
    detailContent.classList.add('flex');

    const lock = event.visibility === 'private' ? '🔒 ' : '';
    detailType.className = 'flex items-center gap-2 text-xs font-bold uppercase tracking-wider';
    detailType.style.cssText = eventTextStyle(event.color);
    detailType.innerHTML = `<span class="h-2 w-2 rounded-full" style="${eventDotStyle(event.color)}"></span>${eventTypeLabel(event.event_type, event.weekNumber)}${event.weekNumber ? `<span class="font-bold text-ink">&middot; Week ${event.weekNumber}</span>` : ''}`;
    detailTitle.textContent = `${lock}${event.title}`;
    detailDatetime.textContent = `${dateFormatter.format(new Date(event.start_time))} · ${timeFormatter.format(new Date(event.start_time))}–${timeFormatter.format(new Date(event.end_time))}`;
    detailDescription.innerHTML = event.description ?? '';
    detailDescription.classList.toggle('hidden', !event.description);

    const priceLines = buildPriceLines(event);
    detailPrice.innerHTML = priceLines.main;
    detailPrice.classList.toggle('hidden', !priceLines.main);
    detailPriceStudent.innerHTML = priceLines.student;
    detailPriceStudent.classList.toggle('hidden', !priceLines.student);
    detailSpots.textContent = spotsText(event);
    detailSpots.classList.toggle('hidden', !detailSpots.textContent);

    // Only public classes/events actually appear as a pickable series on
    // the registration pages — a private one would 404 the preselect, so
    // the button only shows where it can actually work.
    if (event.visibility !== 'private' && event.registration_closed) {
      detailRegisterBtn.removeAttribute('href');
      detailRegisterBtn.textContent = 'Registration Closed';
      detailRegisterBtn.classList.remove('hidden', 'gradient-accent', 'hover:opacity-90');
      detailRegisterBtn.classList.add('bg-border', 'text-ink/50', 'pointer-events-none');
    } else if (event.visibility !== 'private') {
      const seriesKey = event.google_recurring_event_id ?? event.id;
      const base = event.event_type === 'event' ? '/register/events' : '/register';
      detailRegisterBtn.href = `${base}?series=${encodeURIComponent(seriesKey)}`;
      detailRegisterBtn.textContent = 'Register Now';
      detailRegisterBtn.classList.remove('hidden', 'bg-border', 'text-ink/50', 'pointer-events-none');
      detailRegisterBtn.classList.add('gradient-accent', 'hover:opacity-90');
    } else {
      detailRegisterBtn.classList.add('hidden');
    }

    if (event.flyer_url) detailFlyerBtn.dataset.flyerOpen = event.flyer_url;
    else delete detailFlyerBtn.dataset.flyerOpen;
    detailFlyerBtn.dataset.flyerAlt = `Flyer for ${event.title}`;
    detailFlyerBtn.classList.toggle('hidden', !event.flyer_url);
    detailFlyerBtn.classList.toggle('inline-flex', Boolean(event.flyer_url));

    if (event.location) {
      detailLocation.href = locationHref(event.location);
      // Only the location name is underlined, not the pin or the space after it.
      const pin = document.createElement('span');
      pin.setAttribute('aria-hidden', 'true');
      pin.textContent = '📍';
      const label = document.createElement('span');
      label.className = 'underline';
      label.textContent = event.location;
      detailLocation.replaceChildren(pin, ' ', label);
      detailLocation.classList.remove('hidden');
    } else {
      detailLocation.classList.add('hidden');
    }

    detailDeleteSeriesBtn.classList.toggle('hidden', !event.google_recurring_event_id);

    if (adminModeActive) {
      detailAdminActions.classList.remove('hidden');
      detailAdminActions.classList.add('flex');
    }
  }

  // While the section is hidden the header/body are ignored, so dim them
  // (their values are kept in case the toggle is switched back off).
  function syncLessonOverviewFields() {
    lessonOverviewFields.classList.toggle('opacity-40', hideLessonOverviewInput.checked);
  }

  function openModal(mode: 'add' | 'edit', event?: SiteEvent, presetDate?: string) {
    editingId = event?.id || null;
    editingRecurringId = event?.google_recurring_event_id ?? null;
    editingEvent = mode === 'edit' ? event ?? null : null;
    pendingLinkTo = null;
    // A new class has no tabs (editEvent sets them up for a linked one).
    if (mode === 'add') {
      editorTabs = [];
      renderTabs();
    }
    modalHeading.textContent = mode === 'add' ? 'Add Event' : 'Edit Event';
    titleInput.value = event?.title ?? '';
    descriptionInput.innerHTML = event?.description ?? '';
    locationInput.value = event?.location ?? '';
    priceWholeSeriesInput.value = event?.price_whole_series != null ? String(event.price_whole_series) : '';
    priceDropInInput.value = event?.price_drop_in != null ? String(event.price_drop_in) : '';
    priceStudentInput.value = event?.price_student != null ? String(event.price_student) : '';
    priceWholeSeriesEarlyBirdInput.value = event?.price_whole_series_early_bird != null ? String(event.price_whole_series_early_bird) : '';
    priceDropInEarlyBirdInput.value = event?.price_drop_in_early_bird != null ? String(event.price_drop_in_early_bird) : '';
    priceStudentEarlyBirdInput.value = event?.price_student_early_bird != null ? String(event.price_student_early_bird) : '';
    earlyBirdUntilInput.value = toLocalDateTimeValue(event?.early_bird_until);
    priceWholeSeriesFlashSaleInput.value = event?.price_whole_series_flash_sale != null ? String(event.price_whole_series_flash_sale) : '';
    priceDropInFlashSaleInput.value = event?.price_drop_in_flash_sale != null ? String(event.price_drop_in_flash_sale) : '';
    priceStudentFlashSaleInput.value = event?.price_student_flash_sale != null ? String(event.price_student_flash_sale) : '';
    flashSaleUntilInput.value = toLocalDateTimeValue(event?.flash_sale_until);
    registrationClosedInput.checked = event?.registration_closed ?? false;
    lessonOverviewTitleInput.value = event?.lesson_overview_title ?? '';
    lessonOverviewBodyInput.innerHTML = event?.lesson_overview_body ?? '';
    hideLessonOverviewInput.checked = event?.hide_lesson_overview ?? false;
    // Each box's Undo starts here, or at what the last save here replaced.
    const historyKey = `event:${mode === 'edit' && event ? event.google_recurring_event_id ?? event.id : 'new'}`;
    offerPrevious(descriptionInput, `${historyKey}:description`);
    offerPrevious(lessonOverviewBodyInput, `${historyKey}:overview`);
    syncLessonOverviewFields();
    imageUrlInput.value = event?.image_url ?? '';
    imageError.classList.add('hidden');
    updateImagePreview();
    flyerUrlInput.value = event?.flyer_url ?? '';
    flyerError.classList.add('hidden');
    updateFlyerPreview();
    selectedType = event?.event_type === 'event' ? 'event' : 'class';
    // A new event starts with the most recently used color.
    selectedColor = event?.color ?? (cachedAllEvents.length > 0 ? recentEventColors(cachedAllEvents)[0] : DEFAULT_QUICK_COLORS[0]);
    privateInput.checked = event?.visibility === 'private';
    capacityInput.value = event?.capacity != null ? String(event.capacity) : '';
    showCapacityInput.checked = event?.show_capacity ?? false;
    leaderCapacityInput.value = event?.leader_capacity != null ? String(event.leader_capacity) : '';
    followerCapacityInput.value = event?.follower_capacity != null ? String(event.follower_capacity) : '';
    capacityByRole = event?.capacity_by_role ?? false;

    const isSeriesOccurrence = mode === 'edit' && Boolean(editingRecurringId);
    recurrenceRow.classList.toggle('hidden', !(mode === 'add' || isSeriesOccurrence));

    repeatOptions.classList.add('hidden');
    repeatOptions.classList.remove('flex');
    repeatIntervalInput.value = '1';
    repeatCountInput.value = '4';
    repeatUntilInput.disabled = true;
    repeatCountInput.disabled = false;
    repeatEndRadios.forEach((r) => (r.checked = r.value === 'count'));
    recurrenceHint.classList.add('hidden');
    originalPattern = null;

    if (isSeriesOccurrence && event) {
      const weekday = WEEKDAY_CODES[zonedParts(event.start_time).weekday];
      selectedRepeatDays = new Set([weekday]);
      const siblingCount = cachedAllEvents.filter((e) => e.google_recurring_event_id === editingRecurringId).length || 1;
      repeatCountInput.value = String(siblingCount);
      // Existing series data doesn't track a stored interval, so default to 1 (weekly).
      repeatIntervalInput.value = '1';
      originalPattern = { byDay: [weekday], count: siblingCount, interval: 1 };

      repeatInput.checked = true;
      repeatOptions.classList.remove('hidden');
      repeatOptions.classList.add('flex');
      recurrenceHint.textContent = "This class is part of a series. Turn off Repeats to edit just this one instead of the whole series.";
      recurrenceHint.classList.remove('hidden');
    } else {
      repeatInput.checked = false;
    }

    if (event) {
      const start = toLocalParts(event.start_time);
      const end = toLocalParts(event.end_time);
      dateInput.value = start.date;
      startTimeInput.value = start.time;
      endTimeInput.value = end.time;
      if (!isSeriesOccurrence) {
        selectedRepeatDays = new Set([WEEKDAY_CODES[zonedParts(event.start_time).weekday]]);
      }
    } else {
      // Today in the site's time zone; a "YYYY-MM-DD" day's weekday is plain calendar math.
      dateInput.value = presetDate ?? zonedDateKey(new Date());
      const targetDate = new Date(`${dateInput.value}T12:00:00Z`);
      startTimeInput.value = '18:00';
      endTimeInput.value = '19:00';
      selectedRepeatDays = new Set([WEEKDAY_CODES[targetDate.getUTCDay()]]);
    }
    renderRepeatDayButtons();
    updateDateLockForSeriesEdit();

    deleteBtn.classList.toggle('hidden', mode === 'add');
    deleteSeriesBtn.classList.toggle('hidden', mode === 'add' || !editingRecurringId);
    renderTypeButtons();
    renderColorButtons();
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.getElementById('event-modal-scroll')!.scrollTop = 0;
    prepareEditorSections(mode, event);

    // Deferred until the modal (and its location input) is actually visible —
    // Google's Autocomplete widget measures the input's width when it's
    // constructed, and gets it wrong (an invisible, zero-width dropdown) if
    // that happens while the input is still display:none.
    if (adminModeActive) initLocationAutocomplete();
  }

  function closeModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    editingId = null;
    editingEvent = null;
    pendingLinkTo = null;
    editorTabs = [];
    renderTabs();
  }

  // Cancel or close: asks first when a tab has changes that would be lost.
  function cancelEditing() {
    if (hasUnsaved() && !confirm('Discard your unsaved changes?')) return;
    closeModal();
  }

  // "New linked class": a copy of `source` with a blank title and
  // description, starting at its series' next class with the same pattern,
  // linked to it when saved.
  function openNewLinked(source: SiteEvent) {
    const key = source.google_recurring_event_id ?? source.id;
    const occurrences = cachedAllEvents.filter((e) => (e.google_recurring_event_id ?? e.id) === key).sort((a, b) => a.start_time.localeCompare(b.start_time));
    const start = occurrences.find((o) => Date.parse(o.start_time) >= Date.now()) ?? source;
    const remaining = occurrences.filter((o) => o.start_time >= start.start_time);
    openModal('add', { ...start, id: '', title: '', description: null, google_recurring_event_id: null });
    pendingLinkTo = key;
    if (source.google_recurring_event_id && remaining.length > 1) {
      repeatInput.checked = true;
      repeatOptions.classList.remove('hidden');
      repeatOptions.classList.add('flex');
      selectedRepeatDays = new Set(remaining.map((o) => WEEKDAY_CODES[zonedParts(o.start_time).weekday]));
      repeatCountInput.value = String(remaining.length);
      renderRepeatDayButtons();
    }
    modalHeading.textContent = `New linked ${selectedType}`;
    updateEditorSummaries();
    linkedEditor.render();
    titleInput.focus();
  }

  // ---- Editor sections: the section menu, summaries and status ----
  // The menu is a list on wide screens and a sideways-scrolling chip row on
  // phones. Picking a section opens it and scrolls it into view; scrolling by
  // hand highlights the section at the top.
  const modalScroll = document.getElementById('event-modal-scroll')!;
  const sectionNavButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.event-nav-btn'));
  const editorSections = Array.from(document.querySelectorAll<HTMLDetailsElement>('.event-section'));
  const statusChips = document.getElementById('event-status-chips')!;
  const seriesBanner = document.getElementById('event-series-banner')!;
  const wideEditor = window.matchMedia('(min-width: 768px)');
  let activeSection = 'schedule';
  let sectionJumpUntil = 0;

  function setActiveSection(id: string, centerChip = true) {
    activeSection = id;
    for (const btn of sectionNavButtons) {
      const on = btn.dataset.section === id;
      btn.setAttribute('aria-current', on ? 'true' : 'false');
      if (on && centerChip && !wideEditor.matches) btn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    }
  }

  function jumpToSection(id: string) {
    const section = document.getElementById(`sec-${id}`) as HTMLDetailsElement | null;
    if (!section) return;
    section.open = true;
    // Don't let the scroll-spy flicker through the sections passed on the way.
    sectionJumpUntil = Date.now() + 800;
    setActiveSection(id);
    modalScroll.scrollTo({ top: Math.max(0, section.offsetTop - 12), behavior: 'smooth' });
  }

  sectionNavButtons.forEach((btn) => btn.addEventListener('click', () => jumpToSection(btn.dataset.section ?? 'schedule')));

  modalScroll.addEventListener('scroll', () => {
    if (Date.now() < sectionJumpUntil) return;
    let current = editorSections[0]?.id.replace('sec-', '') ?? 'schedule';
    for (const section of editorSections) {
      if (section.offsetTop - 40 <= modalScroll.scrollTop) current = section.id.replace('sec-', '');
    }
    if (current !== activeSection) setActiveSection(current);
  });

  const formatTimeOfDay = (date: string, time: string) =>
    date && time ? timeFormatter.format(zonedToInstant(date, time)) : '';
  const dollars = (v: string) => (v.trim() ? `$${v.trim()}` : '');

  // The one-line summary each section shows in the menu (and under its
  // title on phones), so a closed section still says what's in it.
  function updateEditorSummaries() {
    const isEvent = selectedType === 'event';
    const date = dateInput.value
      ? new Intl.DateTimeFormat('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' }).format(new Date(`${dateInput.value}T12:00:00Z`))
      : 'No date';
    const byRole = !isEvent && capacityByRole;
    const capacityText = byRole
      ? `${leaderCapacityInput.value || '∞'} leaders / ${followerCapacityInput.value || '∞'} followers`
      : capacityInput.value
        ? `${capacityInput.value} spots`
        : 'No limit';
    const earlyBird = (priceWholeSeriesEarlyBirdInput.value || priceDropInEarlyBirdInput.value) && earlyBirdUntilInput.value;
    const flashSale = (priceWholeSeriesFlashSaleInput.value || priceDropInFlashSaleInput.value) && flashSaleUntilInput.value;
    const prices = [
      dollars(priceWholeSeriesInput.value) && `${dollars(priceWholeSeriesInput.value)} ${isEvent ? 'ticket' : 'series'}`,
      !isEvent && dollars(priceDropInInput.value) && `${dollars(priceDropInInput.value)} drop-in`,
      earlyBird && 'early bird',
      flashSale && 'flash sale',
    ].filter(Boolean);
    const overviewSet = lessonOverviewTitleInput.value.trim() || lessonOverviewBodyInput.textContent?.trim();
    const summaries: Record<string, string> = {
      schedule: [date, `${formatTimeOfDay(dateInput.value, startTimeInput.value)}–${formatTimeOfDay(dateInput.value, endTimeInput.value)}`, repeatInput.checked ? 'repeats' : '']
        .filter(Boolean)
        .join(' · '),
      details: locationInput.value.trim() || 'No location yet',
      registration: [registrationClosedInput.checked ? 'Closed' : 'Open', privateInput.checked ? 'Private' : '', capacityText].filter(Boolean).join(' · '),
      pricing: prices.length ? prices.join(' · ') : isEvent ? 'Free' : 'No prices',
      homepage: [imageUrlInput.value ? 'Image set' : 'No image', ...(flyerUrlInput.value ? ['flyer set'] : []), hideLessonOverviewInput.checked ? 'overview hidden' : overviewSet ? 'custom overview' : 'default overview'].join(' · '),
      linked: linkedEditor.summary(),
    };
    document.querySelectorAll<HTMLElement>('#event-modal [data-summary]').forEach((el) => {
      el.textContent = summaries[el.dataset.summary ?? ''] ?? '';
    });

    const chip = (text: string, on: boolean) =>
      `<span class="rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide ${on ? 'bg-green-500/15 text-green-300' : 'bg-border text-ink/70'}">${text}</span>`;
    statusChips.innerHTML = chip(privateInput.checked ? 'Private' : 'Public', !privateInput.checked) + chip(registrationClosedInput.checked ? 'Closed' : 'Open', !registrationClosedInput.checked);
  }

  // Editing one class of a series with Repeats on changes every class in it
  // (each keeps its own date and time); say so up front.
  function updateSeriesBanner() {
    const siblingCount = editingRecurringId ? cachedAllEvents.filter((e) => e.google_recurring_event_id === editingRecurringId).length : 0;
    const show = Boolean(editingId && editingRecurringId);
    seriesBanner.classList.toggle('hidden', !show);
    if (!show) return;
    seriesBanner.textContent = repeatInput.checked
      ? `Part of a ${siblingCount}-class series: changes here apply to all ${siblingCount} classes (each keeps its own date and time). Turn off Repeats under Schedule to edit only this one.`
      : 'Editing only this class of the series.';
  }

  ['input', 'change', 'click'].forEach((type) =>
    modal.addEventListener(type, () => {
      updateEditorSummaries();
      updateSeriesBanner();
      // The open tab's unsaved-changes dot.
      if (editorTabs.length > 1) renderTabs();
    })
  );

  function prepareEditorSections(mode: 'add' | 'edit', event?: SiteEvent) {
    // Wide screens show every section open; phones start with all closed so
    // the menu and summaries give the overview.
    editorSections.forEach((section) => (section.open = wideEditor.matches));
    setActiveSection('schedule', false);
    document.getElementById('event-section-nav')!.scrollLeft = 0;
    const typeLabel = selectedType === 'event' ? 'event' : 'class';
    const total = editingRecurringId ? cachedAllEvents.filter((e) => e.google_recurring_event_id === editingRecurringId).length : 0;
    modalHeading.textContent =
      mode === 'add' ? 'New event' : event?.weekNumber && total > 1 ? `Edit ${typeLabel} · Week ${event.weekNumber} of ${total}` : `Edit ${typeLabel}`;
    linkedEditor.render();
    updateEditorSummaries();
    updateSeriesBanner();
  }

  function updateImagePreview() {
    const url = imageUrlInput.value;
    if (url) {
      imagePreview.src = url;
      imagePreview.classList.remove('hidden');
      imageRemoveBtn.classList.remove('hidden');
      imageUploadLabel.textContent = 'Replace Image';
    } else {
      imagePreview.classList.add('hidden');
      imagePreview.removeAttribute('src');
      imageRemoveBtn.classList.add('hidden');
      imageUploadLabel.textContent = 'Upload Image';
    }
  }

  imageFileInput.addEventListener('change', async () => {
    const picked = imageFileInput.files?.[0];
    imageFileInput.value = '';
    if (!picked) return;

    imageError.classList.add('hidden');

    // The admin chooses which region of the photo shows on the homepage before
    // anything uploads; only the cropped result is stored.
    let cropped: Blob | null;
    try {
      cropped = await openImageCropper(picked);
    } catch (err) {
      imageError.textContent = err instanceof Error ? err.message : "That file couldn't be read as an image.";
      imageError.classList.remove('hidden');
      return;
    }
    if (!cropped) return;

    imageUploadLabel.textContent = 'Uploading…';

    const headers = await withAuthHeader();
    if (!headers) {
      updateImagePreview();
      return;
    }

    const baseName = picked.name.replace(/\.[^.]+$/, '') || 'event';
    const body = new FormData();
    body.append('file', new File([cropped], `${baseName}-banner.jpg`, { type: 'image/jpeg' }));

    try {
      const res = await fetch('/api/admin/upload-event-image', { method: 'POST', headers, body });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? 'Failed to upload image.');
      imageUrlInput.value = data.url;
    } catch (err) {
      imageError.textContent = err instanceof Error ? err.message : 'Failed to upload image.';
      imageError.classList.remove('hidden');
    } finally {
      imageFileInput.value = '';
      updateImagePreview();
    }
  });

  imageRemoveBtn.addEventListener('click', () => {
    imageUrlInput.value = '';
    updateImagePreview();
  });

  const flyerUrlInput = document.getElementById('event-flyer-url') as HTMLInputElement;
  const flyerFileInput = document.getElementById('event-flyer-file') as HTMLInputElement;
  const flyerPreview = document.getElementById('event-flyer-preview') as HTMLImageElement;
  const flyerUploadLabel = document.getElementById('event-flyer-upload-label')!;
  const flyerRemoveBtn = document.getElementById('event-flyer-remove') as HTMLButtonElement;
  const flyerError = document.getElementById('event-flyer-error')!;

  function updateFlyerPreview() {
    const url = flyerUrlInput.value;
    flyerPreview.classList.toggle('hidden', !url);
    flyerRemoveBtn.classList.toggle('hidden', !url);
    if (url) flyerPreview.src = url;
    else flyerPreview.removeAttribute('src');
    flyerUploadLabel.textContent = url ? 'Replace Flyer' : 'Upload Flyer';
  }

  // Flyers upload uncropped, scaled down so the long side is at most 2000px,
  // with their final pixel size (the homepage reserves their space with it).
  // A PNG or WebP may be see-through, so it's re-encoded as WebP, which keeps
  // that (JPEG would turn it black); a JPEG stays a JPEG.
  async function shrinkFlyer(file: File): Promise<{ blob: Blob; width: number; height: number }> {
    const bitmap = await createImageBitmap(file);
    const scale = Math.min(1, 2000 / Math.max(bitmap.width, bitmap.height));
    const width = Math.round(bitmap.width * scale);
    const height = Math.round(bitmap.height * scale);
    if (scale === 1 && file.size <= 2 * 1024 * 1024) return { blob: file, width, height };
    const canvas = document.createElement('canvas');
    canvas.width = width;
    canvas.height = height;
    canvas.getContext('2d')!.drawImage(bitmap, 0, 0, width, height);
    const type = file.type === 'image/jpeg' ? 'image/jpeg' : 'image/webp';
    const blob = await new Promise<Blob>((resolve, reject) =>
      canvas.toBlob((b) => (b ? resolve(b) : reject(new Error("That file couldn't be read as an image."))), type, 0.9)
    );
    return { blob, width, height };
  }

  const FLYER_EXTENSIONS: Record<string, string> = { 'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp' };

  flyerFileInput.addEventListener('change', async () => {
    const picked = flyerFileInput.files?.[0];
    flyerFileInput.value = '';
    if (!picked) return;
    flyerError.classList.add('hidden');
    flyerUploadLabel.textContent = 'Uploading…';
    try {
      const { blob, width, height } = await shrinkFlyer(picked);
      const headers = await withAuthHeader();
      if (!headers) return;
      const body = new FormData();
      const baseName = picked.name.replace(/\.[^.]+$/, '') || 'flyer';
      // A browser that can't write WebP hands back a PNG, which is named as one.
      body.append('file', blob === picked ? picked : new File([blob], `${baseName}-flyer.${FLYER_EXTENSIONS[blob.type] ?? 'png'}`, { type: blob.type }));
      body.append('width', String(width));
      body.append('height', String(height));
      const res = await fetch('/api/admin/upload-event-image', { method: 'POST', headers, body });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? 'Failed to upload flyer.');
      flyerUrlInput.value = data.url;
    } catch (err) {
      flyerError.textContent = err instanceof Error ? err.message : 'Failed to upload flyer.';
      flyerError.classList.remove('hidden');
    } finally {
      updateFlyerPreview();
    }
  });

  flyerRemoveBtn.addEventListener('click', () => {
    flyerUrlInput.value = '';
    updateFlyerPreview();
  });

  function showSync(text: string, autoHide: boolean) {
    syncIndicatorText.textContent = text;
    syncIndicator.classList.remove('hidden');
    syncIndicator.classList.add('flex');
    syncIndicator.style.opacity = '1';
    if (autoHide) {
      setTimeout(() => {
        syncIndicator.style.opacity = '0';
        setTimeout(() => {
          syncIndicator.classList.add('hidden');
          syncIndicator.classList.remove('flex');
        }, 300);
      }, 1500);
    }
  }

  function hideSync() {
    syncIndicator.style.opacity = '0';
    syncIndicator.classList.add('hidden');
    syncIndicator.classList.remove('flex');
  }

  async function withAuthHeader() {
    const {
      data: { session },
    } = await supabaseBrowser.auth.getSession();
    return session ? { Authorization: `Bearer ${session.access_token}` } : null;
  }

  async function performDelete(id: string, deleteSeries = false) {
    const confirmMsg = deleteSeries
      ? 'Delete the ENTIRE series? This removes every occurrence from the site and Google Calendar.'
      : 'Delete this event? This also removes it from Google Calendar.';
    if (!confirm(confirmMsg)) return;
    const headers = await withAuthHeader();
    if (!headers) return;

    showSync('Syncing to Google Calendar…', false);
    const res = await fetch('/api/admin/delete-event', {
      method: 'POST',
      headers: { ...headers, 'Content-Type': 'application/json' },
      body: JSON.stringify({ eventId: id, deleteSeries }),
    });

    if (res.ok) {
      showSync('Synced!', true);
      setTimeout(() => window.location.reload(), 900);
    } else {
      const data = await res.json().catch(() => ({}));
      hideSync();
      await showErrorDialog('Delete failed', `The server returned ${res.status}.`, data.error ?? 'unknown error');
    }
  }

  typeButtons.forEach((btn) =>
    btn.addEventListener('click', () => {
      selectedType = btn.dataset.type as 'class' | 'event';
      renderTypeButtons();
      linkedEditor.render();
    })
  );

  recentColorsRow.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.event-color-btn');
    if (!btn?.dataset.color) return;
    selectedColor = btn.dataset.color;
    renderColorButtons();
  });
  colorPicker.addEventListener('input', () => {
    selectedColor = colorPicker.value.toLowerCase();
    renderColorButtons();
  });

  document.querySelectorAll<HTMLButtonElement>('.description-format-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      descriptionInput.focus();
      document.execCommand(btn.dataset.cmd!, false);
    });
  });

  hideLessonOverviewInput.addEventListener('change', syncLessonOverviewFields);

  document.querySelectorAll<HTMLButtonElement>('.lesson-overview-format-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      lessonOverviewBodyInput.focus();
      document.execCommand(btn.dataset.cmd!, false);
    });
  });

  document.getElementById('event-lesson-overview-link-btn')?.addEventListener('click', () => {
    const url = prompt('Link URL (must start with https:// or /):');
    if (!url) return;
    lessonOverviewBodyInput.focus();
    document.execCommand('createLink', false, url);
  });

  document.getElementById('event-description-link-btn')?.addEventListener('click', () => {
    const url = prompt('Link URL (must start with https:// or /):');
    if (!url) return;
    descriptionInput.focus();
    document.execCommand('createLink', false, url);
  });

  repeatInput.addEventListener('change', () => {
    repeatOptions.classList.toggle('hidden', !repeatInput.checked);
    repeatOptions.classList.toggle('flex', repeatInput.checked);
    recurrenceHint.classList.toggle('hidden', !(editingId && editingRecurringId));
    updateDateLockForSeriesEdit();
  });

  repeatDayButtons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const day = btn.dataset.day ?? '';
      if (selectedRepeatDays.has(day)) selectedRepeatDays.delete(day);
      else selectedRepeatDays.add(day);
      renderRepeatDayButtons();
    })
  );

  repeatEndRadios.forEach((radio) =>
    radio.addEventListener('change', () => {
      repeatCountInput.disabled = radio.value !== 'count' || !radio.checked;
      repeatUntilInput.disabled = radio.value !== 'until' || !radio.checked;
    })
  );

  function updateDateLockForSeriesEdit() {
    const lockDate = Boolean(editingId && editingRecurringId && repeatInput.checked);
    dateInput.disabled = lockDate;
    dateInput.classList.toggle('opacity-50', lockDate);
  }

  document.getElementById('add-event-btn')?.addEventListener('click', () => openModal('add'));
  document.getElementById('event-cancel')?.addEventListener('click', cancelEditing);
  document.getElementById('event-close')?.addEventListener('click', cancelEditing);
  document.getElementById('event-delete')?.addEventListener('click', () => editingId && performDelete(editingId));
  document.getElementById('event-delete-series')?.addEventListener('click', () => editingId && performDelete(editingId, true));

  // Edits the admin copy of the event: one clicked before the admin data
  // loaded only has the public fields, and saving that would wipe its capacity.
  document.getElementById('detail-edit-btn')?.addEventListener('click', async () => {
    if (!detailEvent) return;
    const id = detailEvent.id;
    await adminEventsReady;
    const full = cachedAllEvents.find((e) => e.id === id);
    if (!full) {
      alert("This event's details haven't finished loading — reload the page and try again.");
      return;
    }
    editEvent(full);
  });
  document.getElementById('detail-delete-btn')?.addEventListener('click', () => {
    if (detailEvent) performDelete(detailEvent.id);
  });
  document.getElementById('detail-delete-series-btn')?.addEventListener('click', () => {
    if (detailEvent) performDelete(detailEvent.id, true);
  });

  // Delegated so it keeps working after client-side re-rendering.
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    const banner = target.closest('.event-banner');
    if (banner) {
      const event = JSON.parse((banner as HTMLElement).dataset.event ?? '{}');
      showEventDetail(event);
      return;
    }

    // Mobile only — .day-dots is hidden at the sm breakpoint and up, so this
    // branch is naturally unreachable on desktop/tablet.
    const dayDots = target.closest('.day-dots');
    if (dayDots) {
      const dotsCell = dayDots.closest('.calendar-cell') as HTMLElement | null;
      if (dotsCell) toggleDayExpand(dotsCell);
      return;
    }

    // Empty space inside a day cell (not on a specific event) — admins only.
    const cell = target.closest('.calendar-cell');
    if (cell && adminModeActive) {
      const dateKey = (cell as HTMLElement).dataset.date;
      if (dateKey) openModal('add', undefined, dateKey);
    }
  });

  // Banners are div[role=button]s (the tooltip inside them can't live in a
  // real <button>), so Enter and Space open them by hand, then move focus to
  // the details so keyboard and screen-reader users land on what opened.
  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    if ((e.key !== 'Enter' && e.key !== ' ') || !target.classList?.contains('event-banner')) return;
    e.preventDefault();
    showEventDetail(JSON.parse(target.dataset.event ?? '{}'));
    document.getElementById('detail-title')?.focus();
  });

  interface SaveRequest {
    endpoint: string;
    payload: Record<string, unknown>;
    historyKey: string | null;
    title: string;
  }

  // What the editor (its open tab) would save, or null when it can't be saved
  // yet (after saying why, or with the empty field focused).
  function buildSaveRequest(): SaveRequest | null {
    if (!titleInput.value.trim() || !dateInput.value || !startTimeInput.value || !endTimeInput.value) {
      (!titleInput.value.trim() ? titleInput : dateInput).focus();
      return null;
    }
    const endTimeIso = endAfterStart(dateInput.value, startTimeInput.value, endTimeInput.value);
    if (!endTimeIso) {
      alert('The end time is the same as the start time — pick when the event ends.');
      return null;
    }

    const payload: Record<string, unknown> = {
      id: editingId ?? undefined,
      title: titleInput.value.trim(),
      description: descriptionInput.innerHTML.trim(),
      location: locationInput.value.trim(),
      priceWholeSeries: priceWholeSeriesInput.value.trim(),
      priceDropIn: priceDropInInput.value.trim(),
      priceStudent: priceStudentInput.value.trim(),
      priceWholeSeriesEarlyBird: priceWholeSeriesEarlyBirdInput.value.trim(),
      priceDropInEarlyBird: priceDropInEarlyBirdInput.value.trim(),
      priceStudentEarlyBird: priceStudentEarlyBirdInput.value.trim(),
      earlyBirdUntil: fromLocalDateTimeValue(earlyBirdUntilInput.value),
      priceWholeSeriesFlashSale: priceWholeSeriesFlashSaleInput.value.trim(),
      priceDropInFlashSale: priceDropInFlashSaleInput.value.trim(),
      priceStudentFlashSale: priceStudentFlashSaleInput.value.trim(),
      flashSaleUntil: fromLocalDateTimeValue(flashSaleUntilInput.value),
      registrationClosed: registrationClosedInput.checked,
      lessonOverviewTitle: lessonOverviewTitleInput.value.trim(),
      lessonOverviewBody: lessonOverviewBodyInput.innerHTML.trim(),
      hideLessonOverview: hideLessonOverviewInput.checked,
      imageUrl: imageUrlInput.value.trim(),
      flyerUrl: flyerUrlInput.value.trim(),
      eventType: selectedType,
      capacity: capacityInput.value.trim(),
      showCapacity: showCapacityInput.checked,
      capacityByRole: capacityByRole && selectedType === 'class',
      leaderCapacity: leaderCapacityInput.value.trim(),
      followerCapacity: followerCapacityInput.value.trim(),
      color: selectedColor,
      visibility: privateInput.checked ? 'private' : 'public',
      startTime: fromLocalParts(dateInput.value, startTimeInput.value),
      endTime: endTimeIso,
    };

    if (selectedType === 'event') {
      // Only the ticket price (and its tiers) applies to an event.
      for (const field of ['priceDropIn', 'priceStudent', 'priceDropInEarlyBird', 'priceStudentEarlyBird', 'priceDropInFlashSale', 'priceStudentFlashSale']) {
        payload[field] = '';
      }
    }

    if (!editingId && repeatInput.checked) {
      if (selectedRepeatDays.size === 0) {
        alert('Pick at least one day of the week for the recurrence.');
        return null;
      }
      const endType = repeatEndRadios.find((r) => r.checked)?.value === 'until' ? 'until' : 'count';
      if (endType === 'until' && !repeatUntilInput.value) {
        alert('Pick an end date for the recurrence.');
        return null;
      }
      payload.recurrence = {
        byDay: WEEKDAY_CODES.filter((d) => selectedRepeatDays.has(d)),
        interval: Number(repeatIntervalInput.value) || 1,
        endType,
        count: endType === 'count' ? Number(repeatCountInput.value) || 4 : undefined,
        until: endType === 'until' ? repeatUntilInput.value : undefined,
      };
    }

    if (editingId && editingRecurringId && repeatInput.checked) {
      payload.applyToSeries = true;

      const currentByDay = WEEKDAY_CODES.filter((d) => selectedRepeatDays.has(d));
      const endType = repeatEndRadios.find((r) => r.checked)?.value === 'until' ? 'until' : 'count';
      const currentCount = Number(repeatCountInput.value) || 4;
      const currentInterval = Number(repeatIntervalInput.value) || 1;

      const patternChanged =
        endType === 'until' ||
        JSON.stringify([...currentByDay].sort()) !== JSON.stringify([...(originalPattern?.byDay ?? [])].sort()) ||
        currentCount !== originalPattern?.count ||
        currentInterval !== originalPattern?.interval;

      if (patternChanged) {
        if (endType === 'until' && !repeatUntilInput.value) {
          alert('Pick an end date for the recurrence.');
          return null;
        }
        payload.rebuildSeries = true;
        payload.recurrence = {
          byDay: currentByDay,
          interval: currentInterval,
          endType,
          count: endType === 'count' ? currentCount : undefined,
          until: endType === 'until' ? repeatUntilInput.value : undefined,
        };
      }
    }

    if (!editingId && pendingLinkTo) payload.linkTo = pendingLinkTo;

    return {
      endpoint: editingId ? '/api/admin/update-event' : '/api/admin/create-event',
      payload,
      historyKey: editingEvent ? `event:${editingEvent.google_recurring_event_id ?? editingEvent.id}` : null,
      title: titleInput.value.trim(),
    };
  }

  type SaveResponse = { calendarSyncSkipped?: boolean; calendarSyncError?: string; linkError?: string | null; error?: string };

  // Sends one save. On success the rich-text boxes (still showing what was
  // saved) remember what it replaced, so reopening offers Undo back to it.
  async function sendSave(req: SaveRequest, headers: Record<string, string>): Promise<{ ok: boolean; status: number; data: SaveResponse }> {
    const res = await fetch(req.endpoint, {
      method: 'POST',
      headers: { ...headers, 'Content-Type': 'application/json' },
      body: JSON.stringify(req.payload),
    });
    const data: SaveResponse = await res.json().catch(() => ({}));
    if (res.ok && req.historyKey) {
      rememberBeforeSave(descriptionInput, `${req.historyKey}:description`);
      rememberBeforeSave(lessonOverviewBodyInput, `${req.historyKey}:overview`);
    }
    return { ok: res.ok, status: res.status, data };
  }

  const syncFailedDialog = (saved: { title: string; data: SaveResponse }[]) =>
    showErrorDialog(
      'Saved, but Google Calendar sync failed',
      'The change is saved on the site. Google Calendar did not accept it; the next scheduled sync will retry.',
      saved.map((r) => (saved.length > 1 ? `${r.title}: ` : '') + (r.data.calendarSyncError ?? 'No Google connection was available for this save.')).join('\n')
    );

  // After the editor's saves: the dialogs they need, then a reload to show what's saved.
  async function finishSaves(saved: { title: string; data: SaveResponse }[]) {
    for (const r of saved.filter((s) => s.data.linkError)) {
      hideSync();
      await showErrorDialog('Saved, but not linked', "The new class is saved, but it couldn't be linked. Link it from its Linked Classes/Events section.", r.data.linkError!);
    }
    const skipped = saved.filter((s) => s.data.calendarSyncSkipped);
    if (skipped.length > 0) {
      hideSync();
      await syncFailedDialog(skipped);
      window.location.reload();
      return;
    }
    showSync('Synced!', true);
    setTimeout(() => window.location.reload(), 900);
  }

  // Save: just the open tab. While other tabs have unsaved changes the editor
  // stays open for them; otherwise it closes and the page reloads.
  document.getElementById('event-save')?.addEventListener('click', async () => {
    const headers = await withAuthHeader();
    if (!headers) return;
    const req = buildSaveRequest();
    if (!req) return;
    if (!editorTabs.some((t, i) => i !== activeTab && t.draft)) {
      closeModal();
      showSync('Syncing to Google Calendar…', false);
      const result = await sendSave(req, headers);
      if (!result.ok) {
        hideSync();
        await showErrorDialog('Save failed', `The server returned ${result.status}.`, result.data.error ?? 'unknown error');
        return;
      }
      await finishSaves([{ title: req.title, data: result.data }]);
      return;
    }
    showSync('Saving…', false);
    const result = await sendSave(req, headers);
    hideSync();
    if (!result.ok) {
      await showErrorDialog('Save failed', `The server returned ${result.status}.`, result.data.error ?? 'unknown error');
      return;
    }
    if (result.data.calendarSyncSkipped) await syncFailedDialog([{ title: req.title, data: result.data }]);
    await refreshAdminEvents(headers);
    // This tab starts over from what's now saved; the others keep their changes.
    editorTabs[activeTab].draft = null;
    showTab(activeTab);
    showSync('Saved', true);
  });

  // Save all: every tab with changes, one after another. One that can't be
  // saved stops there, on its tab, with the ones before it saved.
  document.getElementById('event-save-all')?.addEventListener('click', async () => {
    const headers = await withAuthHeader();
    if (!headers) return;
    stashActiveDraft();
    const pending = editorTabs.flatMap((t, i) => (t.draft ? [i] : []));
    const saved: { title: string; data: SaveResponse }[] = [];
    for (const i of pending) {
      showTab(i);
      const req = buildSaveRequest();
      if (!req) {
        hideSync();
        if (saved.length > 0) await afterPartialSave(headers);
        return;
      }
      showSync(`Saving ${req.title}…`, false);
      const result = await sendSave(req, headers);
      if (!result.ok) {
        hideSync();
        await showErrorDialog(`Couldn't save ${req.title}`, `The server returned ${result.status}.`, result.data.error ?? 'unknown error');
        if (saved.length > 0) await afterPartialSave(headers);
        return;
      }
      editorTabs[i].draft = null;
      saved.push({ title: req.title, data: result.data });
    }
    closeModal();
    if (saved.length > 0) await finishSaves(saved);
  });

  // Some tabs saved before one couldn't be: they show what's now saved, and
  // the open tab keeps what's being fixed.
  async function afterPartialSave(headers: Record<string, string>) {
    stashActiveDraft();
    await refreshAdminEvents(headers);
    showTab(activeTab);
  }

  // ---- Tabs: one per linked class (src/lib/linkedClassesEditor.ts) ----
  // One form serves every tab: leaving a tab keeps its changes as a draft
  // (src/lib/editorDrafts.ts), which comes back on return and is what Save
  // all saves. The Linked Classes/Events section saves on its own.
  interface EditorDraft {
    fields: FieldValues;
    type: 'class' | 'event';
    color: string;
    capacityByRole: boolean;
    repeatDays: string[];
  }
  interface EditorTab {
    key: string;
    event: SiteEvent;
    draft: EditorDraft | null;
  }
  let editorTabs: EditorTab[] = [];
  let activeTab = 0;
  // The open tab as saved, to tell whether it has changes.
  let pristine = '';
  const tabsEl = document.getElementById('event-tabs')!;
  const saveAllBtn = document.getElementById('event-save-all')!;
  const seriesKeyOfEvent = (e: SiteEvent) => e.google_recurring_event_id ?? e.id;

  function snapshot(): EditorDraft {
    return { fields: captureFields(modal), type: selectedType, color: selectedColor, capacityByRole, repeatDays: [...selectedRepeatDays].sort() };
  }

  const activeHasChanges = () => editorTabs.length > 0 && JSON.stringify(snapshot()) !== pristine;
  const hasUnsaved = () => activeHasChanges() || editorTabs.some((t, i) => i !== activeTab && t.draft);

  function stashActiveDraft() {
    const tab = editorTabs[activeTab];
    if (tab) tab.draft = activeHasChanges() ? snapshot() : null;
  }

  function applyDraft(d: EditorDraft) {
    applyFields(modal, d.fields);
    selectedType = d.type;
    selectedColor = d.color;
    capacityByRole = d.capacityByRole;
    selectedRepeatDays = new Set(d.repeatDays);
    repeatOptions.classList.toggle('hidden', !repeatInput.checked);
    repeatOptions.classList.toggle('flex', repeatInput.checked);
    renderTypeButtons();
    renderColorButtons();
    renderRepeatDayButtons();
    renderCapacityFields();
    updateImagePreview();
    updateFlyerPreview();
    syncLessonOverviewFields();
    updateDateLockForSeriesEdit();
    updateEditorSummaries();
    updateSeriesBanner();
  }

  function showTab(i: number) {
    activeTab = i;
    const tab = editorTabs[i];
    openModal('edit', tab.event);
    pristine = JSON.stringify(snapshot());
    if (tab.draft) applyDraft(tab.draft);
    renderTabs();
  }

  // Tabs in date order (then title), for the linked set `event` is in.
  function tabsFor(event: SiteEvent, keep: EditorTab[] = []): EditorTab[] {
    const keys = linkedEditor.groupKeys(seriesKeyOfEvent(event));
    if (keys.length < 2) return [];
    const kept = new Map(keep.map((t) => [t.key, t]));
    return keys
      .flatMap((key): EditorTab[] => {
        if (kept.has(key)) return [kept.get(key)!];
        const occurrence = key === seriesKeyOfEvent(event) ? event : linkedEditor.occurrenceFor(key, event);
        return occurrence ? [{ key, event: occurrence, draft: null }] : [];
      })
      .sort((a, b) => a.event.start_time.localeCompare(b.event.start_time) || a.event.title.localeCompare(b.event.title));
  }

  // Opens the editor on `event`, with a tab for each class linked to it.
  function editEvent(event: SiteEvent) {
    editorTabs = tabsFor(event);
    if (editorTabs.length === 0) {
      openModal('edit', event);
      renderTabs();
      return;
    }
    showTab(Math.max(0, editorTabs.findIndex((t) => t.key === seriesKeyOfEvent(event))));
  }

  function renderTabs() {
    const show = editorTabs.length > 1;
    tabsEl.classList.toggle('hidden', !show);
    tabsEl.classList.toggle('flex', show);
    modalHeading.classList.toggle('hidden', show);
    saveAllBtn.classList.toggle('hidden', !show);
    if (!show) {
      tabsEl.replaceChildren();
      delete tabsEl.dataset.keys;
      return;
    }
    // Updated in place, not redrawn: a field losing focus as a tab is pressed
    // redraws this, and a redrawn tab would lose that click.
    const keys = editorTabs.map((t) => t.key).join('|');
    if (tabsEl.dataset.keys !== keys) {
      tabsEl.dataset.keys = keys;
      tabsEl.innerHTML = editorTabs
        .map(
          (t, i) => `<button type="button" role="tab" data-tab-index="${i}" class="event-tab flex max-w-[14rem] shrink-0 items-center gap-1.5 rounded-t-lg border-b-2 px-3 py-1.5 text-sm font-semibold aria-selected:border-accent aria-selected:text-ink aria-[selected=false]:border-transparent aria-[selected=false]:text-ink/60 hover:text-ink">
            <span class="truncate">${escapeHtml(t.event.title)}</span><span class="event-tab-dot hidden h-2 w-2 shrink-0 rounded-full bg-amber-400" aria-label="unsaved changes"></span>
          </button>`
        )
        .join('');
    }
    tabsEl.querySelectorAll<HTMLButtonElement>('.event-tab').forEach((btn, i) => {
      btn.setAttribute('aria-selected', String(i === activeTab));
      const dirty = i === activeTab ? activeHasChanges() : Boolean(editorTabs[i]?.draft);
      btn.querySelector('.event-tab-dot')?.classList.toggle('hidden', !dirty);
    });
    // The open tab in view when the row scrolls sideways (phones, many links).
    const open = tabsEl.querySelector<HTMLElement>('.event-tab[aria-selected="true"]');
    if (open && (open.offsetLeft < tabsEl.scrollLeft || open.offsetLeft + open.offsetWidth > tabsEl.scrollLeft + tabsEl.clientWidth)) {
      tabsEl.scrollLeft = open.offsetLeft - 8;
    }
  }

  tabsEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.event-tab');
    const i = Number(btn?.dataset.tabIndex);
    if (!btn || Number.isNaN(i) || i === activeTab) return;
    stashActiveDraft();
    showTab(i);
  });

  // The admin copy of the events again (after a save that keeps the editor open).
  async function refreshAdminEvents(headers: Record<string, string>) {
    const res = await fetch('/api/admin/all-events', { headers });
    if (!res.ok) return;
    const { events } = await res.json();
    cachedAllEvents = events;
    rerenderWithMergedEvents(events);
    for (const tab of editorTabs) tab.event = cachedAllEvents.find((e) => e.id === tab.event.id) ?? tab.event;
  }

  function buildBannerHTML(event: SiteEvent, isCompact: boolean): string {
    const bannerClass = isCompact
      ? `truncate rounded px-1 py-0.5 text-[10px] font-semibold`
      : `event-banner-label whitespace-normal rounded-lg px-2 py-1.5 text-xs font-semibold leading-snug`;
    const weekTag = event.weekNumber
      ? `<span class="whitespace-nowrap rounded bg-white/25 px-1 py-0.5 text-[9px] font-bold uppercase tracking-wide">Wk ${event.weekNumber}</span> `
      : '';
    return `
      <div class="event-banner group relative cursor-pointer rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" role="button" tabindex="0" data-event="${escapeAttr(JSON.stringify(event))}">
        <div class="${bannerClass}" style="${eventBannerStyle(event.color)}">${weekTag}${event.visibility === 'private' ? '🔒 ' : ''}${escapeHtml(event.title)}</div>
        <div aria-hidden="true" class="event-tooltip pointer-events-none absolute left-1/2 top-full z-30 mt-2 hidden max-h-[calc(100vh-1rem)] w-96 -translate-x-1/2 overflow-hidden rounded-2xl border-2 border-ink bg-bg p-4 text-left shadow-xl group-hover:block group-focus-visible:block">
          <p class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-wider" style="${eventTextStyle(event.color)}">
            <span class="h-2 w-2 rounded-full" style="${eventDotStyle(event.color)}"></span>
            ${eventTypeLabel(event.event_type, event.weekNumber)}
            ${event.weekNumber ? `<span class="font-bold text-ink">&middot; Week ${event.weekNumber}</span>` : ''}
          </p>
          <p class="mt-1 font-display font-bold text-ink">${escapeHtml(event.title)}</p>
          <p class="mt-1 text-xs text-muted">${dateFormatter.format(new Date(event.start_time))} &middot; ${timeFormatter.format(new Date(event.start_time))}${event.end_time ? `–${timeFormatter.format(new Date(event.end_time))}` : ''}</p>
          ${event.description ? `<div class="tooltip-desc line-clamp-6 mt-1 text-xs text-ink/70 [&_a]:text-accent [&_a]:underline [&_ol]:list-decimal [&_ol]:pl-4 [&_ul]:list-disc [&_ul]:pl-4">${event.description}</div><p class="tooltip-more mt-1 hidden text-[10px] font-bold uppercase tracking-wider text-accent">Click for full details</p>` : ''}
          ${buildPriceLines(event).main ? `<p class="mt-1 text-xs font-semibold text-ink">${buildPriceLines(event).main}</p>` : ''}
          ${buildPriceLines(event).student ? `<p class="text-xs font-semibold text-ink">${buildPriceLines(event).student}</p>` : ''}
          ${spotsText(event) ? `<p class="mt-1 text-xs font-bold text-accent">${spotsText(event)}</p>` : ''}
          ${
            event.location
              ? `<a href="${escapeAttr(locationHref(event.location))}" target="_blank" rel="noopener noreferrer" class="pointer-events-auto mt-1 block text-xs font-semibold text-accent" onclick="event.stopPropagation()"><span aria-hidden="true">📍</span> <span class="underline">${escapeHtml(event.location)}</span></a>`
              : ''
          }
        </div>
      </div>`;
  }

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  // Mobile-only: tapping a day's dot summary "opens" that day into a
  // full-width row of its events (a plain sibling with col-span-7, so the
  // grid's own auto-flow pushes later weeks down — no manual layout math),
  // then tapping one of those opens the same detail panel desktop uses.
  function closeDayExpandPanel() {
    document.querySelector('.day-expand-panel')?.remove();
    document.querySelectorAll('.calendar-cell.day-expanded').forEach((c) => c.classList.remove('day-expanded', 'ring-2', 'ring-accent'));
  }

  function toggleDayExpand(cell: HTMLElement) {
    const wasOpen = cell.classList.contains('day-expanded');
    closeDayExpandPanel();
    if (wasOpen) return;

    const dayEvents = JSON.parse(cell.querySelector<HTMLElement>('.day-dots')?.dataset.events ?? '[]') as SiteEvent[];
    if (dayEvents.length === 0) return;

    cell.classList.add('day-expanded', 'ring-2', 'ring-accent');

    const panel = document.createElement('div');
    panel.className = 'day-expand-panel col-span-7 m-1 flex flex-col gap-1 rounded-xl border border-border bg-surface p-2 sm:hidden';

    dayEvents.forEach((event) => {
      const item = document.createElement('button');
      item.type = 'button';
      item.className = 'flex items-center gap-2 rounded-lg px-2 py-2 text-left text-sm transition-colors hover:bg-bg';
      item.innerHTML = `<span class="h-2.5 w-2.5 shrink-0 rounded-full" style="${eventDotStyle(event.color)}"></span><span class="flex-1 truncate font-semibold text-ink">${escapeHtml(event.title)}</span><span class="shrink-0 text-xs text-muted">${timeFormatter.format(new Date(event.start_time))}${event.end_time ? `–${timeFormatter.format(new Date(event.end_time))}` : ''}</span>`;
      item.addEventListener('click', () => {
        showEventDetail(event);
        closeDayExpandPanel();
        document.getElementById('event-detail-panel')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      panel.appendChild(item);
    });


    // Insert after the last cell of this day's week row (not right after
    // the tapped cell) so the panel opens as its own full-width row below
    // an intact week, instead of splitting that week's row in two with the
    // later days pushed down onto a line by themselves.
    const allCells = Array.from(document.querySelectorAll<HTMLElement>('.calendar-cell'));
    const cellIndex = allCells.indexOf(cell);
    const rowEndIndex = Math.min(Math.ceil((cellIndex + 1) / 7) * 7 - 1, allCells.length - 1);
    allCells[rowEndIndex].after(panel);
  }

  function computeWeekNumbers(allEvents: SiteEvent[]): Map<string, number> {
    const bySeriesKey = new Map<string, SiteEvent[]>();
    for (const e of allEvents) {
      if (!e.google_recurring_event_id) continue;
      const list = bySeriesKey.get(e.google_recurring_event_id) ?? [];
      list.push(e);
      bySeriesKey.set(e.google_recurring_event_id, list);
    }
    const weekNumberByEventId = new Map<string, number>();
    for (const occurrences of bySeriesKey.values()) {
      if (occurrences.length < 2) continue;
      occurrences
        .slice()
        .sort((a, b) => new Date(a.start_time).getTime() - new Date(b.start_time).getTime())
        .forEach((occ, idx) => weekNumberByEventId.set(occ.id, idx + 1));
    }
    return weekNumberByEventId;
  }

  function rerenderWithMergedEvents(allEvents: SiteEvent[]) {
    const weekNumberByEventId = computeWeekNumbers(allEvents);
    allEvents = allEvents.slice().sort(calendarOrder(seriesFirstOccurrences(allEvents)));

    document.querySelectorAll('.calendar-cell').forEach((cell) => {
      const dateKey = (cell as HTMLElement).dataset.date;
      if (!dateKey) return;
      // The day it falls on in the site's time zone (each cell's key is already in this month).
      const dayEvents = allEvents.filter((e) => zonedDateKey(e.start_time) === dateKey);
      const container = cell.querySelector('.day-banners')!;
      const MAX = 3;
      const isCompact = dayEvents.length > 2;

      // Square on a phone (dots only); taller from tablet width up, where the banners show.
      cell.classList.remove('sm:min-h-[7.5rem]', 'sm:min-h-[6.5rem]');
      cell.classList.add(isCompact ? 'sm:min-h-[6.5rem]' : 'sm:min-h-[7.5rem]');

      container.innerHTML =
        dayEvents
          .slice(0, MAX)
          .map((e) => buildBannerHTML({ ...e, weekNumber: weekNumberByEventId.get(e.id) ?? null }, isCompact))
          .join('') + (dayEvents.length > MAX ? `<p class="text-[10px] font-semibold text-muted">+${dayEvents.length - MAX} more</p>` : '');

      const dotsContainer = cell.querySelector('.day-dots');
      if (dotsContainer) {
        // Rows of two up to 4 events, rows of three for 5 or 6; at most 6 dots (a tap lists them all).
        dotsContainer.classList.remove('grid-cols-2', 'grid-cols-3');
        dotsContainer.classList.add(dayEvents.length > 4 ? 'grid-cols-3' : 'grid-cols-2');
        (dotsContainer as HTMLElement).dataset.events = JSON.stringify(dayEvents.map((e) => ({ ...e, weekNumber: weekNumberByEventId.get(e.id) ?? null })));
        dotsContainer.innerHTML = dayEvents
          .slice(0, 6)
          .map((e) => `<span class="h-1.5 w-1.5 rounded-full" style="${eventDotStyle(e.color)}"></span>`)
          .join('');
      }
    });

    keepTooltipsOutOfTabOrder();
    fitBannerLabels();
  }

  // Banner titles wrap at word boundaries only (no mid-word breaks) — if a
  // word is still too wide for the banner at the current font size (a
  // narrow cell, a long word, or a high browser zoom level), shrink the
  // font size until it fits, rather than breaking the word. The smallest
  // size is in rem, so it grows with the visitor's own font-size setting
  // instead of overriding it.
  const BANNER_MIN_FONT_REM = 0.625;
  const bannerMinFontPx = () => BANNER_MIN_FONT_REM * parseFloat(getComputedStyle(document.documentElement).fontSize);
  // True when any line of the label's text reaches into its right padding.
  // (scrollWidth only notices text that spills past the padding too, so a
  // word squeezed against the edge used to count as fitting.)
  function labelOverflows(label: HTMLElement): boolean {
    const style = getComputedStyle(label);
    const limit = label.getBoundingClientRect().right - parseFloat(style.paddingRight) - parseFloat(style.borderRightWidth);
    const range = document.createRange();
    range.selectNodeContents(label);
    return Array.from(range.getClientRects()).some((r) => r.right > limit + 0.5);
  }

  // Every banner uses the same font size, so one long title doesn't leave
  // its banner in smaller text than the rest: find the size each one needs
  // to fit, then give them all the smallest.
  function fitBannerLabels() {
    const labels = Array.from(document.querySelectorAll<HTMLElement>('.event-banner-label'));
    for (const label of labels) {
      label.style.fontSize = '';
      label.style.overflowWrap = '';
      label.style.hyphens = '';
    }
    // Hidden banners (e.g. the phone layout's) have no width to measure.
    const visible = labels.filter((label) => label.offsetParent !== null);
    if (visible.length === 0) return;
    const minPx = bannerMinFontPx();
    let sharedPx = parseFloat(getComputedStyle(visible[0]).fontSize);
    for (const label of visible) {
      label.style.fontSize = `${sharedPx}px`;
      if (sharedPx <= minPx || !labelOverflows(label)) continue;
      // Binary search in half-pixel steps for the largest size that fits:
      // a handful of measurements rather than one per step.
      let lo = Math.ceil(minPx * 2);
      let hi = Math.floor(sharedPx * 2) - 1;
      let best = lo;
      while (lo <= hi) {
        const mid = Math.floor((lo + hi) / 2);
        label.style.fontSize = `${mid / 2}px`;
        if (labelOverflows(label)) {
          hi = mid - 1;
        } else {
          best = mid;
          lo = mid + 1;
        }
      }
      sharedPx = Math.max(minPx, best / 2);
    }
    for (const label of labels) {
      label.style.fontSize = `${sharedPx}px`;
      // Still too wide at the smallest readable size (one long word in a narrow
      // cell): break it rather than shrink further or spill past the edge.
      if (label.offsetParent !== null && labelOverflows(label)) {
        label.style.hyphens = 'auto';
        label.style.overflowWrap = 'anywhere';
      }
    }
  }

  let fitBannerLabelsResizeTimer: ReturnType<typeof setTimeout> | null = null;
  window.addEventListener('resize', () => {
    if (fitBannerLabelsResizeTimer) clearTimeout(fitBannerLabelsResizeTimer);
    fitBannerLabelsResizeTimer = setTimeout(fitBannerLabels, 150);
  });

  async function revealAdminControlsIfAdmin() {
    if (isPreviewingAsPublic()) return;

    const gate = await checkAdminSession();
    if (gate.status !== 'admin') return;
    const { session } = gate;

    adminModeActive = true;
    document.getElementById('add-event-btn')?.classList.remove('hidden');

    adminEventsReady = (async () => {
      const headers = { Authorization: `Bearer ${session.access_token}` };
      const [allEventsRes] = await Promise.all([fetch('/api/admin/all-events', { headers }), linkedEditor.load(headers)]);
      if (allEventsRes.ok) {
        const { events } = await allEventsRes.json();
        cachedAllEvents = events;
        rerenderWithMergedEvents(events);
      }
    })().catch(() => undefined);
    await adminEventsReady;
  }

  fitBannerLabels();
  // Measured again once the web font has loaded: it's wider than the fallback the first pass measured.
  document.fonts?.ready.then(fitBannerLabels);
  revealAdminControlsIfAdmin();
</script>
