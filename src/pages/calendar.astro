<script>
  import { supabaseBrowser } from '../lib/supabaseBrowser';
  import { checkAdminSession } from '../lib/adminSession';
  import { showErrorDialog } from '../lib/errorDialog';
  import { isPreviewingAsPublic } from '../lib/previewMode';
  import { getActivePrice, priceTierLabel } from '../lib/pricing';
  import { openImageCropper } from '../lib/imageCropper';
  import { calendarOrder, endAfterStart, seriesFirstOccurrences } from '../lib/eventTimes';
  import { siteFormatter, zonedDateKey, zonedParts, zonedTimeOfDay, zonedToInstant } from '../lib/siteTime';
  import { DEFAULT_QUICK_COLORS, eventBannerStyle, eventColorHex, eventDotStyle, eventTextStyle, recentEventColors } from '../lib/eventColors';
  import { eventTypeLabel } from '../lib/classSeries';
  import { escapeAttr, locationHref } from '../lib/locationLink';
  import { installRichTextShortcuts } from '../lib/richTextShortcuts';
  import { installRichTextHistory, offerPrevious, rememberBeforeSave } from '../lib/richTextHistory';
  import { initLinkedEditor } from '../lib/linkedClassesEditor';
  import { applyFields, captureFields, type FieldValues } from '../lib/editorDrafts';

  installRichTextShortcuts();
  installRichTextHistory();

  // --- Calendar / List view toggle ---
  const viewToggleButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.view-toggle-btn'));
  const calendarViewEl = document.getElementById('calendar-view')!;
  const listViewEl = document.getElementById('list-view')!;

  function setActiveView(view: string) {
    calendarViewEl.classList.toggle('hidden', view !== 'calendar');
    listViewEl.classList.toggle('hidden', view !== 'list');
    listViewEl.classList.toggle('flex', view === 'list');
    if (view === 'list') refreshReadMoreLinks();
    viewToggleButtons.forEach((btn) => {
      const active = btn.dataset.view === view;
      btn.classList.toggle('gradient-accent', active);
      btn.classList.toggle('text-white', active);
      btn.classList.toggle('text-ink/70', !active);
    });
  }


  // List view: a "Read more" link under each description that's cut off,
  // expanding it in place.
  function refreshReadMoreLinks() {
    listViewEl.querySelectorAll<HTMLElement>('.list-desc').forEach((desc) => {
      const toggle = desc.nextElementSibling as HTMLButtonElement | null;
      if (!toggle?.classList.contains('list-desc-toggle') || toggle.getAttribute('aria-expanded') === 'true') return;
      toggle.classList.toggle('hidden', desc.scrollHeight <= desc.clientHeight + 1);
    });
  }
  listViewEl.addEventListener('click', (e) => {
    const toggle = (e.target as HTMLElement).closest<HTMLButtonElement>('.list-desc-toggle');
    if (!toggle) return;
    const expanded = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.previousElementSibling?.classList.toggle('line-clamp-2', !expanded);
    toggle.setAttribute('aria-expanded', String(expanded));
    toggle.textContent = expanded ? 'Show less' : 'Read more';
  });
  window.addEventListener('resize', refreshReadMoreLinks);

  // Calendar hover card: opens below the banner, or above it when there's
  // more room there, and slides sideways to stay inside the window. A long
  // description is cut to a few lines, with a hint to click for the rest.
  const TOOLTIP_MARGIN = 8;
  function placeTooltip(banner: HTMLElement) {
    const tip = banner.querySelector<HTMLElement>('.event-tooltip');
    if (!tip) return;
    tip.classList.remove('bottom-full', 'mb-2');
    tip.classList.add('top-full', 'mt-2');
    tip.style.marginLeft = '';
    const desc = tip.querySelector<HTMLElement>('.tooltip-desc');
    tip.querySelector('.tooltip-more')?.classList.toggle('hidden', !desc || desc.scrollHeight <= desc.clientHeight + 1);

    const rect = tip.getBoundingClientRect();
    const bannerRect = banner.getBoundingClientRect();
    const roomBelow = window.innerHeight - bannerRect.bottom;
    const roomAbove = bannerRect.top;
    if (rect.bottom > window.innerHeight - TOOLTIP_MARGIN && roomAbove > roomBelow) {
      tip.classList.remove('top-full', 'mt-2');
      tip.classList.add('bottom-full', 'mb-2');
    }
    if (rect.left < TOOLTIP_MARGIN) tip.style.marginLeft = `${TOOLTIP_MARGIN - rect.left}px`;
    else if (rect.right > window.innerWidth - TOOLTIP_MARGIN) tip.style.marginLeft = `${window.innerWidth - TOOLTIP_MARGIN - rect.right}px`;
  }
  // Delegated so it keeps working after client-side re-rendering.
  document.addEventListener('mouseover', (e) => {
    const banner = (e.target as HTMLElement).closest<HTMLElement>('.event-banner');
    if (banner && !banner.contains(e.relatedTarget as Node | null)) placeTooltip(banner);
  });
  // A banner reached with Tab shows its tooltip too (group-focus-visible).
  document.addEventListener('focusin', (e) => {
    const target = e.target as HTMLElement;
    if (target.classList?.contains('event-banner')) placeTooltip(target);
  });
  // The tooltip only repeats the details panel, so it stays out of the tab
  // order and the accessibility tree: tabbing into its links would hide it
  // (focus leaves the banner) with the focus still inside.
  function keepTooltipsOutOfTabOrder() {
    document.querySelectorAll<HTMLElement>('.event-tooltip a').forEach((a) => (a.tabIndex = -1));
  }
  keepTooltipsOutOfTabOrder();

  const VIEW_STORAGE_KEY = 'bwb-calendar-view';

  function saveActiveView(view: string) {
    try {
      localStorage.setItem(VIEW_STORAGE_KEY, view);
    } catch {
      // ignore — the toggle still works for this page load, it just won't persist.
    }
  }

  viewToggleButtons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const view = btn.dataset.view ?? 'calendar';
      setActiveView(view);
      saveActiveView(view);
    })
  );

  let savedView = 'calendar';
  try {
    savedView = localStorage.getItem(VIEW_STORAGE_KEY) ?? 'calendar';
  } catch {
    // ignore — default to calendar.
  }
  setActiveView(savedView === 'list' ? 'list' : 'calendar');

  interface SiteEvent {
    id: string;
    title: string;
    description: string | null;
    location: string | null;
    event_type: string;
    color: string;
    visibility: 'public' | 'private' | 'test';
    start_time: string;
    end_time: string;
    google_recurring_event_id: string | null;
    price_whole_series: number | null;
    price_drop_in: number | null;
    price_student: number | null;
    image_url: string | null;
    flyer_url: string | null;
    registration_closed: boolean;
    price_whole_series_early_bird: number | null;
    price_drop_in_early_bird: number | null;
    price_student_early_bird: number | null;
    early_bird_until: string | null;
    price_whole_series_flash_sale: number | null;
    price_drop_in_flash_sale: number | null;
    price_student_flash_sale: number | null;
    flash_sale_until: string | null;
    lesson_overview_title: string | null;
    lesson_overview_body: string | null;
    hide_lesson_overview: boolean;
    capacity?: number | null;
    show_capacity?: boolean;
    capacity_by_role?: boolean;
    leader_capacity?: number | null;
    follower_capacity?: number | null;
    // e.g. "5 spots remaining". For the public only when show_capacity (or
    // something is full); always for admins, with spots_admin_only when hidden.
    spots_label?: string | null;
    spots_admin_only?: boolean;
    // Admin feed only: when the event was last edited (for the recent-color picks).
    updated_at?: string;
    weekNumber?: number | null;
  }

  let selectedType: 'class' | 'event' = 'class';
  let selectedColor: string = 'green';
  let editingId: string | null = null;
  let adminModeActive = false;
  let detailEvent: SiteEvent | null = null;
  let selectedRepeatDays = new Set<string>();
  let cachedAllEvents: SiteEvent[] = [];
  // Settles once the admin copy of the events (with capacities, which the
  // public page leaves out) has loaded.
  let adminEventsReady: Promise<void> = Promise.resolve();
  let editingRecurringId: string | null = null;
  let originalPattern: { byDay: string[]; count: number; interval: number } | null = null;
  // The occurrence open in the editor (null while adding), and for a "New
  // linked class" copy, the series it gets linked to when saved.
  let editingEvent: SiteEvent | null = null;
  let pendingLinkTo: string | null = null;

  const linkedEditor = initLinkedEditor<SiteEvent>({
    events: () => cachedAllEvents,
    current: () => ({ event: editingEvent, pendingLinkTo, eventType: selectedType }),
    authHeaders: withAuthHeader,
    // Its tab, when it has one.
    openEvent(event) {
      const i = editorTabs.findIndex((t) => t.key === seriesKeyOfEvent(event));
      if (i === -1) return editEvent(event);
      if (i === activeTab) return;
      stashActiveDraft();
      showTab(i);
    },
    linksChanged() {
      if (!editingEvent) return;
      const key = seriesKeyOfEvent(editingEvent);
      editorTabs = tabsFor(editingEvent, editorTabs);
      activeTab = Math.max(0, editorTabs.findIndex((t) => t.key === key));
      renderTabs();
    },
    newLinked: openNewLinked,
    flyerShared(flyerUrl, seriesKeys) {
      const keys = new Set(seriesKeys);
      for (const e of cachedAllEvents) if (keys.has(e.google_recurring_event_id ?? e.id)) e.flyer_url = flyerUrl;
      flyerUrlInput.value = flyerUrl;
      updateFlyerPreview();
      updateEditorSummaries();
    },
  });


  declare const google: any;
  let mapsBootstrapped = false;
  let locationAutocomplete: any = null;

  // Google's official dynamic-library-import bootstrap loader. Deliberately
  // NOT the simpler `<script src="...&libraries=places&loading=async">` +
  // onload approach — that races the `places` library against the main
  // script's load event and can silently leave `google.maps.places`
  // undefined on a cold load (it only "worked" in earlier manual testing
  // because the browser had a warm cache). `importLibrary` awaits the
  // specific library actually being ready.
  function bootstrapGoogleMaps(apiKey: string) {
    if (mapsBootstrapped) return;
    mapsBootstrapped = true;
    (g => {
      let h: any, a: any, k: string, p = 'The Google Maps JavaScript API', c = 'google', l = 'importLibrary', q = '__ib__',
        m = document, b: any = window;
      b = b[c] || (b[c] = {});
      let d = b.maps || (b.maps = {}), r = new Set<string>(), e = new URLSearchParams(),
        u = () => h || (h = new Promise(async (f: any, n: any) => {
          await (a = m.createElement('script'));
          e.set('libraries', [...r] + '');
          for (k in g) e.set(k.replace(/[A-Z]/g, (t) => '_' + t[0].toLowerCase()), (g as any)[k]);
          e.set('callback', c + '.maps.' + q);
          a.src = `https://maps.${c}apis.com/maps/api/js?` + e;
          d[q] = f;
          a.onerror = () => (h = n(new Error(p + ' could not load.')));
          a.nonce = (m.querySelector('script[nonce]') as HTMLScriptElement | null)?.nonce || '';
          m.head.append(a);
        }));
      d[l] ? console.warn(p + ' only loads once. Ignoring:', g) : (d[l] = (f: any, ...n: any[]) => r.add(f) && u().then(() => d[l](f, ...n)));
    })({ key: apiKey, v: 'weekly' });
  }

  let placesUnavailable = false;

  // When Google rejects the key (referrer not allowed, API not enabled,
  // billing/quota), the legacy Autocomplete widget only finds out on the
  // first prediction request a few keystrokes in. It then disables the input
  // and swaps the placeholder for "Oops! Something went wrong.", locking the
  // admin out of the field. Google calls `window.gm_authFailure` when this
  // happens, so swap in a fresh clone of the input (dropping the widget's
  // listeners) and fall back to plain-text entry for the rest of the visit.
  function installPlacesAuthFailureFallback() {
    (window as any).gm_authFailure = () => {
      console.error(
        'Google Maps rejected the API key (check its HTTP referrer restrictions and that the Places API is enabled). Location field falls back to plain text.'
      );
      placesUnavailable = true;
      // Google may finish disabling the input after this callback returns.
      setTimeout(restorePlainLocationInput, 0);
    };
  }

  function restorePlainLocationInput() {
    if (locationAutocomplete) google.maps.event.clearInstanceListeners(locationAutocomplete);
    locationAutocomplete = null;
    document.querySelectorAll('.pac-container').forEach((el) => el.remove());

    const typed = locationInput.value;
    const fresh = locationInput.cloneNode(false) as HTMLInputElement;
    fresh.disabled = false;
    fresh.classList.remove('gm-err-autocomplete');
    fresh.removeAttribute('style');
    fresh.removeAttribute('autocomplete');
    fresh.placeholder = 'Location';
    fresh.value = typed;
    const hadFocus = document.activeElement === locationInput;
    locationInput.replaceWith(fresh);
    locationInput = fresh;
    if (hadFocus) fresh.focus();
  }

  async function initLocationAutocomplete() {
    if (locationAutocomplete || placesUnavailable) return;

    try {
      const headers = await withAuthHeader();
      if (!headers) return;
      const usageRes = await fetch('/api/admin/places-usage-check', { headers });
      const { allowed } = await usageRes.json();
      if (!allowed) {
        console.warn('Daily Places Autocomplete usage cap reached — location field will accept plain text only today.');
        return;
      }

      const apiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY;
      if (!apiKey) throw new Error('Missing PUBLIC_GOOGLE_MAPS_API_KEY.');
      bootstrapGoogleMaps(apiKey);
      const { Autocomplete } = await google.maps.importLibrary('places');

      installPlacesAuthFailureFallback();
      locationAutocomplete = new Autocomplete(locationInput, {
        fields: ['name', 'formatted_address'],
      });
      locationAutocomplete.addListener('place_changed', () => {
        const place = locationAutocomplete.getPlace();
        locationInput.value = place?.name || place?.formatted_address || locationInput.value;
      });
    } catch (err) {
      console.error('Failed to initialize location autocomplete:', err);
    }
  }

