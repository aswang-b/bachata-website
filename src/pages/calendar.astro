---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { supabase } from '../lib/supabase';
import { publicVisibilities } from '../lib/testMode';
import { getActivePrice, priceTierLabel } from '../lib/pricing';
import { getSpotsByOccurrence, publicSpotsLabel, type SpotsInfo } from '../lib/capacity';
import { eventBannerStyle, eventDotStyle, eventTextStyle } from '../lib/eventColors';
import { eventTypeLabel } from '../lib/classSeries';
import { locationHref } from '../lib/locationLink';
import { scaledImageUrl } from '../lib/eventImages';
import FlyerDialog from '../components/FlyerDialog.astro';
import { siteFormatter, zonedDateKey, zonedParts, zonedToInstant } from '../lib/siteTime';
import { calendarOrder, seriesFirstOccurrences } from '../lib/eventTimes';

const pad2 = (n: number) => String(n).padStart(2, '0');

// Months and days are the site time zone's (siteTime.ts), not the server's
// (UTC on Netlify, which put an 8 PM class on the next day). The month grid
// itself is plain calendar arithmetic, done in UTC so no zone shifts it.
const monthParam = Astro.url.searchParams.get('month');
const nowParts = zonedParts(new Date());
let year = nowParts.year;
let month = nowParts.month - 1;
if (monthParam && /^\d{4}-\d{2}$/.test(monthParam)) {
  const [y, m] = monthParam.split('-').map(Number);
  year = y;
  month = m - 1;
}

const startWeekday = new Date(Date.UTC(year, month, 1)).getUTCDay();
const daysInMonth = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
const monthLabel = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(Date.UTC(year, month, 15)));
const weekdayLabels = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

const monthKey = (y: number, m: number) => {
  const d = new Date(Date.UTC(y, m, 1));
  return `${d.getUTCFullYear()}-${pad2(d.getUTCMonth() + 1)}`;
};
const prevMonthParam = monthKey(year, month - 1);
const nextMonthParam = monthKey(year, month + 1);

const monthStart = zonedToInstant(`${monthKey(year, month)}-01`);
const monthEnd = zonedToInstant(`${nextMonthParam}-01`);

const EVENT_COLUMNS =
  'id, title, description, location, event_type, color, visibility, start_time, end_time, google_recurring_event_id, price_whole_series, price_drop_in, price_student, image_url, flyer_url, registration_closed, price_whole_series_early_bird, price_drop_in_early_bird, price_student_early_bird, early_bird_until, price_whole_series_flash_sale, price_drop_in_flash_sale, price_student_flash_sale, flash_sale_until, lesson_overview_title, lesson_overview_body, hide_lesson_overview, capacity, show_capacity, capacity_by_role, leader_capacity, follower_capacity';

const { data: monthEvents, error: monthError } = await supabase
  .from('events')
  .select(EVENT_COLUMNS)
  .in('visibility', publicVisibilities())
  .gte('start_time', monthStart.toISOString())
  .lt('start_time', monthEnd.toISOString())
  .order('start_time', { ascending: true });

const { data: upcomingEvents, error: upcomingError } = await supabase
  .from('events')
  .select(EVENT_COLUMNS)
  .in('visibility', publicVisibilities())
  .gte('start_time', new Date(Date.now() - 24 * 60 * 60 * 1000).toISOString())
  .order('start_time', { ascending: true })
  .limit(20);

if (monthError) console.error('Failed to load month events:', monthError);
if (upcomingError) console.error('Failed to load upcoming events:', upcomingError);

// Spots remaining per occurrence as a label, sent to the page only where the
// class or event shows its capacity publicly (or a role or the class is full;
// the capacities themselves are never sent; admins get theirs from
// /api/admin/all-events).
let spotsByOccurrence = new Map<string, SpotsInfo>();
try {
  spotsByOccurrence = await getSpotsByOccurrence(monthEvents ?? []);
} catch {
  // Show the calendar without spots rather than failing the page.
}
const gridEvents = (monthEvents ?? []).map(({ capacity: _capacity, leader_capacity: _leaderCapacity, follower_capacity: _followerCapacity, ...event }) => ({
  ...event,
  spots_label: publicSpotsLabel(spotsByOccurrence.get(event.id) ?? null, event.show_capacity),
}));
const sidebarEvents = upcomingEvents ?? [];

// Position within the series (1-indexed), for the "Week N" tag on any event
// that's part of a recurring series. Computed from every occurrence sharing
// that recurring id — not just this month's — so numbering stays correct
// regardless of which month is being viewed.
const recurringIds = [...new Set(gridEvents.map((e) => e.google_recurring_event_id).filter((id): id is string => Boolean(id)))];
const weekNumberByEventId = new Map<string, number>();
let seriesFirsts = seriesFirstOccurrences(gridEvents);
if (recurringIds.length > 0) {
  const { data: seriesOccurrences, error: seriesError } = await supabase
    .from('events')
    .select('id, google_recurring_event_id, start_time, end_time')
    .in('google_recurring_event_id', recurringIds)
    .order('start_time', { ascending: true });

  if (seriesError) console.error('Failed to load series occurrences for week numbering:', seriesError);
  seriesFirsts = seriesFirstOccurrences([...gridEvents, ...(seriesOccurrences ?? [])]);

  const bySeriesKey = new Map<string, { id: string }[]>();
  for (const occ of seriesOccurrences ?? []) {
    const key = occ.google_recurring_event_id as string;
    const list = bySeriesKey.get(key) ?? [];
    list.push(occ);
    bySeriesKey.set(key, list);
  }
  // A lone class has no week number: it's shown as a Workshop, not "Wk 1".
  for (const occs of bySeriesKey.values()) {
    if (occs.length > 1) occs.forEach((occ, idx) => weekNumberByEventId.set(occ.id, idx + 1));
  }
}
// Same-time classes keep one order week to week (the banners and the list follow it).
gridEvents.sort(calendarOrder(seriesFirsts));


function formatPrice(value: number): string {
  return Number.isInteger(value) ? `$${value}` : `$${value.toFixed(2)}`;
}

interface PricedEvent {
  price_whole_series: number | null;
  price_drop_in: number | null;
  price_student: number | null;
  price_whole_series_early_bird: number | null;
  price_drop_in_early_bird: number | null;
  price_student_early_bird: number | null;
  early_bird_until: string | null;
  price_whole_series_flash_sale: number | null;
  price_drop_in_flash_sale: number | null;
  price_student_flash_sale: number | null;
  flash_sale_until: string | null;
}

function priceTypeHtml(label: string, event: PricedEvent, field: 'whole' | 'dropIn' | 'student', suffix = ''): string {
  const base = field === 'whole' ? event.price_whole_series : field === 'dropIn' ? event.price_drop_in : event.price_student;
  if (base == null) return '';
  const earlyBird = field === 'whole' ? event.price_whole_series_early_bird : field === 'dropIn' ? event.price_drop_in_early_bird : event.price_student_early_bird;
  const flashSale = field === 'whole' ? event.price_whole_series_flash_sale : field === 'dropIn' ? event.price_drop_in_flash_sale : event.price_student_flash_sale;
  const result = getActivePrice(new Date(), {
    base,
    earlyBird,
    earlyBirdUntil: event.early_bird_until,
    flashSale,
    flashSaleUntil: event.flash_sale_until,
  });
  const prefix = label ? `${label}: ` : '';
  if (result.display === 'original') return `${prefix}${formatPrice(result.originalPrice!)}${suffix}`;
  return `${prefix}<s class="text-muted">${formatPrice(result.originalPrice!)}</s> ${formatPrice(result.activePrice!)}${suffix} <span class="rounded-full bg-accent/15 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-accent">${priceTierLabel(result.tag)}</span>`;
}

function buildPriceLines(event: PricedEvent & { event_type?: string }, weekNumber: number | null): { main: string; student: string } {
  // Events have a single ticket price (with its own early bird / flash sale).
  if (event.event_type === 'event') return { main: priceTypeHtml('Ticket', event, 'whole'), student: '' };
  // A workshop (a class that doesn't repeat) has one price: what registration
  // charges for it, its whole-series price, or its drop-in price without one.
  if (!weekNumber) {
    return { main: priceTypeHtml('Workshop', event, event.price_whole_series != null ? 'whole' : 'dropIn'), student: priceTypeHtml('Student Discount', event, 'student') };
  }
  const perClass = event.event_type === 'event' ? '' : '/class';
  const whole = priceTypeHtml('Whole Series', event, 'whole');
  const dropIn = priceTypeHtml('Drop In', event, 'dropIn', perClass);
  const parts = [whole, dropIn].filter(Boolean);
  const student = priceTypeHtml('Student Discount', event, 'student', perClass);
  return { main: parts.join(' &middot; '), student };
}

const eventsByDate = new Map<string, typeof gridEvents>();
for (const event of gridEvents) {
  const key = zonedDateKey(event.start_time);
  const existing = eventsByDate.get(key) ?? [];
  existing.push(event);
  eventsByDate.set(key, existing);
}

// Each cell is a "YYYY-MM-DD" day (null pads the first week).
const cells: { date: string | null; day: number }[] = [];
for (let i = 0; i < startWeekday; i++) cells.push({ date: null, day: 0 });
for (let day = 1; day <= daysInMonth; day++) cells.push({ date: `${monthKey(year, month)}-${pad2(day)}`, day });

const todayKey = zonedDateKey(new Date());
const timeFormatter = siteFormatter({ hour: 'numeric', minute: '2-digit' });
const dateFormatter = siteFormatter({ weekday: 'short', month: 'short', day: 'numeric' });
const monthAbbrevFormatter = siteFormatter({ month: 'short' });
const weekdayAbbrevFormatter = siteFormatter({ weekday: 'short' });
const MAX_BANNERS_PER_DAY = 3;
// Phone dots: rows of two for up to 4 events, rows of three for 5 or 6 (3 over 2,
// 3 and 3). More than 6 shows 6; tapping the day lists them all.
const MAX_DOTS = 6;
const dotColumns = (count: number) => (count > 4 ? 'grid-cols-3' : 'grid-cols-2');
---

<BaseLayout
  title="Class & Event Calendar"
  description="Browse upcoming bachata classes, workshops, and social dance events in Madison, WI, and register directly from the calendar."
>
  <div class="mx-auto max-w-[1700px] px-6 py-16">
    <div class="mb-10 flex flex-col items-center gap-4">
      <div class="flex items-center justify-center gap-6">
        <a
          href={`/calendar?month=${prevMonthParam}`}
          aria-label="Previous month"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-ink transition-colors hover:bg-surface"
        >
          &larr;
        </a>
        <div class="text-center">
          <p class="text-sm font-bold uppercase tracking-[0.3em] text-accent">Classes &amp; Events</p>
          <h1 class="mt-1 font-display text-3xl font-extrabold text-ink">{monthLabel}</h1>
        </div>
        <a
          href={`/calendar?month=${nextMonthParam}`}
          aria-label="Next month"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-ink transition-colors hover:bg-surface"
        >
          &rarr;
        </a>
      </div>
      <button
        id="add-event-btn"
        class="gradient-accent hidden rounded-full px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-white transition-opacity hover:opacity-90"
      >
        + Add Event
      </button>

      <div class="inline-flex rounded-full border border-border p-1">
        <button
          id="view-toggle-calendar"
          data-view="calendar"
          class="view-toggle-btn rounded-full px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-ink/70 transition-colors"
        >
          Calendar
        </button>
        <button
          id="view-toggle-list"
          data-view="list"
          class="view-toggle-btn rounded-full px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-ink/70 transition-colors"
        >
          List
        </button>
      </div>
    </div>

    <div id="calendar-view" class="flex flex-col items-start gap-4 lg:flex-row lg:justify-center">
      <div class="w-full lg:flex-1">
        <div
          id="calendar-grid"
          data-year={year}
          data-month={month}
          class="mx-auto max-w-6xl rounded-3xl border border-border bg-bg p-4 shadow-[0_2px_16px_rgba(0,0,0,0.05)]"
        >
          <div class="grid grid-cols-7 text-center text-xs font-semibold uppercase tracking-wider text-muted">
            {weekdayLabels.map((label) => <div class="py-2">{label}</div>)}
          </div>
          {/* Hairline gridlines: the grid draws its top/left edge, each cell its right/bottom. */}
          <div id="calendar-cells" class="grid grid-cols-7 border-l border-t border-border/30">
            {cells.map(({ date, day }) => {
              const dayEvents = date ? eventsByDate.get(date) ?? [] : [];
              const isToday = date === todayKey;
              const dateKey = date ?? '';
              // Banners get roomy treatment (wrap, show the full title) for
              // the common case of 1-2 events a day. A busier day — meant to
              // stay rare — shrinks back to compact truncated banners rather
              // than ballooning the cell height.
              const isCompact = dayEvents.length > 2;
              return (
                <div
                  class={`calendar-cell flex flex-col gap-0.5 border-b border-r border-border/30 p-1 text-sm min-h-[2.75rem] sm:gap-1 ${isCompact ? 'sm:min-h-[6.5rem]' : 'sm:min-h-[7.5rem]'}`}
                  data-date={dateKey}
                >
                  {date && (
                    <span class={`text-xs ${isToday ? 'inline-flex h-4 w-4 items-center justify-center rounded-full bg-accent font-bold text-white sm:h-5 sm:w-5' : 'text-ink/70'}`}>
                      {day}
                    </span>
                  )}
                  <div class="day-banners hidden flex-1 flex-col gap-1 sm:flex">
                    {dayEvents.slice(0, MAX_BANNERS_PER_DAY).map((event) => {
                      const weekNumber = weekNumberByEventId.get(event.id) ?? null;
                      return (
                      <div class="event-banner group relative cursor-pointer rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" role="button" tabindex="0" data-event={JSON.stringify({ ...event, weekNumber })}>
                        <div
                          class={
                            isCompact
                              ? `truncate rounded px-1 py-0.5 text-[10px] font-semibold`
                              : `event-banner-label whitespace-normal rounded-lg px-2 py-1.5 text-xs font-semibold leading-snug`
                          }
                          style={eventBannerStyle(event.color)}
                        >
                          {/* The space after the pill lets the title wrap below it in a narrow cell. */}
                          {weekNumber && <><span class="whitespace-nowrap rounded bg-white/25 px-1 py-0.5 text-[9px] font-bold uppercase tracking-wide">Wk {weekNumber}</span>{' '}</>}
                          {event.title}
                        </div>
                        <div aria-hidden="true" class="event-tooltip pointer-events-none absolute left-1/2 top-full z-30 mt-2 hidden max-h-[calc(100vh-1rem)] w-96 -translate-x-1/2 overflow-hidden rounded-2xl border-2 border-ink bg-bg p-4 text-left shadow-xl group-hover:block group-focus-visible:block">
                          <p class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-wider" style={eventTextStyle(event.color)}>
                            <span class="h-2 w-2 rounded-full" style={eventDotStyle(event.color)}></span>
                            {eventTypeLabel(event.event_type, weekNumber)}
                            {weekNumber && <span class="font-bold text-ink">&middot; Week {weekNumber}</span>}
                          </p>
                          <p class="mt-1 font-display font-bold text-ink">{event.title}</p>
                          <p class="mt-1 text-xs text-muted">
                            {dateFormatter.format(new Date(event.start_time))} &middot; {timeFormatter.format(new Date(event.start_time))}{event.end_time && `–${timeFormatter.format(new Date(event.end_time))}`}
                          </p>
                          {event.description && (
                            <>
                              <div class="tooltip-desc line-clamp-6 mt-1 text-xs text-ink/70 [&_a]:text-accent [&_a]:underline [&_ol]:list-decimal [&_ol]:pl-4 [&_ul]:list-disc [&_ul]:pl-4" set:html={event.description} />
                              <p class="tooltip-more mt-1 hidden text-[10px] font-bold uppercase tracking-wider text-accent">Click for full details</p>
                            </>
                          )}
                          {buildPriceLines(event, weekNumber).main && <p class="mt-1 text-xs font-semibold text-ink" set:html={buildPriceLines(event, weekNumber).main} />}
                          {buildPriceLines(event, weekNumber).student && <p class="text-xs font-semibold text-ink" set:html={buildPriceLines(event, weekNumber).student} />}
                          {event.spots_label && <p class="mt-1 text-xs font-bold text-accent">{event.spots_label}</p>}
                          {event.location && (
                            <a
                              href={locationHref(event.location)}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="pointer-events-auto mt-1 block text-xs font-semibold text-accent"
                              onclick="event.stopPropagation()"
                            >
                              <span aria-hidden="true">📍</span> <span class="underline">{event.location}</span>
                            </a>
                          )}
                        </div>
                      </div>
                      );
                    })}
                    {dayEvents.length > MAX_BANNERS_PER_DAY && (
                      <p class="text-[10px] font-semibold text-muted">+{dayEvents.length - MAX_BANNERS_PER_DAY} more</p>
                    )}
                  </div>
                  {/* Every event of the day rides along (data-events) for the list a tap opens. */}
                  <div
                    class={`day-dots grid w-fit cursor-pointer ${dotColumns(dayEvents.length)} content-start items-center justify-items-center gap-[3px] self-center sm:hidden`}
                    data-events={JSON.stringify(dayEvents.map((event) => ({ ...event, weekNumber: weekNumberByEventId.get(event.id) ?? null })))}
                  >
                    {dayEvents.slice(0, MAX_DOTS).map((event) => (
                      <span class="h-1.5 w-1.5 rounded-full" style={eventDotStyle(event.color)}></span>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>

      <div class="w-full lg:w-[460px] lg:shrink-0">
        <div id="event-detail-panel" class="sticky top-[calc(var(--site-top-h,4rem)+2rem)] rounded-3xl border border-border bg-bg p-5 shadow-[0_2px_16px_rgba(0,0,0,0.05)]">
          <p id="detail-placeholder" class="text-sm text-muted">Click an event to see details here.</p>
          <div id="detail-content" class="hidden flex-col gap-2">
            <p id="detail-type" class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider"></p>
            <p id="detail-title" tabindex="-1" class="font-display text-lg font-bold text-ink focus:outline-none"></p>
            <p id="detail-datetime" class="text-sm text-muted"></p>
            <div id="detail-description" class="text-sm text-ink/70 [&_a]:text-accent [&_a]:underline [&_ol]:list-decimal [&_ol]:pl-5 [&_ul]:list-disc [&_ul]:pl-5"></div>
            <p id="detail-price" class="hidden text-sm font-semibold text-ink"></p>
            <p id="detail-price-student" class="hidden text-sm font-semibold text-ink"></p>
            <p id="detail-spots" class="hidden text-sm font-bold text-accent"></p>
            <a
              id="detail-location"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="hidden text-sm font-semibold text-accent"
            ></a>
            <div class="mt-1 flex flex-wrap items-center gap-2">
              <a
                id="detail-register-btn"
                href="#"
                class="gradient-accent hidden rounded-full px-6 py-2.5 text-center text-sm font-bold uppercase tracking-wider text-white transition-opacity hover:opacity-90"
              >
                Register Now
              </a>
              {/* Shown for a class or event with a flyer; opens the shared flyer viewer (FlyerDialog). */}
              <button
                id="detail-flyer-btn"
                type="button"
                class="hidden items-center gap-1.5 rounded-full border border-accent px-5 py-2.5 text-sm font-bold uppercase tracking-wider text-accent transition-colors hover:bg-accent hover:text-white"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-5-5L5 21" /></svg>
                See flyer
              </button>
            </div>
            <div id="detail-admin-actions" class="admin-only mt-3 hidden flex-wrap gap-2">
              <button id="detail-edit-btn" class="rounded-full border border-accent px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-accent transition-colors hover:bg-accent hover:text-white">
                Edit
              </button>
              <button id="detail-delete-btn" class="rounded-full border border-red-300 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-red-600 transition-colors hover:bg-red-600 hover:text-white">
                Delete
              </button>
              <button id="detail-delete-series-btn" class="hidden rounded-full border border-red-300 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-red-600 transition-colors hover:bg-red-600 hover:text-white">
                Delete Series
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div id="list-view" class="mx-auto hidden w-full max-w-4xl flex-col gap-3">
      {gridEvents.length === 0 ? (
        <p class="py-8 text-center text-sm text-muted">No classes or events scheduled this month.</p>
      ) : (
        gridEvents.map((event) => {
          const start = new Date(event.start_time);
          const isToday = zonedDateKey(start) === todayKey;
          const weekNumber = weekNumberByEventId.get(event.id) ?? null;
          const priceLines = buildPriceLines(event, weekNumber);
          const seriesKey = event.google_recurring_event_id ?? event.id;
          const registerBase = event.event_type === 'event' ? '/register/events' : '/register';
          const registerHref = `${registerBase}?series=${encodeURIComponent(seriesKey)}`;
          const monthAbbrev = monthAbbrevFormatter.format(start).toUpperCase();
          const weekdayAbbrev = weekdayAbbrevFormatter.format(start).toUpperCase();

          return (
            <div class={`flex flex-col overflow-hidden rounded-2xl border sm:flex-row ${isToday ? 'border-accent' : 'border-border'} bg-bg`}>
              <div class="flex flex-1 flex-col gap-3 overflow-hidden p-3 sm:flex-row sm:gap-4">
              <div
                class={`flex w-16 shrink-0 flex-col items-center justify-center rounded-xl py-2 ${
                  isToday ? 'gradient-accent text-white' : 'bg-surface text-ink'
                }`}
              >
                <span class="text-[10px] font-bold uppercase tracking-wider">{monthAbbrev}</span>
                <span class="text-2xl font-extrabold">{zonedParts(start).day}</span>
                <span class="text-[10px] font-bold uppercase tracking-wider">{weekdayAbbrev}</span>
              </div>

              <div class="flex flex-1 flex-col gap-1 overflow-hidden">
                <div class="flex items-center gap-2">
                  <span class="h-2 w-2 shrink-0 rounded-full" style={eventDotStyle(event.color)} />
                  <p class="font-display font-bold text-ink">
                    {event.title}
                    {weekNumber && <span class="ml-1 text-xs font-semibold text-muted">&middot; Week {weekNumber}</span>}
                  </p>
                </div>
                <p class="text-xs text-muted">
                  {timeFormatter.format(start)}&ndash;{timeFormatter.format(new Date(event.end_time))}
                  {event.location && (
                    <>
                      {' '}
                      &middot;{' '}
                      <a href={locationHref(event.location)} target="_blank" rel="noopener noreferrer" class="text-accent">
                        <span aria-hidden="true">📍</span> <span class="underline">{event.location}</span>
                      </a>
                    </>
                  )}
                </p>
                {event.description && (
                  <>
                    <div
                      class="list-desc line-clamp-2 text-xs text-ink/70 [&_a]:text-accent [&_a]:underline [&_ol]:list-decimal [&_ol]:pl-4 [&_ul]:list-disc [&_ul]:pl-4"
                      set:html={event.description}
                    />
                    {/* Shown by the script below only when the description is cut off. */}
                    <button type="button" class="list-desc-toggle hidden self-start text-xs font-semibold text-accent hover:underline" aria-expanded="false">
                      Read more
                    </button>
                  </>
                )}
                {priceLines.main && <p class="text-xs font-semibold text-ink" set:html={priceLines.main} />}
                {event.spots_label && <p class="text-xs font-bold text-accent">{event.spots_label}</p>}
                {event.flyer_url && (
                  <button type="button" data-flyer-open={event.flyer_url} data-flyer-alt={`Flyer for ${event.title}`} class="list-flyer-link mt-1 inline-flex items-center gap-1.5 self-start text-xs font-bold uppercase tracking-wider text-accent hover:underline sm:hidden">
                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-5-5L5 21" /></svg>
                    See flyer
                  </button>
                )}
              </div>
              {/* The class's flyer, small; it opens full size in the shared flyer viewer. */}
              {event.flyer_url && (
                <button type="button" data-flyer-open={event.flyer_url} class="list-flyer-thumb group hidden shrink-0 self-center sm:block">
                  <img src={scaledImageUrl(event.flyer_url, 240)} alt={`Flyer for ${event.title}`} loading="lazy" decoding="async" class="h-24 w-auto max-w-28 rounded-lg border border-border object-contain transition-transform group-hover:scale-[1.04]" />
                </button>
              )}
              </div>

              {/* Full-height edge strip with an arrow (a bottom bar on phones) instead of a Register Now pill. */}
              {event.registration_closed ? (
                <span
                  class="flex h-10 shrink-0 items-center justify-center border-t border-border bg-surface text-[10px] font-bold uppercase tracking-wider text-ink/40 sm:h-auto sm:w-16 sm:border-l sm:border-t-0"
                  title="Registration is closed"
                >
                  Closed
                </span>
              ) : (
                <a
                  href={registerHref}
                  aria-label={`Register for ${event.title}`}
                  title="Register"
                  class="flex h-10 shrink-0 items-center justify-center border-t border-border bg-surface text-ink/60 transition-colors hover:bg-accent hover:text-white focus-visible:bg-accent focus-visible:text-white sm:h-auto sm:w-14 sm:border-l sm:border-t-0"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
                  </svg>
                </a>
              )}
            </div>
          );
        })
      )}
    </div>
  </div>

  {/* The event editor (above the cookie banner, below the image cropper): a header (title, type, color, status), a section menu
      (a list on the left on wide screens, a sideways-scrolling chip row on
      phones), and collapsible sections. Picking a section in the menu opens
      it and scrolls it into view. */}
  <div id="event-modal" class="fixed inset-0 z-[55] hidden items-stretch justify-center bg-black/40 sm:items-center sm:p-4">
    <div class="flex h-full w-full flex-col bg-bg shadow-2xl sm:h-auto sm:max-h-[90vh] sm:max-w-5xl sm:rounded-2xl">
      <div class="flex flex-col gap-3 border-b border-border px-4 pb-4 pt-3 sm:px-6 sm:pt-5">
        <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2 sm:flex-nowrap">
          <h3 id="modal-heading" class="text-xs font-bold uppercase tracking-wider text-muted">Add Event</h3>
          {/* One tab per linked class (Linked Classes/Events), in the heading's place (on phones, its own row under it); a dot marks unsaved changes. */}
          <div
            id="event-tabs"
            role="tablist"
            aria-label="Linked classes"
            class="relative order-last -mb-1 hidden min-w-0 basis-full gap-1 overflow-x-auto sm:order-none sm:flex-1 sm:basis-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          ></div>
          <div class="ml-auto flex shrink-0 items-center gap-2">
            <div id="event-status-chips" class="flex flex-wrap justify-end gap-1.5"></div>
            <button type="button" id="event-close" aria-label="Close" class="flex h-9 w-9 items-center justify-center rounded-full text-ink/70 hover:bg-surface">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
            </button>
          </div>
        </div>
        <input
          id="event-title"
          type="text"
          placeholder="Add title"
          class="w-full border-b border-border bg-transparent pb-2 font-display text-xl font-bold text-ink focus:border-accent focus:outline-none sm:text-2xl"
        />
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
          <div class="flex w-full gap-2 sm:w-56">
            <button type="button" data-type="class" class="event-type-btn flex-1 rounded-full border px-3 py-1.5 text-sm font-semibold">
              Class
            </button>
            <button type="button" data-type="event" class="event-type-btn flex-1 rounded-full border px-3 py-1.5 text-sm font-semibold">
              Event
            </button>
          </div>
          {/* Any color from the picker, plus the five most recently used for one tap. */}
          <div class="flex flex-wrap items-center gap-3">
            <span class="text-sm text-muted">Color</span>
            <label class="relative flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-full bg-[conic-gradient(#ef4444,#eab308,#22c55e,#06b6d4,#3b82f6,#c084fc,#ef4444)] p-[3px]" title="Pick any color">
              <input
                id="event-color-picker"
                type="color"
                aria-label="Pick any color"
                class="h-full w-full cursor-pointer appearance-none rounded-full border-0 bg-transparent p-0 [&::-moz-color-swatch]:rounded-full [&::-moz-color-swatch]:border-0 [&::-webkit-color-swatch-wrapper]:p-0 [&::-webkit-color-swatch]:rounded-full [&::-webkit-color-swatch]:border-2 [&::-webkit-color-swatch]:border-bg"
              />
            </label>
            <span class="h-6 w-px bg-border" aria-hidden="true"></span>
            <div id="event-recent-colors" class="flex items-center gap-2" role="group" aria-label="Recently used colors"></div>
          </div>
        </div>
        <p id="event-series-banner" class="hidden rounded-xl border border-border bg-surface px-3 py-2 text-xs text-ink/80"></p>
      </div>

      <div class="flex min-h-0 flex-1 flex-col md:flex-row">
        <nav
          id="event-section-nav"
          aria-label="Editor sections"
          class="flex shrink-0 snap-x snap-proximity gap-2 overflow-x-auto scroll-smooth border-b border-border px-4 py-2.5 [mask-image:linear-gradient(to_right,transparent_0,#000_14px,#000_calc(100%-36px),transparent)] [scroll-padding-inline:16px] [scrollbar-width:none] md:w-60 md:snap-none md:flex-col md:gap-1 md:overflow-visible md:border-b-0 md:border-r md:px-3 md:py-4 md:[mask-image:none] [&::-webkit-scrollbar]:hidden"
        >
          {[
            ['schedule', 'Schedule'],
            ['details', 'Location & description'],
            ['registration', 'Registration'],
            ['pricing', 'Pricing'],
            ['homepage', 'Homepage card'],
            ['linked', 'Linked Classes/Events', 'Linked'],
          ].map(([id, label, short]) => (
            <button
              type="button"
              data-section={id}
              aria-current="false"
              class="event-nav-btn shrink-0 snap-start rounded-full border border-border px-4 py-2 text-left text-sm font-semibold text-ink/70 transition-colors aria-[current=true]:border-accent aria-[current=true]:bg-surface aria-[current=true]:text-ink md:rounded-lg md:border-transparent md:px-3 md:aria-[current=true]:border-transparent"
            >
              <span class="block whitespace-nowrap md:whitespace-normal">{id === 'details' || short ? <><span class="md:hidden">{short ?? 'Details'}</span><span class="hidden md:inline">{label}</span></> : label}</span>
              <span data-summary={id} class="hidden truncate text-xs font-normal text-muted md:block"></span>
            </button>
          ))}
        </nav>

        <div id="event-modal-scroll" class="themed-scrollbar relative flex min-h-0 flex-1 flex-col gap-3 overflow-y-auto scroll-smooth p-4 sm:p-6">
          <details id="sec-schedule" class="event-section group/sec scroll-mt-3 rounded-2xl border border-border open:border-accent/60">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 [&::-webkit-details-marker]:hidden">
              <span class="min-w-0"><span class="font-display font-bold text-ink">Schedule</span><span data-summary="schedule" class="block truncate text-xs text-muted md:hidden"></span></span>
              <svg class="h-5 w-5 shrink-0 text-muted transition-transform group-open/sec:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
            </summary>
            <div class="flex flex-col gap-3 border-t border-border p-4">
              <div class="grid gap-3 sm:grid-cols-3">
                <label class="flex flex-col gap-1.5">
                  <span class="text-xs font-semibold text-muted">Date</span>
                  <input id="event-date" type="date" class="rounded-xl border border-border bg-surface px-3 py-2 text-ink focus:border-accent focus:outline-none" />
                </label>
                <label class="flex flex-col gap-1.5">
                  <span class="text-xs font-semibold text-muted">Starts</span>
                  <input id="event-start-time" type="time" class="rounded-xl border border-border bg-surface px-3 py-2 text-ink focus:border-accent focus:outline-none" />
                </label>
                <label class="flex flex-col gap-1.5">
                  <span class="text-xs font-semibold text-muted">Ends</span>
                  <input id="event-end-time" type="time" class="rounded-xl border border-border bg-surface px-3 py-2 text-ink focus:border-accent focus:outline-none" />
                </label>
              </div>
              <p class="text-xs text-muted">Times use your browser's local timezone. An end time before the start is the next day.</p>

              <div id="event-recurrence-row" class="flex flex-col gap-2 border-t border-border pt-3 text-sm text-ink/80">
                <label class="flex items-center gap-2">
                  <input id="event-repeat" type="checkbox" class="h-4 w-4 rounded border-border" />
                  Repeats (a recurring series)
                </label>
                <p id="event-recurrence-hint" class="hidden pl-6 text-xs text-muted"></p>

                <div id="event-repeat-options" class="hidden flex-col gap-3 pl-6">
                  <label class="flex items-center gap-2">
                    Every
                    <input id="event-repeat-interval" type="number" min="1" max="52" value="1" class="w-14 rounded-lg border border-border bg-surface px-2 py-1" />
                    week(s)
                  </label>

                  <div class="flex gap-1">
                    {[
                      ['SU', 'S'],
                      ['MO', 'M'],
                      ['TU', 'T'],
                      ['WE', 'W'],
                      ['TH', 'T'],
                      ['FR', 'F'],
                      ['SA', 'S'],
                    ].map(([value, label]) => (
                      <button
                        type="button"
                        data-day={value}
                        class="repeat-day-btn flex h-8 w-8 items-center justify-center rounded-full border border-border text-xs font-semibold text-ink/70"
                      >
                        {label}
                      </button>
                    ))}
                  </div>

                  <div class="flex flex-col gap-1.5">
                    <span class="text-xs font-semibold uppercase tracking-wider text-muted">Ends</span>
                    <label class="flex items-center gap-2">
                      <input type="radio" name="repeat-end" value="count" checked class="h-4 w-4" />
                      After
                      <input id="event-repeat-count" type="number" min="1" max="52" value="4" class="w-14 rounded-lg border border-border bg-surface px-2 py-1" />
                      occurrences
                    </label>
                    <label class="flex items-center gap-2">
                      <input type="radio" name="repeat-end" value="until" class="h-4 w-4" />
                      On
                      <input id="event-repeat-until" type="date" class="rounded-lg border border-border bg-surface px-2 py-1" disabled />
                    </label>
                  </div>
                </div>
              </div>
            </div>
          </details>

          <details id="sec-details" class="event-section group/sec scroll-mt-3 rounded-2xl border border-border open:border-accent/60">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 [&::-webkit-details-marker]:hidden">
              <span class="min-w-0"><span class="font-display font-bold text-ink">Location &amp; description</span><span data-summary="details" class="block truncate text-xs text-muted md:hidden"></span></span>
              <svg class="h-5 w-5 shrink-0 text-muted transition-transform group-open/sec:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
            </summary>
            <div class="flex flex-col gap-3 border-t border-border p-4">
              <label class="flex flex-col gap-1.5">
                <span class="text-xs font-semibold text-muted">Location</span>
                <input
                  id="event-location"
                  type="text"
                  placeholder="Location"
                  class="rounded-xl border border-border bg-surface px-3 py-2 text-ink focus:border-accent focus:outline-none"
                />
              </label>
              <div class="flex flex-col gap-1.5">
                <span class="text-xs font-semibold text-muted">Description (also shown on Google Calendar)</span>
                <div class="flex flex-wrap gap-1 border-b border-border pb-1.5">
                  <button type="button" data-cmd="bold" class="description-format-btn rounded-lg px-2.5 py-1 text-sm font-bold text-ink/70 hover:bg-bg">B</button>
                  <button type="button" data-cmd="italic" class="description-format-btn rounded-lg px-2.5 py-1 text-sm italic text-ink/70 hover:bg-bg">I</button>
                  <button type="button" data-cmd="underline" class="description-format-btn rounded-lg px-2.5 py-1 text-sm underline text-ink/70 hover:bg-bg">U</button>
                  <button type="button" data-cmd="strikeThrough" class="description-format-btn rounded-lg px-2.5 py-1 text-sm line-through text-ink/70 hover:bg-bg">S</button>
                  <button type="button" data-cmd="insertUnorderedList" class="description-format-btn rounded-lg px-2.5 py-1 text-sm text-ink/70 hover:bg-bg" aria-label="Bulleted list" title="Bulleted list">&#8226;&nbsp;List</button>
                  <button type="button" data-cmd="insertOrderedList" class="description-format-btn rounded-lg px-2.5 py-1 text-sm text-ink/70 hover:bg-bg" aria-label="Numbered list" title="Numbered list">1.&nbsp;List</button>
                  <button type="button" id="event-description-link-btn" class="rounded-lg px-2.5 py-1 text-sm text-ink/70 hover:bg-bg">Link</button><span class="mx-1 w-px self-stretch bg-border" aria-hidden="true"></span><button type="button" data-rich-history="undo" data-rich-target="#event-description" aria-label="Undo" title="Undo (Ctrl+Z)" class="rounded-lg px-2.5 py-1 text-sm text-ink/70 hover:bg-bg">&#8630;</button><button type="button" data-rich-history="redo" data-rich-target="#event-description" aria-label="Redo" title="Redo (Ctrl+Y)" class="rounded-lg px-2.5 py-1 text-sm text-ink/70 hover:bg-bg">&#8631;</button>
                </div>
                <div
                  id="event-description"
                  contenteditable="true"
                  role="textbox"
                  aria-multiline="true"
                  aria-label="Description"
                  data-placeholder="Description"
                  class="event-description-editor min-h-20 rounded-xl border border-border bg-surface px-3 py-2 text-ink empty:before:text-muted/60 empty:before:content-[attr(data-placeholder)] focus:border-accent focus:outline-none [&_a]:text-accent [&_a]:underline [&_ol]:list-decimal [&_ol]:pl-5 [&_ul]:list-disc [&_ul]:pl-5"
                ></div>
              </div>
            </div>
          </details>

          <details id="sec-registration" class="event-section group/sec scroll-mt-3 rounded-2xl border border-border open:border-accent/60">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 [&::-webkit-details-marker]:hidden">
              <span class="min-w-0"><span class="font-display font-bold text-ink">Registration</span><span data-summary="registration" class="block truncate text-xs text-muted md:hidden"></span></span>
              <svg class="h-5 w-5 shrink-0 text-muted transition-transform group-open/sec:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
            </summary>
            <div class="flex flex-col gap-3 border-t border-border p-4">
              <label class="flex items-center gap-2 text-sm text-ink/80">
                <input id="event-registration-closed" type="checkbox" class="h-4 w-4 rounded border-border" />
                Registration closed (greys out Register Now everywhere this appears)
              </label>
              <label class="flex items-center gap-2 text-sm text-ink/80">
                <input id="event-private" type="checkbox" class="h-4 w-4 rounded border-border" />
                Private (only visible to admins)
              </label>

              <div class="flex flex-col gap-2 border-t border-border pt-3">
                {/* Classes can cap Leaders and Followers separately. Both sets of fields
                    keep their values; only the one the toggle shows is used. */}
                <label id="event-capacity-by-role-row" class="flex items-center justify-between gap-2 text-sm text-ink/80">
                  Separate Leader / Follower caps
                  <button
                    id="event-capacity-by-role"
                    type="button"
                    role="switch"
                    aria-checked="false"
                    class="group relative h-6 w-10 shrink-0 rounded-full bg-border transition-colors aria-checked:bg-accent"
                  >
                    <span class="absolute left-1 top-1 h-4 w-4 rounded-full bg-white shadow transition-transform group-aria-checked:translate-x-4"></span>
                  </button>
                </label>
                <label id="event-capacity-general" class="flex items-center gap-2 text-sm text-ink/80">
                  Capacity
                  <input
                    id="event-capacity"
                    type="number"
                    min="1"
                    step="1"
                    placeholder="No limit"
                    class="w-28 rounded-lg border border-border bg-surface px-2 py-1.5 text-sm text-ink focus:border-accent focus:outline-none"
                  />
                </label>
                <div id="event-capacity-roles" class="hidden flex-wrap items-center gap-x-4 gap-y-2 text-sm text-ink/80">
                  <label class="flex items-center gap-2">
                    Leaders
                    <input
                      id="event-leader-capacity"
                      type="number"
                      min="1"
                      step="1"
                      placeholder="No limit"
                      class="w-24 rounded-lg border border-border bg-surface px-2 py-1.5 text-sm text-ink focus:border-accent focus:outline-none"
                    />
                  </label>
                  <label class="flex items-center gap-2">
                    Followers
                    <input
                      id="event-follower-capacity"
                      type="number"
                      min="1"
                      step="1"
                      placeholder="No limit"
                      class="w-24 rounded-lg border border-border bg-surface px-2 py-1.5 text-sm text-ink focus:border-accent focus:outline-none"
                    />
                  </label>
                </div>
                <label class="flex items-center gap-2 text-sm text-ink/80">
                  <input id="event-show-capacity" type="checkbox" class="h-4 w-4 rounded border-border" />
                  Show "spots remaining" to registrants (otherwise only admins see it)
                </label>
                <p class="text-xs text-muted">Registration stops once it&rsquo;s full (with separate caps, a role stops once that role is full; a blank role has no limit).</p>
              </div>
            </div>
          </details>

          <details id="sec-pricing" class="event-section group/sec scroll-mt-3 rounded-2xl border border-border open:border-accent/60">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 [&::-webkit-details-marker]:hidden">
              <span class="min-w-0"><span class="font-display font-bold text-ink">Pricing</span><span data-summary="pricing" class="block truncate text-xs text-muted md:hidden"></span></span>
              <svg class="h-5 w-5 shrink-0 text-muted transition-transform group-open/sec:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
            </summary>
            {/* One row per price tier, one column per price type; the drop-in and student columns are classes-only. */}
            <div class="flex flex-col gap-2 border-t border-border p-4">
              <div id="event-price-grid" class="flex items-end gap-2">
                <span class="w-20 shrink-0 sm:w-24"></span>
                <span id="event-price-whole-label" class="w-0 flex-1 text-xs text-muted">Whole series</span>
                <span class="class-only-price w-0 flex-1 text-xs text-muted">Drop-in</span>
                <span class="class-only-price w-0 flex-1 text-xs text-muted">Student /class</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-20 shrink-0 text-xs font-semibold text-ink sm:w-24">Regular</span>
                <input id="event-price-whole-series" type="number" min="0" step="0.01" placeholder="$" class="w-0 flex-1 rounded-lg border border-border bg-surface px-2 py-1.5 text-sm text-ink focus:border-accent focus:outline-none" />
                <input id="event-price-drop-in" type="number" min="0" step="0.01" placeholder="$" class="class-only-price w-0 flex-1 rounded-lg border border-border bg-surface px-2 py-1.5 text-sm text-ink focus:border-accent focus:outline-none" />
                <input id="event-price-student" type="number" min="0" step="0.01" placeholder="$" class="class-only-price w-0 flex-1 rounded-lg border border-border bg-surface px-2 py-1.5 text-sm text-ink focus:border-accent focus:outline-none" />
              </div>
              <div class="flex items-center gap-2">
                <span class="w-20 shrink-0 text-xs font-semibold text-accent sm:w-24">Early bird</span>
                <input id="event-price-whole-series-early-bird" type="number" min="0" step="0.01" placeholder="$" class="w-0 flex-1 rounded-lg border border-border bg-surface px-2 py-1.5 text-sm text-ink focus:border-accent focus:outline-none" />
                <input id="event-price-drop-in-early-bird" type="number" min="0" step="0.01" placeholder="$" class="class-only-price w-0 flex-1 rounded-lg border border-border bg-surface px-2 py-1.5 text-sm text-ink focus:border-accent focus:outline-none" />
                <input id="event-price-student-early-bird" type="number" min="0" step="0.01" placeholder="$" class="class-only-price w-0 flex-1 rounded-lg border border-border bg-surface px-2 py-1.5 text-sm text-ink focus:border-accent focus:outline-none" />
              </div>
              <label class="flex items-center gap-2 pl-[5.5rem] sm:pl-[6.5rem]">
                <span class="text-xs text-muted">Until</span>
                <input id="event-early-bird-until" type="datetime-local" class="w-0 flex-1 rounded-lg border border-border bg-surface px-2 py-1.5 text-xs text-ink focus:border-accent focus:outline-none" />
              </label>
              <div class="flex items-center gap-2">
                <span class="w-20 shrink-0 text-xs font-semibold text-accent sm:w-24">Flash sale</span>
                <input id="event-price-whole-series-flash-sale" type="number" min="0" step="0.01" placeholder="$" class="w-0 flex-1 rounded-lg border border-border bg-surface px-2 py-1.5 text-sm text-ink focus:border-accent focus:outline-none" />
                <input id="event-price-drop-in-flash-sale" type="number" min="0" step="0.01" placeholder="$" class="class-only-price w-0 flex-1 rounded-lg border border-border bg-surface px-2 py-1.5 text-sm text-ink focus:border-accent focus:outline-none" />
                <input id="event-price-student-flash-sale" type="number" min="0" step="0.01" placeholder="$" class="class-only-price w-0 flex-1 rounded-lg border border-border bg-surface px-2 py-1.5 text-sm text-ink focus:border-accent focus:outline-none" />
              </div>
              <label class="flex items-center gap-2 pl-[5.5rem] sm:pl-[6.5rem]">
