  const dateInput = document.getElementById('event-date') as HTMLInputElement;
  const startTimeInput = document.getElementById('event-start-time') as HTMLInputElement;
  const endTimeInput = document.getElementById('event-end-time') as HTMLInputElement;
  const descriptionInput = document.getElementById('event-description') as HTMLElement;
  const locationInput = document.getElementById('event-location') as HTMLInputElement;
  const priceWholeSeriesInput = document.getElementById('event-price-whole-series') as HTMLInputElement;
  const priceDropInInput = document.getElementById('event-price-drop-in') as HTMLInputElement;
  const priceStudentInput = document.getElementById('event-price-student') as HTMLInputElement;
  const priceWholeSeriesEarlyBirdInput = document.getElementById('event-price-whole-series-early-bird') as HTMLInputElement;
  const priceDropInEarlyBirdInput = document.getElementById('event-price-drop-in-early-bird') as HTMLInputElement;
  const priceStudentEarlyBirdInput = document.getElementById('event-price-student-early-bird') as HTMLInputElement;
  const earlyBirdUntilInput = document.getElementById('event-early-bird-until') as HTMLInputElement;
  const priceWholeSeriesFlashSaleInput = document.getElementById('event-price-whole-series-flash-sale') as HTMLInputElement;
  const priceDropInFlashSaleInput = document.getElementById('event-price-drop-in-flash-sale') as HTMLInputElement;
  const priceStudentFlashSaleInput = document.getElementById('event-price-student-flash-sale') as HTMLInputElement;
  const flashSaleUntilInput = document.getElementById('event-flash-sale-until') as HTMLInputElement;
  const registrationClosedInput = document.getElementById('event-registration-closed') as HTMLInputElement;
  const lessonOverviewTitleInput = document.getElementById('event-lesson-overview-title') as HTMLInputElement;
  const lessonOverviewBodyInput = document.getElementById('event-lesson-overview-body') as HTMLElement;
  const hideLessonOverviewInput = document.getElementById('event-hide-lesson-overview') as HTMLInputElement;
  const lessonOverviewFields = document.getElementById('event-lesson-overview-fields')!;
  const imageUrlInput = document.getElementById('event-image-url') as HTMLInputElement;
  const imageFileInput = document.getElementById('event-image-file') as HTMLInputElement;
  const imagePreview = document.getElementById('event-image-preview') as HTMLImageElement;
  const imageUploadLabel = document.getElementById('event-image-upload-label')!;
  const imageRemoveBtn = document.getElementById('event-image-remove') as HTMLButtonElement;
  const imageError = document.getElementById('event-image-error')!;
  const privateInput = document.getElementById('event-private') as HTMLInputElement;
  const repeatInput = document.getElementById('event-repeat') as HTMLInputElement;
  const repeatOptions = document.getElementById('event-repeat-options')!;
  const repeatIntervalInput = document.getElementById('event-repeat-interval') as HTMLInputElement;
  const repeatDayButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.repeat-day-btn'));
  const repeatCountInput = document.getElementById('event-repeat-count') as HTMLInputElement;
  const repeatUntilInput = document.getElementById('event-repeat-until') as HTMLInputElement;
  const repeatEndRadios = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="repeat-end"]'));
  const recurrenceRow = document.getElementById('event-recurrence-row')!;
  const recurrenceHint = document.getElementById('event-recurrence-hint')!;
  const deleteBtn = document.getElementById('event-delete')!;
  const deleteSeriesBtn = document.getElementById('event-delete-series')!;
  const typeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.event-type-btn'));
  const colorButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.event-color-btn'));
  const syncIndicator = document.getElementById('sync-indicator')!;
  const syncIndicatorText = document.getElementById('sync-indicator-text')!;

  const detailPlaceholder = document.getElementById('detail-placeholder')!;
  const detailContent = document.getElementById('detail-content')!;
  const detailType = document.getElementById('detail-type')!;
  const detailTitle = document.getElementById('detail-title')!;
  const detailDatetime = document.getElementById('detail-datetime')!;
  const detailDescription = document.getElementById('detail-description')!;
  const detailPrice = document.getElementById('detail-price')!;
  const detailPriceStudent = document.getElementById('detail-price-student')!;
  const detailRegisterBtn = document.getElementById('detail-register-btn') as HTMLAnchorElement;
  const detailLocation = document.getElementById('detail-location') as HTMLAnchorElement;

  function formatPrice(value: number): string {
    return Number.isInteger(value) ? `$${value}` : `$${value.toFixed(2)}`;
  }

  function priceTypeHtml(label: string, event: SiteEvent, field: 'whole' | 'dropIn' | 'student', suffix = ''): string {
    const base = field === 'whole' ? event.price_whole_series : field === 'dropIn' ? event.price_drop_in : event.price_student;
    if (base == null) return '';
    const earlyBird = field === 'whole' ? event.price_whole_series_early_bird : field === 'dropIn' ? event.price_drop_in_early_bird : event.price_student_early_bird;
    const flashSale = field === 'whole' ? event.price_whole_series_flash_sale : field === 'dropIn' ? event.price_drop_in_flash_sale : event.price_student_flash_sale;
    const result = getActivePrice(new Date(), {
      base,
      earlyBird,
      earlyBirdUntil: event.early_bird_until,
      flashSale,
      flashSaleUntil: event.flash_sale_until,
    });
    if (result.display === 'original') return `${label}: ${formatPrice(result.originalPrice!)}${suffix}`;
    return `${label}: <s class="text-muted">${formatPrice(result.originalPrice!)}</s> ${formatPrice(result.activePrice!)}${suffix} <span class="rounded-full bg-accent/15 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-accent">${priceTierLabel(result.tag)}</span>`;
  }

  function buildPriceLines(event: SiteEvent): { main: string; student: string } {
    const parts: string[] = [];
    const whole = priceTypeHtml('Whole Series', event, 'whole');
    const dropIn = priceTypeHtml('Drop In', event, 'dropIn', '/class');
    if (whole) parts.push(whole);
    if (dropIn) parts.push(dropIn);
    const student = priceTypeHtml('Student Discount', event, 'student', '/class');
    return { main: parts.join(' &middot; '), student };
  }
  const detailAdminActions = document.getElementById('detail-admin-actions')!;
  const detailDeleteSeriesBtn = document.getElementById('detail-delete-series-btn')!;

  function renderTypeButtons() {
    for (const btn of typeButtons) {
      const active = btn.dataset.type === selectedType;
      btn.classList.toggle('gradient-accent', active);
      btn.classList.toggle('text-white', active);
      btn.classList.toggle('border-transparent', active);
      btn.classList.toggle('text-ink/70', !active);
      btn.classList.toggle('border-border', !active);
    }
  }

  function renderColorButtons() {
    for (const btn of colorButtons) {
      const active = btn.dataset.color === selectedColor;
      btn.classList.toggle('ring-2', active);
      btn.classList.toggle('ring-offset-2', active);
      btn.classList.toggle('ring-ink', active);
    }
  }

  function renderRepeatDayButtons() {
    for (const btn of repeatDayButtons) {
      const active = selectedRepeatDays.has(btn.dataset.day ?? '');
      btn.classList.toggle('gradient-accent', active);
      btn.classList.toggle('text-white', active);
      btn.classList.toggle('border-transparent', active);
      btn.classList.toggle('text-ink/70', !active);
      btn.classList.toggle('border-border', !active);
    }
  }

  const WEEKDAY_CODES = ['SU', 'MO', 'TU', 'WE', 'TH', 'FR', 'SA'];

  function toLocalParts(iso: string) {
    const d = new Date(iso);
    const pad = (n: number) => String(n).padStart(2, '0');
    return {
      date: `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`,
      time: `${pad(d.getHours())}:${pad(d.getMinutes())}`,
    };
  }

  function fromLocalParts(date: string, time: string) {
    return new Date(`${date}T${time}:00`).toISOString();
  }

  // datetime-local inputs want/give "YYYY-MM-DDTHH:mm" in local time.
  function toLocalDateTimeValue(iso: string | null | undefined): string {
    if (!iso) return '';
    const { date, time } = toLocalParts(iso);
    return `${date}T${time}`;
  }

  function fromLocalDateTimeValue(value: string): string | null {
    if (!value) return null;
    return new Date(value).toISOString();
  }

  function showEventDetail(event: SiteEvent) {
    detailEvent = event;
    detailPlaceholder.classList.add('hidden');
    detailContent.classList.remove('hidden');
    detailContent.classList.add('flex');

    const lock = event.visibility === 'private' ? '🔒 ' : '';
    detailType.className = `flex items-center gap-2 text-xs font-bold uppercase tracking-wider ${textClass(event.color)}`;
    detailType.innerHTML = `<span class="h-2 w-2 rounded-full ${dotClass(event.color)}"></span>${event.event_type === 'event' ? 'Event' : 'Class'}${event.weekNumber ? `<span class="font-bold text-ink">&middot; Week ${event.weekNumber}</span>` : ''}`;
    detailTitle.textContent = `${lock}${event.title}`;
    detailDatetime.textContent = `${dateFormatter.format(new Date(event.start_time))} · ${timeFormatter.format(new Date(event.start_time))}–${timeFormatter.format(new Date(event.end_time))}`;
    detailDescription.innerHTML = event.description ?? '';
    detailDescription.classList.toggle('hidden', !event.description);

    const priceLines = buildPriceLines(event);
    detailPrice.innerHTML = priceLines.main;
    detailPrice.classList.toggle('hidden', !priceLines.main);
    detailPriceStudent.innerHTML = priceLines.student;
    detailPriceStudent.classList.toggle('hidden', !priceLines.student);

    // Only public classes/events actually appear as a pickable series on
    // the registration pages — a private one would 404 the preselect, so
    // the button only shows where it can actually work.
    if (event.visibility === 'public' && event.registration_closed) {
      detailRegisterBtn.removeAttribute('href');
      detailRegisterBtn.textContent = 'Registration Closed';
      detailRegisterBtn.classList.remove('hidden', 'gradient-accent', 'hover:opacity-90');
      detailRegisterBtn.classList.add('bg-border', 'text-ink/50', 'pointer-events-none');
    } else if (event.visibility === 'public') {
      const seriesKey = event.google_recurring_event_id ?? event.id;
      const base = event.event_type === 'event' ? '/register/events' : '/register';
      detailRegisterBtn.href = `${base}?series=${encodeURIComponent(seriesKey)}`;
      detailRegisterBtn.textContent = 'Register Now';
      detailRegisterBtn.classList.remove('hidden', 'bg-border', 'text-ink/50', 'pointer-events-none');
      detailRegisterBtn.classList.add('gradient-accent', 'hover:opacity-90');
    } else {
      detailRegisterBtn.classList.add('hidden');
    }

    if (event.location) {
      detailLocation.href = locationHref(event.location);
      detailLocation.textContent = `📍 ${event.location}`;
      detailLocation.classList.remove('hidden');
    } else {
      detailLocation.classList.add('hidden');
    }

    detailDeleteSeriesBtn.classList.toggle('hidden', !event.google_recurring_event_id);

    if (adminModeActive) {
      detailAdminActions.classList.remove('hidden');
      detailAdminActions.classList.add('flex');
    }
  }

  // While the section is hidden the header/body are ignored, so dim them
  // (their values are kept in case the toggle is switched back off).
  function syncLessonOverviewFields() {
    lessonOverviewFields.classList.toggle('opacity-40', hideLessonOverviewInput.checked);
  }

  function openModal(mode: 'add' | 'edit', event?: SiteEvent, presetDate?: string) {
    editingId = event?.id ?? null;
    editingRecurringId = event?.google_recurring_event_id ?? null;
    modalHeading.textContent = mode === 'add' ? 'Add Event' : 'Edit Event';
    titleInput.value = event?.title ?? '';
    descriptionInput.innerHTML = event?.description ?? '';
    locationInput.value = event?.location ?? '';
    priceWholeSeriesInput.value = event?.price_whole_series != null ? String(event.price_whole_series) : '';
    priceDropInInput.value = event?.price_drop_in != null ? String(event.price_drop_in) : '';
    priceStudentInput.value = event?.price_student != null ? String(event.price_student) : '';
    priceWholeSeriesEarlyBirdInput.value = event?.price_whole_series_early_bird != null ? String(event.price_whole_series_early_bird) : '';
    priceDropInEarlyBirdInput.value = event?.price_drop_in_early_bird != null ? String(event.price_drop_in_early_bird) : '';
    priceStudentEarlyBirdInput.value = event?.price_student_early_bird != null ? String(event.price_student_early_bird) : '';
    earlyBirdUntilInput.value = toLocalDateTimeValue(event?.early_bird_until);
    priceWholeSeriesFlashSaleInput.value = event?.price_whole_series_flash_sale != null ? String(event.price_whole_series_flash_sale) : '';
    priceDropInFlashSaleInput.value = event?.price_drop_in_flash_sale != null ? String(event.price_drop_in_flash_sale) : '';
    priceStudentFlashSaleInput.value = event?.price_student_flash_sale != null ? String(event.price_student_flash_sale) : '';
    flashSaleUntilInput.value = toLocalDateTimeValue(event?.flash_sale_until);
    registrationClosedInput.checked = event?.registration_closed ?? false;
    lessonOverviewTitleInput.value = event?.lesson_overview_title ?? '';
    lessonOverviewBodyInput.innerHTML = event?.lesson_overview_body ?? '';
    hideLessonOverviewInput.checked = event?.hide_lesson_overview ?? false;
    syncLessonOverviewFields();
    imageUrlInput.value = event?.image_url ?? '';
    imageError.classList.add('hidden');
    updateImagePreview();
    selectedType = event?.event_type === 'event' ? 'event' : 'class';
    selectedColor = event?.color ?? 'green';
    privateInput.checked = event?.visibility === 'private';

    const isSeriesOccurrence = mode === 'edit' && Boolean(editingRecurringId);
    recurrenceRow.classList.toggle('hidden', !(mode === 'add' || isSeriesOccurrence));

    repeatOptions.classList.add('hidden');
    repeatOptions.classList.remove('flex');
    repeatIntervalInput.value = '1';
    repeatCountInput.value = '4';
    repeatUntilInput.disabled = true;
    repeatCountInput.disabled = false;
    repeatEndRadios.forEach((r) => (r.checked = r.value === 'count'));
    recurrenceHint.classList.add('hidden');
    originalPattern = null;

    if (isSeriesOccurrence && event) {
      const weekday = WEEKDAY_CODES[new Date(event.start_time).getDay()];
      selectedRepeatDays = new Set([weekday]);
      const siblingCount = cachedAllEvents.filter((e) => e.google_recurring_event_id === editingRecurringId).length || 1;
      repeatCountInput.value = String(siblingCount);
      // Existing series data doesn't track a stored interval, so default to 1 (weekly).
      repeatIntervalInput.value = '1';
      originalPattern = { byDay: [weekday], count: siblingCount, interval: 1 };

      repeatInput.checked = true;
      repeatOptions.classList.remove('hidden');
      repeatOptions.classList.add('flex');
      recurrenceHint.textContent = "This occurrence is part of a series. Uncheck 'This is a recurring event' to edit just this one instead of the whole series.";
      recurrenceHint.classList.remove('hidden');
    } else {
      repeatInput.checked = false;
    }

    if (event) {
      const start = toLocalParts(event.start_time);
      const end = toLocalParts(event.end_time);
      dateInput.value = start.date;
      startTimeInput.value = start.time;
      endTimeInput.value = end.time;
      if (!isSeriesOccurrence) {
        selectedRepeatDays = new Set([WEEKDAY_CODES[new Date(event.start_time).getDay()]]);
      }
    } else {
      const now = new Date();
      const pad = (n: number) => String(n).padStart(2, '0');
      const targetDate = presetDate ? new Date(`${presetDate}T00:00:00`) : now;
      dateInput.value = presetDate ?? `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
      startTimeInput.value = '18:00';
      endTimeInput.value = '19:00';
      selectedRepeatDays = new Set([WEEKDAY_CODES[targetDate.getDay()]]);
    }
    renderRepeatDayButtons();
    updateDateLockForSeriesEdit();

    deleteBtn.classList.toggle('hidden', mode === 'add');
    deleteSeriesBtn.classList.toggle('hidden', mode === 'add' || !editingRecurringId);
    renderTypeButtons();
    renderColorButtons();
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.getElementById('event-modal-scroll')!.scrollTop = 0;

    // Deferred until the modal (and its location input) is actually visible —
    // Google's Autocomplete widget measures the input's width when it's
    // constructed, and gets it wrong (an invisible, zero-width dropdown) if
    // that happens while the input is still display:none.
    if (adminModeActive) initLocationAutocomplete();
  }

  function closeModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    editingId = null;
  }

  function updateImagePreview() {
    const url = imageUrlInput.value;
    if (url) {
      imagePreview.src = url;
      imagePreview.classList.remove('hidden');
      imageRemoveBtn.classList.remove('hidden');
      imageUploadLabel.textContent = 'Replace Image';
    } else {
      imagePreview.classList.add('hidden');
      imagePreview.removeAttribute('src');
      imageRemoveBtn.classList.add('hidden');
      imageUploadLabel.textContent = 'Upload Image';
    }
  }

  imageFileInput.addEventListener('change', async () => {
    const picked = imageFileInput.files?.[0];
    imageFileInput.value = '';
    if (!picked) return;

    imageError.classList.add('hidden');

    // The admin chooses which region of the photo shows on the homepage before
    // anything uploads; only the cropped result is stored.
    let cropped: Blob | null;
    try {
      cropped = await openImageCropper(picked);
    } catch (err) {
      imageError.textContent = err instanceof Error ? err.message : "That file couldn't be read as an image.";
      imageError.classList.remove('hidden');
      return;
    }
    if (!cropped) return;

    imageUploadLabel.textContent = 'Uploading…';

    const headers = await withAuthHeader();
    if (!headers) {
      updateImagePreview();
      return;
    }

    const baseName = picked.name.replace(/\.[^.]+$/, '') || 'event';
    const body = new FormData();
    body.append('file', new File([cropped], `${baseName}-banner.jpg`, { type: 'image/jpeg' }));

    try {
      const res = await fetch('/api/admin/upload-event-image', { method: 'POST', headers, body });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? 'Failed to upload image.');
      imageUrlInput.value = data.url;
    } catch (err) {
      imageError.textContent = err instanceof Error ? err.message : 'Failed to upload image.';
      imageError.classList.remove('hidden');
    } finally {
      imageFileInput.value = '';
      updateImagePreview();
    }
  });

  imageRemoveBtn.addEventListener('click', () => {
    imageUrlInput.value = '';
    updateImagePreview();
  });

  function showSync(text: string, autoHide: boolean) {
    syncIndicatorText.textContent = text;
    syncIndicator.classList.remove('hidden');
    syncIndicator.classList.add('flex');
    syncIndicator.style.opacity = '1';
    if (autoHide) {
      setTimeout(() => {
        syncIndicator.style.opacity = '0';
        setTimeout(() => {
          syncIndicator.classList.add('hidden');
          syncIndicator.classList.remove('flex');
        }, 300);
      }, 1500);
    }
  }

  async function withAuthHeader() {
    const {
      data: { session },
    } = await supabaseBrowser.auth.getSession();
    return session ? { Authorization: `Bearer ${session.access_token}` } : null;
  }

  async function performDelete(id: string, deleteSeries = false) {
    const confirmMsg = deleteSeries
      ? 'Delete the ENTIRE series? This removes every occurrence from the site and Google Calendar.'
      : 'Delete this event? This also removes it from Google Calendar.';
    if (!confirm(confirmMsg)) return;
    const headers = await withAuthHeader();
    if (!headers) return;

    showSync('Syncing to Google Calendar…', false);
    const res = await fetch('/api/admin/delete-event', {
      method: 'POST',
      headers: { ...headers, 'Content-Type': 'application/json' },
      body: JSON.stringify({ eventId: id, deleteSeries }),
    });

    if (res.ok) {
      showSync('Synced!', true);
      setTimeout(() => window.location.reload(), 900);
    } else {
      const data = await res.json().catch(() => ({}));
      showSync(`Failed: ${data.error ?? 'unknown error'}`, true);
    }
  }

  typeButtons.forEach((btn) =>
    btn.addEventListener('click', () => {
      selectedType = btn.dataset.type as 'class' | 'event';
      renderTypeButtons();
    })
  );

  colorButtons.forEach((btn) =>
    btn.addEventListener('click', () => {
      selectedColor = btn.dataset.color as typeof selectedColor;
      renderColorButtons();
    })
  );

  document.querySelectorAll<HTMLButtonElement>('.description-format-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      descriptionInput.focus();
      document.execCommand(btn.dataset.cmd!, false);
    });
  });

  hideLessonOverviewInput.addEventListener('change', syncLessonOverviewFields);

  document.querySelectorAll<HTMLButtonElement>('.lesson-overview-format-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      lessonOverviewBodyInput.focus();
      document.execCommand(btn.dataset.cmd!, false);
    });
  });

  document.getElementById('event-lesson-overview-link-btn')?.addEventListener('click', () => {
    const url = prompt('Link URL (must start with https:// or /):');
    if (!url) return;
    lessonOverviewBodyInput.focus();
    document.execCommand('createLink', false, url);
  });

  document.getElementById('event-description-link-btn')?.addEventListener('click', () => {
    const url = prompt('Link URL (must start with https:// or /):');
    if (!url) return;
    descriptionInput.focus();
    document.execCommand('createLink', false, url);
  });

  repeatInput.addEventListener('change', () => {
    repeatOptions.classList.toggle('hidden', !repeatInput.checked);
    repeatOptions.classList.toggle('flex', repeatInput.checked);
    recurrenceHint.classList.toggle('hidden', !(editingId && editingRecurringId));
    updateDateLockForSeriesEdit();
  });

  repeatDayButtons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const day = btn.dataset.day ?? '';
      if (selectedRepeatDays.has(day)) selectedRepeatDays.delete(day);
      else selectedRepeatDays.add(day);
      renderRepeatDayButtons();
    })
  );

  repeatEndRadios.forEach((radio) =>
    radio.addEventListener('change', () => {
      repeatCountInput.disabled = radio.value !== 'count' || !radio.checked;
      repeatUntilInput.disabled = radio.value !== 'until' || !radio.checked;
    })
  );

  function updateDateLockForSeriesEdit() {
    const lockDate = Boolean(editingId && editingRecurringId && repeatInput.checked);
    dateInput.disabled = lockDate;
    dateInput.classList.toggle('opacity-50', lockDate);
  }

  document.getElementById('add-event-btn')?.addEventListener('click', () => openModal('add'));
  document.getElementById('event-cancel')?.addEventListener('click', closeModal);
  document.getElementById('event-delete')?.addEventListener('click', () => editingId && performDelete(editingId));
  document.getElementById('event-delete-series')?.addEventListener('click', () => editingId && performDelete(editingId, true));

  document.getElementById('detail-edit-btn')?.addEventListener('click', () => {
    if (detailEvent) openModal('edit', detailEvent);
  });
  document.getElementById('detail-delete-btn')?.addEventListener('click', () => {
    if (detailEvent) performDelete(detailEvent.id);
  });
  document.getElementById('detail-delete-series-btn')?.addEventListener('click', () => {
    if (detailEvent) performDelete(detailEvent.id, true);
  });

  // Delegated so it keeps working after client-side re-rendering.
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    const banner = target.closest('.event-banner');
    if (banner) {
      const event = JSON.parse((banner as HTMLElement).dataset.event ?? '{}');
      showEventDetail(event);
      return;
    }

    // Mobile only — .day-dots is hidden at the sm breakpoint and up, so this
    // branch is naturally unreachable on desktop/tablet.
    const dayDots = target.closest('.day-dots');
    if (dayDots) {
      const dotsCell = dayDots.closest('.calendar-cell') as HTMLElement | null;
      if (dotsCell) toggleDayExpand(dotsCell);
      return;
    }

    // Empty space inside a day cell (not on a specific event) — admins only.
    const cell = target.closest('.calendar-cell');
    if (cell && adminModeActive) {
      const dateKey = (cell as HTMLElement).dataset.date;
      if (dateKey) openModal('add', undefined, dateKey);
    }
  });

  document.getElementById('event-save')?.addEventListener('click', async () => {
    const headers = await withAuthHeader();
    if (!headers) return;

    if (!titleInput.value.trim() || !dateInput.value || !startTimeInput.value || !endTimeInput.value) {
      return;
    }

    const payload: Record<string, unknown> = {
      id: editingId ?? undefined,
      title: titleInput.value.trim(),
      description: descriptionInput.innerHTML.trim(),
      location: locationInput.value.trim(),
      priceWholeSeries: priceWholeSeriesInput.value.trim(),
      priceDropIn: priceDropInInput.value.trim(),
      priceStudent: priceStudentInput.value.trim(),
      priceWholeSeriesEarlyBird: priceWholeSeriesEarlyBirdInput.value.trim(),
      priceDropInEarlyBird: priceDropInEarlyBirdInput.value.trim(),
      priceStudentEarlyBird: priceStudentEarlyBirdInput.value.trim(),
      earlyBirdUntil: fromLocalDateTimeValue(earlyBirdUntilInput.value),
      priceWholeSeriesFlashSale: priceWholeSeriesFlashSaleInput.value.trim(),
      priceDropInFlashSale: priceDropInFlashSaleInput.value.trim(),
      priceStudentFlashSale: priceStudentFlashSaleInput.value.trim(),
      flashSaleUntil: fromLocalDateTimeValue(flashSaleUntilInput.value),
      registrationClosed: registrationClosedInput.checked,
      lessonOverviewTitle: lessonOverviewTitleInput.value.trim(),
      lessonOverviewBody: lessonOverviewBodyInput.innerHTML.trim(),
      hideLessonOverview: hideLessonOverviewInput.checked,
      imageUrl: imageUrlInput.value.trim(),
      eventType: selectedType,
      color: selectedColor,
      visibility: privateInput.checked ? 'private' : 'public',
      startTime: fromLocalParts(dateInput.value, startTimeInput.value),
      endTime: fromLocalParts(dateInput.value, endTimeInput.value),
    };

    if (!editingId && repeatInput.checked) {
      if (selectedRepeatDays.size === 0) {
        alert('Pick at least one day of the week for the recurrence.');
        return;
      }
      const endType = repeatEndRadios.find((r) => r.checked)?.value === 'until' ? 'until' : 'count';
      if (endType === 'until' && !repeatUntilInput.value) {
        alert('Pick an end date for the recurrence.');
        return;
      }
      payload.recurrence = {
        byDay: WEEKDAY_CODES.filter((d) => selectedRepeatDays.has(d)),
        interval: Number(repeatIntervalInput.value) || 1,
        endType,
        count: endType === 'count' ? Number(repeatCountInput.value) || 4 : undefined,
        until: endType === 'until' ? repeatUntilInput.value : undefined,
      };
    }

    if (editingId && editingRecurringId && repeatInput.checked) {
      payload.applyToSeries = true;

      const currentByDay = WEEKDAY_CODES.filter((d) => selectedRepeatDays.has(d));
      const endType = repeatEndRadios.find((r) => r.checked)?.value === 'until' ? 'until' : 'count';
      const currentCount = Number(repeatCountInput.value) || 4;
      const currentInterval = Number(repeatIntervalInput.value) || 1;

      const patternChanged =
        endType === 'until' ||
        JSON.stringify([...currentByDay].sort()) !== JSON.stringify([...(originalPattern?.byDay ?? [])].sort()) ||
        currentCount !== originalPattern?.count ||
        currentInterval !== originalPattern?.interval;

      if (patternChanged) {
        if (endType === 'until' && !repeatUntilInput.value) {
          alert('Pick an end date for the recurrence.');
          return;
        }
        payload.rebuildSeries = true;
        payload.recurrence = {
          byDay: currentByDay,
          interval: currentInterval,
          endType,
          count: endType === 'count' ? currentCount : undefined,
          until: endType === 'until' ? repeatUntilInput.value : undefined,
        };
      }
    }

    const endpoint = editingId ? '/api/admin/update-event' : '/api/admin/create-event';
    closeModal();
    showSync('Syncing to Google Calendar…', false);

    const res = await fetch(endpoint, {
      method: 'POST',
      headers: { ...headers, 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });

    const data = await res.json().catch(() => ({}));

    if (res.ok) {
      showSync(
        data.calendarSyncSkipped ? 'Saved, but Google Calendar sync failed — it will retry on the next scheduled sync.' : 'Synced!',
        true
      );
      setTimeout(() => window.location.reload(), data.calendarSyncSkipped ? 2500 : 900);
    } else {
      showSync(`Failed: ${data.error ?? 'unknown error'}`, true);
    }
  });

  function buildBannerHTML(event: SiteEvent, isCompact: boolean): string {
    const bannerClass = isCompact
      ? `truncate rounded px-1 py-0.5 text-[10px] font-semibold text-white ${dotClass(event.color)}`
      : `event-banner-label whitespace-normal rounded-lg px-2 py-1.5 text-xs font-semibold leading-snug text-white ${dotClass(event.color)}`;
    const weekTag = event.weekNumber
      ? `<span class="mr-1 whitespace-nowrap rounded bg-white/25 px-1 py-0.5 text-[9px] font-bold uppercase tracking-wide">Wk ${event.weekNumber}</span>`
      : '';
    return `
      <div class="event-banner group relative cursor-pointer" data-event='${JSON.stringify(event).replace(/'/g, '&#39;')}'>
        <div class="${bannerClass}">${weekTag}${event.visibility === 'private' ? '🔒 ' : ''}${escapeHtml(event.title)}</div>
        <div class="pointer-events-none absolute left-1/2 top-full z-30 mt-2 hidden w-96 -translate-x-1/2 rounded-2xl border-2 border-ink bg-bg p-4 text-left shadow-xl group-hover:block">
          <p class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-wider ${textClass(event.color)}">
            <span class="h-2 w-2 rounded-full ${dotClass(event.color)}"></span>
            ${event.event_type === 'event' ? 'Event' : 'Class'}
            ${event.weekNumber ? `<span class="font-bold text-ink">&middot; Week ${event.weekNumber}</span>` : ''}
          </p>
          <p class="mt-1 font-display font-bold text-ink">${escapeHtml(event.title)}</p>
          <p class="mt-1 text-xs text-muted">${dateFormatter.format(new Date(event.start_time))} &middot; ${timeFormatter.format(new Date(event.start_time))}</p>
          ${event.description ? `<div class="mt-1 text-xs text-ink/70 [&_a]:text-accent [&_a]:underline [&_ol]:list-decimal [&_ol]:pl-4 [&_ul]:list-disc [&_ul]:pl-4">${event.description}</div>` : ''}
          ${buildPriceLines(event).main ? `<p class="mt-1 text-xs font-semibold text-ink">${buildPriceLines(event).main}</p>` : ''}
          ${buildPriceLines(event).student ? `<p class="text-xs font-semibold text-ink">${buildPriceLines(event).student}</p>` : ''}
          ${
            event.location
              ? `<a href="${locationHref(event.location)}" target="_blank" rel="noopener noreferrer" class="pointer-events-auto mt-1 block text-xs font-semibold text-accent underline" onclick="event.stopPropagation()">📍 ${escapeHtml(event.location)}</a>`
              : ''
          }
        </div>
      </div>`;
  }

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  // Mobile-only: tapping a day's dot summary "opens" that day into a
  // full-width row of its events (a plain sibling with col-span-7, so the
  // grid's own auto-flow pushes later weeks down — no manual layout math),
  // then tapping one of those opens the same detail panel desktop uses.
  function closeDayExpandPanel() {
    document.querySelector('.day-expand-panel')?.remove();
    document.querySelectorAll('.calendar-cell.day-expanded').forEach((c) => c.classList.remove('day-expanded', 'ring-2', 'ring-accent'));
  }

  function toggleDayExpand(cell: HTMLElement) {
    const wasOpen = cell.classList.contains('day-expanded');
    closeDayExpandPanel();
    if (wasOpen) return;

    const banners = Array.from(cell.querySelectorAll<HTMLElement>('.event-banner'));
    if (banners.length === 0) return;

    cell.classList.add('day-expanded', 'ring-2', 'ring-accent');

    const panel = document.createElement('div');
    panel.className = 'day-expand-panel col-span-7 m-1 flex flex-col gap-1 rounded-xl border border-border bg-surface p-2 sm:hidden';

    banners.forEach((banner) => {
      const event = JSON.parse(banner.dataset.event ?? '{}');
      const item = document.createElement('button');
      item.type = 'button';
      item.className = 'flex items-center gap-2 rounded-lg px-2 py-2 text-left text-sm transition-colors hover:bg-bg';
      item.innerHTML = `<span class="h-2.5 w-2.5 shrink-0 rounded-full ${dotClass(event.color)}"></span><span class="flex-1 truncate font-semibold text-ink">${escapeHtml(event.title)}</span><span class="shrink-0 text-xs text-muted">${timeFormatter.format(new Date(event.start_time))}</span>`;
      item.addEventListener('click', () => {
        showEventDetail(event);
        closeDayExpandPanel();
        document.getElementById('event-detail-panel')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      panel.appendChild(item);
    });

    const moreLine = cell.querySelector('.day-banners > p');
    if (moreLine) {
      const more = document.createElement('p');
      more.className = 'px-2 py-1 text-[10px] font-semibold text-muted';
      more.textContent = moreLine.textContent;
      panel.appendChild(more);
    }

    // Insert after the last cell of this day's week row (not right after
    // the tapped cell) so the panel opens as its own full-width row below
    // an intact week, instead of splitting that week's row in two with the
    // later days pushed down onto a line by themselves.
    const allCells = Array.from(document.querySelectorAll<HTMLElement>('.calendar-cell'));
    const cellIndex = allCells.indexOf(cell);
    const rowEndIndex = Math.min(Math.ceil((cellIndex + 1) / 7) * 7 - 1, allCells.length - 1);
    allCells[rowEndIndex].after(panel);
  }

  function computeWeekNumbers(allEvents: SiteEvent[]): Map<string, number> {
    const bySeriesKey = new Map<string, SiteEvent[]>();
    for (const e of allEvents) {
      if (!e.google_recurring_event_id) continue;
      const list = bySeriesKey.get(e.google_recurring_event_id) ?? [];
      list.push(e);
      bySeriesKey.set(e.google_recurring_event_id, list);
    }
    const weekNumberByEventId = new Map<string, number>();
    for (const occurrences of bySeriesKey.values()) {
      occurrences
        .slice()
        .sort((a, b) => new Date(a.start_time).getTime() - new Date(b.start_time).getTime())
        .forEach((occ, idx) => weekNumberByEventId.set(occ.id, idx + 1));
    }
    return weekNumberByEventId;
  }

  function rerenderWithMergedEvents(allEvents: SiteEvent[]) {
    const grid = document.getElementById('calendar-grid')!;
    const gridYear = Number(grid.dataset.year);
    const gridMonth = Number(grid.dataset.month);
    const weekNumberByEventId = computeWeekNumbers(allEvents);

    document.querySelectorAll('.calendar-cell').forEach((cell) => {
      const dateKey = (cell as HTMLElement).dataset.date;
      if (!dateKey) return;
      const dayEvents = allEvents.filter((e) => {
        const d = new Date(e.start_time);
        return (
          d.getFullYear() === gridYear &&
          d.getMonth() === gridMonth &&
          `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}` === dateKey
        );
      });
      const container = cell.querySelector('.day-banners')!;
      const MAX = 3;
      const isCompact = dayEvents.length > 2;

      cell.classList.remove('min-h-[7rem]', 'sm:min-h-[7.5rem]', 'min-h-[6rem]', 'sm:min-h-[6.5rem]');
      cell.classList.add(...(isCompact ? ['min-h-[6rem]', 'sm:min-h-[6.5rem]'] : ['min-h-[7rem]', 'sm:min-h-[7.5rem]']));

      container.innerHTML =
        dayEvents
          .slice(0, MAX)
          .map((e) => buildBannerHTML({ ...e, weekNumber: weekNumberByEventId.get(e.id) ?? null }, isCompact))
          .join('') + (dayEvents.length > MAX ? `<p class="text-[10px] font-semibold text-muted">+${dayEvents.length - MAX} more</p>` : '');

      const dotsContainer = cell.querySelector('.day-dots');
      if (dotsContainer) {
        dotsContainer.innerHTML =
          dayEvents
            .slice(0, MAX)
            .map((e) => `<span class="h-2 w-2 rounded-full ${dotClass(e.color)}"></span>`)
            .join('') + (dayEvents.length > MAX ? `<span class="text-[9px] font-semibold text-muted">+${dayEvents.length - MAX}</span>` : '');
      }
    });

    fitBannerLabels();
  }

  // Banner titles wrap at word boundaries only (no mid-word breaks) — if a
  // word is still too wide for the banner at the current font size (a
  // narrow cell, a long word, or a high browser zoom level), shrink the
  // font size a step at a time until it fits, rather than breaking the word.
  const BANNER_MIN_FONT_PX = 8;
  function fitBannerLabels() {
    document.querySelectorAll<HTMLElement>('.event-banner-label').forEach((label) => {
      label.style.fontSize = '';
      let fontSizePx = parseFloat(getComputedStyle(label).fontSize);
      while (label.scrollWidth > label.clientWidth + 1 && fontSizePx > BANNER_MIN_FONT_PX) {
        fontSizePx -= 0.5;
        label.style.fontSize = `${fontSizePx}px`;
      }
    });
  }

  let fitBannerLabelsResizeTimer: ReturnType<typeof setTimeout> | null = null;
  window.addEventListener('resize', () => {
    if (fitBannerLabelsResizeTimer) clearTimeout(fitBannerLabelsResizeTimer);
    fitBannerLabelsResizeTimer = setTimeout(fitBannerLabels, 150);
  });

  async function revealAdminControlsIfAdmin() {
    if (isPreviewingAsPublic()) return;

    const {
      data: { session },
    } = await supabaseBrowser.auth.getSession();
    if (!session) return;

    const res = await fetch('/api/admin/check', {
      headers: { Authorization: `Bearer ${session.access_token}` },
    });
    const { isAdmin } = await res.json();
    if (!isAdmin) return;

    adminModeActive = true;
    document.getElementById('add-event-btn')?.classList.remove('hidden');

    const allEventsRes = await fetch('/api/admin/all-events', {
      headers: { Authorization: `Bearer ${session.access_token}` },
    });
    if (allEventsRes.ok) {
      const { events } = await allEventsRes.json();
      cachedAllEvents = events;
      rerenderWithMergedEvents(events);
    }
  }

  fitBannerLabels();
  revealAdminControlsIfAdmin();
</script>
