---
// Rendered per request, so the header and footer follow the live settings
// (Site Visibility, the WhatsApp community link) instead of the last deploy's.
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { cacheSharedPage } from '../lib/pageCache';

cacheSharedPage(Astro.response.headers);
---

<BaseLayout
  title="About B Li — Bachata Instructor in Madison, WI"
  description="Meet B Li (Belinda Li), Madison's sensual bachata instructor and dance event organizer, with over a decade of ballroom and bachata experience, plus zouk and salsa."
/>
