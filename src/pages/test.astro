---
export const prerender = false;

// Trial of the flyer homepage, side by side with the live one (index.astro).
// Each block is one flyer shown whole, beside the live details of every class
// or event it advertises; see src/lib/flyerBlocks.ts.

import BaseLayout from '../layouts/BaseLayout.astro';
import { supabase } from '../lib/supabase';
import { buildClassSeriesList, type ClassSeriesEntry } from '../lib/classSeries';
import { applyCardOrder, getHomepageCardOrder, getHomepageContent, getHomepageSectionOrder, type HomepageSection } from '../lib/homepageContent';
import { listFaqs } from '../lib/faqs';
import { listActiveDeals } from '../lib/dealsStore';
import { getSpotsByOccurrence, publicSpotsLabel, seriesSpots } from '../lib/capacity';
import { blockDeals, dateRange, formatPrice, groupByFlyer, priceOptions, seriesBounds } from '../lib/flyerBlocks';
import { locationHref } from '../lib/locationLink';
import classPlaceholder from '../assets/stock/class-placeholder.jpg';
import eventPlaceholder from '../assets/stock/event-placeholder.jpg';

const now = new Date();
const [{ lessonOverview }, faqs, { data: events, error }, { data: allEventsForTotals }, cardOrder, sectionOrder, deals] = await Promise.all([
  getHomepageContent(),
  listFaqs(),
  supabase
    .from('events')
    .select(
      'id, title, description, location, start_time, end_time, google_recurring_event_id, event_type, price_whole_series, price_drop_in, price_student, image_url, flyer_url, color, registration_closed, price_whole_series_early_bird, price_drop_in_early_bird, price_student_early_bird, early_bird_until, price_whole_series_flash_sale, price_drop_in_flash_sale, price_student_flash_sale, flash_sale_until, lesson_overview_title, lesson_overview_body, hide_lesson_overview, capacity, show_capacity, capacity_by_role, leader_capacity, follower_capacity'
    )
    .eq('visibility', 'public')
    .in('event_type', ['class', 'event'])
    .gte('start_time', now.toISOString())
    .order('start_time', { ascending: true }),
  supabase.from('events').select('id, google_recurring_event_id, start_time').eq('visibility', 'public').in('event_type', ['class', 'event']),
  getHomepageCardOrder(),
  getHomepageSectionOrder(),
  listActiveDeals(now),
]);
if (error) console.error('Failed to load current offerings:', error);

const offerings = applyCardOrder(
  buildClassSeriesList(events ?? [], allEventsForTotals ?? []).sort((a, b) => a.nextStartTime.localeCompare(b.nextStartTime)),
  cardOrder
);
const blocks = groupByFlyer(offerings);
// A series shows its full dates, not just the classes still to come.
const bounds = seriesBounds(allEventsForTotals ?? []);

// A block sits in the section of the first thing on its flyer.
const SECTION_TITLES: Record<HomepageSection, string> = { events: 'Upcoming Events', classes: 'Upcoming Classes' };
const sections = sectionOrder
  .map((id) => ({ id, title: SECTION_TITLES[id], blocks: blocks.filter((b) => (b.offerings[0].eventType === 'event') === (id === 'events')) }))
  .filter((s) => s.blocks.length > 0);

let spotsByOccurrence = new Map<string, import('../lib/capacity').SpotsInfo>();
try {
  spotsByOccurrence = await getSpotsByOccurrence(events ?? []);
} catch {
  // Show the blocks without spots rather than failing the page.
}
const showCapacityByKey = new Map((events ?? []).map((e) => [e.google_recurring_event_id ?? e.id, e.show_capacity]));
function spotsFor(offering: ClassSeriesEntry) {
  const spots = seriesSpots(spotsByOccurrence, offering.occurrences.map((o) => o.id));
  const shown = showCapacityByKey.get(offering.key) ?? false;
  return { full: spots?.full ?? false, label: publicSpotsLabel(spots, shown), adminOnly: spots != null && !shown && !spots.full };
}

// Events sit under Upcoming Events, so only classes get a type tag.
const typeLabel = (o: ClassSeriesEntry) => (o.eventType === 'event' ? '' : o.isSeries ? `${o.totalOccurrences}-week series` : 'Workshop');
const registerHref = (o: ClassSeriesEntry) => `${o.eventType === 'event' ? '/register/events' : '/register'}?series=${encodeURIComponent(o.key)}`;
---

<BaseLayout title="Classes and Events in Madison, WI" description="Bachata classes and social dance events in Madison, WI." noindex>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
    {sections.length === 0 && <p class="mx-auto max-w-md text-center text-sm text-muted">No upcoming classes or events right now — check back soon!</p>}

    <div class="flex flex-col gap-16">
      {sections.map((section) => (
        <div data-section={section.id} class="flex flex-col gap-8">
          <h2 class="text-center font-display text-3xl font-extrabold text-ink">{section.title}</h2>
          {section.blocks.map((block) => {
            const blockDealList = blockDeals(block.offerings, deals);
            const single = block.offerings.length === 1 ? block.offerings[0] : null;
            const fallbackImage = single?.imageUrl ?? (single?.eventType === 'event' ? eventPlaceholder.src : classPlaceholder.src);
            return (
              <article data-flyer-block={block.key} class:list={['overflow-clip rounded-3xl border border-border bg-bg shadow-[0_2px_16px_rgba(0,0,0,0.06)]', block.flyerUrl && 'md:grid md:grid-cols-[minmax(0,4fr)_minmax(0,8fr)]']}>
                {block.flyerUrl ? (
                  <button type="button" data-flyer-open={block.flyerUrl} class="group relative block w-full bg-surface p-3 sm:p-4 md:sticky md:top-20 md:self-start md:bg-transparent md:p-4 md:pr-0" aria-label="View the flyer full size">
                    <img src={block.flyerUrl} alt={`Flyer for ${block.offerings.map((o) => o.title).join(' and ')}`} loading="lazy" class="mx-auto max-h-[75vh] w-full rounded-2xl object-contain md:max-h-[calc(100vh-9rem)]" />
                    <span class="mt-1 block text-center text-xs font-semibold text-muted group-hover:text-accent">Tap to view full size</span>
                  </button>
                ) : (
                  <img src={fallbackImage} alt="" class="h-28 w-full object-cover sm:h-36" />
                )}

                <div class="flex flex-col gap-3 p-3 sm:p-4">

                  {block.offerings.map((o) => {
                    const { full, label, adminOnly } = spotsFor(o);
                    const prices = priceOptions(o, now);
                    const overviewBody = o.lessonOverviewBody ?? lessonOverview;
                    const showOverview = Boolean(overviewBody) && !o.hideLessonOverview;
                    // A flyer with one class/event: its description, then About This Class Format, shown in the panel beside the flyer.
                    const inlineDetails = Boolean(single && block.flyerUrl && (o.description || showOverview));
                    return (
                      <div data-offering-key={o.key} class:list={['rounded-2xl border border-border bg-surface/60 px-4 py-3', inlineDetails && 'md:flex md:flex-1 md:flex-col']}>
                        <div class="flex items-start justify-between gap-3">
                          <h3 class="min-w-0 font-display text-xl font-bold text-ink">{o.title}</h3>
                          {typeLabel(o) && <span class="mt-1.5 shrink-0 whitespace-nowrap text-xs font-bold uppercase tracking-wide text-muted">{typeLabel(o)}</span>}
                        </div>
                        <p class="mt-1 text-sm text-ink/80">
                          {o.isSeries ? `${o.subLabel} · ${dateRange(o, bounds)}` : o.subLabel}
                          {!o.registrationClosed && label && <span data-public-spots class="ml-2 rounded-full bg-accent/15 px-2 py-0.5 text-xs font-bold text-accent">{label}</span>}
                          {/* Filled in for admins by the script below when the count is hidden from the public. */}
                          {adminOnly && <span data-admin-spots-key={o.key} class="ml-2 hidden rounded-full bg-accent/15 px-2 py-0.5 text-xs font-bold text-accent"></span>}
                        </p>
                        {o.location && (
                          <a href={locationHref(o.location)} target="_blank" rel="noopener noreferrer" class="mt-1 inline-block text-sm font-semibold text-accent hover:opacity-80">
                            <span aria-hidden="true">📍</span> <span class="underline underline-offset-2">{o.location}</span>
                          </a>
                        )}

                        <div class="mt-2 flex flex-wrap items-center justify-between gap-3">
                          {prices.length > 0 ? (
                            <p class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-ink">
                              {prices.map((p) => (
                                <span>
                                  {p.label}:{' '}
                                  {p.was != null && <s class="text-muted">{formatPrice(p.was)}</s>}{' '}
                                  <strong class="font-bold">{formatPrice(p.price)}</strong>{p.suffix}
                                  {p.tag && <span class="ml-1 rounded-full bg-accent/15 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-accent">{p.tag}</span>}
                                </span>
                              ))}
                            </p>
                          ) : <span />}
                          {o.registrationClosed || full ? (
                            <span class="rounded-full bg-border px-5 py-2 text-xs font-bold uppercase tracking-wider text-ink/60">{o.registrationClosed ? 'Registration closed' : 'Full'}</span>
                          ) : (
                            <a href={registerHref(o)} class="gradient-accent rounded-full px-5 py-2 text-xs font-bold uppercase tracking-wider text-white transition-opacity hover:opacity-90">Register</a>
                          )}
                        </div>

                        {inlineDetails && (
                          <div data-desc-preview class="group/desc mt-2 flex min-h-28 flex-col overflow-hidden rounded-xl border border-border bg-bg md:flex-1 data-[fits]:min-h-0 md:data-[fits]:flex-none">
                            {/* On desktop the text is taken out of the flow, so the flyer alone sets the card's height and the text fills what's beside it. */}
                            <div data-desc-clip class="relative max-h-56 overflow-hidden md:max-h-none md:min-h-0 md:flex-1 group-data-[expanded]/desc:max-h-none group-data-[expanded]/desc:md:flex-none group-data-[fits]/desc:md:flex-none">
                              <div data-desc-body class="px-3 py-2.5 text-sm leading-relaxed text-ink/75 [&_a]:font-semibold [&_a]:text-accent [&_a]:underline [&_ol]:list-decimal [&_ol]:pl-5 [&_p:not(:first-child)]:mt-3 [&_ul]:list-disc [&_ul]:pl-5 md:absolute md:inset-x-0 md:top-0 group-data-[expanded]/desc:md:static group-data-[fits]/desc:md:static">
                                {o.description && <div set:html={o.description} />}
                                {showOverview && (
                                  <div class:list={[o.description && 'mt-3 border-t border-border pt-3']}>
                                    <p class="font-bold text-ink">{o.lessonOverviewTitle ?? 'About This Class Format'}</p>
                                    <div class="mt-1" set:html={overviewBody} />
                                  </div>
                                )}
                              </div>
                              <div class="pointer-events-none absolute inset-x-0 bottom-0 h-14 bg-gradient-to-t from-bg to-transparent group-data-[expanded]/desc:hidden group-data-[fits]/desc:hidden"></div>
                            </div>
                            <button type="button" data-desc-toggle class="hidden border-t border-border px-3 py-2 text-left text-sm font-bold text-accent hover:opacity-80">Read more</button>
                          </div>
                        )}
                        {o.description && !inlineDetails && (
                          <details class="group/acc mt-2 rounded-xl border border-border bg-surface open:bg-bg">
                            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-3 py-2 text-sm font-bold text-ink [&::-webkit-details-marker]:hidden">
                              More about {o.title}
                              <span class="shrink-0 text-muted transition-transform group-open/acc:rotate-180">⌄</span>
                            </summary>
                            <div class="border-t border-border px-3 py-2.5 text-sm leading-relaxed text-ink/75 [&_a]:font-semibold [&_a]:text-accent [&_a]:underline [&_ol]:list-decimal [&_ol]:pl-5 [&_p:not(:first-child)]:mt-3 [&_ul]:list-disc [&_ul]:pl-5" set:html={o.description} />
                          </details>
                        )}
                        {showOverview && !inlineDetails && (
                          <details class="group/acc mt-2 rounded-xl border border-border bg-surface open:bg-bg">
                            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-3 py-2 text-sm font-bold text-ink [&::-webkit-details-marker]:hidden">
                              {o.lessonOverviewTitle ?? 'About This Class Format'}
                              <span class="shrink-0 text-muted transition-transform group-open/acc:rotate-180">⌄</span>
                            </summary>
                            <div class="border-t border-border px-3 py-2.5 text-sm leading-relaxed text-ink/75 [&_a]:font-semibold [&_a]:text-accent [&_a]:underline [&_ol]:list-decimal [&_ol]:pl-5 [&_p:not(:first-child)]:mt-3 [&_ul]:list-disc [&_ul]:pl-5" set:html={overviewBody} />
                          </details>
                        )}
                      </div>
                    );
                  })}

                  {blockDealList.map((d) => (
                    <p class="rounded-2xl border border-dashed border-accent/50 px-4 py-2.5 text-sm text-ink">
                      {d.custom ? d.text : <><span class="font-bold text-accent">{d.name}:</span> {d.text}</>}
                    </p>
                  ))}
                </div>
              </article>
            );
          })}
        </div>
      ))}
    </div>

    {faqs.length > 0 && (
      <div class="mx-auto mt-16 max-w-3xl">
        <h3 class="font-display text-xl font-bold text-ink">FAQs & Other Info</h3>
        <div class="mt-4 flex flex-col gap-2">
          {faqs.map((faq) => (
            <details class="group rounded-xl border border-border bg-surface open:bg-bg">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 font-semibold text-ink [&::-webkit-details-marker]:hidden">
                {faq.question}
                <span class="shrink-0 text-muted transition-transform group-open:rotate-180">⌄</span>
              </summary>
              <div class="border-t border-border px-4 py-3 text-sm leading-relaxed text-ink/70 [&_a]:font-semibold [&_a]:text-accent [&_a]:underline [&_ol]:list-decimal [&_ol]:pl-5 [&_p:not(:first-child)]:mt-3 [&_ul]:list-disc [&_ul]:pl-5" set:html={faq.answer} />
            </details>
          ))}
        </div>
      </div>
    )}
  </section>

  <dialog id="flyer-dialog" class="m-auto max-h-[95vh] max-w-[95vw] rounded-2xl bg-transparent p-0 backdrop:bg-black/80">
    <form method="dialog" class="flex flex-col items-end gap-2">
      <button class="rounded-full bg-black/70 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-white">Close</button>
      <img id="flyer-dialog-img" alt="Flyer, full size" class="max-h-[85vh] w-auto rounded-2xl object-contain" />
    </form>
  </dialog>
</BaseLayout>

<script>
  import { checkAdminSession } from '../lib/adminSession';
  import { isPreviewingAsPublic } from '../lib/previewMode';

  // Admins also see the spots left on classes whose count is hidden from the public.
  async function revealAdminSpots() {
    const tags = Array.from(document.querySelectorAll<HTMLElement>('[data-admin-spots-key]'));
    if (tags.length === 0 || isPreviewingAsPublic()) return;
    const gate = await checkAdminSession();
    if (gate.status !== 'admin') return;
    try {
      const res = await fetch('/api/admin/series-spots', { headers: { Authorization: `Bearer ${gate.session.access_token}` } });
      if (!res.ok) return;
      const { series } = (await res.json()) as { series: Record<string, { label: string }> };
      for (const tag of tags) {
        const info = series[tag.dataset.adminSpotsKey ?? ''];
        if (!info) continue;
        tag.textContent = `${info.label} (admin only)`;
        tag.classList.remove('hidden');
        // The public's partial tag (e.g. "Leaders full") is covered by this one.
        tag.parentElement?.querySelector('[data-public-spots]')?.classList.add('hidden');
      }
    } catch {
      // Leave the tags hidden if the count can't be loaded.
    }
  }
  revealAdminSpots();

  const dialog = document.getElementById('flyer-dialog') as HTMLDialogElement;
  const dialogImg = document.getElementById('flyer-dialog-img') as HTMLImageElement;
  document.querySelectorAll<HTMLButtonElement>('[data-flyer-open]').forEach((button) => {
    button.addEventListener('click', () => {
      dialogImg.src = button.dataset.flyerOpen!;
      dialog.showModal();
    });
  });
  // Single-class flyer blocks: "Read more" only when the details run past the space they have.
  const previews = Array.from(document.querySelectorAll<HTMLElement>('[data-desc-preview]'));
  function measurePreviews() {
    for (const preview of previews) {
      if (preview.dataset.expanded !== undefined) continue;
      const clip = preview.querySelector<HTMLElement>('[data-desc-clip]')!;
      const body = preview.querySelector<HTMLElement>('[data-desc-body]')!;
      // Measured against the full space beside the flyer (a fitting box shrinks to its text).
      preview.removeAttribute('data-fits');
      const fits = body.scrollHeight <= clip.clientHeight + 2;
      preview.toggleAttribute('data-fits', fits);
      preview.querySelector('[data-desc-toggle]')!.classList.toggle('hidden', fits);
    }
  }
  for (const preview of previews) {
    const toggle = preview.querySelector<HTMLButtonElement>('[data-desc-toggle]')!;
    toggle.addEventListener('click', () => {
      const expanded = preview.toggleAttribute('data-expanded');
      toggle.textContent = expanded ? 'Show less' : 'Read more';
      if (!expanded) {
        measurePreviews();
        preview.closest('article')?.scrollIntoView({ block: 'nearest' });
      }
    });
  }
  // The flyer's height (once loaded) and the window's width decide the space.
  document.querySelectorAll<HTMLImageElement>('[data-flyer-open] img').forEach((img) => img.addEventListener('load', measurePreviews));
  window.addEventListener('resize', measurePreviews);
  measurePreviews();

  // A click on the dimmed backdrop (outside the flyer) closes it too.
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
