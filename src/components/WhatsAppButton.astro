---
import { WHATSAPP_ICON_PATH } from '../lib/whatsappIcon';

// "Join Our WhatsApp Community" on the registration confirmation: only with a link set
// (Admin → Admin → WhatsApp Community); otherwise nothing, so the spacing stays.
interface Props {
  class?: string;
}
const url = Astro.locals.whatsappUrl;
---

{url && (
  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class:list={['whatsapp-join gradient-accent inline-flex items-center gap-2 rounded-full px-6 py-2.5 text-sm font-bold text-white transition-opacity hover:opacity-90 print:hidden', Astro.props.class]}
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d={WHATSAPP_ICON_PATH} /></svg>
    Join Our WhatsApp Community
  </a>
)}
