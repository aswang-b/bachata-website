---
// The public sign-up form for group classes (/register) and for events
// (/register/events). Events sell one ticket per event (no Whole Series /
// Drop In choice) and don't ask for a Leader/Follower role.
import BaseLayout from '../layouts/BaseLayout.astro';
import { supabase } from '../lib/supabase';
import { publicVisibilities } from '../lib/testMode';
import { countOccurrencesByKey } from '../lib/classSeries';
import { getActivePrice, priceTierLabel, type ActivePriceResult } from '../lib/pricing';
import { getSpotsByOccurrence, publicSpotsLabel, remainingFor, seriesSpots } from '../lib/capacity';
import { getCommunityGuidelines, hasGuidelines } from '../lib/communityGuidelines';
import { listActiveDeals } from '../lib/dealsStore';
import { siteFormatter, zonedDateKey } from '../lib/siteTime';
import { lateRegistrationCutoffIso } from '../lib/eventTimes';
import { locationHref } from '../lib/locationLink';
import { PIN_SVG } from '../lib/locationPin';
import { seriesBounds } from '../lib/flyerBlocks';
import { rulesForSeries } from '../lib/linksStore';

interface Props {
  kind?: 'class' | 'event';
}

const { kind = 'class' } = Astro.props;
const isEvent = kind === 'event';
const eventType = isEvent ? 'event' : 'class';


interface ClassOccurrence {
  id: string;
  title: string;
  description: string | null;
  location: string | null;
  start_time: string;
  end_time: string;
  color: string;
  google_recurring_event_id: string | null;
  price_whole_series: number | null;
  price_drop_in: number | null;
  price_student: number | null;
  registration_closed: boolean;
  price_whole_series_early_bird: number | null;
  price_drop_in_early_bird: number | null;
  price_student_early_bird: number | null;
  early_bird_until: string | null;
  price_whole_series_flash_sale: number | null;
  price_drop_in_flash_sale: number | null;
  price_student_flash_sale: number | null;
  flash_sale_until: string | null;
  capacity: number | null;
  show_capacity: boolean;
  capacity_by_role: boolean;
  leader_capacity: number | null;
  follower_capacity: number | null;
}

// Independent, so loaded together. Event registrants read and agree to the
// community guidelines (admin → Guidelines); the section is left out while
// they're blank.
const [guidelines, { data: classEvents, error }, activeDeals] = await Promise.all([
  isEvent ? getCommunityGuidelines() : Promise.resolve(''),
  supabase
    .from('events')
    .select(
      'id, title, description, location, start_time, end_time, color, google_recurring_event_id, price_whole_series, price_drop_in, price_student, registration_closed, price_whole_series_early_bird, price_drop_in_early_bird, price_student_early_bird, early_bird_until, price_whole_series_flash_sale, price_drop_in_flash_sale, price_student_flash_sale, flash_sale_until, capacity, show_capacity, capacity_by_role, leader_capacity, follower_capacity'
    )
    .in('visibility', publicVisibilities())
    .eq('event_type', eventType)
    // Classes until they start; events until 30 minutes after they end, so
    // people can register at the door (see eventTimes.registrationOpen).
    .gte(isEvent ? 'end_time' : 'start_time', isEvent ? lateRegistrationCutoffIso() : new Date().toISOString())
    .order('start_time', { ascending: true }),
  listActiveDeals(),
]);
const showGuidelines = hasGuidelines(guidelines);

if (error) console.error(`Failed to load ${eventType} events:`, error);
// Every occurrence (past ones too) of the series on offer, for their class
// counts and full dates, so a series doesn't shrink as its classes pass; only
// those series, not every class ever (like the homepage). Read with the spots.
const seriesKeys = [...new Set((classEvents ?? []).flatMap((e) => (e.google_recurring_event_id ? [e.google_recurring_event_id] : [])))];
const [{ data: seriesOccurrences, error: totalsError }, spotsByOccurrence] = await Promise.all([
  seriesKeys.length > 0
    ? supabase.from('events').select('id, google_recurring_event_id, start_time').in('visibility', publicVisibilities()).eq('event_type', eventType).in('google_recurring_event_id', seriesKeys)
    : Promise.resolve({ data: [], error: null }),
  // Couldn't count spots: show the form without them; the server still checks capacity on submit.
  getSpotsByOccurrence((classEvents ?? []) as ClassOccurrence[]).catch(() => new Map<string, import('../lib/capacity').SpotsInfo>()),
]);
// Without them, a series' count and dates fall back to its classes still to come.
if (totalsError) console.error('Failed to load series totals:', totalsError);

const totalCountByKey = countOccurrencesByKey(seriesOccurrences ?? []);
// Each series' first and last class, past ones included, for its date range.
const bounds = seriesBounds(seriesOccurrences ?? []);

const weekdayFormatter = { format: (d: Date) => siteFormatter({ weekday: 'long' }).format(d) };
const timeFormatter = { format: (d: Date) => siteFormatter({ hour: 'numeric', minute: '2-digit' }).format(d) };
const dateFormatter = { format: (d: Date) => siteFormatter({ month: 'short', day: 'numeric' }).format(d) };

// Group occurrences into one button per series (or per standalone class).
const seriesMap = new Map<string, ClassOccurrence[]>();
for (const event of (classEvents ?? []) as ClassOccurrence[]) {
  const key = event.google_recurring_event_id ?? event.id;
  const existing = seriesMap.get(key) ?? [];
  existing.push(event);
  seriesMap.set(key, existing);
}

const now = new Date();

const seriesList = Array.from(seriesMap.entries()).map(([key, occurrences]) => {
  const sorted = [...occurrences].sort((a, b) => new Date(a.start_time).getTime() - new Date(b.start_time).getTime());
  const first = sorted[0];
  const last = sorted[sorted.length - 1];
  const occurrenceCount = totalCountByKey.get(key) ?? sorted.length;
  const isSeries = occurrenceCount > 1;

  const weekday = weekdayFormatter.format(new Date(first.start_time));
  const timeRange = `${timeFormatter.format(new Date(first.start_time))}–${timeFormatter.format(new Date(first.end_time))}`;
  const whole = bounds.get(key);
  const dateRange = isSeries
    ? `${dateFormatter.format(new Date(whole?.first ?? first.start_time))}–${dateFormatter.format(new Date(whole?.last ?? last.start_time))}`
    : dateFormatter.format(new Date(first.start_time));

  const spots = seriesSpots(
    spotsByOccurrence,
    sorted.map((occ) => occ.id)
  );
  const dates = sorted.map((occ) => {
    const s = spotsByOccurrence.get(occ.id);
    return {
      id: occ.id,
      // Its day, for linked classes: a Drop-In only takes in what it includes that day.
      day: zonedDateKey(occ.start_time),
      label: `${dateFormatter.format(new Date(occ.start_time))}, ${timeFormatter.format(new Date(occ.start_time))}`,
      full: s?.full ?? false,
      fullRoles: s ? (['leader', 'follower'] as const).filter((r) => remainingFor(s, r) === 0) : [],
    };
  });
  // A Whole Series needs room in every class, a Drop-In only in its own: when
  // the fullest class is full, the series still takes Drop-Ins for the dates
  // that have room.
  const wholeFull = spots?.full ?? false;
  const openDropIns = !isEvent && isSeries && first.price_drop_in != null && dates.some((o) => !o.full);
  const full = wholeFull && !openDropIns;

  const tieredInput = {
    earlyBirdUntil: first.early_bird_until,
    flashSaleUntil: first.flash_sale_until,
  };

  return {
    key,
    title: first.title,
    color: first.color,
    isSeries,
    occurrenceCount,
    // A one-off event names its date rather than a weekly schedule.
    subLabel: isEvent && !isSeries ? `${weekday}, ${dateRange}, ${timeRange}` : `${weekday}s, ${timeRange} (${dateRange})`,
    description: first.description,
    location: first.location,
    // A full class or event can't be picked, just like a closed one.
    registrationClosed: first.registration_closed || full,
    full,
    // Only Drop-Ins are left (see openDropIns above).
    wholeFull: wholeFull && !full,
    spotsText: wholeFull && !full ? 'Whole series full · Drop-ins open' : publicSpotsLabel(spots, first.show_capacity),
    // A role that's full (capped by role): checked on submit against the dancers' roles.
    fullRoles: spots ? (['leader', 'follower'] as const).filter((r) => remainingFor(spots, r) === 0) : [],
    // No whole-series/flat price, only a drop-in price (e.g. a practica): the
    // Drop In option is shown with its price and preselected, as the only choice.
    // Events only ever have the one ticket price.
    dropInOnly: !isEvent && first.price_whole_series == null && first.price_drop_in != null,
    occurrences: dates,
    priceWhole: getActivePrice(now, { ...tieredInput, base: first.price_whole_series, earlyBird: first.price_whole_series_early_bird, flashSale: first.price_whole_series_flash_sale }),
    priceDropIn: getActivePrice(now, { ...tieredInput, base: first.price_drop_in, earlyBird: first.price_drop_in_early_bird, flashSale: first.price_drop_in_flash_sale }),
    priceStudent: getActivePrice(now, { ...tieredInput, base: first.price_student, earlyBird: first.price_student_early_bird, flashSale: first.price_student_flash_sale }),
  };
});

// Bundle deals that cover something on this page, for the live subtotal and
// its "add this to get the deal" suggestions (the server prices the same way).
const pageKeys = new Set(seriesList.map((s) => s.key));
const pageDeals = activeDeals.filter((d) => d.seriesKeys.some((k) => pageKeys.has(k)));
// Every rule among the classes linked with those on this page (linkRules.ts),
// for the subtotal's notes, including ones through a class that isn't on the
// page (A includes B includes C), exactly as the server applies them to
// what's saved. Those off the page are named from their latest class.
const pageLinkRules = await rulesForSeries([...pageKeys]);
const offPageKeys = [...new Set(pageLinkRules.flatMap((r) => [r.from, r.to]))].filter((k) => !pageKeys.has(k));
const linkTitles: Record<string, string> = {};
if (offPageKeys.length > 0) {
  const ids = offPageKeys.filter((k) => /^[0-9a-f-]{36}$/i.test(k));
  const { data: offPage } = await supabase
    .from('events')
    .select('id, title, google_recurring_event_id, start_time')
    .or([`google_recurring_event_id.in.(${offPageKeys.join(',')})`, ...(ids.length ? [`id.in.(${ids.join(',')})`] : [])].join(','))
    .order('start_time', { ascending: true });
  for (const e of offPage ?? []) linkTitles[e.google_recurring_event_id ?? e.id] = e.title;
}

function formatPrice(value: number): string {
  return Number.isInteger(value) ? `$${value}` : `$${value.toFixed(2)}`;
}

// Events need no label: the page only lists events.
function seriesTypeLabel(s: (typeof seriesList)[number]): string | null {
  if (isEvent) return null;
  return s.isSeries ? `${s.occurrenceCount}-Week Series` : 'Workshop';
}

// Renders a price as plain text, or — when a discount is active — the
// original struck through plus the discounted price and a tier tag.
function priceDisplayHtml(result: ActivePriceResult, suffix = ''): string {
  if (result.originalPrice == null) return '';
  if (result.display === 'original') return `${formatPrice(result.originalPrice)}${suffix}`;
  return `<s class="text-muted">${formatPrice(result.originalPrice)}</s> ${formatPrice(result.activePrice!)}${suffix} <span class="rounded-full bg-accent/15 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-accent">${priceTierLabel(result.tag)}</span>`;
}
---

<BaseLayout
  title={isEvent ? 'Register — Bachata Socials & Events' : 'Register — Group Bachata Classes'}
  description={
    isEvent
      ? 'Register for bachata social dance events and workshops in Madison, WI.'
      : 'Sign up for group bachata classes in Madison, WI at Dance Life Studio. Multi-week series and drop-in options available.'
  }
>
  <div class="mx-auto max-w-xl px-6 py-16">
    <h1 class="font-display text-3xl font-bold text-ink">{isEvent ? 'Register for an Event' : 'Register for a Group Lesson'}</h1>
    <p class="mt-2 text-sm text-muted">Fill out the form below to reserve your spot!</p>

    <form method="POST" action="/api/submit-intake" data-kind={kind} class="mt-8 flex flex-col gap-6">
      <input type="hidden" name="registration_type" value={isEvent ? 'events' : 'group'} />
      <input type="hidden" name="class" id="class-value" />
      <input type="hidden" name="class_selections" id="class-selections-value" />
      <input type="hidden" name="dancers" id="dancers-value" />

      <div class="flex flex-col gap-1.5">
        <span class="text-sm font-medium text-ink/80">{isEvent ? 'Events' : 'Classes'}<span class="text-accent"> *</span></span>
        <p class="text-xs text-muted">
          {isEvent ? "Select any events you'd like to register for. You can select more than one." : "Select any classes you'd like to register for. You can select more than one."}
        </p>

        {seriesList.length === 0 ? (
          <p class="rounded-xl border border-border bg-surface px-3 py-2.5 text-sm text-muted">
            {isEvent
              ? "No upcoming events are scheduled yet — check back soon, or reach out through the Contact page."
              : "No upcoming group classes are scheduled yet — leave a note below and we'll follow up."}
          </p>
        ) : (
          <div id="series-list" class="flex flex-col gap-2">
            {seriesList.map((s) => (
              <div
                class={`series-item rounded-xl border bg-surface data-[selected=true]:border-accent ${s.registrationClosed ? 'border-border/60 opacity-60' : 'border-border'}`}
                data-key={s.key}
                data-title={s.title}
                data-sub-label={s.subLabel}
                data-is-series={String(s.isSeries)}
                data-registration-closed={String(s.registrationClosed)}
                data-drop-in-only={String(s.dropInOnly)}
                data-price-whole={s.priceWhole.activePrice ?? ''}
                data-price-drop-in={s.priceDropIn.activePrice ?? ''}
                data-occurrences={JSON.stringify(s.occurrences)}
                data-full-roles={s.fullRoles.join(',')}
                data-whole-full={String(s.wholeFull)}
              >
                {/* The whole header picks the class when clicked, but only its title row is the button: the location link sits beside it rather than inside, since a button's contents aren't announced as controls of their own. */}
                <div class="series-header flex w-full cursor-pointer flex-col items-start gap-1 rounded-t-xl px-4 py-3 text-left transition-colors last:rounded-b-xl hover:bg-bg">
                  {/* A closed class can't be picked, only expanded to read its description (its badge says why), so it is announced as expandable rather than as a disabled button; with no description it isn't a control at all. */}
                  <div
                    role={s.registrationClosed && !s.description ? undefined : 'button'}
                    tabindex={s.registrationClosed && !s.description ? undefined : '0'}
                    aria-pressed={s.registrationClosed ? undefined : 'false'}
                    aria-expanded={s.registrationClosed && s.description ? 'false' : undefined}
                    aria-describedby={`series-sub-${s.key}`}
                    class="series-toggle-btn flex w-full flex-wrap items-center gap-1.5 rounded"
                  >
                    <span class="font-semibold text-ink">{s.title}</span>
                    {seriesTypeLabel(s) && (
                      <>
                        <span class="font-semibold text-ink/50">·</span>
                        <span class="font-semibold text-ink">{seriesTypeLabel(s)}</span>
                      </>
                    )}
                    {s.registrationClosed && (
                      <span class="rounded-full bg-border px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-ink/70">
                        {s.full ? 'Full' : 'Registration Closed'}
                      </span>
                    )}
                    {!s.registrationClosed && s.spotsText && (
                      <span class="rounded-full bg-accent/15 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-accent">
                        {s.spotsText}
                      </span>
                    )}
                    {/* "Included with …" while a linked class that includes this one is picked (set by the script). */}
                    <span class="series-included-badge hidden rounded-full bg-sky-500/15 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-sky-300"></span>
                  </div>
                  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                    <span id={`series-sub-${s.key}`} class="text-xs text-muted">{s.subLabel}</span>
                    {/* No "·" before the location: it would dangle at the line's end when the location wraps, and the pin already sets it apart. */}
                    {s.location && (
                      <>
                        <a
                          href={locationHref(s.location)}
                          target="_blank"
                          rel="noopener noreferrer"
                          onclick="event.stopPropagation()"
                          class="pin-link text-xs font-semibold text-accent"
                        >
                          <Fragment set:html={PIN_SVG} /><span class="underline">{s.location}</span>
                        </a>
                      </>
                    )}
                  </div>
                </div>

                {s.description && (
                  <div class="series-details hidden flex-col gap-1 border-t border-border bg-bg px-4 py-3 last:rounded-b-xl">
                    <div class="text-sm text-ink/70 [&_a]:text-accent [&_a]:underline [&_ol]:list-decimal [&_ol]:pl-5 [&_ul]:list-disc [&_ul]:pl-5" set:html={s.description} />
                  </div>
                )}

                {(isEvent || s.isSeries || s.dropInOnly) && (
                  <div class="series-subchoice hidden flex-col gap-3 border-t border-border bg-bg p-4 last:rounded-b-xl">
                    {isEvent ? (
                      <label class="flex items-center justify-between gap-2 text-sm text-ink">
                        {/* Events sell one ticket type, shown like a class with a single rate: one radio, always selected while the event is picked. */}
                        <span class="flex items-center gap-2">
                          <input type="radio" name={`series_mode_${s.key}`} value="whole" checked disabled={s.registrationClosed} class="series-mode-radio h-4 w-4" />
                          Single Ticket
                        </span>
                        <span class="font-semibold text-ink" set:html={s.priceWhole.originalPrice != null ? priceDisplayHtml(s.priceWhole) : 'Free'} />
                      </label>
                    ) : s.dropInOnly ? (
                      <>
                        <label class="flex items-center justify-between gap-2 text-sm text-ink">
                          <span class="flex items-center gap-2">
                            <input type="radio" name={`series_mode_${s.key}`} value="dropin" disabled={s.registrationClosed} class="series-mode-radio h-4 w-4" />
                            Drop In
                          </span>
                          <span class="font-semibold text-ink" set:html={priceDisplayHtml(s.priceDropIn, s.isSeries ? '/class' : '')} />
                        </label>
                        {s.isSeries && (
                          <div class="dropin-occurrence-picker hidden flex-col gap-2">
                            <span class="text-xs font-medium text-ink/80">
                              Which class are you dropping into?<span class="text-accent"> *</span>
                            </span>
                            <div class="flex flex-wrap gap-2">
                              {s.occurrences.map((occ) => (
                                <button
                                  type="button"
                                  class="occurrence-btn rounded-full border border-border px-3 py-1.5 text-xs font-semibold text-ink/70 transition-colors disabled:cursor-not-allowed disabled:opacity-50"
                                  data-event-id={occ.id}
                                  aria-pressed="false"
                                  disabled={occ.full}
                                >
                                  {occ.label}{occ.full && ' (Full)'}
                                </button>
                              ))}
                            </div>
                            <p class="occurrence-error hidden text-xs font-semibold text-red-600">
                              Please pick which class you're dropping into.
                            </p>
                          </div>
                        )}
                      </>
                    ) : s.priceDropIn.originalPrice != null ? (
                      <>
                        <label class="flex items-center justify-between gap-2 text-sm text-ink">
                          <span class="flex items-center gap-2">
                            <input type="radio" name={`series_mode_${s.key}`} value="whole" checked={!s.wholeFull} disabled={s.registrationClosed || s.wholeFull} class="series-mode-radio h-4 w-4" />
                            Whole Series{s.wholeFull && ' (Full)'}
                          </span>
                          <span class="font-semibold text-ink" set:html={priceDisplayHtml(s.priceWhole)} />
                        </label>
                        <label class="relative flex items-center justify-between gap-2 text-sm text-ink">
                          <span class="flex items-center gap-2">
                            <input type="radio" name={`series_mode_${s.key}`} value="dropin" disabled={s.registrationClosed} class="series-mode-radio h-4 w-4" />
                            Drop In
                            {/* Shown on hover, and on focus so keyboard and touch users can read it too. It hangs from the row's left edge (not the small button) so it never runs off a phone screen, stays open while the pointer moves onto it, and Escape closes it. */}
                            <span class="dropin-tip group inline-flex">
                              <button
                                type="button"
                                class="flex h-4 w-4 items-center justify-center rounded-full border border-muted text-[10px] font-bold text-muted"
                                aria-label="Drop-in policy"
                                aria-describedby={`dropin-policy-${s.key}`}
                              >
                                i
                              </button>
                              <div
                                id={`dropin-policy-${s.key}`}
                                role="tooltip"
                                class="dropin-tip-text absolute left-0 top-full z-30 mt-2 hidden w-full max-w-96 rounded-2xl before:absolute before:inset-x-0 before:-top-3 before:h-3 before:content-[''] border-2 border-ink bg-bg p-3 text-left text-xs text-ink/70 shadow-xl group-focus-within:block group-hover:block"
                              >
                                <strong class="text-ink">Quick Note</strong> — These classes follow a progressive
                                curriculum, so dancers who missed previous classes in a series may have difficulty
                                following along. If you've missed multiple classes, you're welcome to contact me with
                                questions or about catching up with private lessons!
                              </div>
                            </span>
                          </span>
                          <span class="font-semibold text-ink" set:html={priceDisplayHtml(s.priceDropIn, '/class')} />
                        </label>
                        <p class="dropin-note hidden rounded-lg border border-border bg-surface p-3 text-xs text-ink/70">
                          <strong class="text-ink">Quick Note</strong> — These classes follow a progressive curriculum, so
                          dancers who missed previous classes in a series may have difficulty following along. If you've
                          missed multiple classes, you're welcome to contact me with questions or about catching up with
                          private lessons!
                        </p>
                        <div class="dropin-occurrence-picker hidden flex-col gap-2">
                          <span class="text-xs font-medium text-ink/80">
                            Which class are you dropping into?<span class="text-accent"> *</span>
                          </span>
                          <div class="flex flex-wrap gap-2">
                            {s.occurrences.map((occ) => (
                              <button
                                type="button"
                                class="occurrence-btn rounded-full border border-border px-3 py-1.5 text-xs font-semibold text-ink/70 transition-colors disabled:cursor-not-allowed disabled:opacity-50"
                                data-event-id={occ.id}
                                aria-pressed="false"
                                disabled={occ.full}
                              >
                                {occ.label}{occ.full && ' (Full)'}
                              </button>
                            ))}
                          </div>
                          <p class="occurrence-error hidden text-xs font-semibold text-red-600">
                            Please pick which class you're dropping into.
                          </p>
                        </div>
                      </>
                    ) : (
                      <label class="flex items-center justify-between gap-2 text-sm text-ink">
                        <span class="flex items-center gap-2">
                          <input type="radio" name={`series_mode_${s.key}`} value="whole" checked disabled={s.registrationClosed} class="series-mode-radio h-4 w-4" />
                          Whole Series
                        </span>
                        <span class="font-semibold text-ink" set:html={priceDisplayHtml(s.priceWhole)} />
                      </label>
                    )}
                    {!isEvent && s.priceStudent.originalPrice != null && (
                      <p class="pl-6 text-xs text-muted">
                        Student discount: <span set:html={priceDisplayHtml(s.priceStudent, s.isSeries ? '/class' : '')} />{s.dropInOnly ? '' : ' (whole series or drop-in)'}
                      </p>
                    )}
                  </div>
                )}
              </div>
            ))}
          </div>
        )}

        <p id="class-error" class="hidden text-xs font-semibold text-red-600">Please select at least one {isEvent ? 'event' : 'class'}.</p>
      </div>

      <div class="flex flex-col gap-4">
        <span class="text-sm font-medium text-ink/80">Dancers<span class="text-accent"> *</span></span>
        <div id="dancers-container" class="flex flex-col gap-4"></div>
        <button
          type="button"
          id="add-dancer-btn"
          class="self-start rounded-full border border-accent px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-accent transition-colors hover:bg-accent hover:text-white"
        >
          + Add Another Dancer
        </button>
        <p id="dancers-error" class="hidden text-xs font-semibold text-red-600">
          {isEvent
            ? 'Please fill in first name, last name, and a phone or email for each dancer.'
            : 'Please fill in first name, last name, role, and a phone or email for each dancer.'}
        </p>
        <p id="role-full-error" class="hidden text-xs font-semibold text-red-600"></p>
      </div>

      {showGuidelines && (
        <div class="flex flex-col gap-3">
          <span class="text-sm font-medium text-ink/80">Community Guidelines<span class="text-accent"> *</span></span>
          <p class="text-xs text-muted">
            We are dedicated to creating a safe, inclusive, and creative space for dancers of all backgrounds. Please read and confirm that you agree to
            abide by the community guidelines below. Failure to reasonably comply may lead to removal from the event without a refund.
          </p>
          <div
            tabindex="0"
            aria-label="Community guidelines"
            class="themed-scrollbar max-h-64 overflow-y-auto rounded-xl border border-border bg-surface px-4 py-3 text-sm leading-relaxed text-ink/80 [&_a]:font-semibold [&_a]:text-accent [&_a]:underline [&_h3]:mt-3 [&_h3]:font-bold [&_h3]:text-ink [&_h3:first-child]:mt-0 [&_ol]:list-decimal [&_ol]:pl-5 [&_p:not(:first-child)]:mt-2 [&_ul]:list-disc [&_ul]:pl-5"
            set:html={guidelines}
          />
          <label class="flex items-start gap-2 text-sm text-ink">
            <input type="checkbox" name="agree_guidelines" id="agree-guidelines" class="mt-0.5 h-4 w-4 shrink-0 rounded border-border" />
            <span>
              I/We agree to abide by the community guidelines and understand that violations may result in removal without refund.
            </span>
          </label>
          <p id="guidelines-error" class="hidden text-xs font-semibold text-red-600">Please confirm you've read the community guidelines.</p>
        </div>
      )}

      {/* Shown from the start; the events form hides these only while every picked event is free (nothing to pay). */}
      <div id="subtotal-row" class="flex flex-col gap-3 rounded-xl border border-border bg-surface p-4">
        <ul id="subtotal-items" class="hidden flex-col gap-2 border-b border-border pb-3 text-sm" aria-label="What you're signing up for"></ul>
        <div class="flex items-center justify-between">
        <span class="flex items-center gap-2 text-sm font-medium text-ink/80">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 1.821-4.804 2.16-7.428.055-.433-.284-.808-.72-.808H5.106M7.5 14.25 5.106 5.272M6 18.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm9.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
          </svg>
          Subtotal
        </span>
        <span id="subtotal-value" class="text-lg font-bold text-ink">$0</span>
        </div>
        <ul id="deal-suggestions" class="hidden flex-col gap-2 border-t border-border pt-3 text-sm" aria-label="Bundle deals you can add"></ul>
      </div>
      {/* Linked classes: what's included with a pick (blue) and picks usually taken one or the other (amber). Never blocks submitting. */}
      <ul id="link-notes" class="hidden flex-col gap-2 text-sm" aria-live="polite"></ul>
      <script type="application/json" id="deals-data" set:html={JSON.stringify(pageDeals).replace(/</g, '\\u003c')} />
      <script type="application/json" id="link-titles-data" set:html={JSON.stringify(linkTitles).replace(/</g, '\\u003c')} />
      <script type="application/json" id="link-rules-data" set:html={JSON.stringify(pageLinkRules).replace(/</g, '\\u003c')} />

      <div id="payment-section" class="flex flex-col gap-1.5">
        <span class="text-sm font-medium text-ink/80">How will you pay?<span class="text-accent"> *</span></span>
        <input type="hidden" name="payment_method" id="payment-method-value" />

        <div class="flex flex-col gap-2">
          <div class="payment-item overflow-hidden rounded-xl border border-border bg-surface data-[selected=true]:border-accent" data-value="cash">
            <button
              type="button"
              class="payment-toggle-btn flex w-full items-center rounded-t-xl px-4 py-3 text-left transition-colors hover:bg-bg"
              aria-pressed="false"
            >
              <span class="font-semibold text-ink">Pay Cash at the Door</span>
            </button>
            <div class="payment-details hidden flex-col gap-1 border-t border-border bg-bg px-4 py-3">
              <p class="text-sm text-ink/70">
                You'll pay <span class="payment-amount font-semibold text-ink">$0</span> in cash before {isEvent ? 'the event' : 'class'} begins.
              </p>
            </div>
          </div>

          <div class="payment-item overflow-hidden rounded-xl border border-border bg-surface data-[selected=true]:border-accent" data-value="venmo">
            <button
              type="button"
              class="payment-toggle-btn flex w-full items-center rounded-t-xl px-4 py-3 text-left transition-colors hover:bg-bg"
              aria-pressed="false"
            >
              <span class="font-semibold text-ink">Pay with Venmo</span>
            </button>
            <div class="payment-details hidden flex-col items-center gap-3 border-t border-border bg-bg p-5 text-center">
              <p class="text-xs text-ink/70">
                Your subtotal (<span class="payment-amount font-semibold text-ink">$0</span>) is due before {isEvent ? 'the event' : 'class'} begins. Scan the code below or tap to open Venmo.
              </p>
              <p class="text-sm font-semibold text-ink">You are paying <span class="text-accent">@amumira</span></p>
              <img src="/venmo-qr.png" alt="Venmo QR code" class="h-40 w-40" />
              <a
                href="https://venmo.com/code?user_id=2024335518728192092&created=1788834419"
                target="_blank"
                rel="noopener noreferrer"
                class="gradient-accent rounded-full px-5 py-2 text-sm font-bold uppercase tracking-wider text-white transition-opacity hover:opacity-90"
              >
                Open in Venmo
              </a>
            </div>
          </div>
        </div>
        <p id="payment-error" class="hidden text-xs font-semibold text-red-600">Please choose a payment method.</p>
      </div>

      <label class="flex flex-col gap-1.5">
        <span class="text-sm font-medium text-ink/80">Notes</span>
        <textarea
          name="comments"
          rows="4"
          class="rounded-xl border border-border bg-surface px-3 py-2.5 text-ink placeholder:text-muted/60 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
        ></textarea>
      </label>

      <button
        type="submit"
        class="gradient-accent mt-2 rounded-full px-6 py-3 text-sm font-bold uppercase tracking-wider text-white transition-opacity hover:opacity-90"
      >
        Submit
      </button>
      {/* One live region for a blocked submit, refilled each time so screen readers announce the first problem on every attempt (the messages under each field are always in the page, so they aren't announced when they reappear). */}
      <p id="form-error-announcer" class="sr-only" role="alert"></p>
    </form>
  </div>
</BaseLayout>

<script>
  import { applyDeals, suggestDeals, type Deal, type DealItem } from '../lib/deals';
  import { reasonText, resolvePicks, type LinkRule, type PickScope } from '../lib/linkRules';
  import { attachEmailHint, emailsReadyToSubmit } from '../lib/emailHints';

  interface Dancer {
    firstName: string;
    lastName: string;
    role: 'leader' | 'follower' | '';
    phone: string;
    email: string;
  }

  const inputClass =
    'rounded-xl border border-border bg-surface px-3 py-2.5 text-ink placeholder:text-muted/60 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20';

  // Events sell one ticket per event and don't ask for a Leader/Follower role.
  const isEvent = document.querySelector<HTMLFormElement>('form[data-kind]')?.dataset.kind === 'event';
  const personLabel = 'Dancer';

  const ROLE_PICKER_HTML = `
      <div class="flex flex-col gap-1.5">
        <span class="text-sm font-medium text-ink/80">Role<span class="text-accent"> *</span></span>
        <div class="flex gap-2">
          <button type="button" data-role="leader" aria-pressed="false" class="dancer-role-btn flex-1 rounded-full border border-border px-3 py-1.5 text-sm font-semibold text-ink/70 transition-colors">
            Leader
          </button>
          <button type="button" data-role="follower" aria-pressed="false" class="dancer-role-btn flex-1 rounded-full border border-border px-3 py-1.5 text-sm font-semibold text-ink/70 transition-colors">
            Follower
          </button>
        </div>
      </div>`;

  const MAX_DANCERS = 5;
  const dancersContainer = document.getElementById('dancers-container')!;
  const addDancerBtn = document.getElementById('add-dancer-btn') as HTMLButtonElement;

  function updateAddDancerButton() {
    const atLimit = dancersContainer.children.length >= MAX_DANCERS;
    addDancerBtn.classList.toggle('hidden', atLimit);
  }

  // Keeps the displayed "Dancer N" labels contiguous (1, 2, 3, …) based on
  // each block's current position, instead of a counter that only ever
  // increases — otherwise removing and re-adding dancers would let the
  // label climb indefinitely (e.g. "Dancer 6") even with only a few blocks.
  function renumberDancers() {
    Array.from(dancersContainer.children).forEach((block, i) => {
      const index = i + 1;
      (block as HTMLElement).dataset.index = String(index);
      const label = block.querySelector<HTMLElement>('.dancer-number-label');
      if (label) label.textContent = `${personLabel} ${index}`;
    });
  }

  function addDancerBlock() {
    if (dancersContainer.children.length >= MAX_DANCERS) return;
    const index = dancersContainer.children.length + 1;

    const block = document.createElement('div');
    block.className = 'dancer-block flex flex-col gap-3 rounded-xl border border-border bg-bg p-4';
    block.dataset.index = String(index);
    // The first dancer is usually the person filling in the form, so their
    // fields say what they are for autofill; later dancers are someone else,
    // and autofill would put the wrong person's details in them.
    const autocomplete = (token: string) => `autocomplete="${index === 1 ? token : 'off'}"`;
    block.innerHTML = `
      <div class="flex items-center justify-between">
        <p class="dancer-number-label text-sm font-semibold text-ink">${personLabel} ${index}</p>
        ${index > 1 ? `<button type="button" class="remove-dancer-btn text-xs font-semibold text-red-600 hover:underline">Remove</button>` : ''}
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="flex flex-col gap-1.5">
          <span class="text-sm font-medium text-ink/80">First Name<span class="text-accent"> *</span></span>
          <input type="text" class="dancer-first-name ${inputClass}" ${autocomplete('given-name')} />
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="text-sm font-medium text-ink/80">Last Name<span class="text-accent"> *</span></span>
          <input type="text" class="dancer-last-name ${inputClass}" ${autocomplete('family-name')} />
        </label>
      </div>
      ${isEvent ? '' : ROLE_PICKER_HTML}
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="flex flex-col gap-1.5">
          <span class="text-sm font-medium text-ink/80">Phone<span class="text-accent"> **</span></span>
          <input type="tel" class="dancer-phone ${inputClass}" ${autocomplete('tel')} />
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="text-sm font-medium text-ink/80">Email<span class="text-accent"> **</span></span>
          <input type="email" class="dancer-email ${inputClass}" ${autocomplete('email')} />
        </label>
      </div>
      <p class="text-xs text-muted">** Either phone or email is required. We'll use it to reach you about ${isEvent ? '' : 'class '}changes, cancellations, or other important announcements.</p>
      <p class="text-xs text-muted">${isEvent ? 'Confirmations' : 'Class confirmations'} are emailed to any email address entered above. You can also print your confirmation after submitting.</p>
    `;

    const roleButtons = Array.from(block.querySelectorAll<HTMLButtonElement>('.dancer-role-btn'));

    function renderRoleButtons() {
      for (const btn of roleButtons) {
        const active = btn.dataset.role === block.dataset.role;
        btn.setAttribute('aria-pressed', String(active));
        btn.classList.toggle('gradient-accent', active);
        btn.classList.toggle('text-white', active);
        btn.classList.toggle('border-transparent', active);
        btn.classList.toggle('text-ink/70', !active);
        btn.classList.toggle('border-border', !active);
      }
    }

    roleButtons.forEach((btn) =>
      btn.addEventListener('click', () => {
        block.dataset.role = btn.dataset.role;
        renderRoleButtons();
      })
    );

    // A field marked missing by a blocked submit stops being invalid once
    // filled in (either of phone and email clears both).
    block.addEventListener('input', (e) => {
      const input = e.target as HTMLInputElement;
      if (!input.value.trim()) return;
      const fields = input.matches('.dancer-phone, .dancer-email') ? block.querySelectorAll('.dancer-phone, .dancer-email') : [input];
      fields.forEach((f) => {
        f.removeAttribute('aria-invalid');
        f.removeAttribute('aria-describedby');
      });
    });

    block.querySelector('.remove-dancer-btn')?.addEventListener('click', () => {
      block.remove();
      renumberDancers();
      updateAddDancerButton();
      updateSubtotal();
    });

    attachEmailHint(block.querySelector<HTMLInputElement>('.dancer-email')!);
    dancersContainer.appendChild(block);
    renumberDancers();
    updateAddDancerButton();
    updateSubtotal();
  }

  // Class selection — multiple classes can be selected at once, each with
  // its own Whole Series / Drop In choice when applicable.
  interface ClassSelection {
    key: string;
    title: string;
    subLabel: string;
    isSeries: boolean;
    // Only a drop-in price exists (no whole-series price): Drop In is the one, preselected choice.
    dropInOnly: boolean;
    mode: 'whole' | 'dropin';
    priceWhole: number | null;
    priceDropIn: number | null;
    occurrenceEventId: string | null;
  }

  const classValueInput = document.getElementById('class-value') as HTMLInputElement;
  const classSelectionsInput = document.getElementById('class-selections-value') as HTMLInputElement;
  const classError = document.getElementById('class-error')!;
  const selections = new Map<string, ClassSelection>();
  const subtotalValue = document.getElementById('subtotal-value')!;

  function formatPrice(value: number): string {
    return Number.isInteger(value) ? `$${value}` : `$${value.toFixed(2)}`;
  }

  const subtotalItems = document.getElementById('subtotal-items')!;
  const dealSuggestions = document.getElementById('deal-suggestions')!;
  const deals: Deal[] = JSON.parse(document.getElementById('deals-data')?.textContent || '[]');

  // ---- Linked classes (linkRules.ts) ----
  // A pick another pick includes stays picked on its card but is folded into
  // that pick: shown as included at $0, and neither charged nor sent while
  // it's covered. Once nothing covers it (the bigger class switched to a
  // Drop-In on another day, or taken off) it counts as its own pick again.
  // A "cannot take both" pair gets a warning with a one-click remove.
  // Nothing here ever stops the form from being submitted.
  const linkRules: LinkRule[] = JSON.parse(document.getElementById('link-rules-data')?.textContent || '[]');
  const linkNotes = document.getElementById('link-notes')!;
  // Takes a card's pick off without redrawing (filled in for each card below).
  const deselectors = new Map<string, () => void>();
  let linked: { included: Map<string, string>; folded: Set<string>; warnings: LinkRule[] } = { included: new Map(), folded: new Set(), warnings: [] };
  // The picks that are charged and sent: all but those folded into another.
  const charged = () => [...selections.values()].filter((sel) => !linked.folded.has(sel.key));

  // Linked classes that aren't on this page (past or closed), by name.
  const linkTitles: Record<string, string> = JSON.parse(document.getElementById('link-titles-data')?.textContent || '{}');
  const cardOf = (key: string) => document.querySelector<HTMLElement>(`.series-item[data-key="${CSS.escape(key)}"]`);
  const titleOf = (key: string) => cardOf(key)?.dataset.title ?? linkTitles[key] ?? 'this class';

  // What a pick covers (linkRules.PickScope): a whole series, or its Drop-In's day.
  function scopeOf(key: string, sel = selections.get(key)): PickScope {
    if (!sel || sel.mode !== 'dropin') return null;
    const occurrences: { id: string; day: string }[] = JSON.parse(cardOf(key)?.dataset.occurrences ?? '[]');
    return occurrences.find((o) => o.id === sel.occurrenceEventId)?.day ?? '';
  }

  function applyLinkRules() {
    if (linkRules.length === 0) return;
    const resolved = resolvePicks([...selections.keys()], linkRules, scopeOf);
    linked = { included: resolved.included, folded: new Set(resolved.folded.map((f) => f.key)), warnings: resolved.warnings };
    document.querySelectorAll<HTMLElement>('.series-item').forEach((item) => {
      const by = linked.included.get(item.dataset.key ?? '');
      const badge = item.querySelector<HTMLElement>('.series-included-badge');
      if (!badge) return;
      badge.textContent = by ? `Included with ${titleOf(by)}` : '';
      badge.classList.toggle('hidden', !by);
    });
  }

  // The rule that put `key` in with `by` (directly, or through something else included).
  function includeRule(key: string, by: string): LinkRule {
    return (
      linkRules.find((r) => r.kind === 'includes' && r.to === key && (r.from === by || linked.included.has(r.from))) ?? {
        from: by,
        to: key,
        kind: 'includes',
        reason: null,
      }
    );
  }

  function renderLinkNotes() {
    linkNotes.replaceChildren();
    const note = (tone: 'info' | 'warn', text: string, remove?: string) => {
      const li = document.createElement('li');
      li.className = `link-note link-note-${tone} flex flex-wrap items-center justify-between gap-2 rounded-lg px-3 py-2 ${tone === 'info' ? 'bg-sky-500/15 text-sky-200' : 'bg-amber-500/15 text-amber-200'}`;
      const span = document.createElement('span');
      span.textContent = text;
      li.append(span);
      if (remove) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'link-note-remove shrink-0 text-xs font-bold underline';
        btn.textContent = `Remove ${titleOf(remove)}`;
        btn.addEventListener('click', () => {
          deselectors.get(remove)?.();
          updateClassValue();
        });
        li.append(btn);
      }
      linkNotes.append(li);
    };
    for (const [key, by] of linked.included) note('info', reasonText(includeRule(key, by), titleOf));
    for (const w of linked.warnings) {
      const picked = [...selections.keys()];
      // The later of the two picks (or the one picked, when the other came included).
      const remove = [w.from, w.to].filter((k) => selections.has(k)).sort((a, b) => picked.indexOf(b) - picked.indexOf(a))[0];
      note('warn', `${reasonText(w, titleOf)} Double-check before you submit.`, remove);
    }
    const any = linkNotes.children.length > 0;
    linkNotes.classList.toggle('hidden', !any);
    linkNotes.classList.toggle('flex', any);
  }

  // What one dancer's picks cost before deals. A single Drop-In date never
  // counts toward a deal; an event ticket and a one-off class do.
  const selectionPrice = (sel: ClassSelection) => (sel.mode === 'dropin' ? sel.priceDropIn : sel.priceWhole);
  function dealItems(): DealItem[] {
    return charged().map((sel) => ({ key: sel.key, price: selectionPrice(sel), eligible: isEvent || sel.mode !== 'dropin' }));
  }

  // Classes on the page that can be added as a Whole Series / workshop / ticket.
  function addableClasses(): { key: string; price: number }[] {
    return Array.from(document.querySelectorAll<HTMLElement>('.series-item')).flatMap((item) => {
      const price = item.dataset.priceWhole ? Number(item.dataset.priceWhole) : null;
      const unavailable = item.dataset.registrationClosed === 'true' || item.dataset.wholeFull === 'true' || item.dataset.dropInOnly === 'true';
      return price == null || unavailable ? [] : [{ key: item.dataset.key ?? '', price }];
    });
  }

  // Under the subtotal: for each class that would complete a deal the dancer
  // is one class short of, what it saves and a button that adds it.
  function renderDealSuggestions(dancerCount: number) {
    dealSuggestions.replaceChildren();
    const suggestions = deals.length > 0 && selections.size > 0 ? suggestDeals(dealItems(), deals, addableClasses()).slice(0, 3) : [];
    for (const s of suggestions) {
      const item = document.querySelector<HTMLElement>(`.series-item[data-key="${CSS.escape(s.key)}"]`);
      const li = document.createElement('li');
      li.className = 'deal-suggestion flex items-center justify-between gap-3 rounded-lg bg-accent/10 px-3 py-2';
      const text = document.createElement('span');
      text.className = 'text-ink';
      const title = document.createElement('strong');
      title.textContent = item?.dataset.title ?? 'this class';
      text.append('Add ', title, ` to get the ${s.dealName} and save ${formatPrice(s.saving * dancerCount)}.`);
      const add = document.createElement('button');
      add.type = 'button';
      add.className = 'deal-add-btn shrink-0 rounded-full border border-accent px-3 py-1 text-xs font-bold uppercase tracking-wider text-accent transition-colors hover:bg-accent hover:text-white';
      add.textContent = 'Add';
      add.setAttribute('aria-label', `Add ${title.textContent}`);
      add.addEventListener('click', () => item?.querySelector<HTMLElement>('.series-toggle-btn')?.click());
      li.append(text, add);
      dealSuggestions.append(li);
    }
    dealSuggestions.classList.toggle('hidden', suggestions.length === 0);
    dealSuggestions.classList.toggle('flex', suggestions.length > 0);
  }

  // The date a Drop-In is for, from the class card's occurrence list.
  function occurrenceLabel(key: string, occurrenceId: string | null): string | null {
    if (!occurrenceId) return null;
    const item = document.querySelector<HTMLElement>(`.series-item[data-key="${CSS.escape(key)}"]`);
    const occurrences: { id: string; label: string }[] = JSON.parse(item?.dataset.occurrences ?? '[]');
    return occurrences.find((o) => o.id === occurrenceId)?.label ?? null;
  }

  // One receipt line per picked class: what it is, which option (and, for a
  // Drop-In, which date), and its price per dancer times the dancer count.
  function renderSubtotalItems(dancerCount: number, applied: { dealName: string; amount: number }[]) {
    subtotalItems.replaceChildren();
    for (const sel of charged()) {
      const price = selectionPrice(sel);
      let detail = '';
      if (isEvent || !(sel.isSeries || sel.dropInOnly)) {
        detail = sel.subLabel;
      } else if (sel.mode === 'dropin' && sel.isSeries) {
        detail = `Drop In · ${occurrenceLabel(sel.key, sel.occurrenceEventId) ?? 'pick a date above'}`;
      } else if (sel.mode === 'dropin') {
        detail = sel.subLabel;
      } else {
        detail = `Whole Series · ${sel.subLabel}`;
      }

      const line = document.createElement('li');
      line.className = 'flex items-start justify-between gap-3';
      const what = document.createElement('div');
      what.className = 'flex min-w-0 flex-col';
      const title = document.createElement('span');
      title.className = 'font-medium text-ink';
      title.textContent = sel.title;
      const sub = document.createElement('span');
      sub.className = 'text-xs text-muted';
      sub.textContent = detail;
      what.append(title, sub);

      const amount = document.createElement('span');
      amount.className = 'shrink-0 text-right text-ink';
      if (price == null) {
        amount.textContent = '—';
      } else if (dancerCount > 1) {
        amount.innerHTML = `${formatPrice(price * dancerCount)}<div class="text-xs text-muted">${formatPrice(price)} × ${dancerCount} ${isEvent ? 'attendees' : 'dancers'}</div>`;
      } else {
        amount.textContent = formatPrice(price);
      }

      line.append(what, amount);
      subtotalItems.append(line);

      // What comes with it (linked classes), free.
      for (const [included, by] of linked.included) {
        if (by !== sel.key) continue;
        const sub = document.createElement('li');
        sub.className = 'included-line flex items-start justify-between gap-3 pl-3 text-xs text-muted';
        const label = document.createElement('span');
        label.textContent = `Includes ${titleOf(included)}`;
        const free = document.createElement('span');
        free.className = 'shrink-0';
        free.textContent = '$0';
        sub.append(label, free);
        subtotalItems.append(sub);
      }
    }
    // A deal that applied twice (an "any N" deal) shows once, with its total.
    const byDeal = new Map<string, number>();
    for (const a of applied) byDeal.set(a.dealName, (byDeal.get(a.dealName) ?? 0) + a.amount);
    for (const [name, amount] of byDeal) {
      const line = document.createElement('li');
      line.className = 'deal-line flex items-start justify-between gap-3';
      const what = document.createElement('div');
      what.className = 'flex min-w-0 flex-col';
      const title = document.createElement('span');
      title.className = 'font-medium text-accent';
      title.textContent = name;
      const sub = document.createElement('span');
      sub.className = 'text-xs text-muted';
      sub.textContent = 'Bundle deal';
      what.append(title, sub);
      const value = document.createElement('span');
      value.className = 'shrink-0 text-right text-accent';
      value.textContent = `−${formatPrice(amount * dancerCount)}`;
      if (dancerCount > 1) {
        const note = document.createElement('div');
        note.className = 'text-xs text-muted';
        note.textContent = `−${formatPrice(amount)} × ${dancerCount} ${isEvent ? 'attendees' : 'dancers'}`;
        value.append(note);
      }
      line.append(what, value);
      subtotalItems.append(line);
    }
    subtotalItems.classList.toggle('hidden', selections.size === 0);
    subtotalItems.classList.toggle('flex', selections.size > 0);
  }

  function updateSubtotal() {
    const dancerCountNow = dancersContainer.children.length;
    const dealResult = applyDeals(dealItems(), deals);
    const perDancerTotal = charged().reduce((sum, sel) => sum + (selectionPrice(sel) ?? 0), 0) - dealResult.totalDiscount;
    const total = Math.round(perDancerTotal * dancerCountNow * 100) / 100;
    subtotalValue.textContent = formatPrice(total);
    if (isEvent) {
      // Picking only free events skips the subtotal and payment step.
      const paid = total > 0 || selections.size === 0;
      for (const id of ['subtotal-row', 'payment-section']) {
        const el = document.getElementById(id);
        el?.classList.toggle('hidden', !paid);
        el?.classList.toggle('flex', paid);
      }
      if (!paid) {
        (document.getElementById('payment-method-value') as HTMLInputElement).value = '';
        document.querySelectorAll<HTMLElement>('.payment-item').forEach((item) => {
          item.dataset.selected = 'false';
          item.querySelector('.payment-toggle-btn')?.setAttribute('aria-pressed', 'false');
          item.querySelector('.payment-details')?.classList.add('hidden');
          item.querySelector('.payment-details')?.classList.remove('flex');
        });
      }
    }
    document.querySelectorAll('.payment-amount').forEach((el) => (el.textContent = formatPrice(total)));
    renderSubtotalItems(dancerCountNow, dealResult.applied);
    renderDealSuggestions(dancerCountNow);
    renderLinkNotes();
  }

  function updateClassValue() {
    applyLinkRules();
    const values = charged();
    const parts = values.map((sel) =>
      !isEvent && (sel.isSeries || sel.dropInOnly)
        ? `${sel.title} — ${sel.subLabel} — ${sel.mode === 'dropin' ? 'Drop In' : 'Whole Series'}`
        : `${sel.title} — ${sel.subLabel}`
    );
    classValueInput.value = parts.join('; ');
    classSelectionsInput.value = JSON.stringify(
      values.map((sel) => ({
        key: sel.key,
        title: sel.title,
        label: sel.subLabel,
        mode: !isEvent && (sel.isSeries || sel.dropInOnly) ? sel.mode : null,
        occurrenceEventId: sel.mode === 'dropin' ? sel.occurrenceEventId : null,
      }))
    );
    if (parts.length) classError.classList.add('hidden');
    updateSubtotal();
  }

  document.querySelectorAll<HTMLElement>('.series-item').forEach((item) => {
    const key = item.dataset.key ?? '';
    const title = item.dataset.title ?? '';
    const subLabel = item.dataset.subLabel ?? '';
    const isSeries = item.dataset.isSeries === 'true';
    const registrationClosed = item.dataset.registrationClosed === 'true';
    const dropInOnly = item.dataset.dropInOnly === 'true';
    // The Whole Series is full but some dates still take Drop-Ins.
    const wholeFull = item.dataset.wholeFull === 'true';
    // A one-off drop-in class has exactly one occurrence, so there's nothing to pick.
    const singleOccurrenceId: string | null = !isSeries ? (JSON.parse(item.dataset.occurrences ?? '[]')[0]?.id ?? null) : null;
    const priceWhole = item.dataset.priceWhole ? Number(item.dataset.priceWhole) : null;
    const priceDropIn = item.dataset.priceDropIn ? Number(item.dataset.priceDropIn) : null;
    const toggleBtn = item.querySelector('.series-toggle-btn') as HTMLElement;
    const header = item.querySelector('.series-header') as HTMLElement;
    // A click anywhere on the header but the location link (which stops its
    // own clicks) acts on the title row, which is the actual button.
    header.addEventListener('click', (e) => {
      if (!toggleBtn.contains(e.target as Node)) toggleBtn.click();
    });
    const subchoice = item.querySelector<HTMLElement>('.series-subchoice');
    const details = item.querySelector<HTMLElement>('.series-details');
    const dropinNote = item.querySelector<HTMLElement>('.dropin-note');
    const occurrencePicker = item.querySelector<HTMLElement>('.dropin-occurrence-picker');
    const occurrenceError = item.querySelector<HTMLElement>('.occurrence-error');
    const occurrenceButtons = Array.from(item.querySelectorAll<HTMLButtonElement>('.occurrence-btn'));
    const modeRadios = Array.from(item.querySelectorAll<HTMLInputElement>('.series-mode-radio'));

    // Registration is closed for this class — still let its description
    // expand for info, but never add it to the form's selections.
    if (registrationClosed) {
      if (!details) return;
      toggleBtn.addEventListener('click', () => {
        const open = details.classList.toggle('flex');
        details.classList.toggle('hidden', !open);
        toggleBtn.setAttribute('aria-expanded', String(open));
      });
      toggleBtn.addEventListener('keydown', (e) => {
        if (e.target !== toggleBtn) return;
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleBtn.click();
        }
      });
      return;
    }

    function markOccurrence(btn: HTMLButtonElement, active: boolean) {
      btn.setAttribute('aria-pressed', String(active));
      btn.classList.toggle('gradient-accent', active);
      btn.classList.toggle('text-white', active);
      btn.classList.toggle('border-transparent', active);
      btn.classList.toggle('border-border', !active);
      btn.classList.toggle('text-ink/70', !active);
    }

    function showOccurrencePicker(show: boolean) {
      occurrencePicker?.classList.toggle('hidden', !show);
      occurrencePicker?.classList.toggle('flex', show);
      if (!show) {
        occurrenceError?.classList.add('hidden');
        occurrenceButtons.forEach((b) => markOccurrence(b, false));
      }
    }

    function deselectSeries(update = true) {
      selections.delete(key);
      toggleBtn.setAttribute('aria-pressed', 'false');
      header.classList.remove('bg-bg');
      item.dataset.selected = 'false';
      subchoice?.classList.add('hidden');
      subchoice?.classList.remove('flex');
      details?.classList.add('hidden');
      details?.classList.remove('flex');
      dropinNote?.classList.add('hidden');
      showOccurrencePicker(false);
      modeRadios.forEach((r) => (r.checked = false));
      if (update) updateClassValue();
    }
    deselectors.set(key, () => deselectSeries(false));

    // Shows the card as picked with this selection (its option and, for a Drop-In, its date).
    function showSelected(sel: ClassSelection, dropinNoteShown: boolean) {
      selections.set(key, sel);
      modeRadios.forEach((r) => (r.checked = r.value === sel.mode));
      toggleBtn.setAttribute('aria-pressed', 'true');
      header.classList.add('bg-bg');
      item.dataset.selected = 'true';
      subchoice?.classList.remove('hidden');
      subchoice?.classList.add('flex');
      details?.classList.remove('hidden');
      details?.classList.add('flex');
      dropinNote?.classList.toggle('hidden', !dropinNoteShown);
      // A drop-in-only series still needs to know which class they're dropping into.
      showOccurrencePicker(sel.mode === 'dropin' && isSeries);
      occurrenceButtons.forEach((b) => markOccurrence(b, Boolean(sel.occurrenceEventId) && b.dataset.eventId === sel.occurrenceEventId));
    }

    toggleBtn.addEventListener('click', () => {
      if (selections.has(key)) {
        deselectSeries();
      } else {
        const startMode = dropInOnly || wholeFull ? 'dropin' : 'whole';
        showSelected(
          {
            key,
            title,
            subLabel,
            isSeries,
            dropInOnly,
            mode: startMode,
            priceWhole,
            priceDropIn,
            occurrenceEventId: dropInOnly ? singleOccurrenceId : null,
          },
          wholeFull
        );
        updateClassValue();
      }
    });

    // toggleBtn is a div[role=button] (it wraps the title row's badges in a
    // flex layout), so Enter/Space activation needs to be wired up manually to
    // keep it keyboard-accessible — for key presses on the row itself only.
    toggleBtn.addEventListener('keydown', (e) => {
      if (e.target !== toggleBtn) return;
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggleBtn.click();
      }
    });

    // Clicking the already-selected Whole Series / Drop In option again
    // deselects this class entirely — radios don't do this natively, so it's
    // handled on click (by the time a 'change' event would fire, .checked
    // has already flipped) by comparing against the currently stored mode.
    modeRadios.forEach((radio) =>
      radio.addEventListener('click', () => {
        // An event's Single Ticket is its only option: it stays selected, and
        // the event is deselected from its title row instead.
        if (isEvent) {
          radio.checked = true;
          return;
        }
        const selection = selections.get(key);
        if (selection && selection.mode === radio.value) {
          deselectSeries();
        } else if (selection) {
          selection.mode = radio.value as 'whole' | 'dropin';
          const isDropIn = selection.mode === 'dropin';
          dropinNote?.classList.toggle('hidden', !isDropIn);
          showOccurrencePicker(isDropIn);
          if (!isDropIn) selection.occurrenceEventId = null;
          updateClassValue();
        }
      })
    );

    occurrenceButtons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const selection = selections.get(key);
        if (!selection) return;
        occurrenceButtons.forEach((b) => markOccurrence(b, b === btn));
        selection.occurrenceEventId = btn.dataset.eventId ?? null;
        occurrenceError?.classList.add('hidden');
        updateClassValue();
      })
    );
  });

  // Payment method — click a card to select it; the Venmo card expands
  // in place to show the QR code and payment link.
  const paymentMethodValue = document.getElementById('payment-method-value') as HTMLInputElement;
  const paymentError = document.getElementById('payment-error')!;

  document.querySelectorAll<HTMLElement>('.payment-item').forEach((item) => {
    const value = item.dataset.value ?? '';
    const toggleBtn = item.querySelector('.payment-toggle-btn') as HTMLButtonElement;
    const details = item.querySelector<HTMLElement>('.payment-details');

    toggleBtn.addEventListener('click', () => {
      document.querySelectorAll<HTMLElement>('.payment-item').forEach((other) => {
        other.dataset.selected = 'false';
        other.querySelector('.payment-toggle-btn')?.setAttribute('aria-pressed', String(other === item));
        if (other !== item) {
          other.querySelector('.payment-details')?.classList.add('hidden');
          other.querySelector('.payment-details')?.classList.remove('flex');
        }
      });
      item.dataset.selected = 'true';
      paymentMethodValue.value = value;
      paymentError.classList.add('hidden');
      details?.classList.remove('hidden');
      details?.classList.add('flex');
    });
  });

  // Marks each missing dancer field invalid and points it at the message under
  // the dancer list, so a screen reader says what's wrong when it's focused.
  // Phone and email are only missing when both are empty.
  function markDancerFields(dancerBlocks: HTMLElement[], dancers: Dancer[]) {
    dancerBlocks.forEach((block, i) => {
      const d = dancers[i];
      const missing: [string, boolean][] = [
        ['.dancer-first-name', !d.firstName],
        ['.dancer-last-name', !d.lastName],
        ['.dancer-phone', !d.phone && !d.email],
        ['.dancer-email', !d.phone && !d.email],
      ];
      for (const [sel, invalid] of missing) {
        const input = block.querySelector<HTMLInputElement>(sel);
        if (!input) continue;
        if (invalid) {
          input.setAttribute('aria-invalid', 'true');
          input.setAttribute('aria-describedby', 'dancers-error');
        } else {
          input.removeAttribute('aria-invalid');
          input.removeAttribute('aria-describedby');
        }
      }
    });
  }

  // After a blocked submit, scrolls to the first problem on the page (in page
  // order). A missing dancer detail jumps to that dancer, with the cursor in
  // the first empty field, rather than to the message under the dancer list.
  function jumpToFirstError(dancerBlocks: HTMLElement[], dancers: Dancer[]) {
    const firstError = Array.from(document.querySelectorAll<HTMLElement>('form p.text-red-600')).find(
      (el) => !el.classList.contains('hidden') && el.offsetParent !== null
    );
    if (!firstError) return;
    announceError(firstError.textContent?.trim() ?? '');

    if (firstError.id === 'dancers-error') {
      const index = dancers.findIndex((d) => !(d.firstName && d.lastName && (isEvent || d.role) && (d.phone || d.email)));
      const block = dancerBlocks[index];
      if (block) {
        block.scrollIntoView({ behavior: 'smooth', block: 'center' });
        const empty = ['.dancer-first-name', '.dancer-last-name', '.dancer-phone']
          .map((sel) => block.querySelector<HTMLInputElement>(sel))
          .find((input) => input && !input.value.trim());
        // Nothing typed is missing, so it is the role.
        (empty ?? block.querySelector<HTMLElement>('.dancer-role-btn'))?.focus({ preventScroll: true });
        return;
      }
    }
    firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
    // Focus the control the message is about, so keyboard and screen-reader
    // users land where they need to fix it: the first one that's showing and
    // usable (a closed class can only be expanded, not picked).
    Array.from(firstError.parentElement?.querySelectorAll<HTMLElement>('input:not([type="hidden"]):not(:disabled), button:not(:disabled), [role="button"]') ?? [])
      .find((el) => el.offsetParent !== null && !el.closest('[data-registration-closed="true"]'))
      ?.focus({ preventScroll: true });
  }

  // Emptied, then refilled a moment later, so the same message is announced
  // again on a second blocked submit.
  const errorAnnouncer = document.getElementById('form-error-announcer')!;
  function announceError(message: string) {
    errorAnnouncer.textContent = '';
    setTimeout(() => (errorAnnouncer.textContent = message), 100);
  }

  // Escape closes an open drop-in policy tooltip (hovered or focused) until
  // the pointer or focus leaves it.
  const dropinTips = Array.from(document.querySelectorAll<HTMLElement>('.dropin-tip'));
  dropinTips.forEach((tip) => {
    const reset = () => tip.querySelector<HTMLElement>('.dropin-tip-text')?.style.removeProperty('display');
    tip.addEventListener('mouseleave', reset);
    tip.addEventListener('focusout', reset);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    for (const tip of dropinTips) {
      const text = tip.querySelector<HTMLElement>('.dropin-tip-text');
      if (text && (tip.matches(':hover') || tip.contains(document.activeElement))) text.style.display = 'none';
    }
  });

  function fullRoleConflict(dancers: Dancer[]): string | null {
    for (const sel of charged()) {
      const item = document.querySelector<HTMLElement>(`.series-item[data-key="${CSS.escape(sel.key)}"]`);
      // A Drop-In only needs room on its own date; a Whole Series in every class.
      const occurrences: { id: string; fullRoles: string[] }[] = JSON.parse(item?.dataset.occurrences ?? '[]');
      const date = sel.mode === 'dropin' ? occurrences.find((o) => o.id === sel.occurrenceEventId) : undefined;
      const fullRoles = date ? date.fullRoles : (item?.dataset.fullRoles ?? '').split(',').filter(Boolean);
      const role = dancers.find((d) => d.role && fullRoles.includes(d.role))?.role;
      if (role) return `"${sel.title}" is full for ${role}s — please pick another class or role.`;
    }
    return null;
  }

  // Set once the email notes (a likely typo, or a domain that can't receive
  // mail) have had their one chance to stop the submit.
  let emailsChecked = false;

  document.querySelector('form')?.addEventListener('submit', (e) => {
    let hasError = false;

    if (!classValueInput.value) {
      classError.classList.remove('hidden');
      hasError = true;
    }

    for (const sel of charged()) {
      if (sel.mode === 'dropin' && !sel.occurrenceEventId) {
        const item = document.querySelector<HTMLElement>(`.series-item[data-key="${CSS.escape(sel.key)}"]`);
        item?.querySelector('.occurrence-error')?.classList.remove('hidden');
        hasError = true;
      }
    }

    const paymentShown = !document.getElementById('payment-section')?.classList.contains('hidden');
    if (paymentShown && !paymentMethodValue.value) {
      paymentError.classList.remove('hidden');
      hasError = true;
    }

    const dancerBlocks = Array.from(document.querySelectorAll<HTMLElement>('.dancer-block'));
    const dancers: Dancer[] = dancerBlocks.map((block) => ({
      firstName: (block.querySelector('.dancer-first-name') as HTMLInputElement).value.trim(),
      lastName: (block.querySelector('.dancer-last-name') as HTMLInputElement).value.trim(),
      role: (block.dataset.role as Dancer['role']) ?? '',
      phone: (block.querySelector('.dancer-phone') as HTMLInputElement).value.trim(),
      email: (block.querySelector('.dancer-email') as HTMLInputElement).value.trim(),
    }));

    const dancersError = document.getElementById('dancers-error')!;
    const dancersValid = dancers.every((d) => d.firstName && d.lastName && (isEvent || d.role) && (d.phone || d.email));
    markDancerFields(dancerBlocks, dancers);
    if (!dancersValid) {
      dancersError.classList.remove('hidden');
      hasError = true;
    } else {
      dancersError.classList.add('hidden');
    }

    // A class capped by role whose Leader or Follower spots are gone (the
    // server checks the counts too; this just says so before submitting).
    const roleFullError = document.getElementById('role-full-error')!;
    const roleFullMessage = fullRoleConflict(dancers);
    roleFullError.textContent = roleFullMessage ?? '';
    roleFullError.classList.toggle('hidden', !roleFullMessage);
    if (roleFullMessage) hasError = true;

    // Events with community guidelines: everyone's agreement is required.
    const agreeGuidelines = document.getElementById('agree-guidelines') as HTMLInputElement | null;
    const guidelinesError = document.getElementById('guidelines-error');
    if (agreeGuidelines && !agreeGuidelines.checked) {
      guidelinesError?.classList.remove('hidden');
      hasError = true;
    } else {
      guidelinesError?.classList.add('hidden');
    }

    if (hasError) {
      e.preventDefault();
      jumpToFirstError(dancerBlocks, dancers);
      return;
    }

    (document.getElementById('dancers-value') as HTMLInputElement).value = JSON.stringify(dancers);

    // Last: a likely email typo stops the first submit (see emailHints.ts).
    if (!emailsChecked) {
      e.preventDefault();
      const form = e.currentTarget as HTMLFormElement;
      const emails = dancerBlocks.map((b) => b.querySelector<HTMLInputElement>('.dancer-email')!);
      void emailsReadyToSubmit(emails).then((ready) => {
        if (!ready) return;
        emailsChecked = true;
        // A tick later: the browser ignores a submit started while it's still handling the one just stopped.
        setTimeout(() => form.requestSubmit());
      });
    }
  });

  document.getElementById('agree-guidelines')?.addEventListener('change', (e) => {
    if ((e.target as HTMLInputElement).checked) document.getElementById('guidelines-error')?.classList.add('hidden');
  });

  // Bootstrap the first dancer block now that updateSubtotal (and everything
  // it depends on) is defined above.
  addDancerBlock();
  addDancerBtn.addEventListener('click', addDancerBlock);

  // Preselect a class when arriving via a homepage offering panel's
  // "Register Now" link (?series=<key>).
  const preselectKey = new URLSearchParams(window.location.search).get('series');
  if (preselectKey) {
    const targetItem = document.querySelector<HTMLElement>(`.series-item[data-key="${CSS.escape(preselectKey)}"]`);
    targetItem?.querySelector<HTMLElement>('.series-toggle-btn')?.click();
    targetItem?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
</script>
