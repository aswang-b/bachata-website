---
import ClassCalendarPicker from './ClassCalendarPicker.astro';

interface ClassEvent {
  id: string;
  title: string;
  start_time: string;
  end_time: string;
  color: string;
  google_recurring_event_id: string | null;
}

interface Props {
  registrationType: string;
  heading: string;
  subtext?: string;
  commentsLabel?: string;
  classEvents?: ClassEvent[];
  classEmptyMessage?: string;
  contactMethodPicker?: boolean;
  requireAll?: boolean;
  requireComments?: boolean;
}

const {
  registrationType,
  heading,
  subtext = "Fill out the form below and we'll be in touch to get you started.",
  commentsLabel = 'Comments',
  classEvents,
  classEmptyMessage,
  contactMethodPicker = false,
  requireAll = false,
  requireComments = false,
} = Astro.props;

const inputClass =
  'rounded-xl border border-border bg-surface px-3 py-2.5 text-ink placeholder:text-muted/60 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20';

const CONTACT_METHODS = [
  { key: 'phone', label: 'Phone', inputType: 'tel', placeholder: '' },
  { key: 'email', label: 'Email', inputType: 'email', placeholder: '' },
  { key: 'instagram', label: 'Instagram', inputType: 'text', placeholder: '@yourusername' },
  { key: 'whatsapp', label: 'WhatsApp', inputType: 'tel', placeholder: '' },
] as const;
---

<div class="mx-auto max-w-xl px-6 py-16">
  <h1 class="font-display text-3xl font-bold text-ink">{heading}</h1>
  <p class="mt-2 text-sm text-muted">{subtext}</p>

  <form method="POST" action="/api/submit-intake" class="mt-8 flex flex-col gap-5">
    <input type="hidden" name="registration_type" value={registrationType} />

    <div class="grid gap-5 sm:grid-cols-2">
      <label class="flex flex-col gap-1.5">
        <span class="text-sm font-medium text-ink/80">First Name{requireAll && <span class="text-accent"> *</span>}</span>
        <input type="text" name="first_name" required class={inputClass} />
      </label>

      <label class="flex flex-col gap-1.5">
        <span class="text-sm font-medium text-ink/80">Last Name{requireAll && <span class="text-accent"> *</span>}</span>
        <input type="text" name="last_name" required class={inputClass} />
      </label>
    </div>

    {contactMethodPicker ? (
      <div class="flex flex-col gap-3">
        <span class="text-sm font-medium text-ink/80">How can I reach you?<span class="text-accent"> *</span></span>
        <p class="text-xs text-muted">Select at least one way to reach you — you can pick more than one.</p>

        <div id="contact-method-buttons" class="grid grid-cols-2 gap-2">
          {CONTACT_METHODS.map((m) => (
            <button
              type="button"
              class="contact-method-btn w-full rounded-full border border-border px-4 py-1.5 text-center text-sm font-semibold text-ink/70 transition-colors hover:bg-surface"
              data-method={m.key}
            >
              {m.label}
            </button>
          ))}
        </div>

        <div class="flex flex-col gap-3">
          {CONTACT_METHODS.map((m) => (
            <label class="contact-method-field hidden flex-col gap-1.5" data-method={m.key}>
              <span class="text-sm font-medium text-ink/80">{m.label}</span>
              <input type={m.inputType} name={m.key} placeholder={m.placeholder || undefined} class={inputClass} />
            </label>
          ))}
        </div>

        <p id="contact-method-error" class="hidden text-xs font-semibold text-red-600">
          Please select at least one way to reach you and fill in the field.
        </p>
      </div>
    ) : (
      <>
        <label class="flex flex-col gap-1.5">
          <span class="text-sm font-medium text-ink/80">Email{requireAll && <span class="text-accent"> *</span>}</span>
          <input type="email" name="email" required class={inputClass} />
        </label>

        <label class="flex flex-col gap-1.5">
          <span class="text-sm font-medium text-ink/80">Phone{requireAll && <span class="text-accent"> *</span>}</span>
          <input type="tel" name="phone" required={requireAll} class={inputClass} />
        </label>
      </>
    )}

    {classEvents ? (
      <ClassCalendarPicker events={classEvents} required={requireAll} emptyMessage={classEmptyMessage} />
    ) : !contactMethodPicker ? (
      <label class="flex flex-col gap-1.5">
        <span class="text-sm font-medium text-ink/80">Class</span>
        <input
          type="text"
          name="class"
          placeholder="e.g. Beginner Bachata, Wednesday 7pm"
          class={inputClass}
        />
      </label>
    ) : null}

    <label class="flex flex-col gap-1.5">
      <span class="text-sm font-medium text-ink/80">{commentsLabel}{requireComments && <span class="text-accent"> *</span>}</span>
      <textarea name="comments" rows="4" required={requireComments} class={inputClass}></textarea>
    </label>

    <button
      type="submit"
      class="gradient-accent mt-2 rounded-full px-6 py-3 text-sm font-bold uppercase tracking-wider text-white transition-opacity hover:opacity-90"
    >
      Submit
    </button>
  </form>
</div>

<script>
  const contactMethodButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.contact-method-btn'));

  if (contactMethodButtons.length) {
    const errorEl = document.getElementById('contact-method-error');
    const selected = new Set<string>();

    function fieldFor(method: string): HTMLElement | null {
      return document.querySelector(`.contact-method-field[data-method="${method}"]`);
    }

    function inputFor(method: string): HTMLInputElement | null {
      return fieldFor(method)?.querySelector('input') ?? null;
    }

    contactMethodButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const method = btn.dataset.method ?? '';
        const field = fieldFor(method);
        const input = inputFor(method);

        if (selected.has(method)) {
          selected.delete(method);
          btn.classList.remove('gradient-accent', 'text-white', 'border-transparent');
          btn.classList.add('border-border', 'text-ink/70');
          field?.classList.add('hidden');
          field?.classList.remove('flex');
          if (input) input.value = '';
        } else {
          selected.add(method);
          btn.classList.add('gradient-accent', 'text-white', 'border-transparent');
          btn.classList.remove('border-border', 'text-ink/70');
          field?.classList.remove('hidden');
          field?.classList.add('flex');
          input?.focus();
        }
        errorEl?.classList.add('hidden');
      });
    });

    document.querySelector('form')?.addEventListener('submit', (e) => {
      const valid = selected.size > 0 && Array.from(selected).every((m) => (inputFor(m)?.value ?? '').trim());
      if (!valid) {
        e.preventDefault();
        errorEl?.classList.remove('hidden');
        errorEl?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  }
</script>
