---
---

<div id="announcement-banner" role="status" aria-live="polite" class="relative hidden items-center justify-center bg-linear-to-r from-[#cc3068] to-[#d72244] px-11 py-2.5 text-center text-sm font-semibold text-white [&_a]:underline">
  <span id="announcement-banner-content"></span>
  <button id="announcement-banner-close" aria-label="Dismiss announcement" class="absolute right-3 top-1/2 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full text-white/80 transition-colors hover:bg-white/15 hover:text-white">
    ✕
  </button>
</div>

<script>
  async function initBanner() {
    const banner = document.getElementById('announcement-banner')!;
    const content = document.getElementById('announcement-banner-content')!;
    const closeBtn = document.getElementById('announcement-banner-close')!;

    try {
      const res = await fetch('/api/banner');
      const { enabled, content: html } = await res.json();
      if (!enabled || !html) return;

      content.innerHTML = html;
      banner.classList.remove('hidden');
      banner.classList.add('flex');

      // Closing hides it for this page only; it's back on the next page load or refresh.
      closeBtn.addEventListener('click', () => {
        banner.classList.add('hidden');
        banner.classList.remove('flex');
      });
    } catch {
      // If the banner can't be fetched, just don't show it.
    }
  }

  initBanner();
</script>
