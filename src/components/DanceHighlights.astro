---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Drop image files into src/assets/highlights/ (see the README there) and
// they show up here automatically, in filename order. No code changes needed.
const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/highlights/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const slides = Object.keys(modules)
  .sort((a, b) => a.localeCompare(b))
  .map((path) => modules[path].default);

const AUTOPLAY_MS = 4000;
---

<section class="mx-auto max-w-xl px-6 py-20">
  <div class="mb-8 text-center">
    <p class="text-sm font-bold uppercase tracking-[0.3em] text-accent">@ohmytofuu · dance-26</p>
    <h2 class="mt-2 font-display text-3xl font-extrabold text-ink">Follow the Journey</h2>
  </div>

  {slides.length === 0 ? (
    <div class="flex aspect-[9/16] w-full flex-col items-center justify-center gap-2 rounded-3xl border border-dashed border-border bg-surface px-6 text-center">
      <p class="text-sm text-muted">
        Add photos to <code class="text-accent">src/assets/highlights/</code> to populate this gallery.
      </p>
      <a
        href="https://www.instagram.com/ohmytofuu/"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 rounded-full border-2 border-accent px-4 py-2 text-xs font-bold uppercase tracking-wider text-accent transition-colors hover:bg-accent hover:text-white"
      >
        View on Instagram
      </a>
    </div>
  ) : (
    <div
      id="highlight-viewer"
      class="relative aspect-[9/16] w-full overflow-hidden rounded-3xl bg-black shadow-[0_12px_32px_rgba(0,0,0,0.18)]"
      data-autoplay={AUTOPLAY_MS}
    >
      <div class="absolute inset-x-3 top-3 z-20 flex gap-1.5">
        {slides.map((_, i) => (
          <div class="h-1 flex-1 overflow-hidden rounded-full bg-white/25">
            <div class="highlight-progress-fill gradient-accent h-full w-0 rounded-full" data-index={i}></div>
          </div>
        ))}
      </div>

      <div class="absolute inset-x-3 top-6 z-20 flex items-center gap-2">
        <div class="gradient-accent h-7 w-7 rounded-full"></div>
        <span class="text-xs font-semibold text-white drop-shadow">dance-26</span>
      </div>

      <div class="relative h-full w-full">
        {slides.map((slide, i) => (
          <Image
            src={slide}
            alt={`Dance highlight ${i + 1}`}
            width={720}
            height={1280}
            class:list={[
              'highlight-slide absolute inset-0 h-full w-full object-cover transition-opacity duration-500',
              i === 0 ? 'opacity-100' : 'opacity-0',
            ]}
            data-index={i}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        ))}
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
      </div>

      <button
        id="highlight-prev"
        aria-label="Previous highlight"
        class="absolute inset-y-0 left-0 z-20 w-1/3 cursor-pointer"
      ></button>
      <button
        id="highlight-next"
        aria-label="Next highlight"
        class="absolute inset-y-0 right-0 z-20 w-1/3 cursor-pointer"
      ></button>

      <a
        href="https://www.instagram.com/ohmytofuu/"
        target="_blank"
        rel="noopener noreferrer"
        class="gradient-accent absolute inset-x-3 bottom-3 z-20 rounded-full px-4 py-2 text-center text-xs font-bold uppercase tracking-wider text-white transition-opacity hover:opacity-90"
      >
        View on Instagram
      </a>
    </div>
  )}
</section>

<script>
  const viewer = document.getElementById('highlight-viewer');
  if (viewer) {
    const slides = Array.from(viewer.querySelectorAll<HTMLElement>('.highlight-slide'));
    const fills = Array.from(viewer.querySelectorAll<HTMLElement>('.highlight-progress-fill'));
    const autoplayMs = Number(viewer.dataset.autoplay ?? 4000);

    let current = 0;
    let elapsed = 0;
    const tickMs = 50;

    const render = () => {
      slides.forEach((slide, i) => {
        slide.style.opacity = i === current ? '1' : '0';
      });
      fills.forEach((fill, i) => {
        const index = Number(fill.dataset.index);
        if (index < current) {
          fill.style.width = '100%';
        } else if (index === current) {
          fill.style.width = `${(elapsed / autoplayMs) * 100}%`;
        } else {
          fill.style.width = '0%';
        }
      });
    };

    const goTo = (index: number) => {
      current = (index + slides.length) % slides.length;
      elapsed = 0;
      render();
    };

    let interval: ReturnType<typeof setInterval>;

    const tick = () => {
      elapsed += tickMs;
      if (elapsed >= autoplayMs) {
        goTo(current + 1);
      } else {
        render();
      }
    };

    const start = () => {
      interval = setInterval(tick, tickMs);
    };
    const stop = () => clearInterval(interval);

    viewer.querySelector('#highlight-prev')?.addEventListener('click', () => goTo(current - 1));
    viewer.querySelector('#highlight-next')?.addEventListener('click', () => goTo(current + 1));

    viewer.addEventListener('mouseenter', stop);
    viewer.addEventListener('mouseleave', start);

    render();
    start();
  }
</script>
