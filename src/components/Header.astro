---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about', settingsKey: 'hide_about_nav' },
  { label: 'Calendar', href: '/calendar' },
  { label: 'Contact', href: '/contact', settingsKey: 'hide_contact_nav' },
  { label: 'Check In', href: '/check-in', settingsKey: 'hide_checkin_nav' },
];

const currentPath = Astro.url.pathname;
const isAdminPage = currentPath === '/admin';
const isRegisterPage = currentPath === '/register' || currentPath === '/register/events';
// Lavender, to set it apart from the accent-colored Register for Classes button.
const eventsButtonClass = 'border border-violet-300/40 bg-violet-300/10 text-violet-300 hover:border-violet-300/70 hover:bg-violet-300/20';
---

<header class="sticky top-0 z-50 border-b border-border bg-bg/90 backdrop-blur print:hidden">
  <div id="header-row" class="mx-auto grid max-w-6xl grid-cols-[auto_1fr_auto] items-center gap-3 px-4 py-4 sm:gap-4 sm:px-6">
    <a href="/" class="whitespace-nowrap font-display text-lg font-extrabold tracking-tight text-ink sm:text-xl">
      Dance with <span class="text-gradient-accent inline-block align-baseline">B</span>
    </a>

    <nav class="hidden items-center justify-center gap-8 md:flex">
      {navItems.map((item) => {
        const isActive = currentPath === item.href;
        return (
          <a
            href={item.href}
            data-settings-key={item.settingsKey}
            class={`text-sm font-semibold uppercase tracking-wider transition-colors hover:text-accent ${
              isActive ? 'text-accent' : 'text-ink/70'
            }`}
          >
            {item.label}
          </a>
        );
      })}
      <a
        href="/admin"
        class={`admin-nav-link hidden text-sm font-semibold uppercase tracking-wider transition-colors hover:text-accent ${
          isAdminPage ? 'text-accent' : 'text-ink/70'
        }`}
      >
        Admin
      </a>
      <a
        href="/admin/analytics"
        class={`admin-nav-link hidden text-sm font-semibold uppercase tracking-wider transition-colors hover:text-accent ${
          currentPath === '/admin/analytics' ? 'text-accent' : 'text-ink/70'
        }`}
      >
        Dashboard
      </a>
    </nav>

    <div id="header-actions" class="flex items-center justify-end gap-2 md:gap-4">
      {/* Off until an admin turns it on (Admin → Site Visibility); the `hidden` attribute is removed by the script below. */}
      {/* Both register buttons show at every width; the script below swaps in the short label when the full one doesn't fit. */}
      {
        currentPath !== '/register/events' && (
          <a
            href="/register/events"
            hidden
            data-show-settings-key="show_register_events_nav"
            class={`register-btn flex whitespace-nowrap rounded-md px-2 py-1.5 sm:px-2.5 text-[10px] font-semibold uppercase tracking-wide transition-colors md:px-4 md:text-xs md:tracking-wider ${eventsButtonClass}`}
          >
            <span class="register-label-full">Register for Events</span>
            <span class="register-label-short hidden">Events</span>
          </a>
        )
      }

      {
        !isRegisterPage && (
          <a
            href="/register"
            class="register-btn flex whitespace-nowrap rounded-md border border-accent/40 bg-accent/10 px-2 py-1.5 sm:px-2.5 text-[10px] font-semibold uppercase tracking-wide text-accent transition-colors hover:border-accent/70 hover:bg-accent/20 md:px-4 md:text-xs md:tracking-wider"
          >
            <span class="register-label-full">Register for Classes</span>
            <span class="register-label-short hidden">Classes</span>
          </a>
        )
      }

      <a
        href="/admin/inbox"
        id="inbox-link"
        aria-label="Inbox"
        class="admin-nav-link relative hidden h-6 w-6 items-center justify-center rounded-full border border-border text-ink transition-colors hover:bg-surface md:h-9 md:w-9"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 md:h-5 md:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 0 0 2.22 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2Z" />
        </svg>
        <span id="inbox-dot" class="absolute -right-0.5 -top-0.5 hidden h-2 w-2 rounded-full bg-red-500 ring-2 ring-bg md:h-2.5 md:w-2.5"></span>
      </a>

      <button
        id="nav-toggle"
        class="text-ink md:hidden"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="hidden flex-col gap-1 border-t border-border px-6 py-4 md:hidden">
    {navItems.map((item) => (
      <a
        href={item.href}
        data-settings-key={item.settingsKey}
        class="rounded-full px-3 py-2 text-sm font-semibold uppercase tracking-wider text-ink/70 hover:bg-surface hover:text-accent"
      >
        {item.label}
      </a>
    ))}
    <a
      href="/register/events"
      hidden
      data-show-settings-key="show_register_events_nav"
      class={`rounded-full px-3 py-2 text-sm font-semibold uppercase tracking-wider ${eventsButtonClass}`}
    >
      Register for Events
    </a>
    <a
      href="/admin"
      class="admin-nav-link hidden rounded-full px-3 py-2 text-sm font-semibold uppercase tracking-wider text-ink/70 hover:bg-surface hover:text-accent"
    >
      Admin
    </a>
    <a
      href="/admin/analytics"
      class="admin-nav-link hidden rounded-full px-3 py-2 text-sm font-semibold uppercase tracking-wider text-ink/70 hover:bg-surface hover:text-accent"
    >
      Dashboard
    </a>
  </nav>
</header>

<script>
  import { checkAdminSession } from '../lib/adminSession';
  import { isPreviewingAsPublic } from '../lib/previewMode';

  const toggle = document.getElementById('nav-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  // Register buttons show "Register for Classes/Events" when the header row
  // has room, and just "Classes"/"Events" when it doesn't. Re-run whenever the
  // row's contents change (resize, the events button or admin links appearing).
  const headerRow = document.getElementById('header-row');
  const headerActions = document.getElementById('header-actions');

  function setShortLabels(short: boolean) {
    document.querySelectorAll('.register-label-full').forEach((el) => el.classList.toggle('hidden', short));
    document.querySelectorAll('.register-label-short').forEach((el) => el.classList.toggle('hidden', !short));
  }

  function fitRegisterLabels() {
    if (!headerRow || !headerActions) return;
    setShortLabels(false);
    const overflowing = headerRow.scrollWidth > headerRow.clientWidth || headerActions.scrollWidth > headerActions.clientWidth;
    if (overflowing) setShortLabels(true);
  }

  if (headerRow) new ResizeObserver(fitRegisterLabels).observe(headerRow);
  fitRegisterLabels();

  toggle?.addEventListener('click', () => {
    const isHidden = mobileNav?.classList.contains('hidden');
    mobileNav?.classList.toggle('hidden');
    mobileNav?.classList.toggle('flex');
    toggle.setAttribute('aria-expanded', String(Boolean(isHidden)));
  });

  async function revealAdminNavLinkIfAdmin() {
    if (isPreviewingAsPublic()) return;

    const gate = await checkAdminSession();
    if (gate.status !== 'admin') return;
    const { session } = gate;

    document.querySelectorAll('.admin-nav-link').forEach((el) => el.classList.remove('hidden'));
    document.getElementById('inbox-link')?.classList.add('flex');
    fitRegisterLabels();

    try {
      const countRes = await fetch('/api/admin/unseen-count', {
        headers: { Authorization: `Bearer ${session.access_token}` },
      });
      const { count } = await countRes.json();
      document.getElementById('inbox-dot')?.classList.toggle('hidden', !count);
    } catch {
      // If the count can't be fetched, just leave the dot hidden.
    }
  }

  revealAdminNavLinkIfAdmin();

  async function hideDisabledNavLinks() {
    try {
      const res = await fetch('/api/settings');
      const settings = await res.json();
      for (const [key, enabled] of Object.entries(settings)) {
        if (!enabled) continue;
        document.querySelectorAll(`[data-settings-key="${key}"]`).forEach((el) => el.classList.add('hidden'));
        document.querySelectorAll(`[data-show-settings-key="${key}"]`).forEach((el) => el.removeAttribute('hidden'));
      }
      fitRegisterLabels();
    } catch {
      // If settings can't be fetched, fail open and leave nav links visible.
    }
  }

  hideDisabledNavLinks();
</script>
