---
import { getSiteSettings } from '../lib/siteSettings';
import InstallApp from './InstallApp.astro';
import { headerCss } from '../lib/headerFit';

// Site Visibility settings (Admin tab), loaded for each page by middleware.ts,
// so the header arrives whole: no button or link popping in or out after load.
const settings = Astro.locals.siteSettings ?? (await getSiteSettings());
const showEventsButton = settings.show_register_events_nav;

const allNavItems = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about', settingsKey: 'hide_about_nav' as const },
  { label: 'Calendar', href: '/calendar' },
  { label: 'Contact', href: '/contact', settingsKey: 'hide_contact_nav' as const },
  { label: 'Check In', href: '/check-in', settingsKey: 'hide_checkin_nav' as const },
];
const navItems = allNavItems.filter((item) => !(item.settingsKey && settings[item.settingsKey]));

const currentPath = Astro.url.pathname;
const isAdminPage = currentPath === '/admin';
// Lavender, to set it apart from the accent-colored Register for Classes button.
const eventsButtonClass = 'border border-violet-300/40 bg-violet-300/10 text-violet-300 hover:border-violet-300/70 hover:bg-violet-300/20';

// Menu or nav links, short or long register labels: picked by CSS from the
// screen width, at the widths where these very links and buttons fit
// (lib/headerFit.ts), so the first frame is the last.
const layoutCss = headerCss({ navLabels: navItems.map((item) => item.label), showEvents: Boolean(showEventsButton) });
---

<style is:inline set:html={layoutCss}></style>

<header id="site-header" class="border-b border-border bg-bg/90 backdrop-blur print:hidden">
  <div id="header-row" class="mx-auto grid max-w-6xl grid-cols-[auto_1fr_auto] items-center gap-3 px-4 py-4 sm:gap-4 sm:px-6">
    <a href="/" class="whitespace-nowrap font-display text-lg font-extrabold tracking-tight text-ink sm:text-xl">
      Dance with <span class="text-gradient-accent inline-block align-baseline">B</span>
    </a>

    <nav id="desktop-nav" class="items-center justify-center gap-8">
      {navItems.map((item) => {
        const isActive = currentPath === item.href;
        return (
          <a
            href={item.href}
            class={`whitespace-nowrap text-sm font-semibold uppercase tracking-wider transition-colors hover:text-accent ${
              isActive ? 'text-accent' : 'text-ink/70'
            }`}
          >
            {item.label}
          </a>
        );
      })}
      <a
        href="/admin"
        class={`admin-nav-link hidden whitespace-nowrap text-sm font-semibold uppercase tracking-wider transition-colors hover:text-accent ${
          isAdminPage ? 'text-accent' : 'text-ink/70'
        }`}
      >
        Admin
      </a>
      <a
        href="/admin/analytics"
        class={`admin-nav-link hidden whitespace-nowrap text-sm font-semibold uppercase tracking-wider transition-colors hover:text-accent ${
          currentPath === '/admin/analytics' ? 'text-accent' : 'text-ink/70'
        }`}
      >
        Dashboard
      </a>
    </nav>

    <div id="header-actions" class="flex items-center justify-end gap-2 md:gap-4">
      {/* Off until an admin turns it on (Admin → Site Visibility). */}
      {/* Both register buttons show on every page (the register pages too) and at every width; the inline style above picks the long or short label by the screen width. */}
      {showEventsButton && (
        <a
          href="/register/events"
          aria-current={currentPath === '/register/events' ? 'page' : undefined}
          class={`register-btn flex h-8 items-center whitespace-nowrap rounded-md px-2.5 text-[11px] font-semibold uppercase tracking-wide transition-colors md:h-auto md:px-4 md:py-1.5 md:text-xs md:tracking-wider ${eventsButtonClass}`}
        >
          <span class="register-label-full">Register for Events</span>
          <span class="register-label-short">Events</span>
        </a>
      )}

      <a
        href="/register"
        aria-current={currentPath === '/register' ? 'page' : undefined}
        class="register-btn flex h-8 items-center whitespace-nowrap rounded-md border border-accent/40 bg-accent/10 px-2.5 text-[11px] font-semibold uppercase tracking-wide text-accent transition-colors hover:border-accent/70 hover:bg-accent/20 md:h-auto md:px-4 md:py-1.5 md:text-xs md:tracking-wider"
      >
        <span class="register-label-full">Register for Classes</span>
        <span class="register-label-short">Classes</span>
      </a>

      {/* The bell: push notifications, and (on phones) how to add the site to the home screen. Admins get their inbox here instead.
          On a phone the inbox and the register buttons share one height and corner, so the row lines up. */}
      <InstallApp />

      <a
        href="/admin/inbox"
        id="inbox-link"
        aria-label="Inbox"
        class="admin-nav-link relative hidden h-8 w-8 shrink-0 items-center justify-center rounded-md border border-border text-ink transition-colors hover:bg-surface md:h-9 md:w-9 md:rounded-full"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 md:h-5 md:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 0 0 2.22 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2Z" />
        </svg>
        <span id="inbox-dot" class="absolute -right-0.5 -top-0.5 hidden h-2 w-2 rounded-full bg-red-500 ring-2 ring-bg md:h-2.5 md:w-2.5"></span>
      </a>

      <button
        id="nav-toggle"
        class="text-ink"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="hidden flex-col gap-1 border-t border-border px-6 py-4">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="rounded-full px-3 py-2 text-sm font-semibold uppercase tracking-wider text-ink/70 hover:bg-surface hover:text-accent"
      >
        {item.label}
      </a>
    ))}
    <a
      href="/admin"
      class="admin-nav-link hidden rounded-full px-3 py-2 text-sm font-semibold uppercase tracking-wider text-ink/70 hover:bg-surface hover:text-accent"
    >
      Admin
    </a>
    <a
      href="/admin/analytics"
      class="admin-nav-link hidden rounded-full px-3 py-2 text-sm font-semibold uppercase tracking-wider text-ink/70 hover:bg-surface hover:text-accent"
    >
      Dashboard
    </a>
  </nav>
</header>

<style>
  /* Which layout and labels show by screen width is the inline style above
     (lib/headerFit.ts). data-fit (the script below) only overrides it when the
     row really runs past its edge: an admin's extra links, or a visitor's own
     larger minimum font size. */
  #site-header[data-fit~='short'] .register-label-full,
  #site-header[data-fit~='long'] .register-label-short {
    display: none;
  }
  #site-header[data-fit~='short'] .register-label-short,
  #site-header[data-fit~='long'] .register-label-full {
    display: inline;
  }
</style>

<script>
  import { checkAdminSessionIfStored } from '../lib/sessionHint';
  import { isPreviewingAsPublic } from '../lib/previewMode';

  const toggle = document.getElementById('nav-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const siteHeader = document.getElementById('site-header');
  const headerRow = document.getElementById('header-row');
  const headerActions = document.getElementById('header-actions');

  // The style above picks the layout by width. Only if the row then really
  // runs past its edge (an admin's Admin, Dashboard and inbox, or a visitor's
  // own minimum font size) does this force a smaller one, in the order the
  // header always stepped down: short labels, then the menu with long labels,
  // then the menu with short ones. Only boxes in the row's flow count: the
  // bell's and inbox's dots and the menu button's tap area stick out on purpose
  // (the bell's dot, 2px past the bell, was what sent desktops to the phone
  // layout). With the width's own layout fitting, it changes nothing.
  type Fit = { compact: boolean; short: boolean };
  const rank = ({ compact, short }: Fit) => Number(compact) * 2 + Number(short);
  const STEPS: Fit[] = [
    { compact: false, short: true },
    { compact: true, short: false },
    { compact: true, short: true },
  ];
  const shown = (el: Element | null) => !!el && getComputedStyle(el).display !== 'none';

  function overflowing(): boolean {
    if (!headerRow) return false;
    const edge = headerRow.getBoundingClientRect().right + 0.5;
    const boxes = [...headerRow.children, ...(headerActions?.children ?? [])].filter((el) => el.tagName !== 'DIALOG' && el.getClientRects().length > 0);
    return boxes.some((el) => el.getBoundingClientRect().right > edge);
  }

  function setFit(fit: Fit | null) {
    if (!siteHeader) return;
    const value = fit ? `${fit.compact ? 'compact' : 'full'} ${fit.short ? 'short' : 'long'}` : null;
    if (siteHeader.getAttribute('data-fit') === value) return;
    if (value) siteHeader.setAttribute('data-fit', value);
    else siteHeader.removeAttribute('data-fit');
  }

  function fitHeader() {
    if (!siteHeader || !headerRow) return;
    const before = siteHeader.getAttribute('data-fit');
    siteHeader.removeAttribute('data-fit');
    const byWidth: Fit = { compact: !shown(document.getElementById('desktop-nav')), short: shown(siteHeader.querySelector('.register-label-short')) };
    let fit: Fit | null = null;
    if (overflowing()) {
      const smaller = STEPS.filter((step) => rank(step) > rank(byWidth));
      for (const step of smaller) {
        fit = step;
        setFit(step);
        if (!overflowing()) break;
      }
    }
    // Put back what was there before deciding, so an unchanged answer is no change at all.
    if (before) siteHeader.setAttribute('data-fit', before);
    setFit(fit);
  }

  if (headerRow) new ResizeObserver(() => fitHeader()).observe(headerRow);
  document.fonts?.addEventListener('loadingdone', () => fitHeader());

  toggle?.addEventListener('click', () => {
    const isHidden = mobileNav?.classList.contains('hidden');
    mobileNav?.classList.toggle('hidden');
    mobileNav?.classList.toggle('flex');
    toggle.setAttribute('aria-expanded', String(Boolean(isHidden)));
  });

  async function revealAdminNavLinkIfAdmin() {
    if (isPreviewingAsPublic()) return;

    const gate = await checkAdminSessionIfStored();
    if (gate.status !== 'admin') return;
    const { session } = gate;

    document.querySelectorAll('.admin-nav-link').forEach((el) => el.classList.remove('hidden'));
    document.getElementById('inbox-link')?.classList.add('flex');
    fitHeader();

    try {
      const countRes = await fetch('/api/admin/unseen-count', {
        headers: { Authorization: `Bearer ${session.access_token}` },
      });
      const { count } = await countRes.json();
      document.getElementById('inbox-dot')?.classList.toggle('hidden', !count);
    } catch {
      // If the count can't be fetched, just leave the dot hidden.
    }
  }

  revealAdminNavLinkIfAdmin();
</script>
