---
// The event editor's picker for a class or event to link (script: src/lib/linkedClassesEditor.ts).
---

{/* Picks a class or event to link (one row per series). Past ones are only
    listed once their tab is opened. */}
<div id="link-picker" class="fixed inset-0 z-[60] hidden items-stretch justify-center bg-black/50 sm:items-center sm:p-4" role="dialog" aria-modal="true" aria-labelledby="link-picker-title">
  <div class="flex h-full w-full flex-col bg-bg shadow-2xl sm:h-auto sm:max-h-[80vh] sm:max-w-lg sm:rounded-2xl">
    <div class="flex items-center justify-between gap-3 border-b border-border px-4 py-3">
      <h3 id="link-picker-title" class="font-display text-lg font-bold text-ink">Link a class</h3>
      <button type="button" id="link-picker-close" aria-label="Close" class="flex h-9 w-9 items-center justify-center rounded-full text-ink/70 hover:bg-surface">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
    <div id="link-picker-browse" class="flex min-h-0 flex-1 flex-col">
      <div role="tablist" aria-label="Which classes" class="flex gap-1 border-b border-border px-4">
        <button type="button" role="tab" data-tab="upcoming" aria-selected="true" class="link-picker-tab border-b-2 border-transparent px-3 py-2 text-sm font-semibold text-ink/60 aria-selected:border-accent aria-selected:text-ink">Upcoming</button>
        <button type="button" role="tab" data-tab="past" aria-selected="false" class="link-picker-tab border-b-2 border-transparent px-3 py-2 text-sm font-semibold text-ink/60 aria-selected:border-accent aria-selected:text-ink">Past</button>
      </div>
      <div class="px-4 pt-3">
        <input id="link-picker-search" type="search" placeholder="Search by name" aria-label="Search by name" class="w-full rounded-xl border border-border bg-surface px-3 py-2 text-sm text-ink focus:border-accent focus:outline-none" />
      </div>
      <ul id="link-picker-list" class="themed-scrollbar flex min-h-0 flex-1 flex-col overflow-y-auto px-4 py-3"></ul>
    </div>
    <div id="link-picker-confirm" class="hidden flex-col gap-3 p-4">
      <p id="link-picker-confirm-text" class="text-sm text-ink/80"></p>
      <div class="flex justify-end gap-2">
        <button type="button" id="link-picker-back" class="rounded-full border border-border px-4 py-2 text-sm font-semibold text-ink/70 hover:bg-surface">Back</button>
        <button type="button" id="link-picker-confirm-btn" class="gradient-accent rounded-full px-5 py-2 text-sm font-bold text-white hover:opacity-90">Link</button>
      </div>
    </div>
  </div>
</div>
