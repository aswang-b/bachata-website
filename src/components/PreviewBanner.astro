<div
  id="preview-banner"
  class="hidden items-center justify-center gap-3 bg-neutral-900 px-4 py-2 text-center text-xs font-semibold text-white"
>
  <span>Previewing as a public visitor — admin controls are hidden.</span>
  <button id="preview-banner-exit" class="underline hover:text-white/70">Exit preview</button>
</div>

<script>
  import { isPreviewingAsPublic, setPreviewAsPublic } from '../lib/previewMode';

  const banner = document.getElementById('preview-banner');
  if (isPreviewingAsPublic()) {
    banner?.classList.remove('hidden');
    banner?.classList.add('flex');
  }

  document.getElementById('preview-banner-exit')?.addEventListener('click', () => {
    setPreviewAsPublic(false);
    window.location.reload();
  });
</script>
