---
// The homepage's "Past Classes & Events": the flyers an admin uploaded to the
// gallery (admin → Homepage), in a sideways row that turns like a cylinder as it
// scrolls and loops forever both ways. A flyer opens full size through the
// homepage's flyer dialog (data-flyer-open).
// On phones a swipe settles with the nearest flyer centered (CSS scroll snap).
interface Props {
  flyers: string[];
}
const { flyers } = Astro.props;

// The loop: the flyers are repeated in identical copies, the row starts on the
// middle copy, and whenever scrolling stops near either end it jumps back by
// whole copies (invisibly, since the copies match). An odd count, enough that a
// long flick can't reach the end before it stops.
const copies = flyers.length > 0 ? Math.max(5, Math.ceil(15 / flyers.length) | 1) : 0;
const middleCopy = Math.floor(copies / 2);
const arrowClass =
  'absolute top-1/2 z-[200] hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-white shadow-md backdrop-blur transition hover:bg-accent sm:flex';
---

{flyers.length > 0 && (
  <section class="mt-16" aria-labelledby="past-flyers-heading">
    <h2 id="past-flyers-heading" class="mb-2 text-center font-display text-3xl font-extrabold text-ink">Past Classes & Events</h2>
    <div class="relative">
      <button type="button" data-gallery-scroll="-1" aria-label="Scroll back" class={`${arrowClass} left-2`}>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
      </button>
      <div id="past-flyers" data-copies={copies} data-count={flyers.length} class="flex items-center gap-10 overflow-x-auto overscroll-x-contain py-8 max-sm:snap-x max-sm:snap-mandatory [perspective:1100px] [scrollbar-width:none] sm:gap-14 [&::-webkit-scrollbar]:hidden">
        {Array.from({ length: copies }, (_, copy) =>
          flyers.map((url) => {
            // Only the middle copy is for screen readers and the keyboard; the rest are its look-alikes.
            const real = copy === middleCopy;
            return (
              <button
                type="button"
                data-flyer-open={url}
                data-gallery-flyer
                class="shrink-0 will-change-transform max-sm:snap-center"
                aria-label={real ? 'View this past flyer full size' : undefined}
                aria-hidden={real ? undefined : 'true'}
                tabindex={real ? undefined : -1}
              >
                <img src={url} alt={real ? 'Flyer from a past class or event' : ''} loading="lazy" class="h-64 w-auto max-w-none rounded-2xl border border-border shadow-[0_12px_32px_rgba(0,0,0,0.45)] sm:h-80" />
              </button>
            );
          })
        )}
      </div>
      {/* Phones only (where the arrows are hidden): a hint that the row scrolls, gone after the first swipe. */}
      <div id="past-flyers-hint" aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-14 z-[210] flex justify-center transition-opacity duration-500 sm:hidden">
        <div class="flex items-center gap-2 rounded-full bg-black/55 px-4 py-2 text-sm font-semibold text-white shadow-md backdrop-blur">
          <span class="relative h-6 w-10 shrink-0">
            <span class="swipe-hint-gesture absolute left-0 top-0 h-6 w-6">
              <span class="swipe-hint-trail absolute left-[7px] top-[1px] h-[3px] rounded-full bg-linear-to-r from-white/80 to-white/0"></span>
              <svg class="relative h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 14a8 8 0 0 1-8 8" /><path d="M18 11v-1a2 2 0 0 0-2-2a2 2 0 0 0-2 2" /><path d="M14 10V9a2 2 0 0 0-2-2a2 2 0 0 0-2 2v1" /><path d="M10 9.5V4a2 2 0 0 0-2-2a2 2 0 0 0-2 2v10" /><path d="M18 11a2 2 0 1 1 4 0v3a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15" /></svg>
            </span>
          </span>
          Swipe to see more
        </div>
      </div>
      <button type="button" data-gallery-scroll="1" aria-label="Scroll forward" class={`${arrowClass} right-2`}>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
      </button>
    </div>
  </section>
)}

<style>
  /* One finger swipes right to left, leaving a short trail, then fades and
     starts again. The trail grows as far as the finger moves, so its far end
     stays where the swipe began. */
  .swipe-hint-gesture {
    animation: swipe-hint-finger 1.8s ease-out infinite;
  }
  .swipe-hint-trail {
    animation: swipe-hint-trail 1.8s ease-out infinite;
  }
  @keyframes swipe-hint-finger {
    0% {
      transform: translateX(16px);
      opacity: 0;
    }
    8% {
      transform: translateX(16px);
      opacity: 1;
    }
    55% {
      transform: translateX(0);
      opacity: 1;
    }
    80%,
    100% {
      transform: translateX(0);
      opacity: 0;
    }
  }
  @keyframes swipe-hint-trail {
    0%,
    8% {
      width: 0;
    }
    55%,
    100% {
      width: 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .swipe-hint-gesture,
    .swipe-hint-trail {
      animation: none;
    }
  }
</style>

<script>
  const gallery = document.getElementById('past-flyers');
  if (gallery) {
    const items = Array.from(gallery.querySelectorAll<HTMLElement>('[data-gallery-flyer]'));
    const copies = Number(gallery.dataset.copies);
    const count = Number(gallery.dataset.count);
    const middleCopy = Math.floor(copies / 2);
    // One copy's width, flyer to flyer (gaps included).
    const copyWidth = () => items[count].offsetLeft - items[0].offsetLeft;

    // Each flyer turns away, drops back and fades the further it is from the
    // middle, like posters on a cylinder that spins as the row scrolls.
    // Wider up (where the arrows are) only the middle three show: a flyer more
    // than one flyer away from the middle fades out as it moves off, rather
    // than showing as a thin, turned-away sliver at the edge.
    const wide = window.matchMedia('(min-width: 640px)');
    let frame = 0;
    const render = () => {
      frame = 0;
      const half = gallery.clientWidth / 2;
      const center = gallery.scrollLeft + half;
      const step = copyWidth() / count;
      for (const item of items) {
        const distance = item.offsetLeft + item.offsetWidth / 2 - center;
        const offset = Math.max(-1.5, Math.min(1.5, distance / half));
        const beyondThree = wide.matches && step > 0 ? Math.max(0, Math.min(1, (Math.abs(distance) / step - 1.05) / 0.45)) : 0;
        item.style.transform = `translateZ(${-Math.abs(offset) * 160}px) rotateY(${offset * 45}deg)`;
        item.style.opacity = String((1 - Math.min(1, Math.abs(offset)) * 0.45) * (1 - beyondThree));
        item.style.visibility = beyondThree >= 1 ? 'hidden' : '';
        item.style.zIndex = String(100 - Math.round(Math.abs(offset) * 50));
      }
    };
    wide.addEventListener('change', () => schedule());
    const schedule = () => {
      frame ||= requestAnimationFrame(render);
    };

    // Puts the middle copy's first flyer in the middle (until someone scrolls,
    // since the flyers' widths are only known as their images load).
    let touched = false;
    const centerStart = () => {
      if (touched) return;
      const first = items[middleCopy * count];
      gallery.scrollLeft = first.offsetLeft + first.offsetWidth / 2 - gallery.clientWidth / 2;
      render();
    };

    // Back to the middle copies once scrolling stops near either end; the jump
    // is a whole number of copies, so nothing on screen changes.
    let idle = 0;
    const recenter = () => {
      const width = copyWidth();
      if (width <= 0) return;
      const copy = Math.floor((gallery.scrollLeft + gallery.clientWidth / 2 - items[0].offsetLeft) / width);
      if (copy < 1 || copy > copies - 2) gallery.scrollLeft += (middleCopy - copy) * width;
      target = null;
    };
    // The phone hint goes at the first swipe, and stays gone in this browser.
    const hint = document.getElementById('past-flyers-hint');
    const HINT_KEY = 'past-flyers-swiped';
    try {
      if (localStorage.getItem(HINT_KEY)) hint?.remove();
    } catch {
      // Storage blocked: the hint still goes at the first swipe.
    }
    const dismissHint = () => {
      if (!hint?.isConnected) return;
      hint.style.opacity = '0';
      setTimeout(() => hint.remove(), 500);
      try {
        localStorage.setItem(HINT_KEY, '1');
      } catch {
        // Storage blocked: it shows again next visit.
      }
    };

    gallery.addEventListener(
      'scroll',
      () => {
        // Only a scroll someone made (not the row centering itself as images load).
        if (touched) dismissHint();
        schedule();
        clearTimeout(idle);
        idle = window.setTimeout(recenter, 150);
      },
      { passive: true }
    );
    for (const type of ['pointerdown', 'wheel', 'touchstart'] as const) gallery.addEventListener(type, () => (touched = true), { passive: true });
    window.addEventListener('resize', () => {
      centerStart();
      schedule();
    });
    gallery.querySelectorAll('img').forEach((img) => img.addEventListener('load', centerStart));
    centerStart();

    // An arrow centers the next flyer exactly (flyers differ in width, so a
    // fixed step would drift); there's always a next one. Clicks during the
    // glide count from the flyer it's heading to.
    const centeredIndex = () => {
      const middle = gallery.scrollLeft + gallery.clientWidth / 2;
      let best = 0;
      items.forEach((item, i) => {
        if (Math.abs(item.offsetLeft + item.offsetWidth / 2 - middle) < Math.abs(items[best].offsetLeft + items[best].offsetWidth / 2 - middle)) best = i;
      });
      return best;
    };
    let target: number | null = null;
    document.querySelectorAll<HTMLButtonElement>('[data-gallery-scroll]').forEach((button) => {
      button.addEventListener('click', () => {
        touched = true;
        let next = (target ?? centeredIndex()) + Number(button.dataset.galleryScroll);
        // Heading into an end copy (fast clicks outrun the jump that waits for
        // scrolling to stop): jump back by whole copies first. The view is
        // identical, so the glide carries on seamlessly toward the same flyer.
        const copy = Math.floor(next / count);
        if (copy < 1 || copy > copies - 2) {
          const shift = middleCopy - copy;
          gallery.scrollLeft += shift * copyWidth();
          next += shift * count;
        }
        target = next;
        const item = items[target];
        gallery.scrollTo({ left: item.offsetLeft + item.offsetWidth / 2 - gallery.clientWidth / 2, behavior: 'smooth' });
      });
    });
    // Swiping or the wheel takes over from an arrow's glide.
    for (const type of ['pointerdown', 'wheel', 'touchstart'] as const) gallery.addEventListener(type, () => (target = null), { passive: true });
  }
</script>
