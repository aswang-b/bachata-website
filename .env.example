# Server-only (never exposed to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
ADMIN_EMAIL=you@example.com,another-admin@example.com
GOOGLE_CALENDAR_ID_PUBLIC=your-public-calendar-id@group.calendar.google.com
GOOGLE_CALENDAR_ID_PRIVATE=your-private-calendar-id@group.calendar.google.com
RESEND_API_KEY=your-resend-api-key
# Signing secret of the Resend webhook (email.bounced) pointing at /api/resend-webhook
RESEND_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
# Fallback only — the recipient list is normally managed from /admin
# (Contact Notification Recipients), which is stored in Supabase and takes
# precedence over this once set.
NOTIFICATION_EMAILS=you@example.com

# Optional abuse-prevention cap (has a safe built-in default if unset). The
# per-IP limits for check-ins and emails are managed from /admin instead.
RESEND_DAILY_CAP=200

# The door sign (/admin/qr): the "Dance With B" author token for qr.dancewithb.fun (server only)
QR_API_TOKEN=qra_your-author-token
# Optional: feedback emails a day (default 300)
RESEND_FEEDBACK_DAILY_CAP=300

# Exposed to the browser (safe — these are meant to be public)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-api-key

# Push notifications (lib/push.ts). Generate a pair once with
# `npx web-push generate-vapid-keys`; the public one is sent to browsers.
PUBLIC_VAPID_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
